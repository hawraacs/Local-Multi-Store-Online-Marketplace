@page
@model Local_Multi_Store_Online_Marketplace.Pages.CustomerOrdersModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>My Orders | realnest</title>

    <!-- Google Fonts & FontAwesome Icons (Consistent with Customer Feed/Cart) -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-color: #faf9fc;
                --card-bg: #ffffff;
                --border-color: #ece8f6;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                /* Purple / Indigo palette — same tokens as the Cart page */
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --like-color: #ef4444;
                --success-color: #10b981;
                --error-color: #dc2626;
                --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.04);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.08);
                --shadow-lg: 0 20px 40px rgba(109, 40, 217, 0.12);
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-family);
                background-color: var(--bg-color);
                color: var(--text-primary);
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                padding-bottom: 100px; /* Offset to prevent overlap with the bottom nav */
            }

            /* ============================================================
                                   BOTTOM NAV — rendered by the shared _CustomerBottomNav
                                   partial. Styles below match Customer1/Chat/Feed/Cart
                                   exactly (same class names).
                                   ============================================================ */
            .mobile-bottom-nav {
                display: flex !important;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 200;
                background: #ffffff;
                border-top: 1px solid #ece8f6;
                justify-content: space-between;
                gap: 2px;
                padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
                overflow-x: auto;
                box-shadow: 0 -4px 20px rgba(30, 27, 46, 0.06);
            }

                .mobile-bottom-nav a {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: 2px;
                    font-size: 10.5px;
                    color: #6b6478;
                    text-decoration: none;
                    padding: 4px 6px;
                    flex-shrink: 0;
                    position: relative;
                    border-radius: 12px;
                    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
                }

                    .mobile-bottom-nav a i {
                        font-size: 17px;
                        transition: transform 0.2s ease;
                    }

                    .mobile-bottom-nav a:hover {
                        background: var(--accent-light);
                        color: var(--accent-color);
                    }

                    .mobile-bottom-nav a.active {
                        color: var(--accent-color) !important;
                        background: var(--accent-light) !important;
                        font-weight: 700;
                        transform: translateY(-2px);
                    }

                        .mobile-bottom-nav a.active i {
                            transform: scale(1.12);
                        }

            /* Cart badge (used by _CartCountBadge partial inside _CustomerBottomNav) */
            .unread-nav-badge {
                position: absolute;
                top: 2px;
                right: 18px;
                background: var(--accent-gradient);
                color: #fff;
                font-size: 10px;
                font-weight: 800;
                min-width: 16px;
                height: 16px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 4px;
                box-shadow: 0 3px 8px rgba(109, 40, 217, 0.3);
            }

            /* Chat unread dot (used inside _CustomerBottomNav) */
            .chat-icon-wrap {
                position: relative;
                display: inline-flex;
            }

                .chat-icon-wrap .chat-nav-dot {
                    position: absolute;
                    top: -2px;
                    right: -4px;
                    width: 9px;
                    height: 9px;
                    background: #ed4956;
                    border: 2px solid #fff;
                    border-radius: 50%;
                    box-sizing: content-box;
                }

            /* PAGE CONTENT — header treatment matches the Cart page's
                           .cart-header (Playfair title + secondary subtitle). */
            .orders-page {
                min-height: 100vh;
                padding: 32px 16px 20px;
            }

            .orders-header {
                text-align: center;
                margin-bottom: 20px;
                max-width: 1250px;
                margin-left: auto;
                margin-right: auto;
            }

                .orders-header h2 {
                    font-family: 'Playfair Display', Georgia, serif;
                    font-size: 34px;
                    font-weight: 800;
                    margin: 0 0 8px;
                    color: var(--text-primary);
                }

                .orders-header p {
                    margin: 0;
                    color: var(--text-secondary);
                    font-size: 15px;
                    font-weight: 500;
                }

            .orders-box {
                max-width: 1250px;
                margin: auto;
                padding: 28px;
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: 24px;
                box-shadow: var(--shadow-lg);
            }

            /* TABLES — a single, predictable grid: fixed column
                           widths (via <colgroup>), a sticky header so long order
                           histories stay readable, top-aligned cells so rows of
                           different heights (multi-product orders) still line up
                           cleanly, and subtle zebra striping to help the eye track
                           across a row. */
            .table-wrapper {
                width: 100%;
                overflow: auto;
                max-height: 640px;
                border-radius: 16px;
                border: 1px solid var(--border-color);
            }

            table {
                width: 100%;
                min-width: 1320px;
                border-collapse: separate;
                border-spacing: 0;
                table-layout: fixed;
            }

            thead tr {
                position: sticky;
                top: 0;
                z-index: 2;
                background: var(--accent-gradient);
            }

            th {
                padding: 24px 12px;
                background: transparent;
                color: white;
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                text-align: left;
                vertical-align: middle;
                white-space: normal;
                line-height: 1.35;
                box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.15);
            }

                th.col-status,
                th.col-pay-status,
                th.col-total,
                th.col-tracking,
                th.col-invoice {
                    text-align: center;
                }

                th.col-total {
                    text-align: right;
                }

            td {
                padding: 16px;
                border-bottom: 1px solid var(--border-color);
                color: var(--text-secondary);
                font-size: 13.5px;
                vertical-align: top;
            }

            tbody tr:last-child td {
                border-bottom: none;
            }

            tbody tr:nth-child(even) {
                background: #fcfbff;
            }

            tbody tr:hover {
                background: var(--accent-light);
            }

            /* Column widths — keeps every row aligned to the same grid
                           regardless of content length. Products is deliberately
                           narrower now; the space goes to Payment Method/Status so
                           values like "Cash On Delivery" have room to breathe. */
            .col-order {
                width: 11%;
            }

            .col-store {
                width: 9%;
            }

            .col-products {
                width: 13%;
            }

            .col-date {
                width: 9%;
            }

            .col-status {
                width: 9%;
            }

            .col-pay-method {
                width: 12%;
            }

            .col-pay-status {
                width: 11%;
            }

            .col-total {
                width: 9%;
            }

            .col-tracking {
                width: 9%;
            }

            .col-invoice {
                width: 8%;
            }

            .order-number {
                min-width: 120px;
                color: var(--accent-color);
                font-weight: 800;
                font-size: 14px;
                word-break: break-word;
            }

            .store-cell {
                min-width: 120px;
                color: var(--text-primary);
                font-weight: 700;
                font-size: 13px;
            }

                .store-cell i {
                    color: var(--accent-color);
                    margin-right: 6px;
                }

            .products-cell {
                min-width: 150px;
            }

            .date-cell {
                white-space: nowrap;
                font-weight: 600;
                color: var(--text-secondary);
            }

            .pay-method-cell {
                min-width: 115px;
                font-weight: 600;
                color: var(--text-primary);
                word-break: break-word;
            }

            .product-line {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 10px;
                margin-bottom: 7px;
                padding-bottom: 7px;
                border-bottom: 1px dashed var(--border-color);
            }

                .product-line:last-child {
                    margin-bottom: 0;
                    padding-bottom: 0;
                    border-bottom: none;
                }

            .product-name {
                color: var(--text-primary);
                font-weight: 700;
                line-height: 1.35;
                word-break: break-word;
            }

            .product-quantity {
                flex-shrink: 0;
                padding: 2px 8px;
                background: var(--accent-light);
                color: var(--accent-color);
                border-radius: 999px;
                font-size: 11px;
                font-weight: 800;
                white-space: nowrap;
            }

            .no-products {
                color: var(--text-secondary);
                font-size: 12px;
                font-weight: 600;
            }

            /* STATUS CELL */
            .status-cell {
                min-width: 100px;
                text-align: center;
            }

            /* BADGES — one consistent shape (pill) across the page,
                           but the COLOR now carries meaning: amber = waiting,
                           blue = in progress, purple = out for delivery,
                           green = completed/paid, red = cancelled/unpaid. This
                           keeps the palette purposeful instead of every status
                           looking the same. */
            .status-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 12px;
                border-radius: 999px;
                font-size: 11.5px;
                font-weight: 800;
                white-space: nowrap;
                background: #f3effe;
                color: var(--accent-color);
                border: 1px solid #e4d9fb;
            }

                .status-badge.status-pending {
                    background: #fff7ed;
                    color: #c2410c;
                    border-color: #fed7aa;
                }

                .status-badge.status-processing {
                    background: #eff6ff;
                    color: #1d4ed8;
                    border-color: #bfdbfe;
                }

                .status-badge.status-outfordelivery {
                    background: var(--accent-light);
                    color: var(--accent-color);
                    border-color: #e4d9fb;
                }

                .status-badge.status-delivered {
                    background: #dcfce7;
                    color: #166534;
                    border-color: #86efac;
                }

                .status-badge.status-cancelled {
                    background: #fef2f2;
                    color: var(--error-color);
                    border-color: #fee2e2;
                }

            .paid-badge {
                display: inline-block;
                padding: 5px 11px;
                background: #dcfce7;
                color: #166534;
                border: 1px solid #86efac;
                border-radius: 999px;
                font-size: 11px;
                font-weight: 800;
                white-space: nowrap;
            }

            .pending-badge {
                display: inline-block;
                padding: 5px 11px;
                background: #fef2f2;
                color: var(--error-color);
                border: 1px solid #fee2e2;
                border-radius: 999px;
                font-size: 11px;
                font-weight: 800;
                white-space: nowrap;
            }

            .pay-status-cell {
                min-width: 110px;
                text-align: center;
            }

            /* TOTAL CELL — right-aligned so figures line up like a
                           ledger, with the order's total emphasized. */
            .total-cell {
                min-width: 90px;
                text-align: right;
            }

            .total-amount {
                display: block;
                color: var(--text-primary);
                font-weight: 800;
                font-size: 15px;
                white-space: nowrap;
            }

            /* TRACKING / INVOICE CELLS — centered single-action
                           columns matching the Cart page's pill buttons. */
            .tracking-cell,
            .invoice-cell {
                min-width: 130px;
                text-align: center;
            }

            .track-btn,
            .invoice-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                width: 100%;
                padding: 9px 14px;
                background: var(--accent-light);
                color: var(--accent-color);
                border: 1px solid var(--border-color);
                border-radius: 50px;
                text-decoration: none;
                font-size: 12.5px;
                font-weight: 700;
                white-space: nowrap;
                transition: all 0.2s ease;
            }

            .invoice-btn {
                background: var(--accent-gradient);
                color: white;
                border: none;
                box-shadow: 0 4px 10px rgba(109, 40, 217, 0.2);
            }

            .track-btn:hover {
                background: var(--accent-color);
                color: white;
                border-color: var(--accent-color);
                transform: translateY(-1px);
            }

            .invoice-btn:hover {
                opacity: 0.95;
                box-shadow: 0 6px 14px rgba(109, 40, 217, 0.3);
                transform: translateY(-1px);
            }

            .disabled-track {
                display: block;
                color: var(--text-secondary);
                font-size: 11.5px;
                font-weight: 700;
                line-height: 1.4;
                text-align: center;
            }

            /* EMPTY STATES — matches Cart's .empty-cart card exactly. */
            .empty-box {
                max-width: 700px;
                margin: 40px auto 0;
                padding: 60px 40px;
                color: var(--text-secondary);
                text-align: center;
                border: 2px dashed #ded4f5;
                border-radius: 20px;
                background: var(--card-bg);
                box-shadow: var(--shadow-sm);
            }

                .empty-box h3 {
                    color: var(--text-primary);
                    font-size: 22px;
                    font-weight: 800;
                    margin-bottom: 10px;
                }

            .shop-link {
                display: inline-block;
                margin-top: 20px;
                padding: 12px 28px;
                background: var(--accent-gradient);
                color: white;
                border-radius: 50px;
                text-decoration: none;
                font-weight: 800;
                box-shadow: 0 4px 12px rgba(109, 40, 217, 0.25);
                transition: all 0.25s ease;
            }

                .shop-link:hover {
                    opacity: 0.95;
                    box-shadow: 0 6px 15px rgba(109, 40, 217, 0.35);
                }

            /* ALERTS */
            .message {
                max-width: 700px;
                margin: 0 auto 25px auto;
                padding: 14px 18px;
                border-radius: 12px;
                font-weight: 700;
                text-align: center;
                font-size: 14px;
            }

            .success-message {
                background: #ecfdf5;
                color: var(--success-color);
                border: 1px solid #d1fae5;
            }

            .error-message {
                background: #fef2f2;
                color: var(--error-color);
                border: 1px solid #fee2e2;
            }

            @@media (max-width: 850px) {
                .orders-page {
                    padding: 20px 12px;
                }

                .orders-box {
                    padding: 18px;
                }

                table {
                    min-width: 1320px;
                }

                .table-wrapper {
                    max-height: 520px;
                }
            }
    </style>
</head>

<body>

    <partial name="_CustomerBottomNav" />

    <div class="orders-page">

        <div class="orders-header">
            <h2>📦 My Orders</h2>

            <p>
                Track deliveries, payments, and invoices for
                everything you've ordered.
            </p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="message success-message">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="message error-message">
                @TempData["Error"]
            </div>
        }

        @if (Model.Orders == null || !Model.Orders.Any())
        {
            <div class="empty-box">
                <h3>No orders yet</h3>

                <p>
                    Your orders will appear here after checkout.
                </p>

                <a href="/CustomerProducts"
                   class="shop-link">
                    Start Shopping
                </a>
            </div>
        }
        else
        {
            <div class="orders-box">
                <div class="table-wrapper">
                    <table>
                        <colgroup>
                            <col class="col-order" />
                            <col class="col-store" />
                            <col class="col-products" />
                            <col class="col-date" />
                            <col class="col-status" />
                            <col class="col-pay-method" />
                            <col class="col-pay-status" />
                            <col class="col-total" />
                            <col class="col-tracking" />
                            <col class="col-invoice" />
                        </colgroup>

                        <thead>
                            <tr>
                                <th class="col-order">Order Number</th>
                                <th class="col-store">Store</th>
                                <th class="col-products">Products</th>
                                <th class="col-date">Date</th>
                                <th class="col-status">Status</th>
                                <th class="col-pay-method">Payment Method</th>
                                <th class="col-pay-status">Payment Status</th>
                                <th class="col-total">Total</th>
                                <th class="col-tracking">Tracking</th>
                                <th class="col-invoice">Invoice</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                var paymentClass =
                                string.Equals(
                                order.PaymentStatus,
                                "Paid",
                                StringComparison.OrdinalIgnoreCase)
                                ? "paid-badge"
                                : "pending-badge";

                                var statusClass = (order.Status?.Trim().ToLowerInvariant()) switch
                                {
                                    "pending" => "status-pending",
                                    "processing" => "status-processing",
                                    "confirmed" => "status-processing",
                                    "assigned" => "status-processing",
                                    "out for delivery" => "status-outfordelivery",
                                    "delivered" => "status-delivered",
                                    "cancelled" => "status-cancelled",
                                    "failed" => "status-cancelled",
                                    "refunded" => "status-cancelled",
                                    _ => ""
                                };

                                <tr>
                                    <td class="order-number">
                                        @order.OrderNumber
                                    </td>

                                    <td class="store-cell">
                                        <i class="fa-solid fa-store"></i>@(string.IsNullOrWhiteSpace(order.StoreName) ? "—" : order.StoreName)
                                    </td>

                                    <td class="products-cell">
                                        @if (order.Products != null &&
                                       order.Products.Count > 0)
                                        {
                                            @foreach (var product in order.Products)
                                            {
                                                <div class="product-line">
                                                    <span class="product-name">
                                                        @product.ProductName
                                                    </span>

                                                    <span class="product-quantity">
                                                        ×@product.Quantity
                                                    </span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="no-products">
                                                No products
                                            </span>
                                        }
                                    </td>

                                    <td class="date-cell">
                                        @order.OrderDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="status-cell">
                                        <span class="status-badge @statusClass">
                                            @order.Status
                                        </span>
                                    </td>

                                    <td class="pay-method-cell">
                                        @order.PaymentMethod
                                    </td>

                                    <td class="pay-status-cell">
                                        <span class="@paymentClass">
                                            @order.PaymentStatus
                                        </span>
                                    </td>

                                    <td class="total-cell">
                                        <span class="total-amount">
                                            $@order.TotalAmount.ToString("N2")
                                        </span>
                                    </td>

                                    <td class="tracking-cell">
                                        @if (order.CanTrack)
                                        {
                                            <a class="track-btn"
                                               href="/TrackDelivery?OrderId=@order.OrderID">
                                                <i class="fa-solid fa-truck"></i>
                                                Track Delivery
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="disabled-track">
                                                @order.TrackingMessage
                                            </span>
                                        }
                                    </td>

                                    <td class="invoice-cell">
                                        @if (order.CanViewInvoice)
                                        {
                                            <a class="invoice-btn"
                                               href="/Invoice?orderId=@order.OrderID">
                                                <i class="fa-solid fa-file-invoice"></i>
                                                View Invoice
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="disabled-track">
                                                Available after payment
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</body>
</html>
