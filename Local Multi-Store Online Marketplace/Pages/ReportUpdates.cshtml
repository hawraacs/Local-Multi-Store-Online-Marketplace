@page
@model Local_Multi_Store_Online_Marketplace.Pages.ReportUpdatesModel

@{
    Layout = Model.IsStoreOwner ? "/Pages/StoreOwner/Shared/_StoreOwnerLayout.cshtml" : null;
    var backUrl = Model.IsStoreOwner ? "/StoreOwner/Home"
                : Model.IsDeliveryPerson ? "/DeliveryProfile"
                : "/CustomerProfile";
}

@if (Model.IsStoreOwner)
{
    @* StoreOwner branch *@
    <style>
        :root {
            --accent-color: #6d28d9;
            --accent-hover: #5b21b6;
            --accent-light: #f3effe;
            --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
            --bg-color: #f8f7fc;
            --card-bg: #ffffff;
            --text-primary: #1e1b2e;
            --text-secondary: #6b6478;
            --text-muted: #9691a4;
            --border-color: #ece8f6;
            --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.06);
            --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.10);
            --radius-md: 16px;
            --radius-lg: 24px;
            --transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .page-container {
            max-width: 1100px;
            margin: 24px auto;
            padding: 0 16px 100px;
        }

        .page-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 28px;
        }

        /* Back arrow — black */
        .back-btn-plain {
            width: 44px;
            height: 44px;
            background: var(--accent-light);
            border: 1px solid var(--border-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000;
            text-decoration: none;
            transition: var(--transition);
            flex-shrink: 0;
        }

            .back-btn-plain:hover {
                background: #000;
                color: #ffffff;
            }

        .page-header h2 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--accent-color);
            margin: 0;
        }

        .notification-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 8px;
            box-shadow: var(--shadow-sm);
        }

        .ig-notif-form {
            margin: 0;
        }

        .ig-notif-row-wrap {
            position: relative;
        }

        .ig-notif-row {
            width: 100%;
            display: flex;
            align-items: flex-start;
            gap: 16px;
            background: none;
            border: none;
            border-bottom: 1px solid var(--border-color);
            padding: 20px 56px 20px 20px;
            cursor: pointer;
            text-align: left;
            border-radius: 12px;
            transition: transform 0.15s ease, opacity 0.15s ease, background-color 0.25s ease;
        }

            /* Instagram-style tap feedback */
            .ig-notif-row.tapped {
                transform: scale(0.97);
                opacity: 0.7;
            }

        .ig-notif-delete-form {
            margin: 0;
            position: absolute;
            top: 14px;
            right: 14px;
            z-index: 2;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }

        /* Trash bin only appears after a double-tap on the row */
        .ig-notif-row-wrap.show-delete .ig-notif-delete-form {
            opacity: 1;
            pointer-events: auto;
        }

        .ig-notif-remove-btn {
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 10px;
            background: transparent;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

            .ig-notif-remove-btn:hover {
                background: #fef2f2;
                color: #dc2626;
            }

        .ig-notif-row:last-child {
            border-bottom: none;
        }

        .ig-notif-row:hover {
            background-color: var(--accent-light);
            transform: translateX(4px);
        }

        .ig-notif-row.unread {
            background-color: #fdfcff;
            border-left: 4px solid var(--accent-color);
        }

        .ig-notif-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: var(--accent-light);
            color: var(--accent-color);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: var(--transition);
        }

        .ig-notif-row:hover .ig-notif-icon {
            background: var(--accent-color);
            color: #fff;
        }

        .ig-notif-icon.type-like {
            background: #fbeaec;
            color: #e0245e;
        }

        .ig-notif-icon.type-comment {
            background: #e9f3ff;
            color: #2563eb;
        }

        .ig-notif-icon.type-review {
            background: #fdf6e8;
            color: #d97706;
        }

        .ig-notif-icon.type-story-like {
            background: #f3effe;
            color: #6d28d9;
        }

        .ig-notif-icon.type-story-reply {
            background: #eafaf2;
            color: #10b981;
        }

        .ig-notif-icon.type-follow {
            background: #eef2ff;
            color: #4f46e5;
        }

        .ig-notif-row:hover .ig-notif-icon.type-like,
        .ig-notif-row:hover .ig-notif-icon.type-comment,
        .ig-notif-row:hover .ig-notif-icon.type-review,
        .ig-notif-row:hover .ig-notif-icon.type-story-like,
        .ig-notif-row:hover .ig-notif-icon.type-story-reply,
        .ig-notif-row:hover .ig-notif-icon.type-follow {
            background: var(--accent-color);
            color: #ffffff;
        }

        .ig-notif-body {
            flex-grow: 1;
            min-width: 0;
        }

        .ig-notif-text strong {
            display: block;
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .ig-notif-text span {
            font-size: 14px;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        .ig-notif-time {
            font-size: 12px;
            font-weight: 500;
            color: var(--text-muted);
            margin-top: 8px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .ig-notif-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--accent-color);
            flex-shrink: 0;
            margin-top: 10px;
            box-shadow: 0 0 10px rgba(109, 40, 217, 0.4);
        }

        .empty-state {
            text-align: center;
            padding: 80px 24px;
        }

        .empty-icon {
            font-size: 60px;
            margin-bottom: 20px;
            background: var(--accent-light);
            width: 100px;
            height: 100px;
            line-height: 100px;
            border-radius: 50%;
            display: inline-block;
            color: var(--accent-color);
        }

        .empty-state h3 {
            font-weight: 800;
            font-size: 20px;
            margin-bottom: 8px;
        }

        .empty-state p {
            color: var(--text-secondary);
            font-size: 14px;
        }

        @@media (max-width: 768px) {
            .page-header h2 {
                font-size: 20px;
            }
        }
    </style>

    <div class="page-container">
        <div class="page-header">
            <a href="@backUrl" class="back-btn-plain" id="notifBackBtn">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2><i class="fas fa-bell" style="margin-right:10px;"></i>Notifications</h2>
        </div>

        <div class="notification-card">
            @if (Model.NotificationsList.Any())
            {
                <div class="ig-notif-list">
                    @foreach (var n in Model.NotificationsList)
                    {
                        var iconInfo = ReportUpdatesModel.GetNotificationIcon(n.Type);

                        <div class="ig-notif-row-wrap">
                            <form method="post" asp-page-handler="OpenNotification" class="ig-notif-form">
                                <input type="hidden" name="notificationId" value="@n.NotificationID" />
                                <button type="submit" class="ig-notif-row @(n.IsRead ? "" : "unread")">
                                    <div class="ig-notif-icon @iconInfo.CssClass">
                                        <i class="@iconInfo.IconClass"></i>
                                    </div>
                                    <div class="ig-notif-body">
                                        <div class="ig-notif-text">
                                            <strong>@n.Title</strong>
                                            <span>@n.Message</span>
                                        </div>
                                        <div class="ig-notif-time">
                                            <i class="far fa-clock"></i>
                                            @n.SentAt.ToString("MMM d, yyyy 'at' h:mm tt")
                                        </div>
                                    </div>
                                    @if (!n.IsRead)
                                    {
                                        <span class="ig-notif-dot"></span>
                                    }
                                </button>
                            </form>
                            <form method="post" asp-page-handler="DeleteNotification" class="ig-notif-delete-form">
                                <input type="hidden" name="notificationId" value="@n.NotificationID" />
                                <button type="submit" class="ig-notif-remove-btn" title="Remove notification">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fas fa-bell-slash"></i></div>
                    <h3>No notifications yet</h3>
                    <p>You're all caught up. New notifications will show up here as they arrive.</p>
                </div>
            }
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Back arrow: use browser history if we came from within the site, else fall back to href
            var backBtn = document.getElementById('notifBackBtn');
            if (backBtn) {
                backBtn.addEventListener('click', function(e) {
                    if (document.referrer && document.referrer.indexOf(window.location.origin) === 0) {
                        e.preventDefault();
                        window.history.back();
                    }
                });
            }

            // Row tap: single tap -> smooth navigate to the notification's source page
            // double tap -> reveal the trash bin instead of navigating
            document.querySelectorAll('.ig-notif-row-wrap').forEach(function(wrap) {
                var row = wrap.querySelector('.ig-notif-row');
                var form = wrap.querySelector('.ig-notif-form');
                var timer = null;

                row.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (timer === null) {
                        timer = setTimeout(function() {
                            timer = null;
                            row.classList.add('tapped');
                            setTimeout(function() { form.submit(); }, 150);
                        }, 250);
                    } else {
                        clearTimeout(timer);
                        timer = null;
                        wrap.classList.toggle('show-delete');
                    }
                });
            });

            // Tapping anywhere else closes any open trash bin
            document.addEventListener('click', function(e) {
                document.querySelectorAll('.ig-notif-row-wrap.show-delete').forEach(function(wrap) {
                    if (!wrap.contains(e.target)) wrap.classList.remove('show-delete');
                });
            });
        });
    </script>
}
