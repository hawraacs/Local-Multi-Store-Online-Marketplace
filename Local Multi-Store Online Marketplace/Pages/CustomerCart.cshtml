                                   value="@Model.AppliedCouponCode" />

                            <input type="hidden"
                                   name="selectedCartItemIds"
                                   id="selectedCartItemIdsInput"
                                   value="" />

                            <input type="hidden"
                                   name="itemNotesJson"
                                   id="itemNotesJsonInput"
                                   value="" />

                            <div class="payment-section">

