                            </label>

                            <div class="coupon-row">

                                <input type="text"
                                       id="couponCodeInput"
                                       name="couponCode"
                                       value="@Model.AppliedCouponCode"
                                       placeholder="Enter coupon code"
                                       class="coupon-input" />

                                <button type="submit"
                                        class="coupon-btn">
                                    Apply
                                </button>
                            </div>
                        </form>

                        <form id="removeCouponForm"
                              method="post"
                              asp-page-handler="RemoveCoupon"
                              style="display:@(!string.IsNullOrWhiteSpace(Model.AppliedCouponCode) ? "block" : "none")">

                            <button type="submit"
                                    class="remove-coupon-btn">
                                Remove Coupon
                            </button>
                        </form>

                        <div class="summary-free"
                             id="summaryCouponMessage"
                             style="display:@(!string.IsNullOrWhiteSpace(Model.CouponMessage) ? "block" : "none")">
                            @Model.CouponMessage
                        </div>

                        <div class="summary-row discount-row"
                             id="summaryDiscountRow"
                             style="display:@(Model.DiscountAmount > 0 ? "flex" : "none")">
                            <span>Discount</span>

                            <span id="summaryDiscountAmount">
                                -$@Model.DiscountAmount.ToString("N2")
                            </span>
