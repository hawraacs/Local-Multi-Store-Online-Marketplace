                            </div>

                            <div class="free-shipping-bar-track">
                                <div class="free-shipping-bar-fill" id="freeShippingBarFill"></div>
                            </div>

                            <div class="free-shipping-bar-labels">
                                <span>$0</span>
                                <span>$50</span>
                            </div>
                        </div>

                        <div class="summary-row">
                            <span>Items</span>

                            <span id="summaryItemsCount">
                                0
                            </span>
                        </div>

                        <div class="summary-row">
                            <span>Subtotal</span>

                            <span id="summarySubtotal">
                                $0.00
                            </span>
                        </div>

                        <form id="applyCouponForm"
                              method="post"
                              asp-page-handler="ApplyCoupon"
                              class="coupon-form">

                            <label class="coupon-label">
