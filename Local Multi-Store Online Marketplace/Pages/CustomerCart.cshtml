        }
    </div>

    <div id="removeModal"
         class="app-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="removeModalTitle"
         aria-hidden="true">

        <div class="modal-card">

            <div class="modal-icon danger">
                🗑
            </div>

            <h3 id="removeModalTitle"
                class="modal-title">
                Remove Item?
            </h3>

            <p id="removeModalDescription"
               class="modal-description">
                Are you sure you want to remove this item
                from your cart?
            </p>

            <div class="modal-actions">

                <button id="cancelRemoveButton"
                        type="button"
                        class="modal-cancel">
                    Cancel
                </button>

                <button id="confirmRemoveButton"
                        type="button"
                        class="modal-danger">
                    Remove Item
                </button>
            </div>
        </div>
    </div>

    <script>
            document.addEventListener(
                "DOMContentLoaded",
                function() {
                    initializeToasts();
                    initializeCheckoutModal();
                    initializeRemoveModal();
                    initializeAutoUpdateQuantity();
                    initializeAutoUpdateNote();
                    initializeQuantitySteppers();
                    initializeItemSelection();
                    initializeRemoveSelectedButton();
                    initializeCartFilterTabs();
                    initializeAlsoLike();
                    initializeCouponAjax();
                });

            function initializeToasts() {
                const toasts =
                    document.querySelectorAll("[data-toast]");

                toasts.forEach(function(toast, index) {
                    window.setTimeout(function() {
                        toast.classList.add("show");
                    }, 100 + (index * 100));

                    const closeButton =
                        toast.querySelector(".toast-close");

                    if (closeButton) {
                        closeButton.addEventListener(
                            "click",
                            function() {
                                removeToast(toast);
                            });
                    }

                    window.setTimeout(function() {
                        removeToast(toast);
                    }, 5000 + (index * 300));
                });
            }

            function removeToast(toast) {
                if (!toast || !toast.isConnected) {
                    return;
                }

                toast.classList.remove("show");

                window.setTimeout(function() {
                    toast.remove();
                }, 300);
            }

            function openModal(modal) {
                if (!modal) {
                    return;
                }

                modal.classList.add("open");
                modal.setAttribute("aria-hidden", "false");

                document.body.classList.add("modal-open");
            }

            function closeModal(modal) {
                if (!modal) {
                    return;
                }

                modal.classList.remove("open");
                modal.setAttribute("aria-hidden", "true");

                if (!document.querySelector(".app-modal.open")) {
                    document.body.classList.remove("modal-open");
                }
            }

            function initializeCartFilterTabs() {
                const tabs =
                    document.querySelectorAll(
                        ".shein-nav-item[data-filter]");

                if (!tabs.length) {
                    return;
                }

                tabs.forEach(function(tab) {
                    tab.addEventListener(
                        "click",
                        function() {
                            tabs.forEach(function(otherTab) {
                                otherTab.classList.remove("active");
                            });

                            tab.classList.add("active");

                            applyCartFilter(tab.dataset.filter);
                        });
                });

                applyCartFilter("all");
            }

            function applyCartFilter(filter) {
                const cartItems =
                    document.querySelectorAll(
                        ".cart-list .cart-item");

                let visibleCount = 0;

                cartItems.forEach(function(cartItemEl) {
                    let matchesFilter = true;

                    if (filter === "lowstock") {
                        matchesFilter =
                            cartItemEl.dataset.lowStock === "true";
                    } else if (filter === "bestselling") {
                        matchesFilter =
                            cartItemEl.dataset.bestSeller === "true";
                    }

                    cartItemEl.style.display =
                        matchesFilter ? "" : "none";

                    if (matchesFilter) {
                        visibleCount += 1;
                    }
                });

                const emptyMessage =
                    document.getElementById(
                        "cartFilterEmptyMessage");

                if (emptyMessage) {
                    emptyMessage.style.display =
                        visibleCount === 0 ? "block" : "none";
                }
            }

            function getAntiForgeryTokenValue() {
                const input = document.querySelector(
                    'input[name="__RequestVerificationToken"]');

                return input ? input.value : "";
            }

            function initializeAlsoLike() {
                const scroller =
                    document.getElementById("alsoLikeScroller");

                const section =
                    document.getElementById("alsoLikeSection");

                if (!scroller || !section) {
                    return;
                }

                fetch(
                    "/Customer1?handler=ExplorePage&pageNumber=1",
                    { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then(function(res) {
                        return res.json();
                    })
                    .then(function(result) {
                        const items = (result && result.items) || [];

                        const seenProductIds = new Set();
                        const products = [];

                        items.forEach(function(item) {
                            const productId =
                                item.productID != null
                                    ? item.productID
                                    : item.productId;

                            const storeId =
                                item.storeID != null
                                    ? item.storeID
                                    : item.storeId;

                            if (!productId ||
                                !item.productName ||
                                item.productPrice == null) {
                                return;
                            }

                            const realImage = item.mediaType === "Video"
                                ? (item.thumbnailUrl || null)
                                : item.mediaUrl;

                            if (!realImage) {
                                return;
                            }

                            if (seenProductIds.has(productId)) {
                                return;
                            }

                            seenProductIds.add(productId);

                            products.push({
                                productId: productId,
                                storeId: storeId,
                                productName: item.productName,
                                productPrice: item.productPrice,
                                imageUrl: realImage
                            });
                        });

                        if (!products.length) {
                            section.style.display = "none";
                            return;
                        }

                        renderAlsoLikeCards(scroller, products);
                    })
                    .catch(function() {
                        section.style.display = "none";
                    });
            }

            function renderAlsoLikeCards(scroller, products) {
                scroller.innerHTML = "";

                const token = getAntiForgeryTokenValue();

                products.slice(0, 12).forEach(function(product) {
                    const card = document.createElement("a");
                    card.className = "also-like-card";
                    card.href =
                        "/StoreCustomerProfile?id=" + product.storeId +
                        "&productId=" + product.productId;

                    const imgWrap = document.createElement("div");
                    imgWrap.className = "also-like-img-wrap";

                    const img = document.createElement("img");
                    img.src = product.imageUrl;
                    img.alt = product.productName;
                    img.onerror = function() {
                        card.remove();
                    };

                    const wishlistBtn =
                        document.createElement("button");

                    wishlistBtn.type = "button";
                    wishlistBtn.className = "also-like-wishlist-btn";
                    wishlistBtn.setAttribute(
                        "aria-label",
                        "Save " + product.productName +
                        " to wishlist");
                    wishlistBtn.innerHTML =
                        '<i class="fa-regular fa-heart"></i>';

                    wishlistBtn.addEventListener(
                        "click",
                        function(event) {
                            event.preventDefault();
                            event.stopPropagation();
                            toggleAlsoLikeWishlist(
                                product.productId,
                                wishlistBtn,
                                token);
                        });

                    imgWrap.appendChild(img);
                    imgWrap.appendChild(wishlistBtn);

                    const name = document.createElement("div");
                    name.className = "also-like-name";
                    name.textContent = product.productName;

                    const price = document.createElement("div");
                    price.className = "also-like-price";
                    price.textContent = product.productPrice != null
                        ? "$" + formatMoney(product.productPrice)
                        : "";

                    card.appendChild(imgWrap);
                    card.appendChild(name);
                    card.appendChild(price);

                    scroller.appendChild(card);
                });
            }

            function toggleAlsoLikeWishlist(productId, button, token) {
                if (!token) {
                    button.classList.toggle("saved");
                    return;
                }

                const body = new URLSearchParams();
                body.set("__RequestVerificationToken", token);
                body.set("productId", productId);

                button.disabled = true;

                fetch(
                    "/Customer1?handler=ToggleExploreWishlist",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded",
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: body.toString()
                    })
                    .then(function(res) {
                        return res.json();
                    })
                    .then(function(result) {
                        if (result && result.success) {
                            button.classList.toggle(
                                "saved", !!result.saved);

                            button.innerHTML = result.saved
                                ? '<i class="fa-solid fa-heart"></i>'
                                : '<i class="fa-regular fa-heart"></i>';
                        }
                    })
                    .catch(function() { })
                    .finally(function() {
                        button.disabled = false;
                    });
            }

            function getItemCheckboxes() {
                return Array.from(
                    document.querySelectorAll(".item-select-checkbox"));
            }

            function initializeItemSelection() {
                const checkboxes = getItemCheckboxes();
                const selectAllCheckbox =
                    document.getElementById("selectAllCheckbox");

                checkboxes.forEach(function(checkbox) {
                    checkbox.addEventListener(
                        "change",
                        updateSelectedSummary);
                });

                if (selectAllCheckbox) {
                    selectAllCheckbox.addEventListener(
                        "change",
                        function() {
                            checkboxes.forEach(function(checkbox) {
                                checkbox.checked =
                                    selectAllCheckbox.checked;
                            });

                            updateSelectedSummary();
                        });
                }

                updateSelectedSummary();
            }

            function updateSelectedSummary() {
                const checkboxes = getItemCheckboxes();

                let itemsCount = 0;
                let subtotal = 0;
                let anySelected = false;

                checkboxes.forEach(function(checkbox) {
                    const cartItemEl =
                        checkbox.closest(".cart-item");

                    if (!cartItemEl) {
                        return;
                    }

                    const quantity =
                        parseInt(
                            cartItemEl.dataset.quantity || "0",
                            10);

                    const unitPrice =
                        parseFloat(
                            cartItemEl.dataset.unitPrice || "0");

                    if (checkbox.checked) {
                        anySelected = true;
                        itemsCount += quantity;
                        subtotal += quantity * unitPrice;
                    }
                });

                setText("summaryItemsCount", itemsCount);
                setText("summarySubtotal", "$" + formatMoney(subtotal));

                const deliveryFeeEl =
                    document.getElementById("summaryDeliveryFee");

                const discountEl =
                    document.getElementById("summaryDiscountAmount");

                const deliveryFee =
                    deliveryFeeEl
                        ? (parseFloat(
                            deliveryFeeEl.textContent.replace("$", "")) || 0)
                        : 0;

                const discount =
                    discountEl
                        ? (parseFloat(
                            discountEl.textContent.replace(/[-$]/g, "")) || 0)
                        : 0;

                const estimatedGrandTotal = anySelected
                    ? Math.max(subtotal + deliveryFee - discount, 0)
                    : 0;

                setText(
                    "summaryGrandTotal",
                    "$" + formatMoney(estimatedGrandTotal));

                const selectedCount = checkboxes.filter(
                    function(checkbox) {
                        return checkbox.checked;
                    }).length;

                setText(
                    "stickyItemsLabel",
                    selectedCount === 0
                        ? "0 items selected"
                        : (selectedCount === 1
                            ? "1 item selected"
                            : selectedCount + " items selected"));

                setText(
                    "stickyTotalLabel",
                    "Total (" +
                    selectedCount +
                    (selectedCount === 1 ? " item)" : " items)"));

                setText(
                    "stickyGrandTotal",
                    "$" + formatMoney(estimatedGrandTotal));

                const selectedIds = checkboxes
                    .filter(function(checkbox) {
                        return checkbox.checked;
                    })
                    .map(function(checkbox) {
                        return checkbox.dataset.cartItemId;
                    })
                    .join(",");

                const hiddenIdsInput =
                    document.getElementById(
                        "selectedCartItemIdsInput");

                if (hiddenIdsInput) {
                    hiddenIdsInput.value = selectedIds;
                }

                const openCheckoutBtn =
                    document.getElementById(
                        "openCheckoutModalButton");

                if (openCheckoutBtn) {
                    openCheckoutBtn.disabled = !anySelected;
                }

                const confirmCheckoutBtn =
                    document.getElementById("confirmCheckoutButton");

                if (confirmCheckoutBtn) {
                    confirmCheckoutBtn.disabled = !anySelected;
                }

                updateFreeShippingProgress(subtotal, anySelected);

                const removeSelectedBtn =
                    document.getElementById("removeSelectedBtn");

                if (removeSelectedBtn) {
                    removeSelectedBtn.classList.toggle(
                        "visible",
                        anySelected);

                    removeSelectedBtn.disabled = !anySelected;
                }

                const selectAllCheckbox =
                    document.getElementById("selectAllCheckbox");

                if (selectAllCheckbox) {
                    selectAllCheckbox.checked =
                        checkboxes.length > 0 &&
                        checkboxes.every(function(checkbox) {
                            return checkbox.checked;
                        });
                }

                const selectAllCountEl =
                    document.getElementById("selectAllCount");

                if (selectAllCountEl) {
                    selectAllCountEl.textContent =
                        selectedCount + "/" + checkboxes.length;
                }
            }

            function updateFreeShippingProgress(subtotal, anySelected) {
                const box =
                    document.getElementById("freeShippingBox");

                const text =
                    document.getElementById("freeShippingText");

                const fill =
                    document.getElementById("freeShippingBarFill");

                if (!box || !text || !fill) {
                    return;
                }

                const threshold = 50;

                if (!anySelected) {
                    box.classList.remove("reached");
                    fill.style.width = "0%";

                    text.innerHTML =
                        "Select items to see if you qualify for " +
                        "<strong>free shipping</strong>";

                    return;
                }

                if (subtotal >= threshold) {
                    box.classList.add("reached");
                    fill.style.width = "100%";

                    text.innerHTML =
                        "<strong>You've unlocked free shipping!</strong>";

                    return;
                }

                box.classList.remove("reached");

                const remaining = threshold - subtotal;

                const percent = Math.max(
                    0,
                    Math.min(100, (subtotal / threshold) * 100));

                fill.style.width = percent + "%";

                text.innerHTML =
                    "You're $" + formatMoney(remaining) +
                    " away from <strong>FREE SHIPPING!</strong>";
            }

            function initializeQuantitySteppers() {
                document.querySelectorAll(".qty-stepper").forEach(
                    function(stepper) {
                        const input =
                            stepper.querySelector(".qty-input");

                        const decreaseBtn =
                            stepper.querySelector(".qty-decrease");

                        const increaseBtn =
                            stepper.querySelector(".qty-increase");

                        if (!input || !decreaseBtn || !increaseBtn) {
                            return;
                        }

                        function nudge(delta) {
                            const min =
                                parseInt(input.min || "1", 10);

                            const max = input.max
                                ? parseInt(input.max, 10)
                                : null;

                            let value =
                                parseInt(input.value || "1", 10) + delta;

                            if (isNaN(value)) {
                                value = min;
                            }

                            if (delta < 0 && value < min) {
                                const cartItemEl =
                                    stepper.closest(".cart-item");

                                const cartItemId = cartItemEl
                                    ? cartItemEl.dataset.cartItemId
                                    : null;

                                const removeForm = cartItemId
                                    ? document.getElementById(
                                        "removeForm-" + cartItemId)
                                    : null;

                                if (removeForm) {
                                    removeForm.requestSubmit();
                                }

                                return;
                            }

                            value = Math.max(min, value);

                            if (max !== null) {
                                value = Math.min(max, value);
                            }

                            if (value === parseInt(input.value, 10)) {
                                return;
                            }

                            input.value = value;

                            input.dispatchEvent(
                                new Event("change", { bubbles: true }));
                        }

                        decreaseBtn.addEventListener(
                            "click",
                            function() {
                                nudge(-1);
                            });

                        increaseBtn.addEventListener(
                            "click",
                            function() {
                                nudge(1);
                            });
                    });
            }

            function initializeRemoveSelectedButton() {
                const removeSelectedBtn =
                    document.getElementById("removeSelectedBtn");

                if (!removeSelectedBtn) {
                    return;
                }

                removeSelectedBtn.addEventListener(
                    "click",
                    function() {
                        const selectedIds = getItemCheckboxes()
                            .filter(function(checkbox) {
                                return checkbox.checked;
                            })
                            .map(function(checkbox) {
                                return checkbox.dataset.cartItemId;
                            });

                        if (selectedIds.length === 0) {
                            return;
                        }

                        const confirmed = window.confirm(
                            "Remove " + selectedIds.length +
                            " selected item(s) from your cart?");

                        if (!confirmed) {
                            return;
                        }

                        removeSelectedBtn.disabled = true;

                        removeSelectedBtn.innerHTML =
                            "<i class=\"fa-solid fa-spinner fa-spin\">" +
                            "</i> Removing...";

                        const requests = selectedIds.map(
                            function(id) {
                                const form =
                                    document.getElementById(
                                        "removeForm-" + id);

                                if (!form) {
                                    return Promise.resolve();
                                }

                                const formData = new FormData(form);

                                return fetch(form.action, {
                                    method: "POST",
                                    headers: {
                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    },
                                    body: formData
                                });
                            });

                        Promise.all(requests).finally(
                            function() {
                                window.location.reload();
                            });
                    });
            }

            function initializeCheckoutModal() {
                const summaryCard =
                    document.getElementById("orderSummaryCard");

                const checkoutForm =
                    document.getElementById("checkoutForm");

                const openButton =
                    document.getElementById(
                        "openCheckoutModalButton");

                const confirmButton =
                    document.getElementById(
                        "confirmCheckoutButton");

                if (summaryCard && openButton) {
                    openButton.addEventListener(
                        "click",
                        function() {
                            if (openButton.disabled) {
                                return;
                            }

                            summaryCard.scrollIntoView(
                                { behavior: "smooth", block: "start" });
                        });
                }

                if (!checkoutForm || !confirmButton) {
                    return;
                }

                checkoutForm.addEventListener(
                    "submit",
                    function() {
                        const notesInput =
                            document.getElementById("itemNotesJsonInput");

                        if (notesInput) {
                            notesInput.value =
                                buildSelectedItemNotesJson();
                        }

                        confirmButton.disabled = true;

                        confirmButton.innerHTML =
                            "<i class=\"fa-solid fa-spinner fa-spin\">" +
                            "</i> Placing Order...";
                    });
            }

            function initializeRemoveModal() {
                const modal =
                    document.getElementById("removeModal");

                const description =
                    document.getElementById(
                        "removeModalDescription");

                const cancelButton =
                    document.getElementById(
                        "cancelRemoveButton");

                const confirmButton =
                    document.getElementById(
                        "confirmRemoveButton");

                const removeButtons =
                    document.querySelectorAll(
                        ".remove-trigger");

                if (!modal ||
                    !description ||
                    !cancelButton ||
                    !confirmButton) {
                    return;
                }

                let pendingRemoveForm = null;
                let lastRemoveButton = null;

                removeButtons.forEach(function(button) {
                    button.addEventListener(
                        "click",
                        function() {
                            const formId =
                                button.dataset.formId;

                            const productName =
                                button.dataset.productName ||
                                "this item";

                            pendingRemoveForm =
                                document.getElementById(formId);

                            lastRemoveButton =
                                button;

                            description.textContent =
                                `Are you sure you want to remove ` +
                                `"${productName}" from your cart?`;

                            openModal(modal);

                            cancelButton.focus();
                        });
                });

                cancelButton.addEventListener(
                    "click",
                    function() {
                        pendingRemoveForm = null;

                        closeModal(modal);

                        if (lastRemoveButton) {
                            lastRemoveButton.focus();
                        }
                    });

                confirmButton.addEventListener(
                    "click",
                    function() {
                        if (!pendingRemoveForm) {
                            closeModal(modal);
                            return;
                        }

                        confirmButton.disabled = true;

                        confirmButton.textContent =
                            "Removing...";

                        pendingRemoveForm.requestSubmit();
                    });

                modal.addEventListener(
                    "click",
                    function(event) {
                        if (event.target === modal) {
                            pendingRemoveForm = null;

                            closeModal(modal);
                        }
                    });
            }

            function initializeAutoUpdateQuantity() {
                const forms =
                    document.querySelectorAll(
                        ".auto-update-qty-form");

                forms.forEach(function(form) {
                    const input =
                        form.querySelector(
                            ".auto-update-qty-input");

                    if (!input) {
                        return;
                    }

                    let lastSentValue = input.value;
                    let isSubmitting = false;
                    let pendingRetry = false;
                    let debounceTimer = null;

                    function revert() {
                        input.value = lastSentValue;
                    }

                    function submitQuantity() {
                        const rawValue = input.value;

                        if (rawValue === lastSentValue) {
                            return;
                        }

                        const quantity =
                            parseInt(rawValue, 10);

                        const min =
                            parseInt(
                                input.getAttribute("min") || "1",
                                10);

                        const maxAttr =
                            input.getAttribute("max");

                        const max =
                            maxAttr ? parseInt(maxAttr, 10) : null;

                        if (isNaN(quantity) ||
                            quantity < min ||
                            (max !== null && quantity > max)) {
                            revert();
                            return;
                        }

                        if (isSubmitting) {
                            pendingRetry = true;
                            return;
                        }

                        isSubmitting = true;

                        const formData = new FormData(form);

                        formData.set("quantity", String(quantity));

                        input.disabled = true;

                        fetch(form.action, {
                            method: "POST",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            body: formData
                        })
                            .then(function(response) {
                                return response.json().then(
                                    function(data) {
                                        return {
                                            ok: response.ok,
                                            data: data
                                        };
                                    });
                            })
                            .then(function(result) {
                                if (!result.data ||
                                    !result.data.success) {
                                    revert();

                                    createToast(
                                        "error",
                                        "Unable to continue",
                                        (result.data &&
                                            result.data.message) ||
                                        "Could not update the cart.");

                                    return;
                                }

                                lastSentValue = input.value;

                                applyCartSummary(result.data);

                                const cartItemEl =
                                    form.closest(".cart-item");

                                if (cartItemEl &&
                                    result.data.updatedItem) {
                                    cartItemEl.dataset.quantity =
                                        result.data.updatedItem
                                            .quantity;
                                }

                                updateSelectedSummary();
                            })
                            .catch(function() {
                                revert();

                                createToast(
                                    "error",
                                    "Unable to continue",
                                    "Could not update the cart. " +
                                    "Please check your connection.");
                            })
                            .finally(function() {
                                isSubmitting = false;
                                input.disabled = false;

                                if (pendingRetry) {
                                    pendingRetry = false;
                                    submitQuantity();
                                }
                            });
                    }

                    input.addEventListener(
                        "change",
                        function() {
                            window.clearTimeout(debounceTimer);
                            submitQuantity();
                        });

                    input.addEventListener(
                        "input",
                        function() {
                            window.clearTimeout(debounceTimer);

                            debounceTimer = window.setTimeout(
                                submitQuantity,
                                600);
                        });
                });
            }

            // NEW — auto-saves each item's note to the server via
            // OnPostUpdateNoteAsync (?handler=UpdateNote), debounced
            // while typing and also flushed on blur.
            function initializeAutoUpdateNote() {
                document.querySelectorAll(".item-note-input").forEach(
                    function(input) {
                        let debounceTimer = null;
                        let lastSentValue = input.value;
                        let isSubmitting = false;

                        function submitNote() {
                            const value = input.value;

                            if (value === lastSentValue || isSubmitting) {
                                return;
                            }

                            isSubmitting = true;

                            const body = new URLSearchParams();
                            body.set(
                                "cartItemId",
                                input.dataset.cartItemId);
                            body.set("note", value);

                            const token = getAntiForgeryTokenValue();

                            if (token) {
                                body.set(
                                    "__RequestVerificationToken",
                                    token);
                            }

                            fetch("?handler=UpdateNote", {
                                method: "POST",
                                headers: {
                                    "Content-Type":
                                        "application/x-www-form-urlencoded",
                                    "X-Requested-With": "XMLHttpRequest"
                                },
                                body: body.toString()
                            })
                                .then(function(res) {
                                    return res.json();
                                })
                                .then(function(result) {
                                    if (result && result.success) {
                                        lastSentValue = value;
                                    } else {
                                        createToast(
                                            "error",
                                            "Unable to continue",
                                            (result &&
                                                result.message) ||
                                            "Could not save the note.");
                                    }
                                })
                                .catch(function() {
                                    createToast(
                                        "error",
                                        "Unable to continue",
                                        "Could not save the note. " +
                                        "Please check your connection.");
                                })
                                .finally(function() {
                                    isSubmitting = false;
                                });
                        }

                        input.addEventListener("blur", submitNote);

                        input.addEventListener("input", function() {
                            window.clearTimeout(debounceTimer);
                            debounceTimer =
                                window.setTimeout(submitNote, 700);
                        });
                    });
            }

            // NEW — collects the notes for only the currently
            // SELECTED items right before checkout submits, so the
            // server can copy them into OrderItemNotes for this order.
            function buildSelectedItemNotesJson() {
                const selected = {};

                getItemCheckboxes()
                    .filter(function(checkbox) {
                        return checkbox.checked;
                    })
                    .forEach(function(checkbox) {
                        const cartItemEl =
                            checkbox.closest(".cart-item");

                        if (!cartItemEl) {
                            return;
                        }

                        const noteInput =
                            cartItemEl.querySelector(".item-note-input");

                        if (noteInput && noteInput.value.trim()) {
                            selected[checkbox.dataset.cartItemId] =
                                noteInput.value.trim().slice(0, 200);
                        }
                    });

                return JSON.stringify(selected);
            }

            function initializeCouponAjax() {
                const applyForm =
                    document.getElementById("applyCouponForm");

                const removeForm =
                    document.getElementById("removeCouponForm");

                const couponInput =
                    document.getElementById("couponCodeInput");

                const checkoutCouponInput =
                    document.getElementById(
                        "checkoutAppliedCouponInput");

                function syncAppliedCouponCode(code) {
                    const value = code || "";

                    if (checkoutCouponInput) {
                        checkoutCouponInput.value = value;
                    }

                    document
                        .querySelectorAll(
                            'input[name="AppliedCouponCode"]')
                        .forEach(function(input) {
                            input.value = value;
                        });

                    if (couponInput) {
                        couponInput.value = value;
                    }

                    if (removeForm) {
                        removeForm.style.display =
                            value ? "block" : "none";
                    }
                }

                function submitCouponForm(form) {
                    if (!form) {
                        return;
                    }

                    const submitBtn =
                        form.querySelector('button[type="submit"]');

                    if (submitBtn) {
                        submitBtn.disabled = true;
                    }

                    const formData = new FormData(form);

                    fetch(form.action, {
                        method: "POST",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: formData
                    })
                        .then(function(response) {
                            return response.json().then(
                                function(data) {
                                    return {
                                        ok: response.ok,
                                        data: data
                                    };
                                });
                        })
                        .then(function(result) {
                            if (!result.data ||
                                !result.data.success) {
                                createToast(
                                    "error",
                                    "Unable to continue",
                                    (result.data &&
                                        result.data.message) ||
                                    "Could not update the coupon.");

                                return;
                            }

                            applyCartSummary(result.data);

                            syncAppliedCouponCode(
                                result.data.appliedCouponCode);

                            updateSelectedSummary();

                            if (result.data.message) {
                                createToast(
                                    "success",
                                    "Coupon updated",
                                    result.data.message);
                            }
                        })
                        .catch(function() {
                            createToast(
                                "error",
                                "Unable to continue",
                                "Could not update the coupon. " +
                                "Please check your connection.");
                        })
                        .finally(function() {
                            if (submitBtn) {
                                submitBtn.disabled = false;
                            }
                        });
                }

                if (applyForm) {
                    applyForm.addEventListener(
                        "submit",
                        function(event) {
                            event.preventDefault();
                            submitCouponForm(applyForm);
                        });
                }

                if (removeForm) {
                    removeForm.addEventListener(
                        "submit",
                        function(event) {
                            event.preventDefault();
                            submitCouponForm(removeForm);
                        });
                }
            }

            function applyCartSummary(data) {
                setText("summaryItemsCount", data.itemsCount);

                setText(
                    "summarySubtotal",
                    "$" + formatMoney(data.totalAmount));

                const discountRow =
                    document.getElementById("summaryDiscountRow");

                if (discountRow) {
                    if (data.discountAmount > 0) {
                        discountRow.style.display = "flex";

                        setText(
                            "summaryDiscountAmount",
                            "-$" + formatMoney(data.discountAmount));
                    } else {
                        discountRow.style.display = "none";
                    }
                }

                const couponMessageEl =
                    document.getElementById("summaryCouponMessage");

                if (couponMessageEl) {
                    if (data.couponMessage) {
                        couponMessageEl.style.display = "block";
                        couponMessageEl.textContent = data.couponMessage;
                    } else {
                        couponMessageEl.style.display = "none";
                    }
                }

                if (data.hasActiveAddress) {
                    setText(
                        "summaryDeliveryFee",
                        "$" + formatMoney(data.estimatedDeliveryFee));
                }

                const freeDeliveryBanner =
                    document.getElementById(
                        "summaryFreeDeliveryBanner");

                if (freeDeliveryBanner) {
                    freeDeliveryBanner.style.display =
                        data.freeDeliveryApplied ? "block" : "none";
                }

                setText(
                    "summaryGrandTotal",
                    "$" + formatMoney(data.grandTotal));
            }

            function setText(elementId, value) {
                const element =
                    document.getElementById(elementId);

                if (element) {
                    element.textContent = value;
                }
            }

            function formatMoney(value) {
                return Number(value).toFixed(2);
            }

            function createToast(type, title, message) {
                const container =
                    document.getElementById("toastContainer");

                if (!container) {
                    return;
                }

                const toast = document.createElement("div");
                toast.className = "app-toast " + type;
                toast.setAttribute("data-toast", "");

                const icon = document.createElement("span");
                icon.className = "toast-icon";
                icon.textContent = type === "success" ? "✓" : "!";

                const content = document.createElement("div");
                content.className = "toast-content";

                const titleEl = document.createElement("span");
                titleEl.className = "toast-title";
                titleEl.textContent = title;

                const messageEl = document.createElement("span");
                messageEl.className = "toast-message";
                messageEl.textContent = message;

                content.appendChild(titleEl);
                content.appendChild(messageEl);

                const closeButton = document.createElement("button");
                closeButton.type = "button";
                closeButton.className = "toast-close";
                closeButton.setAttribute(
                    "aria-label",
                    "Close notification");
                closeButton.innerHTML = "&times;";

                toast.appendChild(icon);
                toast.appendChild(content);
                toast.appendChild(closeButton);

                container.appendChild(toast);

                window.setTimeout(function() {
                    toast.classList.add("show");
                }, 50);

                closeButton.addEventListener(
                    "click",
                    function() {
                        removeToast(toast);
                    });

                window.setTimeout(function() {
                    removeToast(toast);
                }, 5000);
            }

            document.addEventListener(
                "keydown",
                function(event) {
                    if (event.key !== "Escape") {
                        return;
                    }

                    document
                        .querySelectorAll(".app-modal.open")
                        .forEach(function(modal) {
                            closeModal(modal);
                        });
                });
    </script>

</body>
</html>
