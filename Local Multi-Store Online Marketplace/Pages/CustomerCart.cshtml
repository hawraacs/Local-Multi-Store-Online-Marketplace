@page
@model Local_Multi_Store_Online_Marketplace.Pages.CustomerCartModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Your Cart | realnest</title>

    <!-- Google Fonts & FontAwesome Icons (Consistent with Customer Feed) -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-color: #faf9fc;
                --card-bg: #ffffff;
                --border-color: #ece8f6;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                /* Purple / Indigo palette, matching the Feed */
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --like-color: #ef4444;
                --success-color: #10b981;
                --error-color: #dc2626;
                --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.04);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.08);
                --shadow-lg: 0 20px 40px rgba(109, 40, 217, 0.12);
                --bottom-nav-height: 64px;
                --checkout-bar-height: 68px;
                --content-max-width: 1320px;
                --content-side-padding: 16px;
                --sidebar-width: 380px;
                --free-shipping-threshold: 50;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-family);
                background-color: var(--bg-color);
                color: var(--text-primary);
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                padding-bottom: calc(var(--bottom-nav-height) + 24px);
            }

                body.modal-open {
                    overflow: hidden;
                }

            .mobile-bottom-nav {
                display: flex !important;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 200;
                background: #ffffff;
                border-top: 1px solid #ece8f6;
                justify-content: space-between;
                gap: 2px;
                padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
                overflow-x: auto;
                box-shadow: 0 -4px 20px rgba(30, 27, 46, 0.06);
            }

                .mobile-bottom-nav a {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: 2px;
                    font-size: 10.5px;
                    color: #6b6478;
                    text-decoration: none;
                    padding: 4px 6px;
                    flex-shrink: 0;
                    position: relative;
                    border-radius: 12px;
                    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
                }

                    .mobile-bottom-nav a i {
                        font-size: 17px;
                        transition: transform 0.2s ease;
                    }

                    .mobile-bottom-nav a:hover {
                        background: var(--accent-light);
                        color: var(--accent-color);
                    }

                    .mobile-bottom-nav a.active {
                        color: var(--accent-color) !important;
                        background: var(--accent-light) !important;
                        font-weight: 700;
                        transform: translateY(-2px);
                    }

                        .mobile-bottom-nav a.active i {
                            transform: scale(1.12);
                        }

            .unread-nav-badge {
                position: absolute;
                top: 2px;
                right: 18px;
                background: var(--accent-gradient);
                color: #fff;
                font-size: 10px;
                font-weight: 800;
                min-width: 16px;
                height: 16px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 4px;
                box-shadow: 0 3px 8px rgba(109, 40, 217, 0.3);
            }

            .chat-icon-wrap {
                position: relative;
                display: inline-flex;
            }

                .chat-icon-wrap .chat-nav-dot {
                    position: absolute;
                    top: -2px;
                    right: -4px;
                    width: 9px;
                    height: 9px;
                    background: #ed4956;
                    border: 2px solid #fff;
                    border-radius: 50%;
                    box-sizing: content-box;
                }

            .cart-page {
                padding: 24px var(--content-side-padding) 20px;
                min-height: 100vh;
            }

            .cart-header {
                text-align: center;
                margin-bottom: 24px;
                max-width: var(--content-max-width);
                margin-left: auto;
                margin-right: auto;
                position: relative;
            }

            .cart-header-icon {
                width: 52px;
                height: 52px;
                margin: 0 auto 12px;
                border-radius: 50%;
                background: var(--accent-light);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                color: var(--accent-color);
                position: relative;
            }

                .cart-header-icon .cart-header-count {
                    position: absolute;
                    top: -4px;
                    right: -4px;
                    min-width: 20px;
                    height: 20px;
                    border-radius: 50%;
                    background: var(--accent-gradient);
                    color: #fff;
                    font-size: 11px;
                    font-weight: 800;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 0 4px;
                    box-shadow: 0 3px 8px rgba(109, 40, 217, 0.35);
                }

            .cart-header h2 {
                font-family: 'Playfair Display', Georgia, serif;
                font-size: 32px;
                font-weight: 800;
                margin: 0 0 8px;
                color: var(--text-primary);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }

            .cart-header p {
                margin: 0;
                color: var(--text-secondary);
                font-size: 15px;
                font-weight: 500;
            }

            .cart-layout {
                max-width: var(--content-max-width);
                margin: 0 auto;
                display: grid;
                grid-template-columns: 1fr;
                gap: 24px;
                align-items: start;
            }

            @@media (min-width: 1024px) {
                .cart-layout {
                    grid-template-columns: 1fr var(--sidebar-width);
                    gap: 28px;
                }
            }

            .cart-main {
                min-width: 0;
            }

            .order-summary-sidebar {
                min-width: 0;
            }

            @@media (min-width: 1024px) {
                .order-summary-sidebar {
                    position: sticky;
                    top: 20px;
                }
            }

            .shein-navbar {
                display: flex;
                gap: 12px;
                overflow-x: auto;
                padding: 4px 4px 20px;
                margin: 0 0 8px;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
            }

                .shein-navbar::-webkit-scrollbar {
                    display: none;
                }

            .shein-nav-item {
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: center;
                gap: 9px;
                min-width: 150px;
                padding: 15px 22px;
                border-radius: 18px;
                text-decoration: none;
                color: var(--text-secondary);
                font-size: 14px;
                font-weight: 700;
                text-align: center;
                flex-shrink: 0;
                border: 1px solid var(--border-color);
                background: var(--card-bg);
                font-family: var(--font-family);
                cursor: pointer;
                box-shadow: var(--shadow-sm);
                transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
            }

                .shein-nav-item i {
                    font-size: 20px;
                    color: var(--accent-color);
                    transition: color 0.2s ease;
                }

                .shein-nav-item:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                }

                .shein-nav-item.active {
                    background: var(--accent-gradient);
                    color: #ffffff;
                    border-color: transparent;
                    box-shadow: 0 8px 20px rgba(109, 40, 217, 0.28);
                }

                    .shein-nav-item.active i {
                        color: #ffffff;
                    }

            .cart-filter-empty {
                display: none;
                text-align: center;
                padding: 30px 16px;
                color: var(--text-secondary);
                font-weight: 700;
                font-size: 14px;
                background: var(--accent-light);
                border-radius: 14px;
                margin-bottom: 12px;
            }

            .cart-container {
                min-width: 0;
            }

            .cart-list {
                background: var(--card-bg);
                border-radius: 20px;
                padding: 18px 22px 22px;
                box-shadow: var(--shadow-md);
                border: 1px solid var(--border-color);
            }

            .cart-select-all-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 14px 2px 12px;
                margin-bottom: 6px;
                border-bottom: 1px solid var(--border-color);
                flex-wrap: wrap;
            }

            .cart-checkbox-wrap {
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 700;
                font-size: 14.5px;
                color: var(--text-primary);
                cursor: pointer;
            }

            .cart-checkbox {
                appearance: none;
                -webkit-appearance: none;
                width: 20px;
                height: 20px;
                border-radius: 6px;
                border: 2px solid #d8d0ef;
                background: #ffffff;
                cursor: pointer;
                position: relative;
                flex-shrink: 0;
                transition: all 0.2s ease;
            }

                .cart-checkbox:hover {
                    border-color: var(--accent-color);
                }

                .cart-checkbox:checked {
                    background: var(--accent-gradient);
                    border-color: transparent;
                }

                    .cart-checkbox:checked::after {
                        content: "";
                        position: absolute;
                        left: 50%;
                        top: 46%;
                        width: 5px;
                        height: 9px;
                        border: solid #ffffff;
                        border-width: 0 2px 2px 0;
                        transform: translate(-50%, -50%) rotate(45deg);
                    }

            .remove-selected-btn {
                background: #fff5f5;
                color: var(--like-color);
                border: 1px solid #ffd1cc;
                border-radius: 50px;
                padding: 9px 16px;
                font-weight: 700;
                font-size: 13px;
                display: none;
                align-items: center;
                gap: 6px;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .remove-selected-btn.visible {
                    display: inline-flex;
                }

                .remove-selected-btn:hover {
                    background: #ffe3e1;
                    border-color: var(--like-color);
                }

                .remove-selected-btn:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }

            .cart-item {
                display: flex;
                align-items: flex-start;
                gap: 16px;
                padding: 18px 10px;
                margin: 10px 0 0;
                border-radius: 16px;
                border: 1px solid var(--border-color);
                transition: background-color 0.2s ease, box-shadow 0.2s ease;
                flex-wrap: wrap;
            }

                .cart-item:first-of-type {
                    margin-top: 14px;
                }

                .cart-item:hover {
                    background-color: #fbfaff;
                    box-shadow: var(--shadow-sm);
                }

                .cart-item img {
                    width: 92px;
                    height: 92px;
                    border-radius: 16px;
                    object-fit: cover;
                    background: #f3f0fa;
                    display: block;
                    border: 1px solid var(--border-color);
                    flex-shrink: 0;
                }

            .item-stock-status {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-size: 12.5px;
                font-weight: 700;
                color: var(--success-color);
                margin-top: 4px;
            }

                .item-stock-status.low i,
                .item-stock-status.low {
                    color: #d97706;
                }

                .item-stock-status i {
                    font-size: 7px;
                }

            /* NEW — free-text note input on each cart item
                           (e.g. "Red, size M") since there's no color/size
                           variant system. Saved server-side via the separate
                           CartItemNotes table, no schema change to CartItem. */
            .item-note-wrap {
                width: 100%;
                margin-top: 8px;
            }

            .item-note-input {
                width: 100%;
                padding: 8px 12px;
                border: 1px solid var(--border-color);
                border-radius: 10px;
                font-family: var(--font-family);
                font-size: 12.5px;
                font-weight: 600;
                color: var(--text-primary);
                background: var(--bg-color);
                outline: none;
                transition: all 0.2s ease;
            }

                .item-note-input:focus {
                    border-color: var(--accent-color);
                    background: #ffffff;
                }

                .item-note-input::placeholder {
                    color: var(--text-secondary);
                    font-weight: 500;
                }

            .item-footer-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 10px;
                width: 100%;
                margin-top: 12px;
                padding-top: 12px;
                border-top: 1px solid var(--border-color);
            }

            .item-view-link {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                color: var(--accent-color);
                font-weight: 700;
                font-size: 13px;
                text-decoration: none;
                border-radius: 50px;
                padding: 8px 4px;
                transition: color 0.2s ease;
            }

                .item-view-link:hover {
                    color: var(--accent-hover);
                    text-decoration: underline;
                }

            .qty-stepper {
                display: inline-flex;
                align-items: center;
                gap: 0;
                border: 1px solid var(--border-color);
                border-radius: 50px;
                background: var(--bg-color);
                overflow: hidden;
            }

            .qty-stepper-btn {
                width: 30px;
                height: 30px;
                border: none;
                background: transparent;
                color: var(--accent-color);
                font-size: 13px;
                font-weight: 800;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: background-color 0.2s ease;
            }

                .qty-stepper-btn:hover {
                    background: var(--accent-light);
                }

                .qty-stepper-btn:disabled {
                    opacity: 0.4;
                    cursor: not-allowed;
                }

            .item-select-wrap {
                display: flex;
                align-items: center;
                flex-shrink: 0;
            }

            .item-select-checkbox {
                appearance: none;
                -webkit-appearance: none;
                width: 20px;
                height: 20px;
                border-radius: 6px;
                border: 2px solid #d8d0ef;
                background: #ffffff;
                cursor: pointer;
                position: relative;
                transition: all 0.2s ease;
                flex-shrink: 0;
            }

                .item-select-checkbox:hover {
                    border-color: var(--accent-color);
                }

                .item-select-checkbox:checked {
                    background: var(--accent-gradient);
                    border-color: transparent;
                }

                    .item-select-checkbox:checked::after {
                        content: "";
                        position: absolute;
                        left: 50%;
                        top: 46%;
                        width: 5px;
                        height: 9px;
                        border: solid #ffffff;
                        border-width: 0 2px 2px 0;
                        transform: translate(-50%, -50%) rotate(45deg);
                    }

            .item-info {
                flex: 1 1 200px;
                min-width: 160px;
            }

            .item-name {
                font-size: 16px;
                font-weight: 800;
                color: var(--text-primary);
                margin-bottom: 4px;
                line-height: 1.3;
            }

            .item-badges {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
                margin-bottom: 5px;
            }

            .item-badge {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-size: 10.5px;
                font-weight: 800;
                padding: 3px 8px;
                border-radius: 50px;
            }

                .item-badge.best-seller {
                    background: #fff1e0;
                    color: #c2410c;
                    border: 1px solid #fed7aa;
                }

                .item-badge.low-stock {
                    background: #fee2e2;
                    color: var(--error-color);
                    border: 1px solid #ffd1cc;
                }

            .item-meta-row {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .item-store {
                color: var(--text-secondary);
                font-size: 12.5px;
                font-weight: 600;
            }

            .item-price {
                color: var(--accent-color);
                font-weight: 800;
                font-size: 15px;
                white-space: nowrap;
            }

            .item-actions-inline {
                display: flex;
                align-items: center;
                gap: 10px;
                flex-shrink: 0;
            }

            .view-btn {
                background: var(--accent-light);
                color: var(--accent-color);
                border: 1px solid var(--border-color);
                border-radius: 50%;
                width: 36px;
                height: 36px;
                padding: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                text-decoration: none;
                font-size: 14px;
                transition: all 0.2s ease;
            }

                .view-btn:hover {
                    background: var(--accent-color);
                    color: #ffffff;
                    border-color: var(--accent-color);
                }

            .qty-form {
                display: flex;
                gap: 8px;
                align-items: center;
            }

            .qty-input {
                width: 38px;
                height: 30px;
                padding: 0;
                border: none;
                border-left: 1px solid var(--border-color);
                border-right: 1px solid var(--border-color);
                font-weight: 700;
                font-size: 13.5px;
                background: var(--bg-color);
                font-family: var(--font-family);
                color: var(--accent-color);
                outline: none;
                text-align: center;
                transition: all 0.2s ease;
                -moz-appearance: textfield;
            }

                .qty-input::-webkit-outer-spin-button,
                .qty-input::-webkit-inner-spin-button {
                    -webkit-appearance: none;
                    margin: 0;
                }

                .qty-input:focus {
                    background: #ffffff;
                }

            .remove-btn {
                background: #fff5f5;
                color: var(--like-color);
                border: 1px solid #ffd1cc;
                border-radius: 50%;
                width: 36px;
                height: 36px;
                padding: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-size: 14px;
                flex-shrink: 0;
                transition: all 0.2s ease;
            }

                .remove-btn:hover {
                    background: var(--like-color);
                    color: #ffffff;
                    border-color: var(--like-color);
                }

            .cart-checkout-bar {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 14px;
                background: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 18px 22px;
                box-shadow: var(--shadow-md);
                margin-top: 20px;
            }

            .checkout-bar-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: var(--accent-light);
                color: var(--accent-color);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                flex-shrink: 0;
            }

            .checkout-bar-info {
                display: flex;
                flex-direction: column;
                gap: 3px;
                min-width: 0;
                flex: 1;
            }

            .checkout-bar-items {
                font-size: 12.5px;
                font-weight: 600;
                color: var(--text-secondary);
                white-space: nowrap;
            }

            .checkout-bar-label {
                font-size: 14.5px;
                font-weight: 800;
                color: var(--text-primary);
                white-space: nowrap;
            }

            .checkout-bar-total {
                font-size: 24px;
                font-weight: 800;
                color: var(--accent-color);
                white-space: nowrap;
                flex-shrink: 0;
            }

            .order-summary-card {
                background: var(--card-bg);
                border-radius: 20px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-md);
                padding: 22px;
            }

            .order-summary-title-row {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 4px;
            }

                .order-summary-title-row .modal-icon {
                    width: 40px;
                    height: 40px;
                    margin: 0;
                    border-radius: 12px;
                    font-size: 18px;
                }

                .order-summary-title-row .modal-title {
                    margin: 0;
                    text-align: left;
                    font-size: 19px;
                }

            .free-shipping-box {
                background: var(--accent-light);
                border: 1px solid var(--border-color);
                border-radius: 14px;
                padding: 14px;
                margin: 16px 0;
                text-align: center;
            }

                .free-shipping-box.reached {
                    background: #dcfce7;
                    border-color: #86efac;
                }

            .free-shipping-box-text {
                font-size: 12.5px;
                font-weight: 600;
                color: var(--text-secondary);
                margin-bottom: 8px;
                line-height: 1.5;
            }

                .free-shipping-box-text strong {
                    color: var(--accent-color);
                    font-weight: 800;
                }

            .free-shipping-box.reached .free-shipping-box-text strong {
                color: #166534;
            }

            .free-shipping-bar-track {
                height: 6px;
                border-radius: 50px;
                background: #e3daf7;
                overflow: hidden;
                margin-bottom: 6px;
            }

            .free-shipping-bar-fill {
                height: 100%;
                border-radius: 50px;
                background: var(--accent-gradient);
                transition: width 0.3s ease;
                width: 0%;
            }

            .free-shipping-box.reached .free-shipping-bar-fill {
                background: #22c55e;
            }

            .free-shipping-bar-labels {
                display: flex;
                justify-content: space-between;
                font-size: 11px;
                font-weight: 700;
                color: var(--text-secondary);
            }

            .order-summary-cta {
                width: 100%;
                margin-top: 18px;
                padding: 15px;
                background: var(--accent-gradient);
                color: #ffffff;
                border: none;
                border-radius: 50px;
                font-family: var(--font-family);
                font-weight: 800;
                font-size: 15px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                box-shadow: 0 12px 28px rgba(109, 40, 217, 0.3);
                transition: all 0.25s ease;
            }

                .order-summary-cta:hover {
                    opacity: 0.96;
                    transform: translateY(-2px);
                    box-shadow: 0 16px 32px rgba(109, 40, 217, 0.38);
                }

                .order-summary-cta:disabled {
                    opacity: 0.55;
                    cursor: not-allowed;
                    box-shadow: none;
                    transform: none;
                }

            .secure-checkout-note {
                text-align: center;
                font-size: 12px;
                font-weight: 700;
                color: var(--text-secondary);
                margin-top: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

            .trust-badges-row {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 8px;
                margin-top: 18px;
                padding-top: 18px;
                border-top: 1px solid var(--border-color);
            }

            .trust-badge {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 5px;
                text-align: center;
                font-size: 10.5px;
                font-weight: 700;
                color: var(--text-secondary);
                line-height: 1.3;
            }

                .trust-badge i {
                    width: 32px;
                    height: 32px;
                    border-radius: 10px;
                    background: var(--accent-light);
                    color: var(--accent-color);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 13px;
                }

            .summary-row {
                display: flex;
                justify-content: space-between;
                gap: 15px;
                margin-bottom: 12px;
                color: var(--text-secondary);
                font-weight: 600;
                font-size: 14px;
            }

            .summary-note {
                background: #fff7ed;
                border: 1px solid #fed7aa;
                color: #9a3412;
                padding: 12px;
                border-radius: 12px;
                font-size: 12px;
                font-weight: 700;
                margin: 12px 0;
                line-height: 1.5;
            }

            .summary-free {
                background: #dcfce7;
                border: 1px solid #86efac;
                color: #166534;
                padding: 12px;
                border-radius: 12px;
                font-size: 12px;
                font-weight: 700;
                margin: 12px 0;
                line-height: 1.5;
            }

            .summary-selection-note {
                background: var(--accent-light);
                border: 1px solid var(--border-color);
                color: var(--text-secondary);
                padding: 12px;
                border-radius: 12px;
                font-size: 12px;
                font-weight: 700;
                margin: 0 0 16px;
                line-height: 1.5;
            }

            .summary-total {
                display: flex;
                justify-content: space-between;
                gap: 15px;
                border-top: 1px solid var(--border-color);
                padding-top: 15px;
                margin-top: 15px;
                color: var(--text-primary);
                font-size: 22px;
                font-weight: 800;
            }

            .coupon-form {
                margin: 15px 0;
            }

            .coupon-label,
            .payment-label {
                display: block;
                margin-bottom: 8px;
                font-size: 13px;
                font-weight: 800;
                color: var(--text-primary);
            }

            .coupon-row {
                display: flex;
                gap: 8px;
            }

            .coupon-input {
                flex: 1;
                min-width: 0;
                padding: 10px 16px;
                border: 1px solid var(--border-color);
                border-radius: 50px;
                font-weight: 700;
                font-family: var(--font-family);
                background: var(--bg-color);
                outline: none;
                transition: all 0.2s ease;
            }

                .coupon-input:focus {
                    border-color: var(--accent-color);
                    background: #ffffff;
                }

            .coupon-btn {
                background: var(--accent-color);
                color: white;
                border: none;
                border-radius: 50px;
                padding: 10px 18px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .coupon-btn:hover {
                    background: var(--accent-hover);
                }

            .remove-coupon-btn {
                width: 100%;
                margin-bottom: 10px;
                padding: 10px;
                background: #fff5f5;
                color: var(--like-color);
                border: 1px solid #ffd1cc;
                border-radius: 50px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .remove-coupon-btn:hover {
                    background: #ffe3e1;
                    border-color: var(--like-color);
                }

            .discount-row {
                color: var(--success-color);
            }

            .payment-section {
                margin-top: 15px;
            }

            .payment-select {
                width: 100%;
                padding: 12px;
                border-radius: 12px;
                border: 1px solid var(--border-color);
                font-weight: 700;
                background: white;
                font-family: var(--font-family);
                outline: none;
                transition: all 0.2s ease;
            }

                .payment-select:focus {
                    border-color: var(--accent-color);
                }

            .payment-note {
                margin-top: 10px;
                padding: 12px;
                background: var(--accent-light);
                color: var(--text-secondary);
                border-radius: 12px;
                font-size: 12px;
                font-weight: 700;
                line-height: 1.5;
            }

            .checkout-btn {
                width: 100%;
                margin-top: 20px;
                padding: 14px;
                background: var(--accent-gradient);
                color: white;
                border: none;
                border-radius: 50px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.25s ease;
                box-shadow: 0 4px 12px rgba(109, 40, 217, 0.25);
            }

                .checkout-btn:hover {
                    opacity: 0.95;
                    box-shadow: 0 6px 15px rgba(109, 40, 217, 0.35);
                    transform: translateY(-1px);
                }

                .checkout-btn:disabled {
                    opacity: 0.65;
                    cursor: not-allowed;
                    box-shadow: none;
                    transform: none;
                }

            .also-like-section {
                background: var(--card-bg);
                border-radius: 20px;
                padding: 18px 20px 22px;
                box-shadow: var(--shadow-md);
                border: 1px solid var(--border-color);
                margin-top: 20px;
            }

            .also-like-header {
                display: flex;
                align-items: center;
                gap: 8px;
                font-weight: 800;
                font-size: 16px;
                color: var(--text-primary);
                margin-bottom: 14px;
            }

                .also-like-header i {
                    color: var(--accent-color);
                }

            .also-like-scroller {
                display: flex;
                gap: 14px;
                overflow-x: auto;
                padding: 2px 2px 6px;
                scroll-behavior: smooth;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
            }

                .also-like-scroller::-webkit-scrollbar {
                    display: none;
                }

            .also-like-card {
                flex: 0 0 148px;
                text-decoration: none;
                color: inherit;
                display: block;
            }

                .also-like-card .also-like-img-wrap {
                    position: relative;
                    width: 148px;
                    height: 148px;
                    border-radius: 14px;
                    overflow: hidden;
                    background: #f3f0fa;
                    border: 1px solid var(--border-color);
                    margin-bottom: 8px;
                }

                .also-like-card img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }

            .also-like-wishlist-btn {
                position: absolute;
                top: 8px;
                right: 8px;
                width: 28px;
                height: 28px;
                border-radius: 50%;
                border: none;
                background: rgba(255, 255, 255, 0.92);
                color: var(--text-secondary);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12.5px;
                cursor: pointer;
                box-shadow: 0 3px 8px rgba(30, 27, 46, 0.15);
                transition: all 0.2s ease;
            }

                .also-like-wishlist-btn:hover {
                    color: var(--like-color);
                }

                .also-like-wishlist-btn.saved {
                    color: var(--like-color);
                }

                    .also-like-wishlist-btn.saved i {
                        font-weight: 900;
                    }

            .also-like-name {
                font-size: 12.5px;
                font-weight: 700;
                color: var(--text-primary);
                line-height: 1.35;
                margin-bottom: 4px;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .also-like-price {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--accent-color);
            }

            .also-like-empty,
            .also-like-loading {
                color: var(--text-secondary);
                font-size: 13px;
                font-weight: 600;
                padding: 10px 2px;
            }

            .empty-cart {
                max-width: 700px;
                margin: 40px auto;
                background: var(--card-bg);
                text-align: center;
                color: var(--text-secondary);
                padding: 60px 40px;
                border-radius: 20px;
                border: 2px dashed #ded4f5;
                box-shadow: var(--shadow-sm);
            }

                .empty-cart h3 {
                    color: var(--text-primary);
                    font-size: 22px;
                    font-weight: 800;
                    margin-bottom: 10px;
                }

            .shop-link {
                display: inline-block;
                margin-top: 20px;
                background: var(--accent-gradient);
                color: white;
                padding: 12px 28px;
                border-radius: 50px;
                text-decoration: none;
                font-weight: 800;
                box-shadow: 0 4px 12px rgba(109, 40, 217, 0.25);
                transition: all 0.25s ease;
            }

                .shop-link:hover {
                    opacity: 0.95;
                    box-shadow: 0 6px 15px rgba(109, 40, 217, 0.35);
                }

            .toast-container {
                position: fixed;
                top: 24px;
                right: 24px;
                z-index: 30000;
                display: flex;
                flex-direction: column;
                gap: 12px;
                pointer-events: none;
            }

            .app-toast {
                width: min(390px, calc(100vw - 40px));
                padding: 16px 20px;
                border-radius: 14px;
                background: var(--card-bg);
                display: flex;
                align-items: flex-start;
                gap: 12px;
                box-shadow: 0 15px 35px rgba(30, 27, 46, 0.12);
                opacity: 0;
                transform: translateX(45px);
                transition: opacity 0.3s ease, transform 0.3s ease;
                pointer-events: auto;
                border-left: 5px solid var(--border-color);
            }

                .app-toast.show {
                    opacity: 1;
                    transform: translateX(0);
                }

                .app-toast.success {
                    border-left-color: var(--success-color);
                    color: var(--text-primary);
                }

                    .app-toast.success .toast-icon {
                        background: #e6f7f0;
                        color: var(--success-color);
                    }

                .app-toast.error {
                    border-left-color: var(--error-color);
                    color: var(--text-primary);
                }

                    .app-toast.error .toast-icon {
                        background: #fee2e2;
                        color: var(--error-color);
                    }

            .toast-icon {
                width: 28px;
                height: 28px;
                flex: 0 0 28px;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                font-weight: 800;
            }

            .toast-content {
                flex: 1;
            }

            .toast-title {
                display: block;
                margin-bottom: 3px;
                font-weight: 800;
                color: var(--text-primary);
            }

            .toast-message {
                display: block;
                font-size: 13px;
                font-weight: 600;
                line-height: 1.45;
                color: var(--text-secondary);
            }

            .toast-close {
                border: none;
                background: transparent;
                color: var(--text-secondary);
                padding: 0;
                font-size: 22px;
                cursor: pointer;
                line-height: 1;
                transition: color 0.15s ease;
            }

                .toast-close:hover {
                    color: var(--text-primary);
                }

            .app-modal {
                position: fixed;
                inset: 0;
                z-index: 20000;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
                background: rgba(30, 27, 46, 0.6);
                backdrop-filter: blur(5px);
            }

                .app-modal.open {
                    display: flex;
                }

            .modal-card {
                width: min(440px, 100%);
                background: var(--card-bg);
                border-radius: 20px;
                padding: 30px;
                box-shadow: var(--shadow-lg);
                transform: translateY(15px) scale(0.98);
                opacity: 0;
                transition: 0.2s ease;
                border: 1px solid var(--border-color);
            }

            .app-modal.open .modal-card {
                transform: translateY(0) scale(1);
                opacity: 1;
            }

            .modal-icon {
                width: 58px;
                height: 58px;
                margin: 0 auto 15px;
                border-radius: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 27px;
                background: var(--accent-light);
                color: var(--accent-color);
            }

                .modal-icon.danger {
                    background: #fee2e2;
                    color: var(--error-color);
                }

            .modal-title {
                margin: 0 0 8px;
                text-align: center;
                color: var(--text-primary);
                font-size: 23px;
                font-weight: 800;
            }

            .modal-description {
                margin: 0 0 20px;
                text-align: center;
                color: var(--text-secondary);
                font-size: 14px;
                line-height: 1.55;
            }

            .modal-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-top: 20px;
            }

            .modal-cancel,
            .modal-confirm,
            .modal-danger {
                border: none;
                border-radius: 50px;
                padding: 12px 16px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.2s ease;
            }

            .modal-cancel {
                background: #f1eef8;
                border: 1px solid var(--border-color);
                color: var(--text-secondary);
            }

            .modal-confirm {
                background: var(--accent-gradient);
                color: white;
            }

            .modal-danger {
                background: var(--error-color);
                color: white;
            }

            .modal-cancel:hover {
                background: #e7e1f5;
                color: var(--text-primary);
            }

            .modal-confirm:hover {
                opacity: 0.95;
            }

            .modal-danger:hover {
                background: #b91c1c;
            }

            .modal-confirm:disabled,
            .modal-danger:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }

            @@media (max-width: 550px) {
                .cart-page {
                    padding: 20px 12px 16px;
                }

                .cart-item {
                    padding: 14px 10px;
                }

                    .cart-item img {
                        width: 76px;
                        height: 76px;
                    }

                .item-footer-row {
                    justify-content: space-between;
                }

                .order-summary-card {
                    padding: 18px;
                }

                .also-like-section {
                    padding: 16px 14px 18px;
                }

                .also-like-card,
                .also-like-card .also-like-img-wrap {
                    flex-basis: 124px;
                    width: 124px;
                    height: 124px;
                }

                .coupon-row {
                    flex-direction: column;
                }

                .coupon-btn {
                    width: 100%;
                }

                .modal-actions {
                    grid-template-columns: 1fr;
                }

                .toast-container {
                    top: 15px;
                    right: 15px;
                    left: 15px;
                }

                .app-toast {
                    width: 100%;
                }

                .cart-checkout-bar {
                    padding: 14px 16px;
                }

                .checkout-bar-total {
                    font-size: 19px;
                }

                .shein-nav-item {
                    min-width: 130px;
                    padding: 13px 18px;
                    font-size: 13px;
                }
            }
    </style>
</head>

<body>

    <div id="toastContainer"
         class="toast-container"
         aria-live="polite"
         aria-atomic="true">

        @if (TempData["Success"] is string successMessage &&
        !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="app-toast success" data-toast>
                <span class="toast-icon">✓</span>

                <div class="toast-content">
                    <span class="toast-title">
                        Success
                    </span>

                    <span class="toast-message">
                        @successMessage
                    </span>
                </div>

                <button type="button"
                        class="toast-close"
                        aria-label="Close notification">
                    &times;
                </button>
            </div>
        }

        @if (TempData["Error"] is string errorMessage &&
        !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="app-toast error" data-toast>
                <span class="toast-icon">!</span>

                <div class="toast-content">
                    <span class="toast-title">
                        Unable to continue
                    </span>

                    <span class="toast-message">
                        @errorMessage
                    </span>
                </div>

                <button type="button"
                        class="toast-close"
                        aria-label="Close notification">
                    &times;
                </button>
            </div>
        }
    </div>

    <partial name="_CustomerBottomNav" />

    <!-- BACK ARROW — shared partial, fixed to the same screen spot on every page -->
    <partial name="_CustomerBackArrow" />

    <div class="cart-page">

        <div class="cart-header">
            <div class="cart-header-icon">
                <i class="fa-solid fa-cart-shopping"></i>

                @if (Model.CartItems != null && Model.CartItems.Any())
                {
                    <span class="cart-header-count">
                        @Model.CartItems.Count
                    </span>
                }
            </div>

            <h2>Your Cart</h2>

            <p>
                Select the items you'd like to checkout.
            </p>
        </div>

        @if (Model.CartItems == null ||
        !Model.CartItems.Any())
        {
            <div class="empty-cart">
                <h3>Your cart is empty</h3>

                <p>
                    Add products to your cart before checkout.
                </p>

                <a href="/CustomerProducts"
                   class="shop-link">
                    Continue Shopping
                </a>
            </div>
        }
        else
        {
            <div class="cart-layout">
                <div class="cart-main">

                    <nav class="shein-navbar" aria-label="Filter cart items">
                        <button type="button"
                                class="shein-nav-item active"
                                data-filter="all">
                            <i class="fa-solid fa-layer-group"></i>
                            <span>All Products</span>
                        </button>

                        <button type="button"
                                class="shein-nav-item"
                                data-filter="lowstock">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span>Almost Out of Stock</span>
                        </button>

                        <button type="button"
                                class="shein-nav-item"
                                data-filter="bestselling">
                            <i class="fa-solid fa-fire"></i>
                            <span>Best Selling</span>
                        </button>
                    </nav>

                    <div class="cart-container">

                        <div class="cart-list">

                            <div class="cart-select-all-row">
                                <label class="cart-checkbox-wrap">
                                    <input type="checkbox"
                                           id="selectAllCheckbox"
                                           class="cart-checkbox" />
                                    <span>
                                        Select All
                                        (<span id="selectAllCount">0/@Model.CartItems.Count</span>)
                                    </span>
                                </label>

                                <button type="button"
                                        id="removeSelectedBtn"
                                        class="remove-selected-btn">
                                    <i class="fa-solid fa-trash-can"></i>
                                    Remove Selected
                                </button>
                            </div>

                            <div id="cartFilterEmptyMessage"
                                 class="cart-filter-empty">
                                No items in your cart match this filter.
                            </div>

                            @foreach (var item in Model.CartItems)
                            {
                                var removeFormId =
                                $"removeForm-{item.CartItemID}";

                                <div class="cart-item"
                                     data-cart-item-id="@item.CartItemID"
                                     data-quantity="@item.Quantity"
                                     data-unit-price="@item.UnitPrice.ToString("F2")"
                                     data-available-stock="@item.AvailableStock"
                                     data-low-stock="@item.IsAlmostOutOfStock.ToString().ToLowerInvariant()"
                                     data-best-seller="@item.IsBestSeller.ToString().ToLowerInvariant()">

                                    <label class="item-select-wrap">
                                        <input type="checkbox"
                                               class="item-select-checkbox"
                                               data-cart-item-id="@item.CartItemID"
                                               aria-label="Select @item.ProductName for checkout" />
                                    </label>

                                    <img src="@item.ImageUrl"
                                         alt="@item.ProductName"
                                         onerror="this.onerror=null;this.src='/images/no-image.png';" />

                                    <div class="item-info">
                                        <div class="item-name">
                                            @item.ProductName
                                        </div>

                                        @if (item.IsBestSeller || item.IsAlmostOutOfStock)
                                        {
                                            <div class="item-badges">
                                                @if (item.IsBestSeller)
                                                {
                                                    <span class="item-badge best-seller">
                                                        <i class="fa-solid fa-fire"></i> Best Seller
                                                    </span>
                                                }

                                                @if (item.IsAlmostOutOfStock)
                                                {
                                                    <span class="item-badge low-stock">
                                                        <i class="fa-solid fa-triangle-exclamation"></i> Almost Gone
                                                    </span>
                                                }
                                            </div>
                                        }

                                        <div class="item-meta-row">
                                            <span class="item-store">
                                                Store: @item.StoreName
                                            </span>

                                            <span class="item-price">
                                                $@item.UnitPrice.ToString("N2") each
                                            </span>
                                        </div>

                                        <div class="item-stock-status @(item.IsAlmostOutOfStock ? "low" : "")">
                                            <i class="fa-solid fa-circle"></i>
                                            @(item.IsAlmostOutOfStock ? "Almost Out of Stock" : "In Stock")
                                        </div>

                                        <div class="item-note-wrap">
                                            <input type="text"
                                                   class="item-note-input"
                                                   data-cart-item-id="@item.CartItemID"
                                                   placeholder="Add a note (e.g. color, size)"
                                                   value="@item.Note"
                                                   maxlength="200" />
                                        </div>
                                    </div>

                                    <div class="item-footer-row">

                                        <a href="/StoreCustomerProfile?id=@item.StoreID&productId=@item.ProductID"
                                           class="item-view-link"
                                           title="View product"
                                           aria-label="View @item.ProductName">
                                            <i class="fa-solid fa-eye"></i> View Product
                                        </a>

                                        <div class="item-actions-inline">

                                            <form method="post"
                                                  asp-page-handler="UpdateQuantity"
                                                  class="qty-form auto-update-qty-form"
                                                  data-cart-item-id="@item.CartItemID">

                                                <input type="hidden"
                                                       name="cartItemId"
                                                       value="@item.CartItemID" />

                                                <input type="hidden"
                                                       name="AppliedCouponCode"
                                                       value="@Model.AppliedCouponCode" />

                                                <div class="qty-stepper">
                                                    <button type="button"
                                                            class="qty-stepper-btn qty-decrease"
                                                            aria-label="Decrease quantity">
                                                        <i class="fa-solid fa-minus"></i>
                                                    </button>

                                                    <input type="number"
                                                           name="quantity"
                                                           value="@item.Quantity"
                                                           min="1"
                                                           max="@item.AvailableStock"
                                                           class="qty-input auto-update-qty-input" />

                                                    <button type="button"
                                                            class="qty-stepper-btn qty-increase"
                                                            aria-label="Increase quantity">
                                                        <i class="fa-solid fa-plus"></i>
                                                    </button>
                                                </div>
                                            </form>

                                            <form id="@removeFormId"
                                                  method="post"
                                                  asp-page-handler="Remove">

                                                <input type="hidden"
                                                       name="cartItemId"
                                                       value="@item.CartItemID" />

                                                <input type="hidden"
                                                       name="AppliedCouponCode"
                                                       value="@Model.AppliedCouponCode" />

                                                <button type="button"
                                                        class="remove-btn remove-trigger"
                                                        data-form-id="@removeFormId"
                                                        data-product-name="@item.ProductName"
