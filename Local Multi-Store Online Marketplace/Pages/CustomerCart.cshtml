@page
@model Local_Multi_Store_Online_Marketplace.Pages.CustomerCartModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Your Cart | realnest</title>

    <!-- Google Fonts & FontAwesome Icons (Consistent with Customer Feed) -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-color: #faf9fc;
                --card-bg: #ffffff;
                --border-color: #ece8f6;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                /* Purple / Indigo palette, matching the Feed */
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --like-color: #ef4444;
                --success-color: #10b981;
                --error-color: #dc2626;
                --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.04);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.08);
                --shadow-lg: 0 20px 40px rgba(109, 40, 217, 0.12);
                --bottom-nav-height: 64px;
                --checkout-bar-height: 68px;
                --content-max-width: 1100px;
                --content-side-padding: 16px;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-family);
                background-color: var(--bg-color);
                color: var(--text-primary);
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                /* Offset so page content clears BOTH the sticky checkout
                           bar and the bottom nav underneath it. */
                padding-bottom: calc(var(--bottom-nav-height) + var(--checkout-bar-height) + 34px);
            }

                body.modal-open {
                    overflow: hidden;
                }

            /* ============================================================
                                           BOTTOM NAV — now rendered by the shared _CustomerBottomNav
                                           partial. Styles below match Customer1/Chat/CustomerFeed exactly
                                           (same class names), so the partial renders identically here.
                                           ============================================================ */
            .mobile-bottom-nav {
                display: flex !important;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 200;
                background: #ffffff;
                border-top: 1px solid #ece8f6;
                justify-content: space-between;
                gap: 2px;
                padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
                overflow-x: auto;
                box-shadow: 0 -4px 20px rgba(30, 27, 46, 0.06);
            }

                .mobile-bottom-nav a {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: 2px;
                    font-size: 10.5px;
                    color: #6b6478;
                    text-decoration: none;
                    padding: 4px 6px;
                    flex-shrink: 0;
                    position: relative;
                    border-radius: 12px;
                    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
                }

                    .mobile-bottom-nav a i {
                        font-size: 17px;
                        transition: transform 0.2s ease;
                    }

                    .mobile-bottom-nav a:hover {
                        background: var(--accent-light);
                        color: var(--accent-color);
                    }

                    .mobile-bottom-nav a.active {
                        color: var(--accent-color) !important;
                        background: var(--accent-light) !important;
                        font-weight: 700;
                        transform: translateY(-2px);
                    }

                        .mobile-bottom-nav a.active i {
                            transform: scale(1.12);
                        }

            /* Cart badge (used by _CartCountBadge partial inside _CustomerBottomNav) */
            .unread-nav-badge {
                position: absolute;
                top: 2px;
                right: 18px;
                background: var(--accent-gradient);
                color: #fff;
                font-size: 10px;
                font-weight: 800;
                min-width: 16px;
                height: 16px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 4px;
                box-shadow: 0 3px 8px rgba(109, 40, 217, 0.3);
            }

            /* Chat unread dot (used inside _CustomerBottomNav) */
            .chat-icon-wrap {
                position: relative;
                display: inline-flex;
            }

                .chat-icon-wrap .chat-nav-dot {
                    position: absolute;
                    top: -2px;
                    right: -4px;
                    width: 9px;
                    height: 9px;
                    background: #ed4956;
                    border: 2px solid #fff;
                    border-radius: 50%;
                    box-sizing: content-box;
                }

            /* PAGE HEADER — sits ABOVE the filter chips now */
            .cart-page {
                padding: 32px var(--content-side-padding) 20px;
                min-height: 100vh;
            }

            .cart-header {
                text-align: center;
                margin-bottom: 20px;
                max-width: 1100px;
                margin-left: auto;
                margin-right: auto;
            }

                .cart-header h2 {
                    font-family: 'Playfair Display', Georgia, serif;
                    font-size: 34px;
                    font-weight: 800;
                    margin: 0 0 8px;
                    color: var(--text-primary);
                }

                .cart-header p {
                    margin: 0;
                    color: var(--text-secondary);
                    font-size: 15px;
                    font-weight: 500;
                }

            /* ============================================================
                                           FILTER CHIPS — now BELOW the header (Instagram/Shein-style
                                           scrollable strip). Client-side only: filters which cart rows
                                           are visible, never navigates anywhere.
                                           ============================================================ */
            .shein-navbar {
                display: flex;
                gap: 12px;
                overflow-x: auto;
                padding: 4px 4px 24px;
                max-width: var(--content-max-width);
                margin: 0 auto 8px;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
            }

                .shein-navbar::-webkit-scrollbar {
                    display: none;
                }

            .shein-nav-item {
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: center;
                gap: 9px;
                min-width: 150px;
                padding: 15px 22px;
                border-radius: 18px;
                text-decoration: none;
                color: var(--text-secondary);
                font-size: 14px;
                font-weight: 700;
                text-align: center;
                flex-shrink: 0;
                border: 1px solid var(--border-color);
                background: var(--card-bg);
                font-family: var(--font-family);
                cursor: pointer;
                box-shadow: var(--shadow-sm);
                transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
            }

                .shein-nav-item i {
                    font-size: 20px;
                    color: var(--accent-color);
                    transition: color 0.2s ease;
                }

                .shein-nav-item:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                }

                .shein-nav-item.active {
                    background: var(--accent-gradient);
                    color: #ffffff;
                    border-color: transparent;
                    box-shadow: 0 8px 20px rgba(109, 40, 217, 0.28);
                }

                    .shein-nav-item.active i {
                        color: #ffffff;
                    }

            /* Empty-state shown when a filter chip matches nothing */
            .cart-filter-empty {
                display: none;
                text-align: center;
                padding: 30px 16px;
                color: var(--text-secondary);
                font-weight: 700;
                font-size: 14px;
                background: var(--accent-light);
                border-radius: 14px;
                margin-bottom: 12px;
            }

            /* ============================================================
                                           MAIN CONTAINER — single, wide column. The product list is
                                           now the whole page; the summary lives in the checkout
                                           bottom-sheet instead of a side panel.
                                           ============================================================ */
            .cart-container {
                max-width: var(--content-max-width);
                margin: auto;
            }

            /* CART PRODUCTS LIST */
            .cart-list {
                background: var(--card-bg);
                border-radius: 24px;
                padding: 28px;
                box-shadow: var(--shadow-lg);
                border: 1px solid var(--border-color);
            }

            /* SELECT ALL / BULK REMOVE ROW (Shein-style) */
            .cart-select-all-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 4px 4px 18px;
                margin-bottom: 12px;
                border-bottom: 1px solid var(--border-color);
                flex-wrap: wrap;
            }

            .cart-checkbox-wrap {
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 700;
                font-size: 14px;
                color: var(--text-primary);
                cursor: pointer;
            }

            .cart-checkbox {
                appearance: none;
                -webkit-appearance: none;
                width: 22px;
                height: 22px;
                border-radius: 50%;
                border: 2px solid #d8d0ef;
                background: #ffffff;
                cursor: pointer;
                position: relative;
                flex-shrink: 0;
                transition: all 0.2s ease;
            }

                .cart-checkbox:hover {
                    border-color: var(--accent-color);
                }

                .cart-checkbox:checked {
                    background: var(--accent-gradient);
                    border-color: transparent;
                }

                    .cart-checkbox:checked::after {
                        content: "";
                        position: absolute;
                        left: 50%;
                        top: 46%;
                        width: 5px;
                        height: 9px;
                        border: solid #ffffff;
                        border-width: 0 2px 2px 0;
                        transform: translate(-50%, -50%) rotate(45deg);
                    }

            .remove-selected-btn {
                background: #fff5f5;
                color: var(--like-color);
                border: 1px solid #ffd1cc;
                border-radius: 50px;
                padding: 9px 16px;
                font-weight: 700;
                font-size: 13px;
                display: none;
                align-items: center;
                gap: 6px;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .remove-selected-btn.visible {
                    display: inline-flex;
                }

                .remove-selected-btn:hover {
                    background: #ffe3e1;
                    border-color: var(--like-color);
                }

                .remove-selected-btn:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }

            .cart-item {
                display: grid;
                grid-template-columns: 26px 110px 1fr;
                gap: 18px;
                padding: 22px 14px;
                margin: 0 -14px;
                border-radius: 16px;
                border-bottom: 1px solid var(--border-color);
                transition: background-color 0.2s ease;
            }

                .cart-item:hover {
                    background-color: #fbfaff;
                }

                .cart-item:last-child {
                    border-bottom: none;
                }

                .cart-item img {
                    width: 110px;
                    height: 110px;
                    border-radius: 16px;
                    object-fit: cover;
                    background: #f3f0fa;
                    display: block;
                    border: 1px solid var(--border-color);
                }

            .item-select-wrap {
                display: flex;
                align-items: flex-start;
                justify-content: center;
                padding-top: 6px;
            }

            .item-select-checkbox {
                appearance: none;
                -webkit-appearance: none;
                width: 22px;
                height: 22px;
                border-radius: 50%;
                border: 2px solid #d8d0ef;
                background: #ffffff;
                cursor: pointer;
                position: relative;
                transition: all 0.2s ease;
            }

                .item-select-checkbox:hover {
                    border-color: var(--accent-color);
                }

                .item-select-checkbox:checked {
                    background: var(--accent-gradient);
                    border-color: transparent;
                }

                    .item-select-checkbox:checked::after {
                        content: "";
                        position: absolute;
                        left: 50%;
                        top: 46%;
                        width: 5px;
                        height: 9px;
                        border: solid #ffffff;
                        border-width: 0 2px 2px 0;
                        transform: translate(-50%, -50%) rotate(45deg);
                    }

            .item-name {
                font-size: 19px;
                font-weight: 800;
                color: var(--text-primary);
                margin-bottom: 5px;
            }

            .item-badges {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
                margin-bottom: 8px;
            }

            .item-badge {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-size: 10.5px;
                font-weight: 800;
                padding: 4px 9px;
                border-radius: 50px;
            }

                .item-badge.best-seller {
                    background: #fff1e0;
                    color: #c2410c;
                    border: 1px solid #fed7aa;
                }

                .item-badge.low-stock {
                    background: #fee2e2;
                    color: var(--error-color);
                    border: 1px solid #ffd1cc;
                }

            .item-store {
                color: var(--text-secondary);
                font-size: 13px;
                margin-bottom: 8px;
                font-weight: 600;
            }

            .item-price {
                color: var(--accent-color);
                font-weight: 800;
                font-size: 18px;
                margin-bottom: 12px;
            }

            .item-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
                align-items: center;
            }

            .qty-form {
                display: flex;
                gap: 8px;
                align-items: center;
            }

            .qty-input {
                width: 75px;
                padding: 8px 12px;
                border-radius: 50px;
                border: 1px solid var(--border-color);
                font-weight: 700;
                background: var(--bg-color);
                font-family: var(--font-family);
                color: var(--accent-color);
                outline: none;
                text-align: center;
                transition: all 0.2s ease;
            }

                .qty-input:focus {
                    border-color: var(--accent-color);
                    background: #ffffff;
                }

            /* REMOVE ITEM — a round trash-bin icon button instead of text */
            .remove-btn {
                background: #fff5f5;
                color: var(--like-color);
                border: 1px solid #ffd1cc;
                border-radius: 50%;
                width: 38px;
                height: 38px;
                padding: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-size: 15px;
                transition: all 0.2s ease;
            }

                .remove-btn:hover {
                    background: var(--like-color);
                    color: #ffffff;
                    border-color: var(--like-color);
                }

            /* ============================================================
                                           STICKY BOTTOM CHECKOUT BAR — sits above the bottom nav.
                                           Shows a live preview of the selection and opens the order
                                           summary bottom-sheet when tapped.
                                           ============================================================ */
            .cart-checkout-bar {
                position: fixed;
                left: 50%;
                transform: translateX(-50%);
                width: calc(100% - (var(--content-side-padding) * 2));
                max-width: var(--content-max-width);
                bottom: calc(var(--bottom-nav-height) + 10px);
                z-index: 190;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                background: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 12px 18px;
                box-shadow: var(--shadow-lg);
            }

            .checkout-bar-info {
                display: flex;
                flex-direction: column;
                gap: 2px;
                min-width: 0;
            }

            .checkout-bar-items {
                font-size: 11px;
                font-weight: 700;
                color: var(--text-secondary);
                white-space: nowrap;
            }

            .checkout-bar-total {
                font-size: 18px;
                font-weight: 800;
                color: var(--text-primary);
                white-space: nowrap;
            }

            .checkout-bar-btn {
                flex-shrink: 0;
                padding: 14px 32px;
                background: var(--accent-gradient);
                color: #ffffff;
                border: none;
                border-radius: 50px;
                font-family: var(--font-family);
                font-weight: 800;
                font-size: 15px;
                cursor: pointer;
                box-shadow: 0 12px 28px rgba(109, 40, 217, 0.35);
                transition: all 0.25s ease;
            }

                .checkout-bar-btn:hover {
                    opacity: 0.96;
                    transform: translateY(-2px);
                    box-shadow: 0 16px 32px rgba(109, 40, 217, 0.42);
                }

                .checkout-bar-btn:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                    box-shadow: none;
                    transform: none;
                }

            /* SUMMARY CONTENT (now lives inside the order-summary bottom sheet) */
            .summary-row {
                display: flex;
                justify-content: space-between;
                gap: 15px;
                margin-bottom: 12px;
                color: var(--text-secondary);
                font-weight: 600;
                font-size: 14px;
            }

            .summary-note {
                background: #fff7ed;
                border: 1px solid #fed7aa;
                color: #9a3412;
                padding: 12px;
                border-radius: 12px;
                font-size: 12px;
                font-weight: 700;
                margin: 12px 0;
                line-height: 1.5;
            }

            .summary-free {
                background: #dcfce7;
                border: 1px solid #86efac;
                color: #166534;
                padding: 12px;
                border-radius: 12px;
                font-size: 12px;
                font-weight: 700;
                margin: 12px 0;
                line-height: 1.5;
            }

            .summary-selection-note {
                background: var(--accent-light);
                border: 1px solid var(--border-color);
                color: var(--text-secondary);
                padding: 12px;
                border-radius: 12px;
                font-size: 12px;
                font-weight: 700;
                margin: 0 0 16px;
                line-height: 1.5;
            }

            .summary-total {
                display: flex;
                justify-content: space-between;
                gap: 15px;
                border-top: 1px solid var(--border-color);
                padding-top: 15px;
                margin-top: 15px;
                color: var(--text-primary);
                font-size: 22px;
                font-weight: 800;
            }

            /* COUPONS & PAYMENT */
            .coupon-form {
                margin: 15px 0;
            }

            .coupon-label,
            .payment-label {
                display: block;
                margin-bottom: 8px;
                font-size: 13px;
                font-weight: 800;
                color: var(--text-primary);
            }

            .coupon-row {
                display: flex;
                gap: 8px;
            }

            .coupon-input {
                flex: 1;
                min-width: 0;
                padding: 10px 16px;
                border: 1px solid var(--border-color);
                border-radius: 50px;
                font-weight: 700;
                font-family: var(--font-family);
                background: var(--bg-color);
                outline: none;
                transition: all 0.2s ease;
            }

                .coupon-input:focus {
                    border-color: var(--accent-color);
                    background: #ffffff;
                }

            .coupon-btn {
                background: var(--accent-color);
                color: white;
                border: none;
                border-radius: 50px;
                padding: 10px 18px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .coupon-btn:hover {
                    background: var(--accent-hover);
                }

            .remove-coupon-btn {
                width: 100%;
                margin-bottom: 10px;
                padding: 10px;
                background: #fff5f5;
                color: var(--like-color);
                border: 1px solid #ffd1cc;
                border-radius: 50px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .remove-coupon-btn:hover {
                    background: #ffe3e1;
                    border-color: var(--like-color);
                }

            .discount-row {
                color: var(--success-color);
            }

            .payment-section {
                margin-top: 15px;
            }

            .payment-select {
                width: 100%;
                padding: 12px;
                border-radius: 12px;
                border: 1px solid var(--border-color);
                font-weight: 700;
                background: white;
                font-family: var(--font-family);
                outline: none;
                transition: all 0.2s ease;
            }

                .payment-select:focus {
                    border-color: var(--accent-color);
                }

            .payment-note {
                margin-top: 10px;
                padding: 12px;
                background: var(--accent-light);
                color: var(--text-secondary);
                border-radius: 12px;
                font-size: 12px;
                font-weight: 700;
                line-height: 1.5;
            }

            .checkout-btn {
                width: 100%;
                margin-top: 20px;
                padding: 14px;
                background: var(--accent-gradient);
                color: white;
                border: none;
                border-radius: 50px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.25s ease;
                box-shadow: 0 4px 12px rgba(109, 40, 217, 0.25);
            }

                .checkout-btn:hover {
                    opacity: 0.95;
                    box-shadow: 0 6px 15px rgba(109, 40, 217, 0.35);
                    transform: translateY(-1px);
                }

                .checkout-btn:disabled {
                    opacity: 0.65;
                    cursor: not-allowed;
                    box-shadow: none;
                    transform: none;
                }

            /* EMPTY STATE STYLE */
            .empty-cart {
                max-width: 700px;
                margin: 40px auto;
                background: var(--card-bg);
                text-align: center;
                color: var(--text-secondary);
                padding: 60px 40px;
                border-radius: 20px;
                border: 2px dashed #ded4f5;
                box-shadow: var(--shadow-sm);
            }

                .empty-cart h3 {
                    color: var(--text-primary);
                    font-size: 22px;
                    font-weight: 800;
                    margin-bottom: 10px;
                }

            .shop-link {
                display: inline-block;
                margin-top: 20px;
                background: var(--accent-gradient);
                color: white;
                padding: 12px 28px;
                border-radius: 50px;
                text-decoration: none;
                font-weight: 800;
                box-shadow: 0 4px 12px rgba(109, 40, 217, 0.25);
                transition: all 0.25s ease;
            }

                .shop-link:hover {
                    opacity: 0.95;
                    box-shadow: 0 6px 15px rgba(109, 40, 217, 0.35);
                }

            /* =====================================================
                                                   TOAST NOTIFICATIONS
                                                   ===================================================== */
            .toast-container {
                position: fixed;
                top: 24px;
                right: 24px;
                z-index: 30000;
                display: flex;
                flex-direction: column;
                gap: 12px;
                pointer-events: none;
            }

            .app-toast {
                width: min(390px, calc(100vw - 40px));
                padding: 16px 20px;
                border-radius: 14px;
                background: var(--card-bg);
                display: flex;
                align-items: flex-start;
                gap: 12px;
                box-shadow: 0 15px 35px rgba(30, 27, 46, 0.12);
                opacity: 0;
                transform: translateX(45px);
                transition: opacity 0.3s ease, transform 0.3s ease;
                pointer-events: auto;
                border-left: 5px solid var(--border-color);
            }

                .app-toast.show {
                    opacity: 1;
                    transform: translateX(0);
                }

                .app-toast.success {
                    border-left-color: var(--success-color);
                    color: var(--text-primary);
                }

                    .app-toast.success .toast-icon {
                        background: #e6f7f0;
                        color: var(--success-color);
                    }

                .app-toast.error {
                    border-left-color: var(--error-color);
                    color: var(--text-primary);
                }

                    .app-toast.error .toast-icon {
                        background: #fee2e2;
                        color: var(--error-color);
                    }

            .toast-icon {
                width: 28px;
                height: 28px;
                flex: 0 0 28px;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                font-weight: 800;
            }

            .toast-content {
                flex: 1;
            }

            .toast-title {
                display: block;
                margin-bottom: 3px;
                font-weight: 800;
                color: var(--text-primary);
            }

            .toast-message {
                display: block;
                font-size: 13px;
                font-weight: 600;
                line-height: 1.45;
                color: var(--text-secondary);
            }

            .toast-close {
                border: none;
                background: transparent;
                color: var(--text-secondary);
                padding: 0;
                font-size: 22px;
                cursor: pointer;
                line-height: 1;
                transition: color 0.15s ease;
            }

                .toast-close:hover {
                    color: var(--text-primary);
                }

            /* =====================================================
                                                   CUSTOM MODALS
                                                   ===================================================== */
            .app-modal {
                position: fixed;
                inset: 0;
                z-index: 20000;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
                background: rgba(30, 27, 46, 0.6);
                backdrop-filter: blur(5px);
            }

                .app-modal.open {
                    display: flex;
                }

            .modal-card {
                width: min(440px, 100%);
                background: var(--card-bg);
                border-radius: 20px;
                padding: 30px;
                box-shadow: var(--shadow-lg);
                transform: translateY(15px) scale(0.98);
                opacity: 0;
                transition: 0.2s ease;
                border: 1px solid var(--border-color);
            }

            .app-modal.open .modal-card {
                transform: translateY(0) scale(1);
                opacity: 1;
            }

            /* Order Summary sheet gets its own scroll area and, on
                       mobile, behaves like a bottom sheet sliding up from the
                       edge of the screen — closer to the real Shein checkout
                       flow than a centered dialog. */
            .order-summary-modal .modal-card {
                max-height: 88vh;
                overflow-y: auto;
            }

            @@media (max-width: 768px) {
                .order-summary-modal {
                    align-items: flex-end;
                    padding: 0;
                }

                    .order-summary-modal .modal-card {
                        width: 100%;
                        max-width: 100%;
                        border-radius: 24px 24px 0 0;
                        max-height: 92vh;
                        transform: translateY(30px);
                    }

                    .order-summary-modal.open .modal-card {
                        transform: translateY(0);
                    }
            }

            .modal-icon {
                width: 58px;
                height: 58px;
                margin: 0 auto 15px;
                border-radius: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 27px;
                background: var(--accent-light);
                color: var(--accent-color);
            }

                .modal-icon.danger {
                    background: #fee2e2;
                    color: var(--error-color);
                }

            .modal-title {
                margin: 0 0 8px;
                text-align: center;
                color: var(--text-primary);
                font-size: 23px;
                font-weight: 800;
            }

            .modal-description {
                margin: 0 0 20px;
                text-align: center;
                color: var(--text-secondary);
                font-size: 14px;
                line-height: 1.55;
            }

            .modal-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-top: 20px;
            }

            .modal-cancel,
            .modal-confirm,
            .modal-danger {
                border: none;
                border-radius: 50px;
                padding: 12px 16px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.2s ease;
            }

            .modal-cancel {
                background: #f1eef8;
                border: 1px solid var(--border-color);
                color: var(--text-secondary);
            }

            .modal-confirm {
                background: var(--accent-gradient);
                color: white;
            }

            .modal-danger {
                background: var(--error-color);
                color: white;
            }

            .modal-cancel:hover {
                background: #e7e1f5;
                color: var(--text-primary);
            }

            .modal-confirm:hover {
                opacity: 0.95;
            }

            .modal-danger:hover {
                background: #b91c1c;
            }

            .modal-confirm:disabled,
            .modal-danger:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }

            @@media (max-width: 550px) {
                .cart-page {
                    padding: 20px 12px 16px;
                }

                .cart-item {
                    grid-template-columns: 26px 1fr;
                    grid-template-rows: auto auto;
                }

                    .cart-item .item-select-wrap {
                        grid-row: 1 / 3;
                    }

                    .cart-item img {
                        grid-column: 2;
                        grid-row: 1;
                        width: 100%;
                        height: 190px;
                    }

                    .cart-item > div:last-child {
                        grid-column: 2;
                        grid-row: 2;
                    }

                .coupon-row {
                    flex-direction: column;
                }

                .coupon-btn {
                    width: 100%;
                }

                .modal-actions {
                    grid-template-columns: 1fr;
                }

                .toast-container {
                    top: 15px;
                    right: 15px;
                    left: 15px;
                }

                .app-toast {
                    width: 100%;
                }

                .checkout-bar-btn {
                    padding: 12px 22px;
                    font-size: 14px;
                }

                .checkout-bar-total {
                    font-size: 16px;
                }

                .shein-nav-item {
                    min-width: 130px;
                    padding: 13px 18px;
                    font-size: 13px;
                }
            }
    </style>
</head>

<body>

    <!-- =====================================================
         SUCCESS AND ERROR TOASTERS
         ===================================================== -->
    <div id="toastContainer"
         class="toast-container"
         aria-live="polite"
         aria-atomic="true">

        @if (TempData["Success"] is string successMessage &&
        !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="app-toast success" data-toast>
                <span class="toast-icon">✓</span>

                <div class="toast-content">
                    <span class="toast-title">
                        Success
                    </span>

                    <span class="toast-message">
                        @successMessage
                    </span>
                </div>

                <button type="button"
                        class="toast-close"
                        aria-label="Close notification">
                    &times;
                </button>
            </div>
        }

        @if (TempData["Error"] is string errorMessage &&
        !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="app-toast error" data-toast>
                <span class="toast-icon">!</span>

                <div class="toast-content">
                    <span class="toast-title">
                        Unable to continue
                    </span>

                    <span class="toast-message">
                        @errorMessage
                    </span>
                </div>

                <button type="button"
                        class="toast-close"
                        aria-label="Close notification">
                    &times;
                </button>
            </div>
        }
    </div>

    <partial name="_CustomerBottomNav" />

    <div class="cart-page">

        <!-- HEADER — above the filter chips -->
        <div class="cart-header">
            <h2>🛒 Your Cart</h2>

            <p>
                Select the items you'd like to checkout.
            </p>
        </div>

        <!-- FILTER CHIPS — below the header. Client-side only,
             filters which cart rows are visible, never navigates. -->
        <nav class="shein-navbar" aria-label="Filter cart items">
            <button type="button"
                    class="shein-nav-item active"
                    data-filter="all">
                <i class="fa-solid fa-layer-group"></i>
                <span>All Products</span>
            </button>

            <button type="button"
                    class="shein-nav-item"
                    data-filter="lowstock">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>Almost Out of Stock</span>
            </button>

            <button type="button"
                    class="shein-nav-item"
                    data-filter="bestselling">
                <i class="fa-solid fa-fire"></i>
                <span>Best Selling</span>
            </button>
        </nav>

        @if (Model.CartItems == null ||
        !Model.CartItems.Any())
        {
            <div class="empty-cart">
                <h3>Your cart is empty</h3>

                <p>
                    Add products to your cart before checkout.
                </p>

                <a href="/CustomerProducts"
                   class="shop-link">
                    Continue Shopping
                </a>
            </div>
        }
        else
        {
            <div class="cart-container">

                <!-- =================================================
                     CART ITEMS — full-width, takes up the page
                     ================================================= -->
                <div class="cart-list">

                    <!-- SELECT ALL / BULK REMOVE ROW -->
                    <div class="cart-select-all-row">
                        <label class="cart-checkbox-wrap">
                            <input type="checkbox"
                                   id="selectAllCheckbox"
                                   class="cart-checkbox"
                                   checked />
                            <span>
                                Select All
                                (<span id="selectAllCount">@Model.CartItems.Count/@Model.CartItems.Count</span>)
                            </span>
                        </label>

                        <button type="button"
                                id="removeSelectedBtn"
                                class="remove-selected-btn">
                            <i class="fa-solid fa-trash-can"></i>
                            Remove Selected
                        </button>
                    </div>

                    <div id="cartFilterEmptyMessage"
                         class="cart-filter-empty">
                        No items in your cart match this filter.
                    </div>

                    @foreach (var item in Model.CartItems)
                    {
                        var removeFormId =
                        $"removeForm-{item.CartItemID}";

                        <div class="cart-item"
                             data-cart-item-id="@item.CartItemID"
                             data-quantity="@item.Quantity"
                             data-unit-price="@item.UnitPrice.ToString("F2")"
                             data-available-stock="@item.AvailableStock"
                             data-low-stock="@item.IsAlmostOutOfStock.ToString().ToLowerInvariant()"
                             data-best-seller="@item.IsBestSeller.ToString().ToLowerInvariant()">

                            <label class="item-select-wrap">
                                <input type="checkbox"
                                       class="item-select-checkbox"
                                       data-cart-item-id="@item.CartItemID"
                                       aria-label="Select @item.ProductName for checkout"
                                       checked />
                            </label>

                            <img src="@item.ImageUrl"
                                 alt="@item.ProductName"
                                 onerror="this.onerror=null;this.src='/images/no-image.png';" />

                            <div>
                                <div class="item-name">
                                    @item.ProductName
                                </div>

                                @if (item.IsBestSeller || item.IsAlmostOutOfStock)
                                {
                                    <div class="item-badges">
                                        @if (item.IsBestSeller)
                                        {
                                            <span class="item-badge best-seller">
                                                <i class="fa-solid fa-fire"></i> Best Seller
                                            </span>
                                        }

                                        @if (item.IsAlmostOutOfStock)
                                        {
                                            <span class="item-badge low-stock">
                                                <i class="fa-solid fa-triangle-exclamation"></i> Almost Gone
                                            </span>
                                        }
                                    </div>
                                }

                                <div class="item-store">
                                    Store: @item.StoreName
                                </div>

                                <div class="item-price">
                                    $@item.UnitPrice.ToString("N2") each
                                </div>

                                <div class="item-actions">

                                    <!-- UPDATE QUANTITY (auto-saves on change, no Update button) -->
                                    <form method="post"
                                          asp-page-handler="UpdateQuantity"
                                          class="qty-form auto-update-qty-form"
                                          data-cart-item-id="@item.CartItemID">

                                        <input type="hidden"
                                               name="cartItemId"
                                               value="@item.CartItemID" />

                                        <input type="hidden"
                                               name="AppliedCouponCode"
                                               value="@Model.AppliedCouponCode" />

                                        <input type="number"
                                               name="quantity"
                                               value="@item.Quantity"
                                               min="1"
                                               max="@item.AvailableStock"
                                               class="qty-input auto-update-qty-input" />
                                    </form>

                                    <!-- REMOVE ITEM (trash-bin icon) -->
                                    <form id="@removeFormId"
                                          method="post"
                                          asp-page-handler="Remove">

                                        <input type="hidden"
                                               name="cartItemId"
                                               value="@item.CartItemID" />

                                        <input type="hidden"
                                               name="AppliedCouponCode"
                                               value="@Model.AppliedCouponCode" />

                                        <button type="button"
                                                class="remove-btn remove-trigger"
                                                data-form-id="@removeFormId"
                                                data-product-name="@item.ProductName"
                                                aria-label="Remove @item.ProductName from cart"
                                                title="Remove item">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>

                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>

            <!-- =================================================
                 FLOATING CHECKOUT ROW — info text and button sit
                 side by side, no white panel/card behind them.
                 ================================================= -->
            <div class="cart-checkout-bar" id="cartCheckoutBar">
                <div class="checkout-bar-info">
                    <span class="checkout-bar-items" id="stickyItemsLabel">
                        0 items selected
                    </span>

                    <span class="checkout-bar-total" id="stickyGrandTotal">
                        $0.00
                    </span>
                </div>

                <button type="button"
                        id="openCheckoutModalButton"
                        class="checkout-bar-btn">
                    Checkout
                </button>
            </div>
        }
    </div>

    <!-- =====================================================
         ORDER SUMMARY BOTTOM SHEET (opened by the Checkout bar)
         ===================================================== -->
    <div id="checkoutModal"
         class="app-modal order-summary-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="checkoutModalTitle"
         aria-hidden="true">

        <div class="modal-card">

            <div class="modal-icon">
                🛒
            </div>

            <h3 id="checkoutModalTitle"
                class="modal-title">
                Order Summary
            </h3>

            <p class="modal-description">
                Review your order before placing it.
            </p>

            <div class="summary-selection-note">
                Totals reflect only the items you've selected
                for checkout.
            </div>

            <div class="summary-row">
                <span>Items</span>

                <span id="summaryItemsCount">
                    @Model.CartItems.Sum(item => item.Quantity)
                </span>
            </div>

            <div class="summary-row">
                <span>Subtotal</span>

                <span id="summarySubtotal">
                    $@Model.TotalAmount.ToString("N2")
                </span>
            </div>

            <!-- APPLY COUPON -->
            <form method="post"
                  asp-page-handler="ApplyCoupon"
                  class="coupon-form">

                <label class="coupon-label">
                    Coupon Code
                </label>

                <div class="coupon-row">

                    <input type="text"
                           name="couponCode"
                           value="@Model.AppliedCouponCode"
                           placeholder="Enter coupon code"
                           class="coupon-input" />

                    <button type="submit"
                            class="coupon-btn">
                        Apply
                    </button>
                </div>
            </form>

            <!-- REMOVE COUPON -->
            @if (!string.IsNullOrWhiteSpace(
           Model.AppliedCouponCode))
            {
                <form method="post"
                      asp-page-handler="RemoveCoupon">

                    <button type="submit"
                            class="remove-coupon-btn">
                        Remove Coupon
                    </button>
                </form>
            }

            <!-- COUPON MESSAGE -->
            <div class="summary-free"
                 id="summaryCouponMessage"
                 style="display:@(!string.IsNullOrWhiteSpace(Model.CouponMessage) ? "block" : "none")">
                @Model.CouponMessage
            </div>

            <!-- DISCOUNT -->
            <div class="summary-row discount-row"
                 id="summaryDiscountRow"
                 style="display:@(Model.DiscountAmount > 0 ? "flex" : "none")">
                <span>Discount</span>

                <span id="summaryDiscountAmount">
                    -$@Model.DiscountAmount.ToString("N2")
                </span>
            </div>

            <!-- DELIVERY FEE -->
            @if (Model.HasActiveAddress)
            {
                <div class="summary-row">
                    <span>Delivery Fee</span>

                    <span id="summaryDeliveryFee">
                        $@Model.EstimatedDeliveryFee.ToString("N2")
                    </span>
                </div>

                <div class="summary-free"
                     id="summaryFreeDeliveryBanner"
                     style="display:@(Model.TotalAmount > 50 ? "block" : "none")">
                    Free delivery applied because your
                    subtotal is above $50.
                </div>
            }
            else
            {
                <div class="summary-note">
                    Add a delivery address to calculate
                    the delivery fee.
                </div>
            }

            <!-- GRAND TOTAL -->
            <div class="summary-total">
                <span>Total</span>

                <span id="summaryGrandTotal">
                    $@Model.GrandTotal.ToString("N2")
                </span>
            </div>

            <!-- CHECKOUT FORM -->
            <form id="checkoutForm"
                  method="post"
                  asp-page-handler="Checkout">

                <input type="hidden"
                       name="appliedCouponCode"
                       value="@Model.AppliedCouponCode" />

                <!-- Populated by JS with the comma-separated
                     CartItemIDs the customer has checked. -->
                <input type="hidden"
                       name="selectedCartItemIds"
                       id="selectedCartItemIdsInput"
                       value="" />

                <div class="payment-section">

                    <label for="paymentMethodSelect"
                           class="payment-label">
                        Payment Method
                    </label>

                    <select id="paymentMethodSelect"
                            name="paymentMethod"
                            class="payment-select">

                        <option value="Cash On Delivery">
                            Cash On Delivery
                        </option>

                        <option value="Online Payment">
                            Online Payment
                        </option>
                    </select>

                    <div class="payment-note">
                        Online payment is simulated for demo.
                        Cash on Delivery will be marked as paid
                        when the order is delivered.
                    </div>
                </div>
            </form>

            <div class="modal-actions">

                <button id="cancelCheckoutButton"
                        type="button"
                        class="modal-cancel">
                    Cancel
                </button>

                <button id="confirmCheckoutButton"
                        type="button"
                        class="modal-confirm">
                    Place Order
                </button>
            </div>
        </div>
    </div>

    <!-- =====================================================
         REMOVE ITEM CONFIRMATION MODAL
         ===================================================== -->
    <div id="removeModal"
         class="app-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="removeModalTitle"
         aria-hidden="true">

        <div class="modal-card">

            <div class="modal-icon danger">
                🗑
            </div>

            <h3 id="removeModalTitle"
                class="modal-title">
                Remove Item?
            </h3>

            <p id="removeModalDescription"
               class="modal-description">
                Are you sure you want to remove this item
                from your cart?
            </p>

            <div class="modal-actions">

                <button id="cancelRemoveButton"
                        type="button"
                        class="modal-cancel">
                    Cancel
                </button>

                <button id="confirmRemoveButton"
                        type="button"
                        class="modal-danger">
                    Remove Item
                </button>
            </div>
        </div>
    </div>

    <script>
            document.addEventListener(
                "DOMContentLoaded",
                function() {
                    initializeToasts();
                    initializeCheckoutModal();
                    initializeRemoveModal();
                    initializeAutoUpdateQuantity();
                    initializeItemSelection();
                    initializeRemoveSelectedButton();
                    initializeCartFilterTabs();
                });

            // =====================================================
            // TOASTS
            // =====================================================
            function initializeToasts() {
                const toasts =
                    document.querySelectorAll("[data-toast]");

                toasts.forEach(function(toast, index) {
                    window.setTimeout(function() {
                        toast.classList.add("show");
                    }, 100 + (index * 100));

                    const closeButton =
                        toast.querySelector(".toast-close");

                    if (closeButton) {
                        closeButton.addEventListener(
                            "click",
                            function() {
                                removeToast(toast);
                            });
                    }

                    window.setTimeout(function() {
                        removeToast(toast);
                    }, 5000 + (index * 300));
                });
            }

            function removeToast(toast) {
                if (!toast || !toast.isConnected) {
                    return;
                }

                toast.classList.remove("show");

                window.setTimeout(function() {
                    toast.remove();
                }, 300);
            }

            // =====================================================
            // SHARED MODAL FUNCTIONS
            // =====================================================
            function openModal(modal) {
                if (!modal) {
                    return;
                }

                modal.classList.add("open");
                modal.setAttribute("aria-hidden", "false");

                document.body.classList.add("modal-open");
            }

            function closeModal(modal) {
                if (!modal) {
                    return;
                }

                modal.classList.remove("open");
                modal.setAttribute("aria-hidden", "true");

                if (!document.querySelector(".app-modal.open")) {
                    document.body.classList.remove("modal-open");
                }
            }

            // =====================================================
            // TOP FILTER CHIPS (All Products / Almost Out of Stock /
            // Best Selling) — Instagram-style tabs that only change
            // which cart rows are VISIBLE. They never change which
            // rows are SELECTED for checkout.
            // =====================================================
            function initializeCartFilterTabs() {
                const tabs =
                    document.querySelectorAll(
                        ".shein-nav-item[data-filter]");

                if (!tabs.length) {
                    return;
                }

                tabs.forEach(function(tab) {
                    tab.addEventListener(
                        "click",
                        function() {
                            tabs.forEach(function(otherTab) {
                                otherTab.classList.remove("active");
                            });

                            tab.classList.add("active");

                            applyCartFilter(tab.dataset.filter);
                        });
                });

                // Show everything by default.
                applyCartFilter("all");
            }

            function applyCartFilter(filter) {
                const cartItems =
                    document.querySelectorAll(
                        ".cart-list .cart-item");

                let visibleCount = 0;

                cartItems.forEach(function(cartItemEl) {
                    let matchesFilter = true;

                    if (filter === "lowstock") {
                        matchesFilter =
                            cartItemEl.dataset.lowStock === "true";
                    } else if (filter === "bestselling") {
                        matchesFilter =
                            cartItemEl.dataset.bestSeller === "true";
                    }

                    cartItemEl.style.display =
                        matchesFilter ? "" : "none";

                    if (matchesFilter) {
                        visibleCount += 1;
                    }
                });

                const emptyMessage =
                    document.getElementById(
                        "cartFilterEmptyMessage");

                if (emptyMessage) {
                    emptyMessage.style.display =
                        visibleCount === 0 ? "block" : "none";
                }
            }

            // =====================================================
            // ITEM SELECTION (Shein-style "pick what to checkout")
            // =====================================================
            function getItemCheckboxes() {
                return Array.from(
                    document.querySelectorAll(".item-select-checkbox"));
            }

            function initializeItemSelection() {
                const checkboxes = getItemCheckboxes();
                const selectAllCheckbox =
                    document.getElementById("selectAllCheckbox");

                checkboxes.forEach(function(checkbox) {
                    checkbox.addEventListener(
                        "change",
                        updateSelectedSummary);
                });

                if (selectAllCheckbox) {
                    selectAllCheckbox.addEventListener(
                        "change",
                        function() {
                            checkboxes.forEach(function(checkbox) {
                                checkbox.checked =
                                    selectAllCheckbox.checked;
                            });

                            updateSelectedSummary();
                        });
                }

                updateSelectedSummary();
            }

            function updateSelectedSummary() {
                const checkboxes = getItemCheckboxes();

                let itemsCount = 0;
                let subtotal = 0;
                let anySelected = false;

                checkboxes.forEach(function(checkbox) {
                    const cartItemEl =
                        checkbox.closest(".cart-item");

                    if (!cartItemEl) {
                        return;
                    }

                    const quantity =
                        parseInt(
                            cartItemEl.dataset.quantity || "0",
                            10);

                    const unitPrice =
                        parseFloat(
                            cartItemEl.dataset.unitPrice || "0");

                    if (checkbox.checked) {
                        anySelected = true;
                        itemsCount += quantity;
                        subtotal += quantity * unitPrice;
                    }
                });

                setText("summaryItemsCount", itemsCount);
                setText("summarySubtotal", "$" + formatMoney(subtotal));

                // Delivery fee / discount are cart-wide server values;
                // we reuse whatever is currently displayed to estimate
                // a grand total for the SELECTED items only. The
                // authoritative total is recalculated server-side from
                // the selected items when "Place Order" is pressed.
                const deliveryFeeEl =
                    document.getElementById("summaryDeliveryFee");

                const discountEl =
                    document.getElementById("summaryDiscountAmount");

                const deliveryFee =
                    deliveryFeeEl
                        ? (parseFloat(
                            deliveryFeeEl.textContent.replace("$", "")) || 0)
                        : 0;

                const discount =
                    discountEl
                        ? (parseFloat(
                            discountEl.textContent.replace(/[-$]/g, "")) || 0)
                        : 0;

                const estimatedGrandTotal =
                    Math.max(subtotal + deliveryFee - discount, 0);

                setText(
                    "summaryGrandTotal",
                    "$" + formatMoney(estimatedGrandTotal));

                // Mirror the same numbers into the sticky bottom bar.
                const selectedCount = checkboxes.filter(
                    function(checkbox) {
                        return checkbox.checked;
                    }).length;

                setText(
                    "stickyItemsLabel",
                    selectedCount === 1
                        ? "1 item"
                        : selectedCount + " items");

                setText(
                    "stickyGrandTotal",
                    "$" + formatMoney(estimatedGrandTotal));

                const selectedIds = checkboxes
                    .filter(function(checkbox) {
                        return checkbox.checked;
                    })
                    .map(function(checkbox) {
                        return checkbox.dataset.cartItemId;
                    })
                    .join(",");

                const hiddenIdsInput =
                    document.getElementById(
                        "selectedCartItemIdsInput");

                if (hiddenIdsInput) {
                    hiddenIdsInput.value = selectedIds;
                }

                const openCheckoutBtn =
                    document.getElementById(
                        "openCheckoutModalButton");

                if (openCheckoutBtn) {
                    openCheckoutBtn.disabled = !anySelected;
                }

                const removeSelectedBtn =
                    document.getElementById("removeSelectedBtn");

                if (removeSelectedBtn) {
                    removeSelectedBtn.classList.toggle(
                        "visible",
                        anySelected);

                    removeSelectedBtn.disabled = !anySelected;
                }

                const selectAllCheckbox =
                    document.getElementById("selectAllCheckbox");

                if (selectAllCheckbox) {
                    selectAllCheckbox.checked =
                        checkboxes.length > 0 &&
                        checkboxes.every(function(checkbox) {
                            return checkbox.checked;
                        });
                }

                const selectAllCountEl =
                    document.getElementById("selectAllCount");

                if (selectAllCountEl) {
                    selectAllCountEl.textContent =
                        selectedCount + "/" + checkboxes.length;
                }
            }

            // =====================================================
            // REMOVE SELECTED (bulk trash action)
            // =====================================================
            function initializeRemoveSelectedButton() {
                const removeSelectedBtn =
                    document.getElementById("removeSelectedBtn");

                if (!removeSelectedBtn) {
                    return;
                }

                removeSelectedBtn.addEventListener(
                    "click",
                    function() {
                        const selectedIds = getItemCheckboxes()
                            .filter(function(checkbox) {
                                return checkbox.checked;
                            })
                            .map(function(checkbox) {
                                return checkbox.dataset.cartItemId;
                            });

                        if (selectedIds.length === 0) {
                            return;
                        }

                        const confirmed = window.confirm(
                            "Remove " + selectedIds.length +
                            " selected item(s) from your cart?");

                        if (!confirmed) {
                            return;
                        }

                        removeSelectedBtn.disabled = true;

                        removeSelectedBtn.innerHTML =
                            "<i class=\"fa-solid fa-spinner fa-spin\">" +
                            "</i> Removing...";

                        const requests = selectedIds.map(
                            function(id) {
                                const form =
                                    document.getElementById(
                                        "removeForm-" + id);

                                if (!form) {
                                    return Promise.resolve();
                                }

                                const formData = new FormData(form);

                                return fetch(form.action, {
                                    method: "POST",
                                    headers: {
                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    },
                                    body: formData
                                });
                            });

                        Promise.all(requests).finally(
                            function() {
                                window.location.reload();
                            });
                    });
            }

            // =====================================================
            // ORDER SUMMARY BOTTOM SHEET (opened from the sticky bar)
            // =====================================================
            function initializeCheckoutModal() {
                const modal =
                    document.getElementById("checkoutModal");

                const checkoutForm =
                    document.getElementById("checkoutForm");

                const openButton =
                    document.getElementById(
                        "openCheckoutModalButton");

                const cancelButton =
                    document.getElementById(
                        "cancelCheckoutButton");

                const confirmButton =
                    document.getElementById(
                        "confirmCheckoutButton");

                if (!modal ||
                    !checkoutForm ||
                    !openButton ||
                    !cancelButton ||
                    !confirmButton) {
                    return;
                }

                openButton.addEventListener(
                    "click",
                    function() {
                        if (openButton.disabled) {
                            return;
                        }

                        openModal(modal);

                        cancelButton.focus();
                    });

                cancelButton.addEventListener(
                    "click",
                    function() {
                        closeModal(modal);

                        openButton.focus();
                    });

                confirmButton.addEventListener(
                    "click",
                    function() {
                        confirmButton.disabled = true;

                        confirmButton.textContent =
                            "Placing Order...";

                        checkoutForm.requestSubmit();
                    });

                modal.addEventListener(
                    "click",
                    function(event) {
                        if (event.target === modal) {
                            closeModal(modal);
                        }
                    });
            }

            // =====================================================
            // REMOVE ITEM MODAL
            // =====================================================
            function initializeRemoveModal() {
                const modal =
                    document.getElementById("removeModal");

                const description =
                    document.getElementById(
                        "removeModalDescription");

                const cancelButton =
                    document.getElementById(
                        "cancelRemoveButton");

                const confirmButton =
                    document.getElementById(
                        "confirmRemoveButton");

                const removeButtons =
                    document.querySelectorAll(
                        ".remove-trigger");

                if (!modal ||
                    !description ||
                    !cancelButton ||
                    !confirmButton) {
                    return;
                }

                let pendingRemoveForm = null;
                let lastRemoveButton = null;

                removeButtons.forEach(function(button) {
                    button.addEventListener(
                        "click",
                        function() {
                            const formId =
                                button.dataset.formId;

                            const productName =
                                button.dataset.productName ||
                                "this item";

                            pendingRemoveForm =
                                document.getElementById(formId);

                            lastRemoveButton =
                                button;

                            description.textContent =
                                `Are you sure you want to remove ` +
                                `"${productName}" from your cart?`;

                            openModal(modal);

                            cancelButton.focus();
                        });
                });

                cancelButton.addEventListener(
                    "click",
                    function() {
                        pendingRemoveForm = null;

                        closeModal(modal);

                        if (lastRemoveButton) {
                            lastRemoveButton.focus();
                        }
                    });

                confirmButton.addEventListener(
                    "click",
                    function() {
                        if (!pendingRemoveForm) {
                            closeModal(modal);
                            return;
                        }

                        confirmButton.disabled = true;

                        confirmButton.textContent =
                            "Removing...";

                        pendingRemoveForm.requestSubmit();
                    });

                modal.addEventListener(
                    "click",
                    function(event) {
                        if (event.target === modal) {
                            pendingRemoveForm = null;

                            closeModal(modal);
                        }
                    });
            }

            // =====================================================
            // AUTO-UPDATE QUANTITY (no Update button)
            // Reuses the exact same UpdateQuantity page handler that
            // used to be triggered by the Update button - it is now
            // triggered automatically whenever the quantity changes,
            // via fetch instead of a full-page form submit.
            // =====================================================
            function initializeAutoUpdateQuantity() {
                const forms =
                    document.querySelectorAll(
                        ".auto-update-qty-form");

                forms.forEach(function(form) {
                    const input =
                        form.querySelector(
                            ".auto-update-qty-input");

                    if (!input) {
                        return;
                    }

                    let lastSentValue = input.value;
                    let isSubmitting = false;
                    let pendingRetry = false;
                    let debounceTimer = null;

                    function revert() {
                        input.value = lastSentValue;
                    }

                    function submitQuantity() {
                        const rawValue = input.value;

                        if (rawValue === lastSentValue) {
                            return;
                        }

                        const quantity =
                            parseInt(rawValue, 10);

                        const min =
                            parseInt(
                                input.getAttribute("min") || "1",
                                10);

                        const maxAttr =
                            input.getAttribute("max");

                        const max =
                            maxAttr ? parseInt(maxAttr, 10) : null;

                        if (isNaN(quantity) ||
                            quantity < min ||
                            (max !== null && quantity > max)) {
                            revert();
                            return;
                        }

                        if (isSubmitting) {
                            pendingRetry = true;
                            return;
                        }

                        isSubmitting = true;

                        const formData = new FormData(form);

                        // Pin the value we already validated in case
                        // disabling the input below would otherwise
                        // drop it from the submission (disabled form
                        // fields are excluded from FormData).
                        formData.set("quantity", String(quantity));

                        input.disabled = true;

                        fetch(form.action, {
                            method: "POST",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            body: formData
                        })
                            .then(function(response) {
                                return response.json().then(
                                    function(data) {
                                        return {
                                            ok: response.ok,
                                            data: data
                                        };
                                    });
                            })
                            .then(function(result) {
                                if (!result.data ||
                                    !result.data.success) {
                                    revert();

                                    createToast(
                                        "error",
                                        "Unable to continue",
                                        (result.data &&
                                            result.data.message) ||
                                        "Could not update the cart.");

                                    return;
                                }

                                lastSentValue = input.value;

                                applyCartSummary(result.data);

                                // Keep the checked-item quantity in
                                // sync so the Shein-style selection
                                // totals stay accurate.
                                const cartItemEl =
                                    form.closest(".cart-item");

                                if (cartItemEl &&
                                    result.data.updatedItem) {
                                    cartItemEl.dataset.quantity =
                                        result.data.updatedItem
                                            .quantity;
                                }

                                updateSelectedSummary();
                            })
                            .catch(function() {
                                revert();

                                createToast(
                                    "error",
                                    "Unable to continue",
                                    "Could not update the cart. " +
                                    "Please check your connection.");
                            })
                            .finally(function() {
                                isSubmitting = false;
                                input.disabled = false;

                                if (pendingRetry) {
                                    pendingRetry = false;
                                    submitQuantity();
                                }
                            });
                    }

                    input.addEventListener(
                        "change",
                        function() {
                            window.clearTimeout(debounceTimer);
                            submitQuantity();
                        });

                    input.addEventListener(
                        "input",
                        function() {
                            window.clearTimeout(debounceTimer);

                            debounceTimer = window.setTimeout(
                                submitQuantity,
                                600);
                        });
                });
            }

            // =====================================================
            // APPLY UPDATED ORDER SUMMARY VALUES (no page reload)
            // =====================================================
            function applyCartSummary(data) {
                setText("summaryItemsCount", data.itemsCount);

                setText(
                    "summarySubtotal",
                    "$" + formatMoney(data.totalAmount));

                const discountRow =
                    document.getElementById("summaryDiscountRow");

                if (discountRow) {
                    if (data.discountAmount > 0) {
                        discountRow.style.display = "flex";

                        setText(
                            "summaryDiscountAmount",
                            "-$" + formatMoney(data.discountAmount));
                    } else {
                        discountRow.style.display = "none";
                    }
                }

                const couponMessageEl =
                    document.getElementById("summaryCouponMessage");

                if (couponMessageEl) {
                    if (data.couponMessage) {
                        couponMessageEl.style.display = "block";
                        couponMessageEl.textContent = data.couponMessage;
                    } else {
                        couponMessageEl.style.display = "none";
                    }
                }

                if (data.hasActiveAddress) {
                    setText(
                        "summaryDeliveryFee",
                        "$" + formatMoney(data.estimatedDeliveryFee));
                }

                const freeDeliveryBanner =
                    document.getElementById(
                        "summaryFreeDeliveryBanner");

                if (freeDeliveryBanner) {
                    freeDeliveryBanner.style.display =
                        data.freeDeliveryApplied ? "block" : "none";
                }

                setText(
                    "summaryGrandTotal",
                    "$" + formatMoney(data.grandTotal));
            }

            function setText(elementId, value) {
                const element =
                    document.getElementById(elementId);

                if (element) {
                    element.textContent = value;
                }
            }

            function formatMoney(value) {
                return Number(value).toFixed(2);
            }

            // =====================================================
            // DYNAMICALLY CREATED TOAST (mirrors the server-rendered
            // toast markup/styles used by initializeToasts)
            // =====================================================
            function createToast(type, title, message) {
                const container =
                    document.getElementById("toastContainer");

                if (!container) {
                    return;
                }

                const toast = document.createElement("div");
                toast.className = "app-toast " + type;
                toast.setAttribute("data-toast", "");

                const icon = document.createElement("span");
                icon.className = "toast-icon";
                icon.textContent = type === "success" ? "✓" : "!";

                const content = document.createElement("div");
                content.className = "toast-content";

                const titleEl = document.createElement("span");
                titleEl.className = "toast-title";
                titleEl.textContent = title;

                const messageEl = document.createElement("span");
                messageEl.className = "toast-message";
                messageEl.textContent = message;

                content.appendChild(titleEl);
                content.appendChild(messageEl);

                const closeButton = document.createElement("button");
                closeButton.type = "button";
                closeButton.className = "toast-close";
                closeButton.setAttribute(
                    "aria-label",
                    "Close notification");
                closeButton.innerHTML = "&times;";

                toast.appendChild(icon);
                toast.appendChild(content);
                toast.appendChild(closeButton);

                container.appendChild(toast);

                window.setTimeout(function() {
                    toast.classList.add("show");
                }, 50);

                closeButton.addEventListener(
                    "click",
                    function() {
                        removeToast(toast);
                    });

                window.setTimeout(function() {
                    removeToast(toast);
                }, 5000);
            }

            // =====================================================
            // CLOSE MODAL WITH ESCAPE
            // =====================================================
            document.addEventListener(
                "keydown",
                function(event) {
                    if (event.key !== "Escape") {
                        return;
                    }

                    document
                        .querySelectorAll(".app-modal.open")
                        .forEach(function(modal) {
                            closeModal(modal);
                        });
                });
    </script>

</body>
</html>
