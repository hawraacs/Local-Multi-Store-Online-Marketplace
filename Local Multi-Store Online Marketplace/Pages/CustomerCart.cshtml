                        <div class="secure-checkout-note">
                            <i class="fa-solid fa-shield-halved"></i>
                            Secure checkout
                        </div>

                        <div class="trust-badges-row">
                            <div class="trust-badge">
                                <i class="fa-solid fa-shield-halved"></i>
                                Secure Payment
                            </div>

                            <div class="trust-badge">
                                <i class="fa-solid fa-truck-fast"></i>
                                Fast Delivery
                            </div>

                            <div class="trust-badge">
