                        @if (Model.HasActiveAddress)
                        {
                            <div class="summary-row">
                                <span>Shipping</span>

                                <span id="summaryDeliveryFee">
                                    $@Model.EstimatedDeliveryFee.ToString("N2")
                                </span>
