                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-storeId="@Model.StoreId"
                           asp-route-area="@Model.Area"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-feedType="@Model.FeedType"
                           asp-route-typeFilter="Reel"
                           class="legend-filter @(string.Equals(Model.TypeFilter, "Reel", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="fa-solid fa-play"></i>
                            Reel
                        </a>

                        <a asp-page="/Customer1"
                           asp-route-category="@Model.SelectedCategory"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-storeId="@Model.StoreId"
                           asp-route-area="@Model.Area"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-feedType="@Model.FeedType"
                           asp-route-typeFilter="Carousel"
                           class="legend-filter @(string.Equals(Model.TypeFilter, "Carousel", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="fa-regular fa-images"></i>
                            Carousel
                        </a>

                        <a asp-page="/Customer1"
                           asp-route-category="@Model.SelectedCategory"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-storeId="@Model.StoreId"
                           asp-route-area="@Model.Area"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-feedType="@Model.FeedType"
                           asp-route-typeFilter="Product"
                           class="legend-filter @(string.Equals(Model.TypeFilter, "Product", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="fa-solid fa-bag-shopping"></i>
                            Product
                        </a>
