    <script>
        (function () {
            var slides = document.querySelectorAll('.explore-intro .intro-slide');
            if (slides.length === 0) return;

            var current = 0;
            setInterval(function () {
                slides[current].classList.remove('active');
                current = (current + 1) % slides.length;
                slides[current].classList.add('active');
            }, 4000);
        })();
    </script>

    <script>
        // =====================================================
        // DISCOVERY BAR: collapsible filters + store autocomplete
        // (kept inline since this page does not use a separate JS
        // file for the search toolbar)
        // =====================================================
        (function () {
            var toggleBtn = document.getElementById('exploreFiltersToggle');
            var filtersPanel = document.getElementById('exploreAdvancedFilters');

            if (toggleBtn && filtersPanel) {
                toggleBtn.addEventListener('click', function () {
                    var isCollapsed = filtersPanel.classList.toggle('is-collapsed');
                    toggleBtn.setAttribute('aria-expanded', (!isCollapsed).toString());
                });
            }

            var searchInput = document.getElementById('exploreStoreSearchInput');
            var resultsBox = document.getElementById('exploreStoreSearchResults');

            if (!searchInput || !resultsBox) return;

            var debounceTimer = null;

            function escapeHtml(value) {
                var div = document.createElement('div');
                div.textContent = value || '';
                return div.innerHTML;
            }

            function renderStores(stores) {
                if (!stores.length) {
                    resultsBox.innerHTML = '<div class="store-search-empty">No matching stores</div>';
                    resultsBox.classList.remove('hidden');
                    return;
                }

                resultsBox.innerHTML = stores.map(function (store) {
                    var safeName = escapeHtml(store.storeName);
                    var safeArea = escapeHtml(store.area);

                    var avatar = store.logoUrl
                        ? '<img src="' + escapeHtml(store.logoUrl) + '" alt="' + safeName + '" onerror="this.onerror=null;this.style.display=\'none\';">'
                        : '<span class="store-search-fallback">' + (safeName ? safeName.charAt(0).toUpperCase() : 'S') + '</span>';

                    return '<a class="store-search-item" href="/StoreCustomerProfile?id=' + store.storeId + '">' +
                        avatar +
                        '<span><strong>' + safeName + '</strong>' +
                        (safeArea ? '<small>' + safeArea + '</small>' : '') +
                        '</span></a>';
                }).join('');

                resultsBox.classList.remove('hidden');
            }

            searchInput.addEventListener('input', function () {
                var term = searchInput.value.trim();

                clearTimeout(debounceTimer);

                if (term.length === 0) {
                    resultsBox.classList.add('hidden');
                    resultsBox.innerHTML = '';
                    return;
                }

                debounceTimer = setTimeout(function () {
                    fetch('/Customer1?handler=SearchStores&term=' + encodeURIComponent(term))
                        .then(function (res) { return res.json(); })
                        .then(function (data) {
                            if (data && data.success) {
                                renderStores(data.stores || []);
                            }
                        })
                        .catch(function () {
                            resultsBox.classList.add('hidden');
                        });
                }, 250);
            });

            document.addEventListener('click', function (event) {
                if (!resultsBox.contains(event.target) && event.target !== searchInput) {
                    resultsBox.classList.add('hidden');
                }
            });

            searchInput.addEventListener('focus', function () {
                if (searchInput.value.trim().length > 0 && resultsBox.innerHTML) {
                    resultsBox.classList.remove('hidden');
                }
            });
        })();
    </script>

    <script>
        // =====================================================
        // AVATAR DROPDOWN MENU (My Profile / Logout)
        // =====================================================
        (function () {
            var trigger = document.getElementById('avatarMenuTrigger');
            var dropdown = document.getElementById('avatarMenuDropdown');
            if (!trigger || !dropdown) return;

            window.toggleAvatarMenu = function () {
                var isOpen = dropdown.classList.contains('open');
                dropdown.classList.toggle('open', !isOpen);
                trigger.setAttribute('aria-expanded', (!isOpen).toString());
            };

            document.addEventListener('click', function (event) {
                if (!dropdown.contains(event.target) && event.target !== trigger) {
                    dropdown.classList.remove('open');
                    trigger.setAttribute('aria-expanded', 'false');
                }
            });
        })();
    </script>

    <script>
        // =====================================================
        // MODAL 3-DOT MENU (Instagram-style: Not interested / Block
        // store / Report). Self-contained — doesn't rely on any function
        // from customer-explore.js, since that file's contents weren't
        // available to build against.
        //
        // The menu now lives inside the modal (next to Follow), not on
        // each grid tile, so there's no per-item dropdown to read data
        // from anymore. Instead, every click on a tile is captured to
        // remember which item is being opened (storeId/storeName/
        // productId/postId), and the modal menu's actions use that
        // "currently open" context.
        // =====================================================
        (function () {
            var openDropdown = null;
            var currentModalContext = { storeId: null, storeName: null, productId: null, postId: null };

            document.addEventListener('click', function (event) {
                var tile = event.target.closest('.explore-tile');
                if (!tile) return;

                currentModalContext = {
                    storeId: tile.dataset.storeId || null,
                    storeName: tile.dataset.storeName || null,
                    productId: tile.dataset.productId || null,
                    postId: tile.dataset.postId || null
                };

                var blockLabel = document.getElementById('modalBlockLabel');
                if (blockLabel) {
                    blockLabel.textContent = 'Block ' + (currentModalContext.storeName || 'store');
                }
            });

            function getAntiForgeryToken() {
                var input = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
                return input ? input.value : '';
            }

            function postForm(url, fields) {
                var body = new URLSearchParams();
                body.set('__RequestVerificationToken', getAntiForgeryToken());

                Object.keys(fields).forEach(function (key) {
                    if (fields[key] !== null && fields[key] !== undefined && fields[key] !== '') {
                        body.set(key, fields[key]);
                    }
                });

                return fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                }).then(function (res) { return res.json(); });
            }

            window.toggleTileMenu = function (triggerButton) {
                var dropdown = triggerButton.nextElementSibling;
                if (!dropdown || !dropdown.classList.contains('tile-menu-dropdown')) return;

                var isOpen = dropdown.classList.contains('open');

                closeOpenTileMenu();

                if (!isOpen) {
                    dropdown.classList.add('open');
                    triggerButton.setAttribute('aria-expanded', 'true');
                    openDropdown = { dropdown: dropdown, trigger: triggerButton };
                }
            };

            function closeOpenTileMenu() {
                if (openDropdown) {
                    openDropdown.dropdown.classList.remove('open');
                    openDropdown.trigger.setAttribute('aria-expanded', 'false');
                    openDropdown = null;
                }
            }

            document.addEventListener('click', function (event) {
                if (openDropdown && !openDropdown.dropdown.contains(event.target) && event.target !== openDropdown.trigger) {
                    closeOpenTileMenu();
                }
            });

            function showTileToast(message) {
                var toast = document.getElementById('tileMenuToast');
                if (!toast) return;

                toast.textContent = message;
                toast.classList.add('visible');

                window.clearTimeout(showTileToast._timer);
                showTileToast._timer = window.setTimeout(function () {
                    toast.classList.remove('visible');
                }, 2600);
            }

            // Removes the matching tile(s) from the grid behind the modal,
            // fading them out first.
            function removeTileFromGrid(selector) {
                document.querySelectorAll(selector).forEach(function (tile) {
                    tile.classList.add('tile-removed');
                    window.setTimeout(function () {
                        tile.remove();
                    }, 260);
                });
            }

            // Closes the explore modal by clicking its existing close
            // button, so whatever logic customer-explore.js already has
            // bound to it (state cleanup, video pause, etc.) still runs
            // normally instead of being bypassed.
            function closeExploreModal() {
                var closeBtn = document.querySelector('#exploreModal .modal-close[data-close-explore-modal]');
                if (closeBtn) {
                    closeBtn.click();
                }
            }

            window.handleModalNotInterested = function () {
                closeOpenTileMenu();

                var context = currentModalContext;

                postForm('/Customer1?handler=ExploreNotInterested', {
                    productId: context.productId,
                    postId: context.postId
                }).then(function (data) {
                    if (data && data.success) {
                        if (context.productId) {
                            removeTileFromGrid('.explore-tile[data-product-id="' + context.productId + '"]');
                        } else if (context.postId) {
                            removeTileFromGrid('.explore-tile[data-post-id="' + context.postId + '"]');
                        }
                        closeExploreModal();
                        showTileToast(data.message || "We'll show fewer items like this.");
                    } else {
                        showTileToast((data && data.message) || 'Something went wrong.');
                    }
                }).catch(function () {
                    showTileToast('Something went wrong.');
                });
            };

            window.handleModalBlockStore = function () {
                closeOpenTileMenu();

                var context = currentModalContext;
                var storeName = context.storeName || 'this store';

                if (!context.storeId) {
                    showTileToast('Could not determine which store to block.');
                    return;
                }

                if (!window.confirm('Block ' + storeName + '? You will not see their posts or products until you unblock them from your profile.')) {
                    return;
                }

                postForm('/Customer1?handler=ExploreBlockStore', {
                    storeId: context.storeId
                }).then(function (data) {
                    if (data && data.success) {
                        removeTileFromGrid('.explore-tile[data-store-id="' + context.storeId + '"]');
                        closeExploreModal();
                        showTileToast(data.message || (storeName + ' blocked.'));
                    } else {
                        showTileToast((data && data.message) || 'Something went wrong.');
                    }
                }).catch(function () {
                    showTileToast('Something went wrong.');
                });
            };

            window.handleModalReport = function () {
                closeOpenTileMenu();

                var context = currentModalContext;

                postForm('/Customer1?handler=ExploreReport', {
                    productId: context.productId,
                    postId: context.postId
                }).then(function (data) {
                    showTileToast((data && data.message) || 'Report submitted.');
                }).catch(function () {
                    showTileToast('Something went wrong.');
                });
            };
        })();
    </script>
</body>
</html>
