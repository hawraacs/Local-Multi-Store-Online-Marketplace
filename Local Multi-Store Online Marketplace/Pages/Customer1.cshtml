                <section class="grid-heading">
                    <div>
                        <h2>
                            @(string.IsNullOrWhiteSpace(Model.SelectedCategory)
                                ? "Explore"
                                : Model.SelectedCategory)
                        </h2>

                        <p>
                            Check out products available in our local stores and find your next favorite thing.
                        </p>
                    </div>
                </section>

                @if (Model.TrendingItems.Any())
                {
                    <!-- =========================================================
                         TRENDING RAIL — Instagram-style "most interested" strip,
                         ranked by likes + views. Reuses the .explore-tile markup
                         at a smaller size, so the same click handling / styling
                         applies. Handled by a dedicated click listener in
                         customer-explore.js since it lives outside #exploreGrid.
                         ========================================================= -->
                    <section class="trending-rail" aria-label="Trending now">
                        <div class="trending-rail-heading">
                            <i class="fa-solid fa-fire"></i>
                            <h3>Trending now</h3>
                        </div>

                        <div class="trending-rail-track">
                            @foreach (var item in Model.TrendingItems)
                            {
                                <button type="button"
                                        class="explore-tile trending-tile"
                                        data-grid-item
                                        data-item-type="@item.GridItemType"
                                        data-post-id="@item.ExplorePostID"
                                        data-post-type="@item.PostType"
                                        data-store-id="@item.StoreID"
                                        data-store-name="@item.StoreName">

                                    <span class="tile-media">
                                        <img src="@(string.Equals(item.MediaType, "Video", StringComparison.OrdinalIgnoreCase) ? (item.ThumbnailUrl ?? "/images/product-placeholder.svg") : item.MediaUrl)"
                                             alt="@(item.ProductName ?? item.StoreName)"
                                             loading="lazy"
                                             onerror="this.onerror=null;this.src='/images/product-placeholder.svg';" />
                                    </span>

                                    <span class="tile-gradient"></span>

                                    <span class="tile-top">
                                        <span class="tile-badge"><i class="fa-solid fa-fire"></i></span>

                                        @if (item.ProductPrice.HasValue)
                                        {
                                            <span class="tile-price">$@item.ProductPrice.Value.ToString("N2")</span>
                                        }
                                    </span>

                                    <span class="tile-bottom">
                                        <span class="tile-store">
                                            <span>@item.StoreName</span>
                                        </span>
                                    </span>
                                </button>
                            }
                        </div>
                    </section>
                }

                <section id="exploreGrid"
                         class="explore-grid"
                         aria-live="polite">

                    @foreach (var item in Model.InitialItems)
                    {
                        var isPost = string.Equals(
                        item.GridItemType,
                        "Post",
                        StringComparison.OrdinalIgnoreCase);

                        var isVideo = string.Equals(
                        item.MediaType,
                        "Video",
                        StringComparison.OrdinalIgnoreCase);

                        var isReel = string.Equals(
                        item.PostType,
                        "Reel",
                        StringComparison.OrdinalIgnoreCase);

                        var isCarousel = string.Equals(
                        item.PostType,
                        "Carousel",
                        StringComparison.OrdinalIgnoreCase);
                        <div class="explore-tile"
     role="button"
     tabindex="0"
     data-grid-item
     data-item-type="@item.GridItemType"
     data-post-id="@item.ExplorePostID"
     data-product-id="@item.ProductID"
     data-post-type="@item.PostType"
     data-store-id="@item.StoreID"
     data-store-name="@item.StoreName"
     aria-label="@(isPost
         ? $"Open post from {item.StoreName}"
         : $"Open product {item.ProductName}")">


                            <span class="tile-image-wrap">
                                <span class="tile-media">
                                    @if (isVideo &&
                                   string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                                    {
                                        <video muted
                                               loop
                                               playsinline
                                               preload="metadata"
                                               data-reel-preview>
                                            <source src="@item.MediaUrl" />
                                        </video>
                                    }
