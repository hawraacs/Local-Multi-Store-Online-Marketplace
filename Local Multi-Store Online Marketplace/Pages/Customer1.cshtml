@page
@model Local_Multi_Store_Online_Marketplace.Pages.Customer1Model
@{
    Layout = null;
    var hasActiveExploreFilters = Model.CategoryId.HasValue || Model.StoreId.HasValue
        || !string.IsNullOrEmpty(Model.Area) || Model.MinPrice.HasValue || Model.MaxPrice.HasValue;
}

@functions {
    // Maps a category name to a Font Awesome icon for the sidebar / icon
    // strip. Purely cosmetic — falls back to a generic tag icon for any
    // category name that isn't explicitly mapped.
    private static string GetCategoryIcon(string? name)
    {
        var key = (name ?? string.Empty).Trim().ToLowerInvariant();

        return key switch
        {
            "women" => "fa-person-dress",
            "men" => "fa-person",
            "electronics" => "fa-tv",
            "shoes" => "fa-shoe-prints",
            "bags" => "fa-bag-shopping",
            "beauty" => "fa-spray-can-sparkles",
            "home" => "fa-house",
            "kids" => "fa-child",
            "accessories" => "fa-gem",
            "sports" => "fa-futbol",
            _ => "fa-tag"
        };
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>Explore | realnest</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/customer-explore.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/customer-explore-polish.css"
          asp-append-version="true" />

    <style>
        :root {
            --accent-color: #6d28d9;
            --accent-hover: #5b21b6;
            --accent-light: #f3effe;
            --accent-steel: #4f46e5;
            --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
            --bg-color: #faf9fc;
            --text-primary: #1e1b2e;
        }

        .brand-mark {
            color: #ffffff !important;
            background: var(--accent-gradient) !important;
        }

        .category-chip.active {
            background: var(--accent-gradient) !important;
            color: #ffffff !important;
            border-color: transparent !important;
        }

        .tile-price {
            background: var(--accent-gradient) !important;
            color: #ffffff !important;
        }

        .tile-badge {
            background: rgba(109, 40, 217, 0.85) !important;
            color: #ffffff !important;
        }

        /* NEW — boosted/sponsored tile badge, overrides the default purple tile-badge */
        .sponsored-badge {
            background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%) !important;
            color: #ffffff !important;
        }

        .follow-button,
        .primary-product-button,
        .comment-submit-button {
            background: var(--accent-gradient) !important;
            color: #ffffff !important;
            border-color: transparent !important;
        }

        .modal-action-button:hover,
        .secondary-product-button:hover,
        .write-review-link {
            background: var(--accent-gradient) !important;
            -webkit-background-clip: text !important;
            background-clip: text !important;
            -webkit-text-fill-color: transparent !important;
            color: var(--accent-color) !important;
        }

        .product-review-stars,
        .intro-stat .stat-icon {
            color: var(--accent-color) !important;
        }

        .loader-spinner {
            border-top-color: var(--accent-color) !important;
        }

        .mobile-bottom-nav a.active {
            color: var(--accent-color) !important;
        }

        .mobile-bottom-nav {
            display: flex !important;
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 200;
            background: #ffffff;
            border-top: 1px solid #ece8f6;
            justify-content: space-between;
            gap: 2px;
            padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
            overflow-x: auto;
        }

            .mobile-bottom-nav a {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 2px;
                font-size: 10.5px;
                color: #6b6478;
                text-decoration: none;
                padding: 4px 6px;
                flex-shrink: 0;
                position: relative;
            }

                .mobile-bottom-nav a i {
                    font-size: 17px;
                }

        .category-chip:hover {
            border-color: var(--accent-color) !important;
            color: var(--accent-color) !important;
        }

        .tile-store-fallback {
            background: var(--accent-gradient) !important;
            color: #ffffff !important;
        }

        .modal-store-avatar {
            background: var(--accent-gradient) !important;
        }

        .media-nav {
            color: var(--accent-color) !important;
        }

            .media-nav:hover {
                background: var(--accent-light) !important;
            }

        .grid-legend i,
        .modal-caption a,
        .modal-store-link:hover strong,
        .comments-list a {
            color: var(--accent-color) !important;
        }

        /* NEW — the grid-legend items (All / Reel / Carousel / Product) are now
           real filter links instead of static labels. */
        .grid-legend {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .legend-filter {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 14px;
            border-radius: 999px;
            border: 1.5px solid var(--border-color, #ece8f6);
            background: var(--card-bg, #ffffff);
            color: var(--text-secondary, #6b6478);
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .legend-filter i {
                font-size: 12px;
                color: inherit !important;
            }

            .legend-filter:hover {
                border-color: var(--accent-color);
                color: var(--accent-color) !important;
            }

            .legend-filter.active {
                background: var(--accent-color);
                border-color: var(--accent-color);
                color: #ffffff !important;
            }

                .legend-filter.active i {
                    color: #ffffff !important;
                }

        .modal-action-button.active,
        .modal-action-button.liked,
        .modal-action-button[aria-pressed="true"] {
            color: var(--accent-color) !important;
        }

        .comment-submit-button i {
            color: #ffffff !important;
        }

        ::selection {
            background: var(--accent-light);
            color: var(--accent-color);
        }

        a {
            color: var(--accent-color);
        }

        html,
        body {
            background: var(--bg-color, #faf9fc) !important;
        }

        .explore-page {
            background: var(--bg-color, #faf9fc) !important;
            position: relative;
            overflow-x: hidden;
            padding-bottom: 82px;
        }

        .explore-intro {
            position: relative;
            overflow: hidden;
            isolation: isolate;
            border-radius: 20px;
            padding: 36px 32px;
            min-height: 220px;
            background: #2a2140;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
        }

        .intro-slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.4s ease;
            z-index: 0;
            /* Duotone-style purple tint — forces ANY photo (regardless of its
               original colors) into the accent purple palette: desaturate to
               grayscale first, push it through sepia to get a warm base tone,
               then rotate the hue into purple and boost saturation/contrast
               so it reads as a deliberate purple photo, not a filtered one. */
            filter: grayscale(0.25) sepia(0.65) hue-rotate(220deg) saturate(2.4) brightness(0.62) contrast(1.08);
        }

            .intro-slide.active {
                opacity: 1;
            }

        .explore-intro::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(109, 40, 217, 0.55) 0%, rgba(45, 20, 90, 0.68) 100%);
            mix-blend-mode: multiply;
            z-index: 1;
            pointer-events: none;
        }

        .explore-intro::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(24, 12, 46, 0.35);
            z-index: 1;
            pointer-events: none;
        }

        .explore-intro-copy,
        .explore-intro h1,
        .explore-intro p {
            position: relative;
            z-index: 2;
            background: transparent !important;
            color: #ffffff !important;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
        }

        .explore-intro-copy {
            max-width: 640px;
        }

        .explore-intro .eyebrow {
            position: relative;
            z-index: 2;
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.24) !important;
        }

        .explore-intro p {
            opacity: 1;
        }

        .explore-intro h1 span {
            position: relative;
            z-index: 2;
            background: none !important;
            -webkit-background-clip: unset !important;
            background-clip: unset !important;
            -webkit-text-fill-color: unset !important;
            color: #d8cef0 !important;
        }

        .intro-stat {
            position: relative;
            z-index: 2;
            background: rgba(255, 255, 255, 0.14) !important;
            border: 1px solid rgba(255, 255, 255, 0.25) !important;
            backdrop-filter: blur(6px);
        }

            .intro-stat strong,
            .intro-stat span {
                color: #ffffff !important;
            }

            .intro-stat .stat-icon {
                color: #d8cef0 !important;
            }

            .intro-stat-action {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 34px;
                margin-top: 10px;
                padding: 0 14px;
                border-radius: 10px;
                background: rgba(255, 255, 255, 0.18);
                color: #ffffff !important;
                text-decoration: none;
                font-size: 12px;
                font-weight: 800;
                border: 1px solid rgba(255, 255, 255, 0.3);
            }

                .intro-stat-action:hover {
                    background: rgba(255, 255, 255, 0.3);
                }

        @@keyframes fadeSlideUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .explore-intro, .category-icon-chip, .explore-tile, .intro-stat, .intro-slide {
                animation: none !important;
                transition: none !important;
            }
        }

        .explore-intro > div,
        .intro-stat {
            animation: fadeSlideUp 0.55s ease both;
        }

        .intro-stat {
            animation-delay: 0.1s;
        }

        .category-icon-chip {
            animation: fadeSlideUp 0.4s ease both;
        }

        .explore-tile {
            animation: fadeSlideUp 0.45s ease both;
            transition: transform 0.25s ease, box-shadow 0.25s ease !important;
        }

            .explore-tile:hover {
                transform: translateY(-5px);
                box-shadow: 0 14px 28px rgba(109, 40, 217, 0.18) !important;
            }

        .intro-stat .stat-icon {
            animation: pulseGlow 3.4s ease-in-out infinite;
        }

        @@keyframes pulseGlow {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.05);
                opacity: 0.88;
            }
        }

        .mobile-bottom-nav {
            box-shadow: 0 -4px 20px rgba(30, 27, 46, 0.06);
        }

            .mobile-bottom-nav a {
                border-radius: 12px;
                transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
            }

                .mobile-bottom-nav a:hover {
                    background: var(--accent-light);
                    color: var(--accent-color);
                }

                .mobile-bottom-nav a.active {
                    background: var(--accent-light) !important;
                    font-weight: 700;
                    transform: translateY(-2px);
                }

                .mobile-bottom-nav a i {
                    transition: transform 0.2s ease;
                }

                .mobile-bottom-nav a.active i {
                    transform: scale(1.12);
                }

        /* Cart badge (used by _CartCountBadge partial inside _CustomerBottomNav) */
        .unread-nav-badge {
            position: absolute;
            top: 2px;
            right: 18px;
            background: var(--accent-gradient);
            color: #fff;
            font-size: 10px;
            font-weight: 800;
            min-width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            box-shadow: 0 3px 8px rgba(109, 40, 217, 0.3);
        }

        /* Chat unread dot (used inside _CustomerBottomNav) */
        .chat-icon-wrap {
            position: relative;
            display: inline-flex;
        }

            .chat-icon-wrap .chat-nav-dot {
                position: absolute;
                top: -2px;
                right: -4px;
                width: 9px;
                height: 9px;
                background: #ed4956;
                border: 2px solid #fff;
                border-radius: 50%;
                box-sizing: content-box;
            }

        /* =====================================================
           DISCOVERY BAR (search toolbar + collapsible filters)
           ===================================================== */
        .discovery-search {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 14px;
            height: 52px;
            background: #ffffff;
            border: 1px solid #e7e2f2;
            border-radius: 16px;
            box-shadow: 0 10px 28px rgba(67, 46, 110, 0.07);
        }

            .discovery-search > i.fa-magnifying-glass {
                color: #9992ab;
            }

            .discovery-search input[type="text"] {
                flex: 1;
                height: 100%;
                border: none;
                outline: none;
                font-size: 14px;
                color: var(--text-primary);
                background: transparent;
            }

        .discovery-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border: none;
            border-radius: 10px;
            background: var(--accent-gradient);
            color: #fff;
            cursor: pointer;
            flex-shrink: 0;
        }

        .discovery-filters {
            margin-top: 12px;
            padding: 18px;
            border: 1px solid #e7e2f2;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 10px 28px rgba(67, 46, 110, 0.07);
            max-height: 500px;
            overflow: hidden;
            transition: max-height 0.25s ease, opacity 0.25s ease, margin-top 0.25s ease, padding 0.25s ease;
        }

            .discovery-filters.is-collapsed {
                max-height: 0;
                opacity: 0;
                margin-top: 0;
                padding-top: 0;
                padding-bottom: 0;
                border-width: 0;
                box-shadow: none;
            }

        /* Store search autocomplete dropdown */
        .store-search-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #e7e2f2;
            border-radius: 14px;
            box-shadow: 0 16px 32px rgba(67, 46, 110, 0.14);
            z-index: 50;
            max-height: 320px;
            overflow-y: auto;
            padding: 6px;
        }

            .store-search-dropdown.hidden {
                display: none;
            }

        .store-search-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 10px;
            cursor: pointer;
            text-decoration: none;
            color: var(--text-primary);
        }

            .store-search-item:hover {
                background: var(--accent-light);
            }

            .store-search-item img,
            .store-search-item .store-search-fallback {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                object-fit: cover;
                flex-shrink: 0;
            }

            .store-search-item .store-search-fallback {
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--accent-gradient);
                color: #fff;
                font-weight: 800;
                font-size: 13px;
            }

            .store-search-item strong {
                display: block;
                font-size: 13.5px;
            }

            .store-search-item small {
                color: #8d859c;
                font-size: 11.5px;
            }

        .store-search-empty {
            padding: 12px;
            text-align: center;
            color: #8d859c;
            font-size: 12.5px;
        }

        .market-filter-grid {
            display: grid;
            grid-template-columns: minmax(220px, 2fr) repeat(3, minmax(150px, 1fr)) repeat(2, minmax(120px, .75fr));
            gap: 12px;
        }

        .market-filter-field label {
            display: block;
            margin-bottom: 6px;
            color: #5f5870;
            font-size: 11px;
            font-weight: 800;
        }

        .market-filter-field input,
        .market-filter-field select {
            width: 100%;
            min-height: 44px;
            padding: 0 12px;
            border: 1px solid #ded8eb;
            border-radius: 12px;
            background: #fff;
            color: #1e1b2e;
            outline: none;
        }

            .market-filter-field input:focus,
            .market-filter-field select:focus {
                border-color: var(--accent-color);
                box-shadow: 0 0 0 3px rgba(109, 40, 217, .10);
            }

        .market-filter-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 14px;
        }

        .market-filter-button,
        .market-filter-clear {
            min-height: 42px;
            padding: 0 18px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
            cursor: pointer;
        }

        .market-filter-button {
            border: none;
            color: #fff;
            background: var(--accent-gradient);
        }

        .market-filter-clear {
            border: 1px solid #ded8eb;
            color: #5f5870;
            background: #fff;
        }

        @@media (max-width: 1100px) {
            .market-filter-grid

        {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        }

        @@media (max-width: 700px) {
            .market-filter-grid

        {
            grid-template-columns: 1fr 1fr;
        }

        .market-filter-field:first-child {
            grid-column: 1 / -1;
        }

        .market-filter-actions {
            justify-content: stretch;
        }

        .market-filter-button, .market-filter-clear {
            flex: 1;
        }

        }

        /* =====================================================
           INLINE PRODUCT REVIEW COMPOSER (Explore modal)
           ===================================================== */
        .product-review-summary {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .product-review-form {
            margin: 14px 0 18px;
            padding: 14px 16px 16px;
            border: 1px solid #ece7f6;
            border-radius: 16px;
            background: linear-gradient(180deg, #fbfaff 0%, #ffffff 100%);
            box-shadow: 0 6px 18px rgba(67, 46, 110, 0.05);
        }

        .product-review-form-label {
            font-size: 11.5px;
            font-weight: 800;
            letter-spacing: .2px;
            color: #6b6478;
            text-transform: uppercase;
            margin-bottom: 8px;
            display: block;
        }

        .product-review-form-stars {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 12px;
        }

            .product-review-form-stars .star-pick {
                border: none;
                background: transparent;
                cursor: pointer;
                padding: 2px;
                font-size: 20px;
                line-height: 1;
                color: #d8d2e6;
                transition: transform 0.15s ease, color 0.15s ease;
            }

                .product-review-form-stars .star-pick:hover,
                .product-review-form-stars .star-pick:focus-visible {
                    transform: scale(1.18);
                }

                .product-review-form-stars .star-pick.hovered,
                .product-review-form-stars .star-pick.filled {
                    color: #f5a524;
                }

                .product-review-form-stars .star-pick i.fa-solid {
                    color: #f5a524;
                }

        .product-review-form-hint {
            font-size: 12px;
            font-weight: 700;
            color: #a79fbb;
            margin-left: 4px;
        }

            .product-review-form-hint.active {
                color: #6d28d9;
            }

        .product-review-form-row {
            display: flex;
            align-items: flex-end;
            gap: 10px;
        }

            .product-review-form-row input[type="text"] {
                flex: 1;
                min-height: 44px;
                padding: 0 14px;
                border: 1px solid #e3ddf1;
                border-radius: 12px;
                background: #fff;
                font-size: 13.5px;
                color: var(--text-primary);
                outline: none;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .product-review-form-row input[type="text"]:focus {
                    border-color: var(--accent-color);
                    box-shadow: 0 0 0 3px rgba(109, 40, 217, .10);
                }

        .product-review-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 44px;
            padding: 0 18px;
            border: none;
            border-radius: 12px;
            background: var(--accent-gradient);
            color: #fff;
            font-weight: 800;
            font-size: 13px;
            cursor: pointer;
            flex-shrink: 0;
            transition: opacity 0.2s ease, transform 0.15s ease;
        }

            .product-review-submit:hover:not(:disabled) {
                transform: translateY(-1px);
            }

            .product-review-submit:disabled {
                opacity: 0.6;
                cursor: default;
                transform: none;
            }

        .product-review-item {
            display: flex;
            gap: 10px;
            padding: 12px 0;
            border-top: 1px solid #f1eef8;
        }

            .product-review-item:first-child {
                border-top: none;
            }

            .product-review-item .review-stars {
                color: #f5a524;
                font-size: 11px;
                margin: 2px 0 4px;
            }

            .product-review-item .verified-review {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-size: 10px;
                font-weight: 800;
                color: #16a34a;
                background: #eafbf1;
                border-radius: 20px;
                padding: 2px 8px;
                margin-left: 6px;
            }

        /* =====================================================
           MERGED STATS + ACTIONS ROW
           One row: views (icon+count, not clickable), Like and
           Comment (icon+count, clickable), Save + Cart (icon-only,
           only shown when a product exists) and Share (dropdown:
           WhatsApp / Send in chat / Copy link).
           ===================================================== */
        .modal-stats {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 10px 0;
            border-top: 1px solid #f1eef8;
            border-bottom: 1px solid #f1eef8;
            margin: 8px 0 4px;
            flex-wrap: wrap;
        }

            .modal-stats .stat-item {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                color: #6b6478;
                font-size: 13px;
                font-weight: 700;
            }

                .modal-stats .stat-item i {
                    font-size: 18px;
                }

        .modal-action-button {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: none !important;
            background: transparent !important;
            padding: 4px;
            cursor: pointer;
            color: #6b6478;
            font-size: 13px;
            font-weight: 700;
            -webkit-tap-highlight-color: transparent;
        }

            .modal-action-button i {
                font-size: 20px;
                transition: transform 0.15s ease, color 0.15s ease;
            }

            .modal-action-button:active i {
                transform: scale(0.82);
            }

            .modal-action-button:hover i {
                opacity: 0.72;
            }

        /* Heart: fills red when liked (independent of the purple accent theme
           used for the rest of the modal actions) */
        #modalLikeButton.liked i {
            color: #ed4956 !important;
        }

        #modalLikeButton.liked i.fa-heart {
            animation: heartPop 0.32s ease;
        }

        /* Wishlist icon in the merged stats row: red heart when saved */
        #wishlistProductButton.liked i,
        #wishlistProductButton.saved i {
            color: #ed4956 !important;
        }

        @@keyframes heartPop {
            0% {
                transform: scale(1);
            }

            35% {
                transform: scale(1.35);
            }

            100% {
                transform: scale(1);
            }
        }

        /* Share: brief green checkmark confirmation after sharing/copying */
        #modalShareButton.shared i {
            color: #16a34a !important;
        }

        /* Share dropdown wrapper + menu (reuses .tile-menu-dropdown /
           .tile-menu-item, already defined below for the 3-dot menu) */
        .modal-share-wrap {
            position: relative;
        }

        .modal-share-dropdown {
            top: 40px;
            right: 0;
        }

        /* =====================================================
           FIX — root cause confirmed from the real customer-explore.css:
           .modal-media-pane has a FIXED height (58vh, dropping to 52vh
           and 46vh at smaller breakpoints) that's completely independent
           of its width. The modal card can be up to 680px wide, so that
           box ends up landscape-shaped on most screens. Every product
           image is now a guaranteed 1:1 square at upload
           (CreateModel.SaveProductImages) — object-fit: cover was
           cropping the top/bottom off those square images to force them
           into that wider, non-square box (this is what showed up as
           "cropped vertically"). object-fit: contain would instead have
           letterboxed them with black bars on the sides (the original
           complaint, before cover was added).
           The actual fix is neither object-fit value — it's making the
           box itself square, so a square image fills it exactly with
           nothing left to crop OR pad, at every breakpoint. Reels (the
           only non-square content) never open this modal; they open the
           separate full-screen Reels Player, so this doesn't affect them.
           ===================================================== */
        .modal-media-pane {
            height: auto !important;
            aspect-ratio: 1 / 1 !important;
            background: #f3f0fa !important;
        }

        .modal-media-content img,
        .modal-media-content video {
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
        }

        /* NEW — PRODUCT-MODE MODAL: a bigger card whenever a product is
           being shown (either ContentType === "Product" or a post's
           linked product), toggled via JS on .explore-modal-card. */
        .explore-modal-card.product-mode {
            width: min(880px, 100%);
        }

        @@media (min-width: 921px) {
            .explore-modal-card.product-mode .modal-media-pane {
                height: 64vh;
            }
        }

        /* =====================================================
           FIX — the Follow button (right-aligned in modal-store-header)
           was sitting right next to / overlapping the modal's X close
           button, since the close button floats top-right over the card
           and the header didn't reserve any space for it. Pin the close
           button's exact position and give the header matching right
           padding so Follow always clears it.
           ===================================================== */
        .explore-modal-card {
            position: relative;
        }

        .modal-close {
            position: absolute !important;
            top: 14px !important;
            right: 14px !important;
            left: auto !important;
            z-index: 20 !important;
            width: 34px !important;
            height: 34px !important;
            border-radius: 50% !important;
            background: rgba(30, 27, 46, 0.06) !important;
            color: var(--text-primary) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            border: none !important;
            cursor: pointer;
            font-size: 14px !important;
        }

            .modal-close:hover {
                background: rgba(30, 27, 46, 0.12) !important;
            }

        .modal-store-header {
            padding-right: 54px !important;
            box-sizing: border-box;
        }

        /* =====================================================
           MODAL 3-DOT MENU (Instagram-style: "Not interested",
           "Block store", "Report") — lives in the modal header next
           to Follow, not on the grid tiles.
           ===================================================== */
        .modal-header-actions {
            position: relative;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .tile-menu-trigger {
            width: 28px;
            height: 28px;
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 13px;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

        /* Base .tile-menu-trigger above is written generically; the modal
           is the only place it's used now, so this gives it the actual
           look — a plain circle button that fits a white header, not the
           translucent dark corner-of-an-image style it originally had. */
        .modal-menu-trigger {
            background: var(--accent-light);
            color: var(--accent-color);
        }

            .modal-menu-trigger:hover {
                background: var(--accent-color);
                color: #ffffff;
            }

        .tile-menu-dropdown {
            position: absolute;
            top: 40px;
            right: 0;
            z-index: 30;
            min-width: 190px;
            background: #ffffff;
            border: 1px solid #ece7f6;
            border-radius: 14px;
            box-shadow: 0 16px 36px rgba(67, 46, 110, 0.18);
            padding: 6px;
            display: none;
            animation: fadeSlideUp 0.15s ease both;
        }

            .tile-menu-dropdown.open {
                display: block;
            }

        .tile-menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            border: none;
            background: transparent;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-primary);
            cursor: pointer;
            text-align: left;
        }

            .tile-menu-item i {
                width: 16px;
                text-align: center;
                color: #8d859c;
                font-size: 13px;
            }

            .tile-menu-item:hover {
                background: var(--accent-light);
            }

            .tile-menu-item.danger {
                color: #dc2626;
            }

                .tile-menu-item.danger i {
                    color: #dc2626;
                }

                .tile-menu-item.danger:hover {
                    background: #fdeeec;
                }

        .tile-menu-toast {
            position: fixed;
            left: 50%;
            bottom: max(90px, calc(70px + env(safe-area-inset-bottom)));
            transform: translateX(-50%) translateY(12px);
            background: #1e1b2e;
            color: #ffffff;
            padding: 10px 18px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            box-shadow: 0 10px 26px rgba(0, 0, 0, 0.25);
            z-index: 900;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

            .tile-menu-toast.visible {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
                pointer-events: auto;
            }

        .explore-tile.tile-removed {
            animation: tileFadeOut 0.25s ease forwards;
        }

        @@keyframes tileFadeOut {
            to {
                opacity: 0;
                transform: scale(0.94);
            }
        }

        /* =====================================================
           TRENDING RAIL — Instagram-style "most interested" strip
           above the main grid.
           ===================================================== */
        .trending-rail {
            margin: 4px 0 22px;
        }

        .trending-rail-heading {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
        }

            .trending-rail-heading i {
                color: var(--accent-color);
            }

            .trending-rail-heading h3 {
                margin: 0;
                font-size: 16px;
                color: var(--text-primary);
            }

        .trending-rail-track {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 4px;
            scrollbar-width: none;
        }

            .trending-rail-track::-webkit-scrollbar {
                display: none;
            }

        .trending-tile {
            flex: 0 0 130px;
            aspect-ratio: 1 / 1.3;
        }

            .trending-tile.explore-tile {
                border-radius: 14px !important;
            }

        @@media (max-width: 680px) {
            .trending-tile {
                flex-basis: 108px;
            }
        }

        /* =====================================================
           REELS PLAYER (full-screen, Instagram-Reels-style)
           ===================================================== */
        /* Hide the bottom nav completely while a Reel is playing, so the
           video gets the full screen (Instagram/TikTok-style) instead of
           sharing space with it. */
        body.reels-open .mobile-bottom-nav {
            display: none !important;
        }

        .reels-player {
            position: fixed;
            inset: 0;
            z-index: 500;
            background: #000;
            display: none;
        }

            .reels-player.open {
                display: block;
            }

        .reels-close {
            position: fixed;
            top: max(16px, env(safe-area-inset-top));
            right: 16px;
            z-index: 30;
            width: 38px;
            height: 38px;
            border: none;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.45);
            color: #fff;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .reels-track {
            height: 100%;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            scroll-behavior: auto;
            overscroll-behavior-y: contain;
        }

            .reels-track::-webkit-scrollbar {
                display: none;
            }

        .reel-slide {
            position: relative;
            height: 100%;
            width: 100%;
            scroll-snap-align: start;
            scroll-snap-stop: always;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
            overflow: hidden;
        }

        .reel-video {
            max-height: 100%;
            max-width: 100%;
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #000;
        }

        .reel-loading {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255, 255, 255, 0.6);
            font-size: 22px;
        }

        .reel-video-error {
            position: absolute;
            inset: 0;
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #17121f;
            color: rgba(255, 255, 255, 0.7);
            text-align: center;
            padding: 0 32px;
        }

            .reel-video-error.hidden {
                display: none;
            }

            .reel-video-error i {
                font-size: 26px;
                color: #f59e0b;
            }

            .reel-video-error span {
                font-size: 13px;
                font-weight: 600;
            }

        .reel-overlay-top {
            position: absolute;
            top: max(18px, env(safe-area-inset-top));
            left: 16px;
            /* Widened from 70px to clear both the mute toggle and the close
               button now that they sit side by side instead of stacked. */
            right: 104px;
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .reel-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--accent-gradient);
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 13px;
            flex-shrink: 0;
            border: 1.5px solid rgba(255, 255, 255, 0.5);
        }

        .reel-store-name {
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
            flex-shrink: 0;
        }

        .reel-follow-button {
            border: 1.5px solid rgba(255, 255, 255, 0.7);
            background: transparent;
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            padding: 4px 12px;
            border-radius: 8px;
            cursor: pointer;
        }

            .reel-follow-button.following {
                border-color: rgba(255, 255, 255, 0.35);
                color: rgba(255, 255, 255, 0.75);
            }

        .reel-overlay-side {
            position: absolute;
            right: 12px;
            /* Nav is hidden while a Reel plays (not overlaid), so this can
               sit close to the bottom edge again. */
            bottom: calc(30px + env(safe-area-inset-bottom));
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .reel-action {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            border: none;
            background: transparent;
            color: #fff;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

            .reel-action i {
                font-size: 26px;
                filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.5));
                transition: transform 0.15s ease, color 0.15s ease;
            }

            .reel-action span {
                font-size: 11px;
                font-weight: 700;
                text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
            }

            .reel-action:active i {
                transform: scale(0.82);
            }

            .reel-like.liked i {
                color: #ed4956;
                animation: heartPop 0.32s ease;
            }

            .reel-share.shared i {
                color: #16a34a;
            }

        .reel-caption {
            position: absolute;
            left: 16px;
            right: 76px;
            /* Nav is hidden while a Reel plays, so this can sit close to
               the bottom edge again. */
            bottom: max(20px, env(safe-area-inset-bottom));
            z-index: 10;
            color: #fff;
            font-size: 13px;
            line-height: 1.4;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.55);
            max-height: 4.2em;
            overflow: hidden;
        }

        .reel-mute-toggle {
            position: absolute;
            top: max(16px, env(safe-area-inset-top));
            /* Sits just left of the close (X) button — close is right:16px,
               width:38px (ends at ~54px from the edge), so this starts past
               that with an 8px gap instead of sitting on top of it. */
            right: 62px;
            z-index: 10;
            width: 32px;
            height: 32px;
            border: none;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.45);
            color: #fff;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        /* =====================================================
           REEL LINKED-PRODUCT CHIP + SLIDE-UP BUY CARD
           Tapping the chip slides a compact product card up over
           the bottom of the video (which keeps playing behind it)
           instead of navigating away from the Reel.
           ===================================================== */
        .reel-product-chip {
            position: absolute;
            left: 16px;
            right: 76px;
            /* Sits just above the caption with a small gap. */
            bottom: calc(70px + env(safe-area-inset-bottom));
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            border: none;
            border-radius: 14px;
            background: rgba(20, 14, 32, 0.55);
            backdrop-filter: blur(6px);
            color: #fff;
            cursor: pointer;
            text-align: left;
        }

            .reel-product-chip.hidden {
                display: none;
            }

            .reel-product-chip .reel-product-chip-img {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                object-fit: cover;
                flex-shrink: 0;
                background: #241c33;
            }

        .reel-product-chip-text {
            display: flex;
            flex-direction: column;
            min-width: 0;
            flex: 1;
        }

        .reel-product-chip-name {
            font-size: 12.5px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .reel-product-chip-price {
            font-size: 11.5px;
            color: #d8cef0;
            font-weight: 700;
        }

        .reel-product-chip i.fa-chevron-up {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.7);
            flex-shrink: 0;
        }

        .reel-product-sheet {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 20;
            background: linear-gradient(180deg, rgba(23, 18, 31, 0) 0%, #17121f 26%);
            padding: 46px 16px calc(20px + env(safe-area-inset-bottom));
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }

            .reel-product-sheet.open {
                transform: translateY(0);
            }

        .reel-product-sheet-close {
            position: absolute;
            top: 10px;
            right: 14px;
            width: 30px;
            height: 30px;
            border: none;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .reel-product-sheet-main {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            margin-bottom: 12px;
            width: 100%;
            border: none;
            background: transparent;
            padding: 0;
            text-align: left;
            cursor: pointer;
        }

        .reel-product-sheet-img {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            object-fit: cover;
            background: #241c33;
            flex-shrink: 0;
        }

        .reel-product-sheet-info {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .reel-product-sheet-category {
            color: #b9aee0;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .reel-product-sheet-name {
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .reel-product-sheet-price {
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            margin-top: 2px;
        }

        .reel-product-sheet-actions {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

        .reel-product-save,
        .reel-product-cart {
            flex: 1;
            min-height: 42px;
            border: none;
            border-radius: 12px;
            font-weight: 800;
            font-size: 13px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
        }

        .reel-product-save {
            background: rgba(255, 255, 255, 0.14);
            color: #fff;
        }

            .reel-product-save.saved {
                background: rgba(237, 73, 86, 0.22);
                color: #ff8a94;
            }

        .reel-product-cart {
            background: var(--accent-gradient);
            color: #fff;
        }

            .reel-product-cart:disabled {
                opacity: 0.6;
                cursor: default;
            }

        .reel-product-sheet-details {
            display: block;
            width: 100%;
            text-align: center;
            color: #cabdf0;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            border: none;
            background: transparent;
            padding: 4px 0 0;
            cursor: pointer;
        }

        /* =====================================================
           ROWNIN-STYLE SHELL — sidebar + topbar layout, category
           icon strip, tabs/pills row, and card-style grid tiles.
           Visual layer only; all existing IDs, data-attributes,
           and JS hooks used by customer-explore.js / the inline
           scripts below are unchanged.
           ===================================================== */
        :root {
            --sidebar-width: 232px;
        }

        .app-shell {
            display: flex;
            align-items: stretch;
            min-height: 100vh;
        }

        .app-sidebar {
            width: var(--sidebar-width);
            flex-shrink: 0;
            padding: 22px 16px;
            border-right: 1px solid #ece7f6;
            background: #ffffff;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .app-sidebar-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--text-primary);
            text-decoration: none;
            font-family: "Playfair Display", serif;
            font-size: 21px;
            font-weight: 700;
        }

            .app-sidebar-brand .brand-mark {
                width: 34px;
                height: 34px;
                border-radius: 11px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 15px;
            }

        .app-sidebar-nav,
        .app-sidebar-categories {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .app-sidebar-heading {
            margin: 6px 0 4px;
            padding: 0 10px;
            color: #a79fbb;
            font-size: 10.5px;
            font-weight: 900;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .app-sidebar-link,
        .app-sidebar-category {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 10px;
            border-radius: 12px;
            color: #4b4558;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 700;
            transition: background-color .15s ease, color .15s ease;
        }

            .app-sidebar-link i,
            .app-sidebar-category i {
                width: 18px;
                text-align: center;
                font-size: 14px;
                color: #9992ab;
            }

            .app-sidebar-link:hover,
            .app-sidebar-category:hover {
                background: var(--accent-light);
                color: var(--accent-color);
            }

                .app-sidebar-link:hover i,
                .app-sidebar-category:hover i {
                    color: var(--accent-color);
                }

            .app-sidebar-link.active,
            .app-sidebar-category.active {
                color: var(--accent-color);
                background: var(--accent-light);
                font-weight: 800;
            }

                .app-sidebar-link.active i,
                .app-sidebar-category.active i {
                    color: var(--accent-color);
                }

        .app-sidebar-seller {
            margin-top: auto;
            padding: 16px;
            border-radius: 18px;
            background: var(--accent-light);
        }

            .app-sidebar-seller strong {
                display: block;
                margin-bottom: 6px;
                color: var(--text-primary);
                font-size: 13.5px;
            }

            .app-sidebar-seller p {
                margin: 0 0 12px;
                color: #6b6478;
                font-size: 11.5px;
                line-height: 1.5;
            }

            .app-sidebar-seller a {
                display: inline-flex;
                min-height: 36px;
                padding: 0 14px;
                border-radius: 10px;
                align-items: center;
                justify-content: center;
                width: 100%;
                color: #fff;
                background: var(--accent-gradient);
                text-decoration: none;
                font-size: 12px;
                font-weight: 800;
            }

        .app-content {
            flex: 1;
            min-width: 0;
        }

        .app-topbar {
            position: sticky;
            top: 0;
            z-index: 40;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 26px;
            background: rgba(250, 249, 252, 0.92);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid #ece7f6;
        }

        .app-topbar-search {
            flex: 1;
            min-width: 0;
            margin: 0;
        }

        .app-topbar .discovery-search {
            height: 46px;
        }

        .app-topbar-filters {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: 46px;
            padding: 0 16px;
            border: 1px solid #ded8eb;
            border-radius: 12px;
            background: #fff;
            color: #4b4558;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            flex-shrink: 0;
        }

            .app-topbar-filters[aria-expanded="true"] {
                border-color: var(--accent-color);
                color: var(--accent-color);
            }

        .app-topbar-icons {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .app-topbar-icon {
            width: 42px;
            height: 42px;
            border: 1px solid #ece7f6;
            border-radius: 50%;
            background: #fff;
            color: #4b4558;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 15px;
            text-decoration: none;
        }

            .app-topbar-icon:hover {
                border-color: var(--accent-color);
                color: var(--accent-color);
            }

        .app-topbar-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: var(--accent-gradient);
            font-weight: 800;
            font-size: 14px;
            flex-shrink: 0;
            border: none;
            cursor: pointer;
        }

        /* NEW — avatar dropdown menu (Logout / My Profile). Reuses the
           same .tile-menu-dropdown / .tile-menu-item styling defined
           above for the 3-dot menu and modal share menu. */
        .avatar-menu-wrap {
            position: relative;
        }

        .avatar-menu-dropdown {
            top: 50px;
            right: 0;
        }

        .app-topbar-filterpanel {
            margin: 0 26px !important;
        }

        /* ---- category icon strip ---- */
        .category-icon-section {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding: 4px 2px 8px;
            margin: 22px 0 6px;
            scrollbar-width: none;
        }

            .category-icon-section::-webkit-scrollbar {
                display: none;
            }

        .category-icon-chip {
            flex: 0 0 auto;
            width: 84px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 14px 8px;
            border: 1px solid #ece7f6;
            border-radius: 16px;
            background: #fff;
            color: #4b4558;
            text-decoration: none;
            font-size: 11px;
            font-weight: 800;
            text-align: center;
            transition: all .18s ease;
        }

            .category-icon-chip i {
                font-size: 17px;
                color: #9992ab;
            }

            .category-icon-chip:hover {
                border-color: var(--accent-color);
                color: var(--accent-color);
                transform: translateY(-2px);
            }

                .category-icon-chip:hover i {
                    color: var(--accent-color);
                }

            .category-icon-chip.active {
                color: #fff;
                border-color: transparent;
                background: var(--accent-gradient);
            }

                .category-icon-chip.active i {
                    color: #fff;
                }

        /* ---- tabs + filter pills row ---- */
        .app-tabs-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            margin: 6px 0 20px;
        }

        .app-view-tabs {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .app-view-tab {
            padding: 6px 0;
            border: none;
            border-bottom: 2px solid transparent;
            background: none;
            color: #a79fbb;
            font-size: 14px;
            font-weight: 800;
            cursor: default;
        }

            .app-view-tab.active {
                color: var(--text-primary);
                border-bottom-color: var(--accent-color);
            }

        /* ---- Explore grid card redesign ---- */
        .explore-tile {
            display: flex !important;
            flex-direction: column;
            height: auto !important;
            aspect-ratio: auto !important;
            background: #fff !important;
            border: 1px solid #ece7f6;
            border-radius: 16px !important;
        }

        .tile-image-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 1 / 1;
            overflow: hidden;
            flex-shrink: 0;
        }

        .tile-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 11px;
        }

        .tile-title {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--text-primary);
            font-size: 12.5px;
            font-weight: 800;
        }

        .tile-icons {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .tile-heart,
        .tile-bookmark {
            width: 30px;
            height: 30px;
            border: none;
            border-radius: 50%;
            background: #f6f4fb;
            color: #6b6478;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12.5px;
            cursor: pointer;
            flex-shrink: 0;
        }

            .tile-heart:hover,
            .tile-bookmark:hover {
                background: var(--accent-light);
                color: var(--accent-color);
            }

            .tile-heart.liked {
                color: #ed4956 !important;
                background: #fdeeef;
            }

        @@media (max-width: 920px) {
            .app-sidebar {
                display: none;
            }

            .app-topbar {
                padding: 12px 16px;
            }

            .app-topbar-filterpanel {
                margin: 0 16px !important;
            }
        }

        @@media (min-width: 921px) {
            .mobile-bottom-nav {
                left: var(--sidebar-width);
            }
        }

        @@media (max-width: 680px) {
            .category-icon-chip {
                width: 72px;
                padding: 11px 6px;
            }

            .app-tabs-row {
                justify-content: flex-start;
            }

            .app-topbar-icons .app-topbar-icon:nth-child(2),
            .app-topbar-icons .app-topbar-icon:nth-child(3) {
                display: none;
            }
        }



/* =========================================================
   FINAL EXPLORE CARD LAYOUT
   VISUAL ONLY - DO NOT CHANGE FUNCTIONALITY
   ========================================================= */

#exploreGrid.explore-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    grid-auto-flow: row !important;
    grid-auto-rows: auto !important;
    gap: 24px !important;
    align-items: start !important;
    justify-items: stretch !important;
    width: 100% !important;
}

#exploreGrid .explore-tile {
    position: relative !important;
    grid-column: auto !important;
    grid-row: auto !important;
    width: 100% !important;
    height: auto !important;
    min-width: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-self: start !important;
    aspect-ratio: auto !important;
    overflow: hidden !important;
    background: #ffffff !important;
    border: 1px solid #ece7f6 !important;
    border-radius: 16px !important;
}

#exploreGrid .explore-tile .tile-image-wrap {
    position: relative !important;
    width: 100% !important;
    height: 280px !important;
    min-height: 280px !important;
    aspect-ratio: auto !important;
    flex: 0 0 280px !important;
    overflow: hidden !important;
}

#exploreGrid .explore-tile .tile-media {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
}

#exploreGrid .explore-tile .tile-media img,
#exploreGrid .explore-tile .tile-media video {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
}

#exploreGrid .explore-tile .tile-footer {
    position: relative !important;
    width: 100% !important;
    min-height: 54px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 10px 12px !important;
    box-sizing: border-box !important;
}

@@media (min-width: 1201px) {
    #exploreGrid.explore-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
}

@@media (min-width: 801px) and (max-width: 1200px) {
    #exploreGrid.explore-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
}

@@media (min-width: 521px) and (max-width: 800px) {
    #exploreGrid.explore-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    #exploreGrid .explore-tile .tile-image-wrap {
        height: 240px !important;
        min-height: 240px !important;
        flex-basis: 240px !important;
    }
}

@@media (max-width: 520px) {
    #exploreGrid.explore-grid {
        grid-template-columns: 1fr !important;
    }

    #exploreGrid .explore-tile .tile-image-wrap {
        height: 280px !important;
        min-height: 280px !important;
        flex-basis: 280px !important;
    }
}

</style>
</head>

<body>

    <form id="antiForgeryForm" method="post" class="hidden-antiforgery-form">
        @Html.AntiForgeryToken()
    </form>

    <!-- NEW — hidden logout form, submitted from the avatar dropdown. -->
    <form id="logoutForm" method="post" asp-page="/Account/Logout" asp-area="Identity" asp-route-returnUrl="/Customer1">
        @Html.AntiForgeryToken()
    </form>

    <div class="app-shell">

        <!-- =========================================================
             SIDEBAR — visual navigation only. "Explore" is the only
             link wired to a real page (this one); the others are
             placeholders (javascript:void(0)) until their routes
             exist, so nothing here can 404.
             ========================================================= -->
        <aside class="app-sidebar">
            <a asp-page="/Customer1" class="app-sidebar-brand">
               
            </a>

         <nav class="app-sidebar-nav">


    <a asp-page="/Customer1"
       class="app-sidebar-link active">
        <i class="fa-solid fa-compass"></i>
        Explore
    </a>

    <a asp-page="/CustomerWishlist"
       class="app-sidebar-link">
        <i class="fa-regular fa-heart"></i>
        Wishlist
    </a>

    <a asp-page="/CustomerFeed"
       class="app-sidebar-link">
        <i class="fa-regular fa-bookmark"></i>
        Following
    </a>

    <a asp-page="/CustomerCart"
       class="app-sidebar-link">
        <i class="fa-solid fa-store"></i>
        Cart
    </a>

    <a asp-page="/CustomerPromotions"
       class="app-sidebar-link">
        <i class="fa-solid fa-grip"></i>
        Offers
    </a>

</nav>

            <div class="app-sidebar-categories">
                <span class="app-sidebar-heading">Browse categories</span>

                <a asp-page="/Customer1"
                   class="app-sidebar-category @(string.IsNullOrWhiteSpace(Model.SelectedCategory) ? "active" : "")">
                    <i class="fa-solid fa-layer-group"></i> All
                </a>

                @foreach (var category in Model.NavbarCategories)
                {
                    var isActive = string.Equals(Model.SelectedCategory, category, StringComparison.OrdinalIgnoreCase);

                    <a asp-page="/Customer1"
                       asp-route-category="@category"
                       class="app-sidebar-category @(isActive ? "active" : "")">
                        <i class="fa-solid @GetCategoryIcon(category)"></i> @category
                    </a>
                }
            </div>

            <!-- CHANGED — routes to the seller's own dashboard if they
                 already own a store, otherwise to the seller signup /
                 store-request flow. -->
            <div class="app-sidebar-seller">
                <strong>Become a Seller</strong>
                <p>Start your store and reach thousands of customers.</p>
                @if (Model.CustomerHasStore)
                {
                    <a asp-page="/StoreDashboard">Go to My Store</a>
                }
                else
                {
                    <a asp-page="/StoreRequest">Get Started</a>
                }
            </div>
        </aside>

        <div class="app-content">

            <!-- =====================================================
                 TOPBAR — search + filters toggle live here now (same
                 form / element IDs the inline script + JS file expect).
                 ===================================================== -->
            <form method="get" asp-page="/Customer1" id="exploreDiscoveryForm">
                <input type="hidden" name="category" value="@Model.SelectedCategory" />

                <header class="app-topbar">
                    <div class="app-topbar-search">
                        <div class="discovery-search">
                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input type="text"
                                   id="exploreStoreSearchInput"
                                   name="SearchTerm"
                                   value="@Model.SearchTerm"
                                   placeholder="Search products, stores and more..."
                                   autocomplete="off" />

                            <div id="exploreStoreSearchResults" class="store-search-dropdown hidden"></div>

                            <button type="submit" class="discovery-submit" aria-label="Search">
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>

                    <button type="button" class="app-topbar-filters" id="exploreFiltersToggle"
                            aria-expanded="@(hasActiveExploreFilters ? "true" : "false")"
                            aria-controls="exploreAdvancedFilters">
                        <i class="fa-solid fa-sliders"></i> Filters
                    </button>

                    <!-- CHANGED — Wishlist / Messages / Notifications now
                         route to real pages, and the avatar is a dropdown
                         trigger (My Profile / Logout) instead of inert. -->
                    <div class="app-topbar-icons">
                        <a asp-page="/CustomerWishlist" class="app-topbar-icon" title="Wishlist">
                            <i class="fa-regular fa-heart"></i>
                        </a>

                        <a asp-page="/Chat" class="app-topbar-icon" title="Messages">
                            <i class="fa-regular fa-comment"></i>
                        </a>

                        <a asp-page="/ReportUpdates" class="app-topbar-icon" title="Notifications">
                            <i class="fa-regular fa-bell"></i>
                        </a>

                        <div class="menu-wrap avatar-menu-wrap">
                            <button type="button"
                                    class="app-topbar-avatar"
                                    id="avatarMenuTrigger"
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                    onclick="event.stopPropagation(); toggleAvatarMenu()">
                                @(User.Identity?.Name?.Trim().Length > 0 ? User.Identity.Name.Trim().Substring(0, 1).ToUpper() : "U")
                            </button>

                            <div class="tile-menu-dropdown avatar-menu-dropdown" id="avatarMenuDropdown">
                                <a asp-page="/CustomerProfile" class="tile-menu-item">
                                    <i class="fa-regular fa-user"></i> My Profile
                                </a>

                                <button type="button" class="tile-menu-item danger"
                                        onclick="event.stopPropagation(); document.getElementById('logoutForm').submit();">
                                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                                </button>
                            </div>
                        </div>
                    </div>
                </header>

                <div class="discovery-filters market-filter-panel app-topbar-filterpanel @(hasActiveExploreFilters ? "" : "is-collapsed")" id="exploreAdvancedFilters">

                    <div class="market-filter-grid">
                        <div class="market-filter-field">
                            <label for="exploreCategory">Category</label>
                            <select id="exploreCategory" name="CategoryId">
                                <option value="">All categories</option>
                                @foreach (var filterCategory in Model.FilterCategories)
                                {
                                    <option value="@filterCategory.CategoryID"
                                            selected="@(Model.CategoryId == filterCategory.CategoryID ? "selected" : null)">
                                        @filterCategory.CategoryName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="market-filter-field">
                            <label for="exploreStore">Store</label>
                            <select id="exploreStore" name="StoreId">
                                <option value="">All stores</option>
                                @foreach (var filterStore in Model.FilterStores)
                                {
                                    <option value="@filterStore.StoreID"
                                            selected="@(Model.StoreId == filterStore.StoreID ? "selected" : null)">
                                        @filterStore.StoreName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="market-filter-field">
                            <label for="exploreArea">Area</label>
                            <select id="exploreArea" name="Area">
                                <option value="">All areas</option>
                                @foreach (var filterArea in Model.FilterAreas)
                                {
                                    <option value="@filterArea" selected="@(Model.Area == filterArea ? "selected" : null)">@filterArea</option>
                                }
                            </select>
                        </div>

                        <div class="market-filter-field">
                            <label for="exploreMinPrice">Min price</label>
                            <input id="exploreMinPrice" type="number" min="0" step="0.01"
                                   name="MinPrice" value="@Model.MinPrice" placeholder="$0" />
                        </div>

                        <div class="market-filter-field">
                            <label for="exploreMaxPrice">Max price</label>
                            <input id="exploreMaxPrice" type="number" min="0" step="0.01"
                                   name="MaxPrice" value="@Model.MaxPrice" placeholder="Any" />
                        </div>
                    </div>

                    <div class="market-filter-actions">
                        <a asp-page="/Customer1" class="market-filter-clear">
                            <i class="fa-solid fa-rotate-left"></i> Clear
                        </a>
                        <button type="submit" class="market-filter-button">
                            <i class="fa-solid fa-magnifying-glass"></i> Search / Filter
                        </button>
                    </div>
                </div>
            </form>

            <main id="exploreApp"
                  class="explore-page"
                  data-category="@(Model.SelectedCategory ?? string.Empty)"
                  data-search-term="@(Model.SearchTerm ?? string.Empty)"
                  data-category-id="@(Model.CategoryId?.ToString() ?? string.Empty)"
                  data-store-id="@(Model.StoreId?.ToString() ?? string.Empty)"
                  data-area="@(Model.Area ?? string.Empty)"
                  data-min-price="@(Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                  data-max-price="@(Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                  data-type-filter="@(Model.TypeFilter ?? string.Empty)"
                  data-feed-type="@Model.FeedType"
                  data-current-page="1"
                  data-has-more="@Model.HasMoreItems.ToString().ToLowerInvariant()">

                <section class="explore-intro">

                    <div class="intro-slide active" style="background-image: url('https://images.unsplash.com/photo-1506169894395-36397e4aaee4?fm=jpg&amp;q=80&amp;w=1600&amp;auto=format&amp;fit=crop');"></div>
                    <div class="intro-slide" style="background-image: url('https://images.unsplash.com/photo-1772570824145-e996a55204fb?fm=jpg&amp;q=80&amp;w=1600&amp;auto=format&amp;fit=crop');"></div>
                    <div class="intro-slide" style="background-image: url('https://images.unsplash.com/photo-1604494320172-4e4e5f40359d?fm=jpg&amp;q=80&amp;w=1600&amp;auto=format&amp;fit=crop');"></div>

                    <div class="explore-intro-copy">
                        <span class="eyebrow">Discover · Shop · Support local</span>

                        <h1>
                            Shop local,
                            <span>discover more.</span>
                        </h1>

                        <p>
                            Every active product appears here automatically, together with any existing image, carousel or reel content.
                            Open any item for details, reviews, wishlist, cart and familiar recommendations.
                        </p>
                    </div>

                    <div class="intro-stat">
                        <span class="stat-icon">
                            <i class="fa-solid fa-infinity"></i>
                        </span>

                        <div>
                            <strong>Infinite Explore</strong>
                            <span>New arrivals added daily, just for you.</span>
                            <a href="#exploreGrid" class="intro-stat-action">Discover Now</a>
                        </div>
                    </div>
                </section>

                <!-- =========================================================
                     CATEGORY ICON STRIP — same category links/routes as
                     before, just rendered as icon chips.
                     ========================================================= -->
                <section class="category-icon-section" aria-label="Product categories">

                    <a asp-page="/Customer1"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-storeId="@Model.StoreId"
                       asp-route-area="@Model.Area"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       class="category-icon-chip @(string.IsNullOrWhiteSpace(Model.SelectedCategory) ? "active" : string.Empty)">
                        <i class="fa-solid fa-grip"></i>
                        All
                    </a>

                    @foreach (var category in Model.NavbarCategories)
                    {
                        var isActive = string.Equals(
                        Model.SelectedCategory,
                        category,
                        StringComparison.OrdinalIgnoreCase);

                        <a asp-page="/Customer1"
                           asp-route-category="@category"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-storeId="@Model.StoreId"
                           asp-route-area="@Model.Area"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           class="category-icon-chip @(isActive ? "active" : string.Empty)">
                            <i class="fa-solid @GetCategoryIcon(category)"></i>
                            @category
                        </a>
                    }
                </section>

                @if (TempData["Success"] is string successMessage &&
                !string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="server-message success">
                        <i class="fa-solid fa-circle-check"></i>
                        @successMessage
                    </div>
                }

                @if (TempData["Error"] is string errorMessage &&
                !string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="server-message error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @errorMessage
                    </div>
                }

                <!-- =========================================================
                     TABS + FILTER PILLS — "For You" now shows products only
                     in categories the customer has already shown interest in
                     (recently viewed / liked / followed stores' products);
                     "All Stores" shows everything. The pills on the right
                     are the existing Reel/Carousel/Product type-filter
                     links, unchanged.
                     ========================================================= -->
                <section class="app-tabs-row">
                  <div class="app-view-tabs">

    <a asp-page="/Customer1"
       asp-route-feedType="ForYou"
       asp-route-category="@Model.SelectedCategory"
       asp-route-searchTerm="@Model.SearchTerm"
       asp-route-categoryId="@Model.CategoryId"
       asp-route-storeId="@Model.StoreId"
       asp-route-area="@Model.Area"
       asp-route-minPrice="@Model.MinPrice"
       asp-route-maxPrice="@Model.MaxPrice"
       asp-route-typeFilter="@Model.TypeFilter"
       class="app-view-tab @(Model.FeedType == "ForYou" ? "active" : "")">
        For You
    </a>

    <a asp-page="/Customer1"
       asp-route-feedType="AllStores"
       asp-route-category="@Model.SelectedCategory"
       asp-route-searchTerm="@Model.SearchTerm"
       asp-route-categoryId="@Model.CategoryId"
       asp-route-storeId="@Model.StoreId"
       asp-route-area="@Model.Area"
       asp-route-minPrice="@Model.MinPrice"
       asp-route-maxPrice="@Model.MaxPrice"
       asp-route-typeFilter="@Model.TypeFilter"
       class="app-view-tab @(Model.FeedType == "AllStores" ? "active" : "")">
        All Stores
    </a>

</div>

                    <div class="grid-legend">
                        <a asp-page="/Customer1"
