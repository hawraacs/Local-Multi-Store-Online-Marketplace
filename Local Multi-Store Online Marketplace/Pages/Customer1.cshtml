@page
@model Local_Multi_Store_Online_Marketplace.Pages.Customer1Model
@{
    Layout = null;
    var hasActiveExploreFilters = Model.CategoryId.HasValue || Model.StoreId.HasValue
        || !string.IsNullOrEmpty(Model.Area) || Model.MinPrice.HasValue || Model.MaxPrice.HasValue;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>Explore | realnest</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/customer-explore.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/customer-explore-polish.css"
          asp-append-version="true" />

    <style>
        :root {
            --accent-color: #6d28d9;
            --accent-hover: #5b21b6;
            --accent-light: #f3effe;
            --accent-steel: #4f46e5;
            --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
            --bg-color: #faf9fc;
            --text-primary: #1e1b2e;
        }

        .brand-mark {
            color: #ffffff !important;
            background: var(--accent-gradient) !important;
        }

        .category-chip.active {
            background: var(--accent-gradient) !important;
            color: #ffffff !important;
            border-color: transparent !important;
        }

        .tile-price {
            background: var(--accent-gradient) !important;
            color: #ffffff !important;
        }

        .tile-badge {
            background: rgba(109, 40, 217, 0.85) !important;
            color: #ffffff !important;
        }

        /* NEW — boosted/sponsored tile badge, overrides the default purple tile-badge */
        .sponsored-badge {
            background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%) !important;
            color: #ffffff !important;
        }

        .follow-button,
        .primary-product-button,
        .comment-submit-button {
            background: var(--accent-gradient) !important;
            color: #ffffff !important;
            border-color: transparent !important;
        }

        .modal-action-button:hover,
        .secondary-product-button:hover,
        .write-review-link {
            background: var(--accent-gradient) !important;
            -webkit-background-clip: text !important;
            background-clip: text !important;
            -webkit-text-fill-color: transparent !important;
            color: var(--accent-color) !important;
        }

        .product-review-stars,
        .intro-stat .stat-icon {
            color: var(--accent-color) !important;
        }

        .loader-spinner {
            border-top-color: var(--accent-color) !important;
        }

        .mobile-bottom-nav a.active {
            color: var(--accent-color) !important;
        }

        .mobile-bottom-nav {
            display: flex !important;
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 200;
            background: #ffffff;
            border-top: 1px solid #ece8f6;
            justify-content: space-between;
            gap: 2px;
            padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
            overflow-x: auto;
        }

            .mobile-bottom-nav a {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 2px;
                font-size: 10.5px;
                color: #6b6478;
                text-decoration: none;
                padding: 4px 6px;
                flex-shrink: 0;
                position: relative;
            }

                .mobile-bottom-nav a i {
                    font-size: 17px;
                }

        .category-chip:hover {
            border-color: var(--accent-color) !important;
            color: var(--accent-color) !important;
        }

        .tile-store-fallback {
            background: var(--accent-gradient) !important;
            color: #ffffff !important;
        }

        .modal-store-avatar {
            background: var(--accent-gradient) !important;
        }

        .media-nav {
            color: var(--accent-color) !important;
        }

            .media-nav:hover {
                background: var(--accent-light) !important;
            }

        .grid-legend i,
        .modal-caption a,
        .modal-store-link:hover strong,
        .comments-list a {
            color: var(--accent-color) !important;
        }

        /* NEW — the grid-legend items (All / Reel / Carousel / Product) are now
           real filter links instead of static labels. */
        .grid-legend {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .legend-filter {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 14px;
            border-radius: 999px;
            border: 1.5px solid var(--border-color, #ece8f6);
            background: var(--card-bg, #ffffff);
            color: var(--text-secondary, #6b6478);
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .legend-filter i {
                font-size: 12px;
                color: inherit !important;
            }

            .legend-filter:hover {
                border-color: var(--accent-color);
                color: var(--accent-color) !important;
            }

            .legend-filter.active {
                background: var(--accent-color);
                border-color: var(--accent-color);
                color: #ffffff !important;
            }

                .legend-filter.active i {
                    color: #ffffff !important;
                }

        .modal-action-button.active,
        .modal-action-button.liked,
        .modal-action-button[aria-pressed="true"] {
            color: var(--accent-color) !important;
        }

        .comment-submit-button i {
            color: #ffffff !important;
        }

        ::selection {
            background: var(--accent-light);
            color: var(--accent-color);
        }

        a {
            color: var(--accent-color);
        }

        html,
        body {
            background: var(--bg-color, #faf9fc) !important;
        }

        .explore-page {
            background: var(--bg-color, #faf9fc) !important;
            position: relative;
            overflow-x: hidden;
            padding-bottom: 82px;
        }

        .explore-intro {
            position: relative;
            overflow: hidden;
            isolation: isolate;
            border-radius: 20px;
            padding: 36px 32px;
            min-height: 300px;
            background: #2a2140;
        }

        .intro-slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.4s ease;
            z-index: 0;
        }

            .intro-slide.active {
                opacity: 1;
            }

        .explore-intro::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(20, 14, 40, 0.72) 0%, rgba(35, 22, 70, 0.62) 100%);
            z-index: 1;
            pointer-events: none;
        }

        .explore-intro > div:first-child,
        .explore-intro h1,
        .explore-intro p {
            position: relative;
            z-index: 2;
            background: transparent !important;
            color: #ffffff !important;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
        }

        .explore-intro .eyebrow {
            position: relative;
            z-index: 2;
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.24) !important;
        }

        .explore-intro p {
            opacity: 1;
        }

        .explore-intro h1 span {
            position: relative;
            z-index: 2;
            background: none !important;
            -webkit-background-clip: unset !important;
            background-clip: unset !important;
            -webkit-text-fill-color: unset !important;
            color: #d8cef0 !important;
        }

        .intro-stat {
            position: relative;
            z-index: 2;
            background: rgba(255, 255, 255, 0.14) !important;
            border: 1px solid rgba(255, 255, 255, 0.25) !important;
            backdrop-filter: blur(6px);
        }

            .intro-stat strong,
            .intro-stat span {
                color: #ffffff !important;
            }

            .intro-stat .stat-icon {
                color: #d8cef0 !important;
            }

        @@keyframes fadeSlideUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .explore-intro, .category-chip, .explore-tile, .intro-stat, .intro-slide {
                animation: none !important;
                transition: none !important;
            }
        }

        .explore-intro > div,
        .intro-stat {
            animation: fadeSlideUp 0.55s ease both;
        }

        .intro-stat {
            animation-delay: 0.1s;
        }

        .category-chip {
            animation: fadeSlideUp 0.4s ease both;
        }

            .category-chip:nth-child(1) {
                animation-delay: 0.02s;
            }

            .category-chip:nth-child(2) {
                animation-delay: 0.06s;
            }

            .category-chip:nth-child(3) {
                animation-delay: 0.10s;
            }

            .category-chip:nth-child(4) {
                animation-delay: 0.14s;
            }

            .category-chip:nth-child(5) {
                animation-delay: 0.18s;
            }

            .category-chip:nth-child(6) {
                animation-delay: 0.22s;
            }

        .explore-tile {
            animation: fadeSlideUp 0.45s ease both;
            transition: transform 0.25s ease, box-shadow 0.25s ease !important;
        }

            .explore-tile:hover {
                transform: translateY(-5px);
                box-shadow: 0 14px 28px rgba(109, 40, 217, 0.18) !important;
            }

        .intro-stat .stat-icon {
            animation: pulseGlow 3.4s ease-in-out infinite;
        }

        @@keyframes pulseGlow {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.05);
                opacity: 0.88;
            }
        }

        .mobile-bottom-nav {
            box-shadow: 0 -4px 20px rgba(30, 27, 46, 0.06);
        }

            .mobile-bottom-nav a {
                border-radius: 12px;
                transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
            }

                .mobile-bottom-nav a:hover {
                    background: var(--accent-light);
                    color: var(--accent-color);
                }

                .mobile-bottom-nav a.active {
                    background: var(--accent-light) !important;
                    font-weight: 700;
                    transform: translateY(-2px);
                }

                .mobile-bottom-nav a i {
                    transition: transform 0.2s ease;
                }

                .mobile-bottom-nav a.active i {
                    transform: scale(1.12);
                }

        /* Cart badge (used by _CartCountBadge partial inside _CustomerBottomNav) */
        .unread-nav-badge {
            position: absolute;
            top: 2px;
            right: 18px;
            background: var(--accent-gradient);
            color: #fff;
            font-size: 10px;
            font-weight: 800;
            min-width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            box-shadow: 0 3px 8px rgba(109, 40, 217, 0.3);
        }

        /* Chat unread dot (used inside _CustomerBottomNav) */
        .chat-icon-wrap {
            position: relative;
            display: inline-flex;
        }

            .chat-icon-wrap .chat-nav-dot {
                position: absolute;
                top: -2px;
                right: -4px;
                width: 9px;
                height: 9px;
                background: #ed4956;
                border: 2px solid #fff;
                border-radius: 50%;
                box-sizing: content-box;
            }

        /* =====================================================
           DISCOVERY BAR (search toolbar + collapsible filters)
           ===================================================== */
        .discovery-bar {
            margin: 22px 0 16px;
        }

        .discovery-search {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 14px;
            height: 52px;
            background: #ffffff;
            border: 1px solid #e7e2f2;
            border-radius: 16px;
            box-shadow: 0 10px 28px rgba(67, 46, 110, 0.07);
        }

            .discovery-search > i.fa-magnifying-glass {
                color: #9992ab;
            }

            .discovery-search input[type="text"] {
                flex: 1;
                height: 100%;
                border: none;
                outline: none;
                font-size: 14px;
                color: var(--text-primary);
                background: transparent;
            }

        .discovery-toggle {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            height: 36px;
            padding: 0 14px;
            border: 1px solid #ded8eb;
            border-radius: 10px;
            background: #fff;
            color: #5f5870;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            flex-shrink: 0;
        }

            .discovery-toggle[aria-expanded="true"] {
                border-color: var(--accent-color);
                color: var(--accent-color);
            }

            .discovery-toggle i {
                font-size: 11px;
                transition: transform 0.2s ease;
            }

            .discovery-toggle[aria-expanded="true"] i {
                transform: rotate(180deg);
            }

        .discovery-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border: none;
            border-radius: 10px;
            background: var(--accent-gradient);
            color: #fff;
            cursor: pointer;
            flex-shrink: 0;
        }

        .discovery-filters {
            margin-top: 12px;
            padding: 18px;
            border: 1px solid #e7e2f2;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 10px 28px rgba(67, 46, 110, 0.07);
            max-height: 500px;
            overflow: hidden;
            transition: max-height 0.25s ease, opacity 0.25s ease, margin-top 0.25s ease, padding 0.25s ease;
        }

            .discovery-filters.is-collapsed {
                max-height: 0;
                opacity: 0;
                margin-top: 0;
                padding-top: 0;
                padding-bottom: 0;
                border-width: 0;
                box-shadow: none;
            }

        /* Store search autocomplete dropdown */
        .store-search-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #e7e2f2;
            border-radius: 14px;
            box-shadow: 0 16px 32px rgba(67, 46, 110, 0.14);
            z-index: 50;
            max-height: 320px;
            overflow-y: auto;
            padding: 6px;
        }

            .store-search-dropdown.hidden {
                display: none;
            }

        .store-search-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 10px;
            cursor: pointer;
            text-decoration: none;
            color: var(--text-primary);
        }

            .store-search-item:hover {
                background: var(--accent-light);
            }

            .store-search-item img,
            .store-search-item .store-search-fallback {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                object-fit: cover;
                flex-shrink: 0;
            }

            .store-search-item .store-search-fallback {
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--accent-gradient);
                color: #fff;
                font-weight: 800;
                font-size: 13px;
            }

            .store-search-item strong {
                display: block;
                font-size: 13.5px;
            }

            .store-search-item small {
                color: #8d859c;
                font-size: 11.5px;
            }

        .store-search-empty {
            padding: 12px;
            text-align: center;
            color: #8d859c;
            font-size: 12.5px;
        }

        .market-filter-grid {
            display: grid;
            grid-template-columns: minmax(220px, 2fr) repeat(3, minmax(150px, 1fr)) repeat(2, minmax(120px, .75fr));
            gap: 12px;
        }

        .market-filter-field label {
            display: block;
            margin-bottom: 6px;
            color: #5f5870;
            font-size: 11px;
            font-weight: 800;
        }

        .market-filter-field input,
        .market-filter-field select {
            width: 100%;
            min-height: 44px;
            padding: 0 12px;
            border: 1px solid #ded8eb;
            border-radius: 12px;
            background: #fff;
            color: #1e1b2e;
            outline: none;
        }

            .market-filter-field input:focus,
            .market-filter-field select:focus {
                border-color: var(--accent-color);
                box-shadow: 0 0 0 3px rgba(109, 40, 217, .10);
            }

        .market-filter-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 14px;
        }

        .market-filter-button,
        .market-filter-clear {
            min-height: 42px;
            padding: 0 18px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
            cursor: pointer;
        }

        .market-filter-button {
            border: none;
            color: #fff;
            background: var(--accent-gradient);
        }

        .market-filter-clear {
            border: 1px solid #ded8eb;
            color: #5f5870;
            background: #fff;
        }

        @@media (max-width: 1100px) {
            .market-filter-grid

        {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        }

        @@media (max-width: 700px) {
            .market-filter-grid

        {
            grid-template-columns: 1fr 1fr;
        }

        .market-filter-field:first-child {
            grid-column: 1 / -1;
        }

        .market-filter-actions {
            justify-content: stretch;
        }

        .market-filter-button, .market-filter-clear {
            flex: 1;
        }

        }

        /* =====================================================
           INLINE PRODUCT REVIEW COMPOSER (Explore modal)
           ===================================================== */
        .product-review-summary {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .product-review-form {
            margin: 14px 0 18px;
            padding: 14px 16px 16px;
            border: 1px solid #ece7f6;
            border-radius: 16px;
            background: linear-gradient(180deg, #fbfaff 0%, #ffffff 100%);
            box-shadow: 0 6px 18px rgba(67, 46, 110, 0.05);
        }

        .product-review-form-label {
            font-size: 11.5px;
            font-weight: 800;
            letter-spacing: .2px;
            color: #6b6478;
            text-transform: uppercase;
            margin-bottom: 8px;
            display: block;
        }

        .product-review-form-stars {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 12px;
        }

            .product-review-form-stars .star-pick {
                border: none;
                background: transparent;
                cursor: pointer;
                padding: 2px;
                font-size: 20px;
                line-height: 1;
                color: #d8d2e6;
                transition: transform 0.15s ease, color 0.15s ease;
            }

                .product-review-form-stars .star-pick:hover,
                .product-review-form-stars .star-pick:focus-visible {
                    transform: scale(1.18);
                }

                .product-review-form-stars .star-pick.hovered,
                .product-review-form-stars .star-pick.filled {
                    color: #f5a524;
                }

                .product-review-form-stars .star-pick i.fa-solid {
                    color: #f5a524;
                }

        .product-review-form-hint {
            font-size: 12px;
            font-weight: 700;
            color: #a79fbb;
            margin-left: 4px;
        }

            .product-review-form-hint.active {
                color: #6d28d9;
            }

        .product-review-form-row {
            display: flex;
            align-items: flex-end;
            gap: 10px;
        }

            .product-review-form-row input[type="text"] {
                flex: 1;
                min-height: 44px;
                padding: 0 14px;
                border: 1px solid #e3ddf1;
                border-radius: 12px;
                background: #fff;
                font-size: 13.5px;
                color: var(--text-primary);
                outline: none;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .product-review-form-row input[type="text"]:focus {
                    border-color: var(--accent-color);
                    box-shadow: 0 0 0 3px rgba(109, 40, 217, .10);
                }

        .product-review-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 44px;
            padding: 0 18px;
            border: none;
            border-radius: 12px;
            background: var(--accent-gradient);
            color: #fff;
            font-weight: 800;
            font-size: 13px;
            cursor: pointer;
            flex-shrink: 0;
            transition: opacity 0.2s ease, transform 0.15s ease;
        }

            .product-review-submit:hover:not(:disabled) {
                transform: translateY(-1px);
            }

            .product-review-submit:disabled {
                opacity: 0.6;
                cursor: default;
                transform: none;
            }

        .product-review-item {
            display: flex;
            gap: 10px;
            padding: 12px 0;
            border-top: 1px solid #f1eef8;
        }

            .product-review-item:first-child {
                border-top: none;
            }

            .product-review-item .review-stars {
                color: #f5a524;
                font-size: 11px;
                margin: 2px 0 4px;
            }

            .product-review-item .verified-review {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-size: 10px;
                font-weight: 800;
                color: #16a34a;
                background: #eafbf1;
                border-radius: 20px;
                padding: 2px 8px;
                margin-left: 6px;
            }

        /* =====================================================
           MERGED STATS + ACTIONS ROW
           One row: views (icon+count, not clickable), Like and
           Comment (icon+count, clickable), Share (icon only,
           clickable). Replaces the old two-row layout that showed
           counts on top and duplicate icons/labels underneath.
           ===================================================== */
        .modal-stats {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 10px 0;
            border-top: 1px solid #f1eef8;
            border-bottom: 1px solid #f1eef8;
            margin: 8px 0 4px;
        }

            .modal-stats .stat-item {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                color: #6b6478;
                font-size: 13px;
                font-weight: 700;
            }

                .modal-stats .stat-item i {
                    font-size: 18px;
                }

        .modal-action-button {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: none !important;
            background: transparent !important;
            padding: 4px;
            cursor: pointer;
            color: #6b6478;
            font-size: 13px;
            font-weight: 700;
            -webkit-tap-highlight-color: transparent;
        }

            .modal-action-button i {
                font-size: 20px;
                transition: transform 0.15s ease, color 0.15s ease;
            }

            .modal-action-button:active i {
                transform: scale(0.82);
            }

            .modal-action-button:hover i {
                opacity: 0.72;
            }

        /* Heart: fills red when liked (independent of the purple accent theme
           used for the rest of the modal actions) */
        #modalLikeButton.liked i {
            color: #ed4956 !important;
        }

        #modalLikeButton.liked i.fa-heart {
            animation: heartPop 0.32s ease;
        }

        @@keyframes heartPop {
            0% {
                transform: scale(1);
            }

            35% {
                transform: scale(1.35);
            }

            100% {
                transform: scale(1);
            }
        }

        /* Share: brief green checkmark confirmation after sharing/copying */
        #modalShareButton.shared i {
            color: #16a34a !important;
        }

        /* =====================================================
           REELS PLAYER (full-screen, Instagram-Reels-style)
           ===================================================== */
        /* Hide the bottom nav completely while a Reel is playing, so the
           video gets the full screen (Instagram/TikTok-style) instead of
           sharing space with it. */
        body.reels-open .mobile-bottom-nav {
            display: none !important;
        }

        .reels-player {
            position: fixed;
            inset: 0;
            z-index: 500;
            background: #000;
            display: none;
        }

            .reels-player.open {
                display: block;
            }

        .reels-close {
            position: fixed;
            top: max(16px, env(safe-area-inset-top));
            right: 16px;
            z-index: 30;
            width: 38px;
            height: 38px;
            border: none;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.45);
            color: #fff;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .reels-track {
            height: 100%;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            scroll-behavior: auto;
            overscroll-behavior-y: contain;
        }

            .reels-track::-webkit-scrollbar {
                display: none;
            }

        .reel-slide {
            position: relative;
            height: 100%;
            width: 100%;
            scroll-snap-align: start;
            scroll-snap-stop: always;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
            overflow: hidden;
        }

        .reel-video {
            max-height: 100%;
            max-width: 100%;
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #000;
        }

        .reel-loading {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255, 255, 255, 0.6);
            font-size: 22px;
        }

        .reel-video-error {
            position: absolute;
            inset: 0;
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #17121f;
            color: rgba(255, 255, 255, 0.7);
            text-align: center;
            padding: 0 32px;
        }

            .reel-video-error.hidden {
                display: none;
            }

            .reel-video-error i {
                font-size: 26px;
                color: #f59e0b;
            }

            .reel-video-error span {
                font-size: 13px;
                font-weight: 600;
            }

        .reel-overlay-top {
            position: absolute;
            top: max(18px, env(safe-area-inset-top));
            left: 16px;
            /* Widened from 70px to clear both the mute toggle and the close
               button now that they sit side by side instead of stacked. */
            right: 104px;
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .reel-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--accent-gradient);
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 13px;
            flex-shrink: 0;
            border: 1.5px solid rgba(255, 255, 255, 0.5);
        }

        .reel-store-name {
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
            flex-shrink: 0;
        }

        .reel-follow-button {
            border: 1.5px solid rgba(255, 255, 255, 0.7);
            background: transparent;
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            padding: 4px 12px;
            border-radius: 8px;
            cursor: pointer;
        }

            .reel-follow-button.following {
                border-color: rgba(255, 255, 255, 0.35);
                color: rgba(255, 255, 255, 0.75);
            }

        .reel-overlay-side {
            position: absolute;
            right: 12px;
            /* Nav is hidden while a Reel plays (not overlaid), so this can
               sit close to the bottom edge again. */
            bottom: calc(30px + env(safe-area-inset-bottom));
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .reel-action {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            border: none;
            background: transparent;
            color: #fff;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

            .reel-action i {
                font-size: 26px;
                filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.5));
                transition: transform 0.15s ease, color 0.15s ease;
            }

            .reel-action span {
                font-size: 11px;
                font-weight: 700;
                text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
            }

            .reel-action:active i {
                transform: scale(0.82);
            }

            .reel-like.liked i {
                color: #ed4956;
                animation: heartPop 0.32s ease;
            }

            .reel-share.shared i {
                color: #16a34a;
            }

        .reel-caption {
            position: absolute;
            left: 16px;
            right: 76px;
            /* Nav is hidden while a Reel plays, so this can sit close to
               the bottom edge again. */
            bottom: max(20px, env(safe-area-inset-bottom));
            z-index: 10;
            color: #fff;
            font-size: 13px;
            line-height: 1.4;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.55);
            max-height: 4.2em;
            overflow: hidden;
        }

        .reel-mute-toggle {
            position: absolute;
            top: max(16px, env(safe-area-inset-top));
            /* Sits just left of the close (X) button — close is right:16px,
               width:38px (ends at ~54px from the edge), so this starts past
               that with an 8px gap instead of sitting on top of it. */
            right: 62px;
            z-index: 10;
            width: 32px;
            height: 32px;
            border: none;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.45);
            color: #fff;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        /* =====================================================
           REEL LINKED-PRODUCT CHIP + SLIDE-UP BUY CARD
           Tapping the chip slides a compact product card up over
           the bottom of the video (which keeps playing behind it)
           instead of navigating away from the Reel.
           ===================================================== */
        .reel-product-chip {
            position: absolute;
            left: 16px;
            right: 76px;
            /* Sits just above the caption with a small gap. */
            bottom: calc(70px + env(safe-area-inset-bottom));
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            border: none;
            border-radius: 14px;
            background: rgba(20, 14, 32, 0.55);
            backdrop-filter: blur(6px);
            color: #fff;
            cursor: pointer;
            text-align: left;
        }

            .reel-product-chip.hidden {
                display: none;
            }

            .reel-product-chip .reel-product-chip-img {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                object-fit: cover;
                flex-shrink: 0;
                background: #241c33;
            }

        .reel-product-chip-text {
            display: flex;
            flex-direction: column;
            min-width: 0;
            flex: 1;
        }

        .reel-product-chip-name {
            font-size: 12.5px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .reel-product-chip-price {
            font-size: 11.5px;
            color: #d8cef0;
            font-weight: 700;
        }

        .reel-product-chip i.fa-chevron-up {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.7);
            flex-shrink: 0;
        }

        .reel-product-sheet {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 20;
            background: linear-gradient(180deg, rgba(23, 18, 31, 0) 0%, #17121f 26%);
            padding: 46px 16px calc(20px + env(safe-area-inset-bottom));
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }

            .reel-product-sheet.open {
                transform: translateY(0);
            }

        .reel-product-sheet-close {
            position: absolute;
            top: 10px;
            right: 14px;
            width: 30px;
            height: 30px;
            border: none;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .reel-product-sheet-main {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            margin-bottom: 12px;
            width: 100%;
            border: none;
            background: transparent;
            padding: 0;
            text-align: left;
            cursor: pointer;
        }

        .reel-product-sheet-img {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            object-fit: cover;
            background: #241c33;
            flex-shrink: 0;
        }

        .reel-product-sheet-info {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .reel-product-sheet-category {
            color: #b9aee0;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .reel-product-sheet-name {
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .reel-product-sheet-price {
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            margin-top: 2px;
        }

        .reel-product-sheet-actions {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

        .reel-product-save,
        .reel-product-cart {
            flex: 1;
            min-height: 42px;
            border: none;
            border-radius: 12px;
            font-weight: 800;
            font-size: 13px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
        }

        .reel-product-save {
            background: rgba(255, 255, 255, 0.14);
            color: #fff;
        }

            .reel-product-save.saved {
                background: rgba(237, 73, 86, 0.22);
                color: #ff8a94;
            }

        .reel-product-cart {
            background: var(--accent-gradient);
            color: #fff;
        }

            .reel-product-cart:disabled {
                opacity: 0.6;
                cursor: default;
            }

        .reel-product-sheet-details {
            display: block;
            width: 100%;
            text-align: center;
            color: #cabdf0;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            border: none;
            background: transparent;
            padding: 4px 0 0;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <form id="antiForgeryForm" method="post" class="hidden-antiforgery-form">
        @Html.AntiForgeryToken()
    </form>

    <main id="exploreApp"
          class="explore-page"
          data-category="@(Model.SelectedCategory ?? string.Empty)"
          data-search-term="@(Model.SearchTerm ?? string.Empty)"
          data-category-id="@(Model.CategoryId?.ToString() ?? string.Empty)"
          data-store-id="@(Model.StoreId?.ToString() ?? string.Empty)"
          data-area="@(Model.Area ?? string.Empty)"
          data-min-price="@(Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
          data-max-price="@(Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
          data-type-filter="@(Model.TypeFilter ?? string.Empty)"
          data-current-page="1"
          data-has-more="@Model.HasMoreItems.ToString().ToLowerInvariant()">

        <section class="explore-intro">

            <div class="intro-slide active" style="background-image: url('https://commons.wikimedia.org/wiki/Special:FilePath/Fashion_model_looking_at_the_camera.jpg');"></div>
            <div class="intro-slide" style="background-image: url('https://commons.wikimedia.org/wiki/Special:FilePath/Smartphone_in_Hand_(Unsplash).jpg');"></div>
            <div class="intro-slide" style="background-image: url('https://commons.wikimedia.org/wiki/Special:FilePath/Fondue_dish.jpg');"></div>

            <div>
                <span class="eyebrow">Discover local stores</span>

                <h1>
                    Shop local,
                    <span>discover more.</span>
                </h1>

                <p>
                    Every active product appears here automatically, together with any existing image, carousel or reel content.
                    Open any item for details, reviews, wishlist, cart and familiar recommendations.
                </p>
            </div>

            <div class="intro-stat">
                <span class="stat-icon">
                    <i class="fa-solid fa-infinity"></i>
                </span>

                <div>
                    <strong>Infinite Explore</strong>
                    <span>New items load automatically while you scroll.</span>
                </div>
            </div>
        </section>

        <!-- =========================================================
             DISCOVERY BAR — search toolbar (products + store name
             autocomplete) with collapsible advanced filters
             ========================================================= -->
        <section class="discovery-bar">
            <form method="get" asp-page="/Customer1" id="exploreDiscoveryForm">
                <input type="hidden" name="category" value="@Model.SelectedCategory" />

                <div class="discovery-search">
                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="text"
                           id="exploreStoreSearchInput"
                           name="SearchTerm"
                           value="@Model.SearchTerm"
                           placeholder="Search products or stores by name"
                           autocomplete="off" />

                    <div id="exploreStoreSearchResults" class="store-search-dropdown hidden"></div>

                    <button type="button" class="discovery-toggle" id="exploreFiltersToggle"
                            aria-expanded="@(hasActiveExploreFilters ? "true" : "false")"
                            aria-controls="exploreAdvancedFilters">
                        Filters <i class="fa-solid fa-chevron-down"></i>
                    </button>

                    <button type="submit" class="discovery-submit" aria-label="Search">
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>

                <div class="discovery-filters market-filter-panel @(hasActiveExploreFilters ? "" : "is-collapsed")" id="exploreAdvancedFilters">

                    <div class="market-filter-grid">
                        <div class="market-filter-field">
                            <label for="exploreCategory">Category</label>
                            <select id="exploreCategory" name="CategoryId">
                                <option value="">All categories</option>
                                @foreach (var filterCategory in Model.FilterCategories)
                                {
                                    <option value="@filterCategory.CategoryID"
                                            selected="@(Model.CategoryId == filterCategory.CategoryID ? "selected" : null)">
                                        @filterCategory.CategoryName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="market-filter-field">
                            <label for="exploreStore">Store</label>
                            <select id="exploreStore" name="StoreId">
                                <option value="">All stores</option>
                                @foreach (var filterStore in Model.FilterStores)
                                {
                                    <option value="@filterStore.StoreID"
                                            selected="@(Model.StoreId == filterStore.StoreID ? "selected" : null)">
                                        @filterStore.StoreName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="market-filter-field">
                            <label for="exploreArea">Area</label>
                            <select id="exploreArea" name="Area">
                                <option value="">All areas</option>
                                @foreach (var filterArea in Model.FilterAreas)
                                {
                                    <option value="@filterArea" selected="@(Model.Area == filterArea ? "selected" : null)">@filterArea</option>
                                }
                            </select>
                        </div>

                        <div class="market-filter-field">
                            <label for="exploreMinPrice">Min price</label>
                            <input id="exploreMinPrice" type="number" min="0" step="0.01"
                                   name="MinPrice" value="@Model.MinPrice" placeholder="$0" />
                        </div>

                        <div class="market-filter-field">
                            <label for="exploreMaxPrice">Max price</label>
                            <input id="exploreMaxPrice" type="number" min="0" step="0.01"
                                   name="MaxPrice" value="@Model.MaxPrice" placeholder="Any" />
                        </div>
                    </div>

                    <div class="market-filter-actions">
                        <a asp-page="/Customer1" class="market-filter-clear">
                            <i class="fa-solid fa-rotate-left"></i> Clear
                        </a>
                        <button type="submit" class="market-filter-button">
                            <i class="fa-solid fa-magnifying-glass"></i> Search / Filter
                        </button>
                    </div>
                </div>
            </form>
        </section>

        <section class="category-section"
                 aria-label="Product categories">

            <a asp-page="/Customer1"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-storeId="@Model.StoreId"
               asp-route-area="@Model.Area"
               asp-route-minPrice="@Model.MinPrice"
               asp-route-maxPrice="@Model.MaxPrice"
               class="category-chip @(string.IsNullOrWhiteSpace(Model.SelectedCategory) ? "active" : string.Empty)">
                All
            </a>

            @foreach (var category in Model.NavbarCategories)
            {
                var isActive = string.Equals(
                Model.SelectedCategory,
                category,
                StringComparison.OrdinalIgnoreCase);

                <a asp-page="/Customer1"
                   asp-route-category="@category"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-storeId="@Model.StoreId"
                   asp-route-area="@Model.Area"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   class="category-chip @(isActive ? "active" : string.Empty)">
                    @category
                </a>
            }
        </section>

        @if (TempData["Success"] is string successMessage &&
        !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="server-message success">
                <i class="fa-solid fa-circle-check"></i>
                @successMessage
            </div>
        }

        @if (TempData["Error"] is string errorMessage &&
        !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="server-message error">
                <i class="fa-solid fa-circle-exclamation"></i>
                @errorMessage
            </div>
        }

        <section class="grid-heading">
            <div>
                <h2>
                    @(string.IsNullOrWhiteSpace(Model.SelectedCategory)
                        ? "Explore"
                        : Model.SelectedCategory)
                </h2>

                <p>
                    Click any item for a SHEIN-style quick view and familiar recommendations.
                </p>
            </div>

            <div class="grid-legend">
                <a asp-page="/Customer1"
                   asp-route-category="@Model.SelectedCategory"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-storeId="@Model.StoreId"
                   asp-route-area="@Model.Area"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   class="legend-filter @(string.IsNullOrWhiteSpace(Model.TypeFilter) ? "active" : "")">
                    <i class="fa-solid fa-layer-group"></i>
                    All
                </a>

                <a asp-page="/Customer1"
                   asp-route-category="@Model.SelectedCategory"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-storeId="@Model.StoreId"
                   asp-route-area="@Model.Area"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-typeFilter="Reel"
                   class="legend-filter @(string.Equals(Model.TypeFilter, "Reel", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <i class="fa-solid fa-play"></i>
                    Reel
                </a>

                <a asp-page="/Customer1"
                   asp-route-category="@Model.SelectedCategory"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-storeId="@Model.StoreId"
                   asp-route-area="@Model.Area"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-typeFilter="Carousel"
                   class="legend-filter @(string.Equals(Model.TypeFilter, "Carousel", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <i class="fa-regular fa-images"></i>
                    Carousel
                </a>

                <a asp-page="/Customer1"
                   asp-route-category="@Model.SelectedCategory"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-storeId="@Model.StoreId"
                   asp-route-area="@Model.Area"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-typeFilter="Product"
                   class="legend-filter @(string.Equals(Model.TypeFilter, "Product", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <i class="fa-solid fa-bag-shopping"></i>
                    Product
                </a>
            </div>
        </section>

        <section id="exploreGrid"
                 class="explore-grid"
                 aria-live="polite">

            @foreach (var item in Model.InitialItems)
            {
                var isPost = string.Equals(
                item.GridItemType,
                "Post",
                StringComparison.OrdinalIgnoreCase);

                var isVideo = string.Equals(
                item.MediaType,
                "Video",
                StringComparison.OrdinalIgnoreCase);

                var isReel = string.Equals(
                item.PostType,
                "Reel",
                StringComparison.OrdinalIgnoreCase);

                var isCarousel = string.Equals(
                item.PostType,
                "Carousel",
                StringComparison.OrdinalIgnoreCase);

                <button type="button"
                        class="explore-tile"
                        data-grid-item
                        data-item-type="@item.GridItemType"
                        data-post-id="@item.ExplorePostID"
                        data-product-id="@item.ProductID"
                        data-post-type="@item.PostType"
                        aria-label="@(isPost
                            ? $"Open post from {item.StoreName}"
                            : $"Open product {item.ProductName}")">

                    <span class="tile-media">
                        @if (isVideo &&
                       string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                        {
                            <video muted
                                   loop
                                   playsinline
                                   preload="metadata"
                                   data-reel-preview>
                                <source src="@item.MediaUrl" />
                            </video>
                        }
                        else
                        {
                            <img src="@(isVideo
                                    ? item.ThumbnailUrl
                                    : item.MediaUrl)"
                                 alt="@(item.ProductName ?? item.StoreName)"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/product-placeholder.svg';" />
                        }
                    </span>

                    <span class="tile-gradient"></span>

                    <span class="tile-top">
                        @if (item.IsBoosted)
                        {
                            <span class="tile-badge sponsored-badge">
                                <i class="fa-solid fa-bolt"></i>
                                Sponsored
                            </span>
                        }
                        else if (isReel)
                        {
                            <span class="tile-badge">
                                <i class="fa-solid fa-play"></i>
                                Reel
                            </span>
                        }
                        else if (isCarousel)
                        {
                            <span class="tile-badge">
                                <i class="fa-regular fa-images"></i>
                                @item.MediaCount
                            </span>
                        }
                        else if (!isPost)
                        {
                            <span class="tile-badge">
                                <i class="fa-solid fa-bag-shopping"></i>
                                Product
                            </span>
                        }

                        @if (item.ProductPrice.HasValue)
                        {
                            <span class="tile-price">
                                $@item.ProductPrice.Value.ToString("N2")
                            </span>
                        }
                    </span>

                    <span class="tile-bottom">
                        <span class="tile-store">
                            @if (!string.IsNullOrWhiteSpace(item.StoreLogoUrl))
                            {
                                <img src="@item.StoreLogoUrl"
                                     alt="@item.StoreName"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                                <span class="tile-store-fallback">
                                    @(string.IsNullOrWhiteSpace(item.StoreName)
                                        ? "S"
                                        : item.StoreName.Substring(0, 1).ToUpper())
                                </span>
                            }
                            else
                            {
                                <span class="tile-store-fallback visible">
                                    @(string.IsNullOrWhiteSpace(item.StoreName)
                                        ? "S"
                                        : item.StoreName.Substring(0, 1).ToUpper())
                                </span>
                            }

                            <span>@item.StoreName</span>
                        </span>

                        @if (!string.IsNullOrWhiteSpace(item.ProductName))
                        {
                            <strong>@item.ProductName</strong>
                        }
                    </span>
                </button>
            }
        </section>

        <div id="emptyExploreState"
             class="empty-explore @(Model.InitialItems.Any() ? "hidden" : string.Empty)">

            <span>
                <i class="fa-regular fa-compass"></i>
            </span>

            <h3>No Explore items found</h3>

            <p>
                Try another category or return later when stores publish new content.
            </p>
        </div>

        <div id="infiniteLoader"
             class="infinite-loader @(Model.HasMoreItems ? string.Empty : "hidden")">

            <span class="loader-spinner"></span>
            <span>Loading more discoveries...</span>
        </div>

        <div id="infiniteSentinel"
             class="infinite-sentinel"
             aria-hidden="true"></div>

        <div id="endOfFeed"
             class="end-of-feed @(!Model.HasMoreItems && Model.InitialItems.Any() ? string.Empty : "hidden")">

            <i class="fa-solid fa-circle-check"></i>
            You reached the end for now.
        </div>
    </main>

