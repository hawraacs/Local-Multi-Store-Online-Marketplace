@page
@model Local_Multi_Store_Online_Marketplace.Pages.AdminAssignDeliveryModel

@{
    ViewData["Title"] = "Assign Delivery";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #6366F1;
            --brand-dark: #4F46E5;
            --brand-soft: rgba(99, 102, 241, 0.08);
            --navy: #0F172A;
            --bg: #F8FAFC;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --border: #E2E8F0;
            --text: #0F172A;
            --muted: #64748B;
            --positive: #16A34A;
            --positive-bg: #DCFCE7;
            --positive-txt: #15803D;
            --danger: #DC2626;
            --danger-bg: #FEE2E2;
            --danger-txt: #B91C1C;
            --radius-sm: 10px;
            --radius: 16px;
            --radius-lg: 22px;
            --shadow: 0 1px 3px rgba(15,23,42,0.06), 0 6px 20px -8px rgba(15,23,42,0.10);
            --font: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        .assign-page {
            max-width: 100%;
            width: 100%;
            margin: 0 auto;
            padding: 0 20px 48px;
            color: var(--text);
            font-family: var(--font);
        }

        /* ── Header ── */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            padding: 28px 4px 24px;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

            .page-header h1 {
                font-size: 24px;
                font-weight: 800;
                letter-spacing: -0.03em;
                margin: 0 0 4px;
            }

            .page-header p {
                font-size: 13.5px;
                color: var(--muted);
                margin: 0;
            }

        /* ── Top links ── */
        .top-links {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .link-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--surface);
            color: var(--text);
            border: 1px solid var(--border);
            padding: 9px 16px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 600;
            font-size: 13.5px;
            transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
        }

            .link-btn:hover {
                border-color: var(--brand);
                color: var(--brand);
                background: var(--brand-soft);
            }

        /* ── Messages ── */
        .message {
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 20px;
            font-weight: 600;
            font-size: 13.5px;
            text-align: center;
        }

        .success {
            background: var(--positive-bg);
            color: var(--positive-txt);
            border: 1px solid #86efac;
        }

        .error {
            background: var(--danger-bg);
            color: var(--danger-txt);
            border: 1px solid #fca5a5;
        }

        /* ── Panel / Table ── */
        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 8px;
            box-shadow: var(--shadow);
        }

        .table-responsive {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            padding: 12px 16px;
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--muted);
            background: var(--surface-2);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

            thead th:first-child {
                border-radius: var(--radius-sm) 0 0 0;
            }

            thead th:last-child {
                border-radius: 0 var(--radius-sm) 0 0;
            }

        tbody td {
            padding: 14px 16px;
            font-size: 13.5px;
            border-bottom: 1px solid var(--border);
            color: var(--text);
            font-weight: 500;
            vertical-align: middle;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover td {
            background: var(--surface-2);
        }

        .order-number {
            font-weight: 700;
            color: var(--navy);
            display: block;
        }

        .customer-info {
            display: block;
            color: var(--muted);
            font-size: 12px;
            margin-top: 3px;
        }

        /* ── Select + Button ── */
        select {
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            width: 100%;
            min-width: 220px;
            max-width: 340px;
            background: var(--surface);
            color: var(--text);
            font-family: var(--font);
            font-size: 13px;
            outline: none;
            cursor: pointer;
        }

            select:focus {
                border-color: var(--brand);
                box-shadow: 0 0 0 3px var(--brand-soft);
            }

        button {
            background: var(--brand);
            color: #fff;
            border: none;
            padding: 9px 18px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-weight: 700;
            font-size: 13px;
            font-family: var(--font);
            transition: background 0.18s ease;
        }

            button:hover:not(:disabled) {
                background: var(--brand-dark);
            }

            button:disabled {
                background: #cbd5e1;
                color: #64748b;
                cursor: not-allowed;
                opacity: 1;
            }

        /* ── Product column (same pattern as CustomerOrders.cshtml) ── */
        .products-cell {
            min-width: 210px;
            max-width: 340px;
        }

        .product-line {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 6px;
            padding-bottom: 6px;
            border-bottom: 1px dashed var(--border);
        }

            .product-line:last-child {
                margin-bottom: 0;
                padding-bottom: 0;
                border-bottom: none;
            }

        .product-name {
            color: var(--text);
            font-weight: 600;
            line-height: 1.35;
            word-break: break-word;
        }

        .product-quantity {
            flex-shrink: 0;
            padding: 2px 8px;
            background: var(--brand-soft);
            color: var(--brand-dark);
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .no-products {
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        /* ── Delivery Region column ── */
        .region-cell {
            min-width: 150px;
        }

        .region-badge {
            display: inline-block;
            background: var(--surface-2);
            color: var(--text);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 4px 12px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .no-delivery {
            display: inline-block;
            background: var(--danger-bg);
            color: var(--danger-txt);
            border: 1px solid #fca5a5;
            border-radius: var(--radius-sm);
            padding: 8px 12px;
            font-size: 12.5px;
            font-weight: 600;
        }

        .empty {
            text-align: center;
            color: var(--muted);
            padding: 48px 16px;
            font-weight: 500;
            font-size: 14px;
        }

        /* ── In-header filter row (replaces the old top filter panel) ── */
        thead .filter-row th {
            padding: 8px 10px 12px;
            background: var(--surface-2);
            border-bottom: 1px solid var(--border);
            font-weight: 400;
            text-transform: none;
            letter-spacing: normal;
        }

        .col-filter {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .col-filter input,
            .col-filter select {
                padding: 6px 8px;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border);
                font-family: var(--font);
                font-size: 12.5px;
                background: var(--surface);
                color: var(--text);
                outline: none;
                width: 100%;
                min-width: 90px;
            }

                .col-filter input:focus,
                .col-filter select:focus {
                    border-color: var(--brand);
                    box-shadow: 0 0 0 3px var(--brand-soft);
                }

        .col-filter-range {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .col-filter-range input {
                width: 100%;
            }

        .col-filter-sub-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--muted);
        }

        .clear-filters-btn {
            background: var(--surface);
            color: var(--muted);
            border: 1px solid var(--border);
            padding: 6px 12px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-weight: 700;
            font-size: 12px;
            font-family: var(--font);
            width: 100%;
        }

            .clear-filters-btn:hover {
                border-color: var(--brand);
                color: var(--brand);
            }

        .no-filter-results {
            text-align: center;
            color: var(--muted);
            padding: 32px 16px;
            font-weight: 500;
            font-size: 13.5px;
        }

        /* NEW — brief highlight pulse for a row inserted live via
                   SignalR (a store owner just confirmed this order). */
        @@keyframes assignRowHighlightPulse {
            0% {
                background-color: rgba(99, 102, 241, 0.16);
            }

            100% {
                background-color: transparent;
            }
        }

        tr.live-row-highlight td {
            animation: assignRowHighlightPulse 2.5s ease-out;
            background-color: rgba(99, 102, 241, 0.08) !important;
        }

        @@media (max-width: 850px) {
            .assign-page {
                padding: 0 12px 32px;
            }

            table {
                min-width: 1050px;
            }
        }
    </style>
}

<partial name="_AppHubScript" />

<div class="assign-page">

    <div class="page-header">
        <div>
            <h1>Assign Delivery Person</h1>
            <p>Match unassigned orders with available delivery staff</p>
        </div>
        <div class="top-links">
            <a href="/AdminDelivery" class="link-btn">
                <i class="fas fa-truck"></i> Delivery Requests
            </a>
            <a href="/AdminOrders" class="link-btn">
                <i class="fas fa-shopping-cart"></i> View Orders
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="message success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="message error">
            @TempData["Error"]
        </div>
    }

    @if (Model.Orders == null || !Model.Orders.Any())
    {
        <div class="panel" id="emptyStatePanel">
            <div class="empty" id="emptyStateMessage">
                No unassigned orders available for delivery assignment.
            </div>
        </div>
    }

    <div class="panel" id="assignPanel" style="display:@(Model.Orders != null && Model.Orders.Any() ? "block" : "none");">
        <div class="table-responsive">
            <table id="assignTable">
                <thead>
                    <tr>
                        <th>Order Number</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Product</th>
                        <th>Delivery Region</th>
                        <th>Assign Delivery Person</th>
                        <th>Action</th>
                    </tr>

                    <tr class="filter-row">
                        <th>
                            <div class="col-filter">
                                <input type="text" id="filterOrderNumber" placeholder="Search order #" />
                            </div>
                        </th>

                        <th>
                            <div class="col-filter">
                                <input type="text" id="filterCustomerName" placeholder="Search customer" />
                            </div>
                        </th>

                        <th>
                            <div class="col-filter-range">
                                <span class="col-filter-sub-label">From</span>
                                <input type="date" id="filterDateFrom" />
                                <span class="col-filter-sub-label">To</span>
                                <input type="date" id="filterDateTo" />
                            </div>
                        </th>

                        <th>
                            <div class="col-filter">
                                <select id="filterStatus">
                                    <option value="">All</option>
                                    @if (Model.Orders != null)
                                    {
                                        @foreach (var status in Model.Orders
                                       .Select(o => o.Status)
                                       .Where(s => !string.IsNullOrWhiteSpace(s))
                                       .Distinct()
                                       .OrderBy(s => s))
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    }
                                </select>
                            </div>
                        </th>

                        <th>
                            <div class="col-filter-range">
                                <span class="col-filter-sub-label">Min</span>
                                <input type="number" id="filterAmountMin" placeholder="Min" min="0" step="0.01" />
                                <span class="col-filter-sub-label">Max</span>
                                <input type="number" id="filterAmountMax" placeholder="Max" min="0" step="0.01" />
                            </div>
                        </th>

                        <th>
                            <div class="col-filter">
                                <input type="text" id="filterProduct" placeholder="Search product" />
                            </div>
                        </th>

                        <th>
                            <div class="col-filter">
                                <input type="text" id="filterRegion" placeholder="Search region" />
                            </div>
                        </th>

                        <th>
                            <div class="col-filter">
                                <input type="text" id="filterDeliveryPerson" placeholder="Search delivery person" />
                            </div>
                        </th>

                        <th>
                            <button type="button" class="clear-filters-btn" id="clearFiltersBtn">
                                Clear
                            </button>
                        </th>
                    </tr>
                </thead>

                <tbody id="assignTableBody">
                    @if (Model.Orders != null)
                    {
                        @foreach (var order in Model.Orders)
                        {
                            var formId = $"assignForm_{order.OrderID}";

                            var orderNumberSearchText =
                            order.OrderNumber.ToLower();

                            var customerSearchText =
                            order.CustomerName.ToLower();

                            var productSearchText = order.Products != null
                            ? string.Join(" | ", order.Products.Select(p => p.ProductName))
                            : "";

                            var deliveryPeopleSearchText = order.AvailableDeliveryPeople != null
                            ? string.Join(" | ", order.AvailableDeliveryPeople.Select(p => p.FullName))
                            : "";

                            <tr id="order-row-@order.OrderID"
                                data-order-number="@orderNumberSearchText"
                                data-customer-name="@customerSearchText"
                                data-customer-id="@order.CustomerID"
                                data-product="@productSearchText.ToLower()"
                                data-region="@order.DeliveryRegion.ToLower()"
                                data-status="@order.Status"
                                data-delivery-people="@deliveryPeopleSearchText.ToLower()"
                                data-date="@order.OrderDate.ToString("yyyy-MM-dd")"
                                data-total="@order.TotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <td>
                                    <span class="order-number">
                                        @order.OrderNumber
                                    </span>
                                </td>

                                <td>
                                    @order.CustomerName
                                    <span class="customer-info">
                                        ID: @order.CustomerID
                                    </span>
                                </td>

                                <td>
                                    @order.OrderDate.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    @order.Status
                                </td>

                                <td>
                                    $@order.TotalAmount.ToString("N2")
                                </td>

                                <td class="products-cell">
                                    @if (order.Products != null &&
                                   order.Products.Count > 0)
                                    {
                                        @foreach (var product in order.Products)
                                        {
                                            <div class="product-line">
                                                <span class="product-name">
                                                    @product.ProductName
                                                </span>

                                                <span class="product-quantity">
                                                    ×@product.Quantity
                                                </span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="no-products">
                                            No products
                                        </span>
                                    }
                                </td>

                                <td class="region-cell">
                                    <span class="region-badge">
                                        @order.DeliveryRegion
                                    </span>
                                </td>

                                <td>
                                    @if (order.AvailableDeliveryPeople != null &&
                                   order.AvailableDeliveryPeople.Any())
                                    {
                                        <form method="post"
                                              asp-page-handler="Assign"
                                              id="@formId">

                                            <input type="hidden"
                                                   name="orderId"
                                                   value="@order.OrderID" />

                                            <select name="deliveryPersonId" required>
                                                <option value="">
                                                    Select delivery
                                                </option>

                                                @foreach (var groupLabel in new[] { "Same Area", "Nearby", "Far" })
                                                {
                                                    var groupPeople = order.AvailableDeliveryPeople
                                                    .Where(p => p.AreaLabel == groupLabel)
                                                    .ToList();

                                                    if (groupPeople.Any())
                                                    {
                                                        var groupEmoji = groupLabel == "Same Area"
                                                        ? "🟢"
                                                        : groupLabel == "Nearby"
                                                        ? "🟡"
                                                        : "⚪";

                                                        <optgroup label="@(groupEmoji + " " + groupLabel)">
                                                            @foreach (var delivery in groupPeople)
                                                            {
                                                                <option value="@delivery.DeliveryPersonID">
                                                                    @delivery.FullName - @delivery.Area - @delivery.VehicleType
                                                                </option>
                                                            }
                                                        </optgroup>
                                                    }
                                                }
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="no-delivery">
                                            No eligible delivery person
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (order.AvailableDeliveryPeople != null &&
                                   order.AvailableDeliveryPeople.Any())
                                    {
                                        <button type="submit"
                                                form="@formId">
                                            Assign
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" disabled>
                                            Unavailable
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="no-filter-results" id="noFilterResults" style="display:none;">
                No orders match the current filters.
            </div>
        </div>
    </div>

</div>

<script>
    (function() {
        // ==========================================
        // CLIENT-SIDE FILTERING ONLY.
        //
        // This purely shows/hides existing <tr> elements based on
        // their data-* attributes (already rendered server-side, or
        // inserted live below). It does not touch, resubmit, or alter
        // any of the existing Assign forms, POST handlers, or row
        // content in any way.
        // ==========================================
        var table = document.getElementById('assignTable');
        if (!table) {
            return;
        }

        var noResultsEl = document.getElementById('noFilterResults');

        var orderNumberInput = document.getElementById('filterOrderNumber');
        var customerNameInput = document.getElementById('filterCustomerName');
        var productInput = document.getElementById('filterProduct');
        var regionInput = document.getElementById('filterRegion');
        var statusSelect = document.getElementById('filterStatus');
        var deliveryPersonInput = document.getElementById('filterDeliveryPerson');
        var dateFromInput = document.getElementById('filterDateFrom');
        var dateToInput = document.getElementById('filterDateTo');
        var amountMinInput = document.getElementById('filterAmountMin');
        var amountMaxInput = document.getElementById('filterAmountMax');
        var clearBtn = document.getElementById('clearFiltersBtn');

        function getRows() {
            return Array.prototype.slice.call(
                table.querySelectorAll('tbody tr'));
        }

        function applyFilters() {
            var orderNumberVal = orderNumberInput.value.trim().toLowerCase();
            var customerNameVal = customerNameInput.value.trim().toLowerCase();
            var productVal = productInput.value.trim().toLowerCase();
            var regionVal = regionInput.value.trim().toLowerCase();
            var statusVal = statusSelect.value;
            var deliveryPersonVal = deliveryPersonInput.value.trim().toLowerCase();
            var dateFromVal = dateFromInput.value; // yyyy-MM-dd or ""
            var dateToVal = dateToInput.value;
            var amountMinVal = amountMinInput.value !== '' ? parseFloat(amountMinInput.value) : null;
            var amountMaxVal = amountMaxInput.value !== '' ? parseFloat(amountMaxInput.value) : null;

            var visibleCount = 0;

            getRows().forEach(function(row) {
                var matches = true;

                if (orderNumberVal) {
                    var orderNumberSuffix = row.dataset.orderNumber.replace(/^ord-/, '');

                    if (orderNumberSuffix.indexOf(orderNumberVal) !== 0) {
                        matches = false;
                    }
                }

                if (matches && customerNameVal) {
                    if (/^\d+$/.test(customerNameVal)) {
                        if (row.dataset.customerId.indexOf(customerNameVal) !== 0) {
                            matches = false;
                        }
                    } else if (row.dataset.customerName.indexOf(customerNameVal) === -1) {
                        matches = false;
                    }
                }

                if (matches && deliveryPersonVal &&
                    row.dataset.deliveryPeople.indexOf(deliveryPersonVal) === -1) {
                    matches = false;
                }

                if (matches && productVal &&
                    row.dataset.product.indexOf(productVal) === -1) {
                    matches = false;
                }

                if (matches && regionVal &&
                    row.dataset.region.indexOf(regionVal) === -1) {
                    matches = false;
                }

                if (matches && statusVal &&
                    row.dataset.status !== statusVal) {
                    matches = false;
                }

                if (matches && dateFromVal &&
                    row.dataset.date < dateFromVal) {
                    matches = false;
                }

                if (matches && dateToVal &&
                    row.dataset.date > dateToVal) {
                    matches = false;
                }

                if (matches && amountMinVal !== null) {
                    var total = parseFloat(row.dataset.total);
                    if (isNaN(total) || total < amountMinVal) {
                        matches = false;
                    }
                }

                if (matches && amountMaxVal !== null) {
                    var totalMax = parseFloat(row.dataset.total);
                    if (isNaN(totalMax) || totalMax > amountMaxVal) {
                        matches = false;
                    }
                }

                row.style.display = matches ? '' : 'none';

                if (matches) {
                    visibleCount++;
                }
            });

            if (noResultsEl) {
                noResultsEl.style.display = visibleCount === 0 ? '' : 'none';
            }
        }

        [orderNumberInput, customerNameInput, productInput, regionInput,
            deliveryPersonInput, dateFromInput, dateToInput,
            amountMinInput, amountMaxInput].forEach(function(input) {
                input.addEventListener('input', applyFilters);
            });

        statusSelect.addEventListener('change', applyFilters);

        if (clearBtn) {
            clearBtn.addEventListener('click', function() {
                orderNumberInput.value = '';
                customerNameInput.value = '';
                productInput.value = '';
                regionInput.value = '';
                statusSelect.value = '';
                deliveryPersonInput.value = '';
                dateFromInput.value = '';
                dateToInput.value = '';
                amountMinInput.value = '';
                amountMaxInput.value = '';
                applyFilters();
            });
        }

        applyFilters();

        // =====================================================
        // NEW — LIVE ROW INSERTION
        //
        // When a store owner confirms an order (Order/Index.cshtml.cs
        // already broadcasts "OrderStatusUpdated" via the shared
        // AppHub), fetch that order's full row data and insert it
        // here instantly, so admins don't have to refresh to see
        // newly-confirmed orders become assignable.
        // =====================================================
        function escapeHtml(value) {
            var div = document.createElement('div');
            div.textContent = value == null ? '' : String(value);
            return div.innerHTML;
        }

        function buildDeliverySelectHtml(orderId, people) {
            if (!people || people.length === 0) {
                return '<span class="no-delivery">No eligible delivery person</span>';
            }

            var groups = [
                { label: 'Same Area', emoji: '🟢' },
                { label: 'Nearby', emoji: '🟡' },
                { label: 'Far', emoji: '⚪' }
            ];

            var optionsHtml = '<option value="">Select delivery</option>';

            groups.forEach(function(group) {
                var groupPeople = people.filter(function(p) {
                    return p.areaLabel === group.label;
                });

                if (groupPeople.length === 0) return;

                optionsHtml += '<optgroup label="' + escapeHtml(group.emoji + ' ' + group.label) + '">';

                groupPeople.forEach(function(p) {
                    optionsHtml +=
                        '<option value="' + p.deliveryPersonID + '">' +
                        escapeHtml(p.fullName + ' - ' + p.area + ' - ' + p.vehicleType) +
                        '</option>';
                });

                optionsHtml += '</optgroup>';
            });

            var formId = 'assignForm_' + orderId;

            return (
                '<form method="post" action="?handler=Assign" id="' + formId + '">' +
                '<input type="hidden" name="orderId" value="' + orderId + '" />' +
                '<select name="deliveryPersonId" required>' + optionsHtml + '</select>' +
                '</form>'
            );
        }

        function buildProductsHtml(products) {
            if (!products || products.length === 0) {
                return '<span class="no-products">No products</span>';
            }

            return products.map(function(p) {
                return (
                    '<div class="product-line">' +
                    '<span class="product-name">' + escapeHtml(p.productName) + '</span>' +
                    '<span class="product-quantity">×' + escapeHtml(p.quantity) + '</span>' +
                    '</div>'
                );
            }).join('');
        }

        function insertOrUpdateLiveOrderRow(order) {
            var existingRow = document.getElementById('order-row-' + order.orderID);
            var hasDeliveryPeople = order.availableDeliveryPeople && order.availableDeliveryPeople.length > 0;

            var orderNumberLower = (order.orderNumber || '').toLowerCase();
            var customerNameLower = (order.customerName || '').toLowerCase();
            var productSearchText = (order.products || []).map(function(p) { return p.productName; }).join(' | ').toLowerCase();
            var deliverySearchText = (order.availableDeliveryPeople || []).map(function(p) { return p.fullName; }).join(' | ').toLowerCase();
            var regionLower = (order.deliveryRegion || '').toLowerCase();
            var orderDate = new Date(order.orderDate);
            var dateAttr = !isNaN(orderDate.getTime()) ? orderDate.toISOString().slice(0, 10) : '';
            var dateDisplay = !isNaN(orderDate.getTime())
                ? orderDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) +
                ' ' + orderDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                : '';

            var row = existingRow || document.createElement('tr');
            row.id = 'order-row-' + order.orderID;
            row.setAttribute('data-order-number', orderNumberLower);
            row.setAttribute('data-customer-name', customerNameLower);
            row.setAttribute('data-customer-id', String(order.customerID));
            row.setAttribute('data-product', productSearchText);
            row.setAttribute('data-region', regionLower);
            row.setAttribute('data-status', order.status);
            row.setAttribute('data-delivery-people', deliverySearchText);
            row.setAttribute('data-date', dateAttr);
            row.setAttribute('data-total', String(order.totalAmount));

            row.innerHTML =
                '<td>' +
                '<span class="order-number">' + escapeHtml(order.orderNumber) + '</span>' +
                '</td>' +
                '<td>' + escapeHtml(order.customerName) +
                '<span class="customer-info">ID: ' + escapeHtml(order.customerID) + '</span>' +
                '</td>' +
                '<td>' + escapeHtml(dateDisplay) + '</td>' +
                '<td>' + escapeHtml(order.status) + '</td>' +
                '<td>$' + Number(order.totalAmount).toFixed(2) + '</td>' +
                '<td class="products-cell">' + buildProductsHtml(order.products) + '</td>' +
                '<td class="region-cell"><span class="region-badge">' + escapeHtml(order.deliveryRegion) + '</span></td>' +
                '<td>' + buildDeliverySelectHtml(order.orderID, order.availableDeliveryPeople) + '</td>' +
                '<td>' +
                (hasDeliveryPeople
                    ? '<button type="submit" form="assignForm_' + order.orderID + '">Assign</button>'
                    : '<button type="button" disabled>Unavailable</button>') +
                '</td>';

            if (!existingRow) {
                var tbody = document.getElementById('assignTableBody');
                if (tbody) {
                    tbody.prepend(row);
                }

                // The empty-state panel/message only exists in the initial
                // server-rendered HTML when there were zero orders — once a
                // live row arrives, make sure the table panel is visible.
                var emptyPanel = document.getElementById('emptyStatePanel');
                if (emptyPanel) {
                    emptyPanel.style.display = 'none';
                }

                var assignPanel = document.getElementById('assignPanel');
                if (assignPanel) {
                    assignPanel.style.display = 'block';
                }
            }

            row.classList.add('live-row-highlight');
            row.scrollIntoView({ behavior: 'smooth', block: 'center' });

            applyFilters();
        }

        if (window.appHubReady) {
            window.appHubReady.then(function() {
                window.appHub.on("OrderStatusUpdated", function(orderId, newStatus) {
                    if (String(newStatus).trim().toLowerCase() !== 'confirmed') return;

                    fetch('?handler=OrderRowData&orderId=' + encodeURIComponent(orderId))
                        .then(function(res) { return res.json(); })
                        .then(function(result) {
                            if (result && result.success && result.order) {
                                insertOrUpdateLiveOrderRow(result.order);
                            }
                        })
                        .catch(function() {
                            // Silently ignore — worst case the admin sees it
                            // on their next manual refresh.
                        });
                });
            });
        }
    })();
</script>
