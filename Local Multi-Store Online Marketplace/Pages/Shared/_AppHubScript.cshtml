@* Pages/Shared/_AppHubScript.cshtml *@
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script>
    if (!window.appHub) {
        window.appHub = new signalR.HubConnectionBuilder()
            .withUrl("/apphub")
            .withAutomaticReconnect()
            .build();

        window.appHubReady = window.appHub.start()
            .catch(err => console.error("AppHub connection error:", err));
    }
</script>