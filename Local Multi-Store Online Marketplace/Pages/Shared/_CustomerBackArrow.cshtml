@{
    // Optional: pass a custom fallback route from the page that includes
    // this partial, e.g.:
    //   <partial name="_CustomerBackArrow" view-data='@(new ViewDataDictionary(ViewData) { ["BackFallbackUrl"] = "/CustomerFeed" })' />
    // If not set, defaults to /CustomerFeed.
    var backFallbackUrl = ViewData["BackFallbackUrl"] as string ?? "/CustomerFeed";

    // Optional: render in normal document flow instead of floating fixed
    // in the corner. Use this on pages with their own left sidebar (like
    // CustomerFeed) where a fixed top-left button would sit on top of
    // that sidebar's own content:
    //   <partial name="_CustomerBackArrow" view-data='@(new ViewDataDictionary(ViewData) { ["BackArrowInline"] = true })' />
    var isInline = ViewData["BackArrowInline"] as bool? ?? false;
}

<style>
    /* ============================================================
                   SHARED BACK ARROW — same button, same behavior on every
                   page that includes this partial. By default it floats
                   fixed in the same top-left spot everywhere (same idea
                   as the bottom nav always being pinned to the bottom).
                   Pages that need it to sit inside their own layout
                   instead (e.g. a sidebar) pass BackArrowInline = true.
                   ============================================================ */
    .back-arrow-btn {
        position: fixed;
        top: 18px;
        left: 18px;
        z-index: 250;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 12px;
        border: 1px solid var(--border-color, #ece8f6);
        background: var(--card-bg, #ffffff);
        color: var(--text-secondary, #6b6478);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        cursor: pointer;
        text-decoration: none;
        box-shadow: var(--shadow-md, 0 10px 30px rgba(109, 40, 217, 0.08));
        transition: all 0.2s ease;
    }

        .back-arrow-btn:hover {
            border-color: var(--accent-color, #6d28d9);
            color: var(--accent-color, #6d28d9);
            background: var(--accent-light, #f3effe);
            transform: translateX(-2px);
        }

    @@media (max-width: 560px) {
        .back-arrow-btn {
            top: 14px;
            left: 14px;
            width: 36px;
            height: 36px;
            font-size: 14px;
            border-radius: 10px;
        }
    }

    /* INLINE VARIANT — sits in normal document flow wherever the
                   page places it (e.g. above a sidebar's own nav list),
                   instead of floating fixed over the page. */
    .back-arrow-btn.back-arrow-btn--inline {
        position: static;
        top: auto;
        left: auto;
        width: 36px;
        height: 36px;
        margin-bottom: 6px;
        border-radius: 50%;
        box-shadow: none;
        transition: border-color 0.2s ease, color 0.2s ease;
    }

        .back-arrow-btn.back-arrow-btn--inline:hover {
            transform: none;
        }
</style>

<button type="button"
        class="back-arrow-btn @(isInline ? "back-arrow-btn--inline" : "")"
        data-fallback-url="@backFallbackUrl"
        aria-label="Go back">
    <i class="fa-solid fa-arrow-left"></i>
</button>

<script>
    // =====================================================
    // Shared by every page that includes _CustomerBackArrow.
    // Wired with addEventListener (not inline onclick) so it
    // isn't blocked by a CSP that disallows inline handlers.
    // Self-initializes, so it works regardless of whether the
    // host page fires its own DOMContentLoaded listeners.
    // Wires ALL .back-arrow-btn elements on the page (a page may
    // legitimately render two — a floating one for mobile and an
    // inline one for a desktop sidebar, hidden/shown by CSS).
    //
    // Behavior: goes to the real previous page in browser
    // history. Falls back to each button's own data-fallback-url
    // (or /CustomerFeed) only when there's no history to go back
    // to (page opened directly, new tab, bookmark, etc.).
    // =====================================================
    (function() {
        function wireBackArrows() {
            document.querySelectorAll(".back-arrow-btn").forEach(function(btn) {
                if (btn.dataset.wired === "true") return;
                btn.dataset.wired = "true";

                var fallbackUrl = btn.getAttribute("data-fallback-url") || "/CustomerFeed";

                btn.addEventListener("click", function() {
                    if (window.history.length > 1) {
                        window.history.back();
                    } else {
                        window.location.href = fallbackUrl;
                    }
                });
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", wireBackArrows);
        } else {
            wireBackArrows();
        }
    })();
</script>
