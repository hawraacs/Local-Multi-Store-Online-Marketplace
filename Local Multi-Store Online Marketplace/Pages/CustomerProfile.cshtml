@page
@model Local_Multi_Store_Online_Marketplace.Pages.CustomerProfileModel

@{
    Layout = null;

    var deliveryLoginError =
        TempData["DeliveryLoginError"]?.ToString();

    var storeOwnerLoginError =
        TempData["StoreOwnerLoginError"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>My Profile | Realnest</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-color: #faf9fc;
                --card-bg: #ffffff;
                --border-color: #ece8f6;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --success-color: #10b981;
                --error-color: #dc2626;
                --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                --font-display: 'Fraunces', Georgia, serif;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.05);
                --shadow-md: 0 10px 26px rgba(109, 40, 217, 0.09);
                --shadow-lg: 0 20px 44px rgba(30, 27, 46, 0.16);
                --radius-lg: 18px;
                --radius-md: 12px;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: var(--font-family);
                background: var(--bg-color);
                color: var(--text-primary);
                min-height: 100vh;
                padding-bottom: 100px;
            }

            .header-menu-btn {
                position: absolute;
                top: 14px;
                right: 16px;
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--accent-light);
                border: 1px solid var(--border-color);
                color: var(--accent-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 15px;
                cursor: pointer;
                transition: background-color 0.15s ease, color 0.15s ease;
                z-index: 2;
            }

                .header-menu-btn:hover {
                    background: var(--accent-color);
                    color: #ffffff;
                }

            .profile-container {
                max-width: 1180px;
                width: 100%;
                margin: 28px auto;
                padding: 0 24px;
            }

            .main-content {
                width: 100%;
                min-width: 0;
            }

            /* ===================== Profile header ===================== */
            .profile-header-card {
                position: relative;
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-md);
                margin-bottom: 20px;
                overflow: hidden;
            }

            .profile-cover {
                height: 130px;
                background: radial-gradient(circle 160px at 82% 30%, rgba(124, 58, 237, 0.10), transparent 70%), radial-gradient(circle 140px at 62% 100%, rgba(99, 102, 241, 0.08), transparent 70%), radial-gradient(circle, rgba(109, 40, 217, 0.10) 1px, transparent 1.4px) 0 0/16px 16px, #ffffff;
                position: relative;
            }

            .ig-top-row {
                display: flex;
                align-items: flex-end;
                gap: 20px;
                padding: 0 28px;
                margin-top: -58px;
                position: relative;
                z-index: 1;
            }

            .ig-avatar-ring {
                width: 108px;
                height: 108px;
                border-radius: 50%;
                padding: 4px;
                background: var(--accent-gradient);
                flex-shrink: 0;
                box-shadow: var(--shadow-md);
                position: relative;
            }

            .ig-avatar {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                background: var(--accent-gradient);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 38px;
                color: #ffffff;
                border: 3px solid #ffffff;
            }

            .avatar-edit-badge {
                position: absolute;
                right: 2px;
                bottom: 2px;
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: var(--accent-color);
                color: #fff;
                border: 3px solid #fff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
            }

            .ig-identity {
                padding-bottom: 16px;
                flex-grow: 1;
                min-width: 0;
            }

            .ig-name {
                font-family: var(--font-display);
                font-size: 26px;
                font-weight: 700;
                letter-spacing: -0.01em;
                color: var(--text-primary);
                display: flex;
                align-items: center;
                gap: 9px;
                line-height: 1.3;
            }

            .ig-joined {
                font-size: 13px;
                color: var(--text-secondary);
                margin-top: 4px;
            }

            .ig-badges {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                padding: 0 28px 22px;
            }

            .sidebar-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: var(--accent-light);
                padding: 6px 12px;
                border-radius: 50px;
                font-size: 12.5px;
                font-weight: 700;
                color: var(--accent-color);
            }

            .loyalty-badge {
                background: #fdf6e8;
                color: #92650a;
            }

            .restricted-badge {
                background: #fbeae8;
                color: #a3271f;
            }

            .verified-badge {
                background: var(--accent-light);
                color: var(--accent-color);
            }

            /* ===================== Stat row ===================== */
            .ig-stats-row {
                display: flex;
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-sm);
                margin-bottom: 26px;
                overflow: hidden;
            }

            .ig-stat {
                flex: 1;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 20px 18px;
                cursor: default;
                position: relative;
                transition: background-color 0.15s ease;
            }

                .ig-stat:not(:last-child)::after {
                    content: "";
                    position: absolute;
                    right: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 1px;
                    background: var(--border-color);
                }

                .ig-stat.clickable {
                    cursor: pointer;
                }

                    .ig-stat.clickable:hover {
                        background: var(--accent-light);
                    }

            .ig-stat-icon {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: var(--accent-light);
                color: var(--accent-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
                flex-shrink: 0;
            }

                .ig-stat-icon.orders-icon {
                    background: #eaf1ff;
                    color: #2563eb;
                }

                .ig-stat-icon.following-icon {
                    background: var(--accent-light);
                    color: var(--accent-color);
                }

                .ig-stat-icon.reviews-icon {
                    background: #fdf6e8;
                    color: #d97706;
                }

                .ig-stat-icon.wishlist-icon {
                    background: #fbeaec;
                    color: #e0245e;
                }

            .ig-stat-count {
                display: block;
                font-family: var(--font-display);
                font-size: 22px;
                font-weight: 700;
                color: var(--text-primary);
                line-height: 1.2;
            }

            .ig-stat-label {
                display: block;
                font-size: 11.5px;
                font-weight: 700;
                color: var(--text-secondary);
                margin-top: 1px;
                text-transform: uppercase;
                letter-spacing: 0.4px;
            }

            /* ===================== Page heading ===================== */
            .eyebrow {
                font-size: 11.5px;
                font-weight: 800;
                letter-spacing: 0.6px;
                text-transform: uppercase;
                color: var(--accent-color);
                margin-bottom: 6px;
            }

            .content-topbar {
                margin-bottom: 20px;
            }

            .page-heading h1 {
                font-family: var(--font-display);
                font-size: 26px;
                font-weight: 700;
                color: var(--text-primary);
                letter-spacing: -0.01em;
            }

            .page-heading p {
                font-size: 13.5px;
                color: var(--text-secondary);
                margin-top: 4px;
            }

            .message {
                padding: 14px 18px;
                border-radius: 8px;
                font-weight: 700;
                margin-bottom: 20px;
            }

            .success-message {
                background: #eafaf2;
                color: var(--success-color);
                border: 1px solid #cdeedd;
            }

            .error-message {
                background: #fdeeec;
                color: var(--error-color);
                border: 1px solid #f8d7d2;
            }

            .warning-message {
                background: #fdf3e7;
                color: #92400e;
                border: 1px solid #f5e2c2;
                padding: 12px;
                border-radius: 8px;
                font-size: 13px;
                margin-bottom: 14px;
            }

            .info-message {
                background: var(--accent-light);
                color: var(--accent-color);
                border: 1px solid var(--border-color);
                padding: 12px;
                border-radius: 8px;
                font-size: 13px;
                margin-bottom: 14px;
            }

            /* ===================== Dashboard grid ===================== */
            .dashboard-grid {
                display: grid;
                grid-template-columns: minmax(260px, 340px) 1fr;
                gap: 18px;
                align-items: start;
                margin-bottom: 20px;
            }

            .dash-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-sm);
                padding: 22px 24px;
            }

            .dash-card-title {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 15.5px;
                font-weight: 800;
                color: var(--text-primary);
                margin-bottom: 16px;
            }

                .dash-card-title i {
                    width: 34px;
                    height: 34px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    background: var(--accent-light);
                    border-radius: 9px;
                    color: var(--accent-color);
                    font-size: 14px;
                }

            /* Account & Security list rows */
            .account-list {
                display: flex;
                flex-direction: column;
            }

            .account-row {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 14px 4px;
                border-bottom: 1px solid var(--border-color);
                text-decoration: none;
                color: inherit;
                transition: background-color 0.15s ease;
                border-radius: 8px;
            }

                .account-row:last-child {
                    border-bottom: none;
                }

                .account-row:hover {
                    background: var(--accent-light);
                }

            .account-row-icon {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: var(--accent-light);
                color: var(--accent-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                flex-shrink: 0;
            }

            .account-row-text {
                flex-grow: 1;
                min-width: 0;
            }

                .account-row-text h4 {
                    font-size: 14px;
                    font-weight: 700;
                    color: var(--text-primary);
                }

                .account-row-text p {
                    font-size: 12px;
                    color: var(--text-secondary);
                    margin-top: 1px;
                }

            .account-row-chevron {
                color: var(--text-secondary);
                font-size: 13px;
                flex-shrink: 0;
            }

            /* Access & Roles: two sub-cards side by side */
            .roles-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 16px;
            }

            .role-card {
                background: var(--bg-color);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 18px;
                --role-accent: var(--accent-color);
                --role-accent-light: var(--accent-light);
            }

                .role-card.accent-store {
                    --role-accent: #2563eb;
                    --role-accent-light: #eaf1ff;
                }

                .role-card.accent-delivery {
                    --role-accent: #b45309;
                    --role-accent-light: #fdf3e7;
                }

            .role-card-head {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 6px;
            }

                .role-card-head i.role-icon {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: var(--role-accent-light);
                    color: var(--role-accent);
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 13px;
                }

                .role-card-head h4 {
                    font-size: 14.5px;
                    font-weight: 800;
                    color: var(--text-primary);
                }

            .status-pill {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-size: 11px;
                font-weight: 800;
                padding: 3px 10px;
                border-radius: 50px;
                margin-bottom: 10px;
            }

                .status-pill.approved {
                    background: #eafaf2;
                    color: var(--success-color);
                }

                .status-pill.pending {
                    background: #fdf3e7;
                    color: #92400e;
                }

                .status-pill.rejected {
                    background: #fdeeec;
                    color: var(--error-color);
                }

                .status-pill.unavailable {
                    background: #f1f2f4;
                    color: var(--text-secondary);
                }

            .role-desc {
                font-size: 12.5px;
                color: var(--text-secondary);
                line-height: 1.5;
                margin-bottom: 12px;
            }

            .role-email-box {
                width: 100%;
                padding: 9px 12px;
                border: 1px solid var(--border-color);
                border-radius: 8px;
                background: var(--card-bg);
                font-size: 12.5px;
                color: var(--text-secondary);
                margin-bottom: 8px;
            }

            .role-pass-wrap {
                position: relative;
                margin-bottom: 10px;
            }

                .role-pass-wrap input {
                    width: 100%;
                    padding: 9px 38px 9px 12px;
                    border: 1px solid var(--border-color);
                    border-radius: 8px;
                    font-size: 13px;
                    outline: none;
                    font-family: var(--font-family);
                }

                    .role-pass-wrap input:focus {
                        border-color: var(--role-accent);
                    }

            .role-pass-toggle {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: var(--text-secondary);
                cursor: pointer;
                font-size: 13px;
            }

            .role-login-btn {
                width: 100%;
                border: none;
                background: var(--role-accent);
                color: #fff;
                padding: 11px;
                border-radius: 10px;
                font-weight: 700;
                font-size: 13px;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                transition: opacity 0.15s ease;
            }

                .role-login-btn:hover {
                    opacity: 0.92;
                }

                .role-login-btn:disabled {
                    opacity: 0.55;
                    cursor: not-allowed;
                }

            .role-manage-link {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                width: 100%;
                justify-content: center;
                margin-top: 10px;
                font-size: 12.5px;
                font-weight: 700;
                color: var(--role-accent);
                text-decoration: none;
            }

                .role-manage-link:hover {
                    text-decoration: underline;
                }

            @@media (max-width: 900px) {
                .dashboard-grid {
                    grid-template-columns: 1fr;
                }

                .roles-grid {
                    grid-template-columns: 1fr;
                }
            }

            /* ===================== Activity preview strip ===================== */
            .activity-preview-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-sm);
                padding: 22px 24px;
                margin-bottom: 20px;
            }

            .activity-preview-head {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 14px;
                margin-bottom: 18px;
            }

                .activity-preview-head h3 {
                    font-family: var(--font-display);
                    font-size: 17px;
                    font-weight: 700;
                    color: var(--text-primary);
                }

                .activity-preview-head p {
                    font-size: 12.5px;
                    color: var(--text-secondary);
                    margin-top: 3px;
                }

            .view-all-btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                background: var(--accent-light);
                color: var(--accent-color);
                border: none;
                padding: 9px 16px;
                border-radius: 50px;
                font-weight: 700;
                font-size: 12.5px;
                cursor: pointer;
                white-space: nowrap;
                transition: background-color 0.15s ease, color 0.15s ease;
            }

                .view-all-btn:hover {
                    background: var(--accent-color);
                    color: #fff;
                }

            .activity-preview-grid {
                display: grid;
                grid-template-columns: repeat(5, 1fr);
                gap: 14px;
            }

            .activity-preview-tile {
                background: var(--bg-color);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 16px 14px;
            }

            .activity-preview-icon {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                margin-bottom: 10px;
            }

                .activity-preview-icon.reviews-icon {
                    background: #fdf6e8;
                    color: #d97706;
                }

                .activity-preview-icon.likes-icon {
                    background: #fbeaec;
                    color: #e0245e;
                }

                .activity-preview-icon.comments-icon {
                    background: #e9f3ff;
                    color: #2563eb;
                }

                .activity-preview-icon.story-icon {
                    background: #e6fbf6;
                    color: #0d9488;
                }

                .activity-preview-icon.reply-icon {
                    background: #fdf1e4;
                    color: #ea8c26;
                }

            .activity-preview-count {
                font-family: var(--font-display);
                font-size: 21px;
                font-weight: 700;
                color: var(--text-primary);
            }

            .activity-preview-label {
                font-size: 11px;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.3px;
                margin-top: 1px;
            }

            .activity-preview-link {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-size: 11.5px;
                font-weight: 700;
                color: var(--accent-color);
                text-decoration: none;
                background: none;
                border: none;
                cursor: pointer;
                padding: 0;
                margin-top: 10px;
            }

                .activity-preview-link:hover {
                    text-decoration: underline;
                }

            @@media (max-width: 900px) {
                .activity-preview-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            /* ===================== Sidebar drawer ===================== */
            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(16, 24, 40, 0.35);
                z-index: 9998;
                opacity: 0;
                transition: opacity 0.2s ease;
            }

                .sidebar-overlay.open {
                    display: block;
                    opacity: 1;
                }

            .profile-sidebar {
                position: fixed;
                top: 0;
                right: -300px;
                width: 280px;
                max-width: 85vw;
                height: 100%;
                background: var(--card-bg);
                border-left: 1px solid var(--border-color);
                box-shadow: var(--shadow-lg);
                z-index: 9999;
                overflow-y: auto;
                transition: right 0.25s ease;
                display: flex;
                flex-direction: column;
            }

                .profile-sidebar.open {
                    right: 0;
                }

            .sidebar-drawer-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 20px 18px;
                border-bottom: 1px solid var(--border-color);
            }

                .sidebar-drawer-head span {
                    font-family: var(--font-display);
                    font-weight: 700;
                    font-size: 17px;
                }

            .sidebar-close-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: var(--bg-color);
                border: 1px solid var(--border-color);
                color: var(--text-secondary);
                font-size: 15px;
                cursor: pointer;
            }

            .sidebar-nav {
                padding: 10px 12px;
            }

            .sidebar-nav-label {
                font-size: 10.5px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: var(--text-secondary);
                padding: 12px 12px 6px;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 12px;
                width: 100%;
                padding: 11px 12px;
                font-size: 14px;
                font-weight: 600;
                font-family: var(--font-family);
                color: var(--text-primary);
                text-decoration: none;
                background: transparent;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                text-align: left;
                transition: background-color 0.15s ease, color 0.15s ease;
            }

                .sidebar-link i {
                    width: 18px;
                    text-align: center;
                    color: var(--accent-color);
                    font-size: 15px;
                }

                .sidebar-link:hover {
                    background: var(--accent-light);
                }

                .sidebar-link.active {
                    background: var(--accent-color);
                    color: #ffffff;
                    font-weight: 700;
                }

                    .sidebar-link.active i {
                        color: #ffffff;
                    }

                .sidebar-link.logout {
                    color: var(--error-color);
                }

                    .sidebar-link.logout i {
                        color: var(--error-color);
                    }

                    .sidebar-link.logout:hover {
                        background: #fbeae8;
                    }

            .sidebar-divider {
                height: 1px;
                background: var(--border-color);
                margin: 8px 12px;
            }

            .logout-form {
                margin: 0;
            }

            /* ===================== Tabs ===================== */
            .tab-content {
                display: none;
                animation: fadeUp 0.2s ease forwards;
            }

                .tab-content.active {
                    display: block;
                }

            /* ===================== Instagram grid (wishlist) ===================== */
            .instagram-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 20px;
            }

            .product-grid-item {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                overflow: hidden;
                display: flex;
                flex-direction: column;
                box-shadow: var(--shadow-sm);
                transition: box-shadow 0.2s ease;
            }

                .product-grid-item:hover {
                    box-shadow: var(--shadow-md);
                }

                .product-grid-item img {
                    width: 100%;
                    height: 170px;
                    object-fit: cover;
                    border-bottom: 1px solid var(--border-color);
                }

            .product-details {
                padding: 16px;
                display: flex;
                flex-direction: column;
                flex-grow: 1;
            }

                .product-details h4 {
                    font-size: 14.5px;
                    font-weight: 700;
                    color: var(--text-primary);
                    margin-bottom: 6px;
                    height: 38px;
                    overflow: hidden;
                }

                .product-details .price {
                    font-size: 15.5px;
                    font-weight: 800;
                    color: var(--accent-color);
                    margin-bottom: 12px;
                }

            .view-btn {
                background-color: var(--accent-light);
                color: var(--accent-color);
                border: 1px solid var(--border-color);
                text-align: center;
                text-decoration: none;
                border-radius: 50px;
                padding: 8px;
                font-size: 13px;
                font-weight: 700;
                transition: all 0.15s ease;
                margin-top: auto;
            }

                .view-btn:hover {
                    background-color: var(--accent-color);
                    border-color: var(--accent-color);
                    color: #ffffff;
                }

            .wishlist-btn {
                background-color: var(--bg-color);
                color: var(--text-secondary);
                border: 1px solid var(--border-color);
                text-align: center;
                border-radius: 50px;
                padding: 8px;
                font-size: 13px;
                font-weight: 700;
                width: 100%;
                margin-top: 8px;
                cursor: pointer;
                transition: all 0.15s ease;
            }

                .wishlist-btn:hover {
                    background-color: #eceef1;
                    color: var(--text-primary);
                }

            .empty-state {
                text-align: center;
                padding: 54px 20px;
                color: var(--text-secondary);
            }

            .empty-icon {
                width: 76px;
                height: 76px;
                margin: 0 auto 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: var(--accent-light);
                font-size: 30px;
                color: var(--accent-color);
            }

            .empty-state h3 {
                font-family: var(--font-display);
                font-size: 18px;
                font-weight: 600;
                color: var(--text-primary);
                margin-bottom: 8px;
            }

            .empty-state p {
                font-size: 13.5px;
                max-width: 350px;
                margin: 0 auto;
                line-height: 1.5;
            }

            /* ===================== Full Activity tab (unchanged content, restyled) ===================== */
            .activity-section {
                margin-bottom: 30px;
            }

                .activity-section:last-child {
                    margin-bottom: 0;
                }

            .activity-section-title {
                font-family: var(--font-display);
                font-size: 15.5px;
                font-weight: 700;
                color: var(--text-primary);
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 14px;
                padding-bottom: 10px;
                border-bottom: 1px solid var(--border-color);
            }

                .activity-section-title i {
                    color: var(--accent-color);
                    font-size: 14px;
                }

            .activity-tile-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
                gap: 12px;
            }

            .activity-tile {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 8px;
                background: var(--card-bg);
                border: 2px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 20px 12px;
                cursor: pointer;
                font-family: var(--font-family);
                transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
                box-shadow: var(--shadow-sm);
            }

                .activity-tile:hover {
                    transform: translateY(-3px);
                    box-shadow: var(--shadow-md);
                }

                .activity-tile.active {
                    border-color: var(--accent-color);
                    background: var(--accent-light);
                }

            .activity-tile-icon {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                background: var(--accent-light);
                color: var(--accent-color);
            }

                .activity-tile-icon.reviews-icon {
                    background: #fdf6e8;
                    color: #d97706;
                }

                .activity-tile-icon.likes-icon {
                    background: #fbeaec;
                    color: #e0245e;
                }

                .activity-tile-icon.comments-icon {
                    background: #e9f3ff;
                    color: #2563eb;
                }

                .activity-tile-icon.story-icon {
                    background: #f3effe;
                    color: #6d28d9;
                }

                .activity-tile-icon.reply-icon {
                    background: #eafaf2;
                    color: #10b981;
                }

            .activity-tile-count {
                font-family: var(--font-display);
                font-size: 20px;
                font-weight: 600;
                color: var(--text-primary);
            }

            .activity-tile-label {
                font-size: 12px;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.3px;
            }

            .activity-detail-panel {
                display: none;
                margin-top: 16px;
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-sm);
                overflow: hidden;
                animation: fadeUp 0.25s ease forwards;
            }

                .activity-detail-panel.open {
                    display: block;
                }

            .activity-detail-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 10px 10px 0;
            }

            .activity-detail-tabs {
                display: flex;
                gap: 4px;
                padding: 4px;
                background: var(--bg-color);
                border-radius: 50px;
                flex-grow: 1;
                margin-right: 8px;
                overflow-x: auto;
            }

            .activity-detail-tab {
                flex: 1;
                white-space: nowrap;
                text-align: center;
                padding: 8px 12px;
                border-radius: 50px;
                border: none;
                background: transparent;
                color: var(--text-secondary);
                font-family: var(--font-family);
                font-weight: 700;
                font-size: 12.5px;
                cursor: pointer;
                transition: background-color 0.2s ease, color 0.2s ease;
            }

                .activity-detail-tab.active {
                    background: var(--card-bg);
                    color: var(--accent-color);
                    box-shadow: var(--shadow-sm);
                }

            .activity-detail-close {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                border: 1px solid var(--border-color);
                background: var(--bg-color);
                color: var(--text-secondary);
                cursor: pointer;
                font-size: 13px;
                flex-shrink: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .activity-detail-close:hover {
                    background: var(--accent-color);
                    color: #ffffff;
                    border-color: var(--accent-color);
                }

            .activity-swipe-track {
                display: flex;
                overflow-x: auto;
                scroll-snap-type: x mandatory;
                scroll-behavior: smooth;
                -webkit-overflow-scrolling: touch;
            }

                .activity-swipe-track::-webkit-scrollbar {
                    display: none;
                }

            .activity-swipe-page {
                flex: 0 0 100%;
                width: 100%;
                scroll-snap-align: start;
                max-height: 380px;
                overflow-y: auto;
                padding: 14px 18px 18px;
            }

            .activity-swipe-dots {
                display: flex;
                justify-content: center;
                gap: 6px;
                padding-bottom: 12px;
            }

            .activity-swipe-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--border-color);
                transition: background-color 0.2s ease, width 0.2s ease;
            }

                .activity-swipe-dot.active {
                    background: var(--accent-color);
                    width: 16px;
                    border-radius: 4px;
                }

            .activity-list-item {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 14px;
                padding: 14px 4px;
                border-bottom: 1px solid var(--border-color);
            }

                .activity-list-item:last-child {
                    border-bottom: none;
                }

            .activity-list-main {
                flex-grow: 1;
                min-width: 0;
            }

                .activity-list-main h4 {
                    font-size: 14px;
                    font-weight: 700;
                    color: var(--text-primary);
                    margin-bottom: 4px;
                }

                .activity-list-main p {
                    font-size: 13px;
                    color: var(--text-secondary);
                    line-height: 1.5;
                }

            .activity-list-time {
                font-size: 11.5px;
                color: var(--text-secondary);
                white-space: nowrap;
                flex-shrink: 0;
                padding-top: 2px;
            }

            .activity-empty-inline {
                text-align: center;
                padding: 30px 10px;
                color: var(--text-secondary);
                font-size: 13.5px;
            }

                .activity-empty-inline i {
                    display: block;
                    font-size: 26px;
                    margin-bottom: 10px;
                    color: var(--border-color);
                }

            .extra-item {
                display: none;
            }

            .view-more-btn {
                display: block;
                width: 100%;
                margin-top: 10px;
                padding: 10px;
                background: var(--accent-light);
                border: 1px dashed var(--border-color);
                border-radius: 10px;
                color: var(--accent-color);
                font-family: var(--font-family);
                font-weight: 700;
                font-size: 12.5px;
                cursor: pointer;
                transition: background-color 0.15s ease;
            }

                .view-more-btn:hover {
                    background: var(--accent-color);
                    color: #ffffff;
                }

            .bulk-actions-bar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                padding: 4px 4px 12px;
                margin-bottom: 6px;
                border-bottom: 1px solid var(--border-color);
            }

            .select-all-label {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-size: 12.5px;
                font-weight: 700;
                color: var(--text-secondary);
                cursor: pointer;
            }

            .item-checkbox, .select-all-checkbox {
                width: 16px;
                height: 16px;
                accent-color: var(--accent-color);
                cursor: pointer;
                flex-shrink: 0;
            }

            .bulk-delete-btn {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: none;
                border: 1px solid var(--error-color);
                color: var(--error-color);
                font-weight: 700;
                font-size: 12px;
                padding: 6px 14px;
                border-radius: 50px;
                cursor: pointer;
                transition: all 0.15s ease;
            }

                .bulk-delete-btn:hover {
                    background: var(--error-color);
                    color: #ffffff;
                }

            .trash-btn {
                background: none;
                border: none;
                color: var(--text-secondary);
                font-size: 13px;
                cursor: pointer;
                padding: 4px;
                border-radius: 6px;
                transition: color 0.15s ease, background-color 0.15s ease;
                flex-shrink: 0;
            }

                .trash-btn:hover {
                    color: var(--error-color);
                    background: #fdeeec;
                }

            .reviews-container {
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            .review-row {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 18px 20px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 16px;
                box-shadow: var(--shadow-sm);
            }

            .review-main {
                flex-grow: 1;
            }

                .review-main h4 {
                    font-size: 15px;
                    font-weight: 700;
                    color: var(--text-primary);
                    margin-bottom: 6px;
                }

                .review-main p {
                    font-size: 13.5px;
                    color: var(--text-secondary);
                    line-height: 1.5;
                    font-style: italic;
                }

            .review-meta {
                text-align: right;
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                gap: 6px;
                min-width: 110px;
            }

            .stars-row {
                display: flex;
                gap: 2px;
            }

            .modal {
                display: none;
                position: fixed;
                z-index: 20000;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(16, 24, 40, 0.5);
                backdrop-filter: blur(3px);
            }

            .modal-content {
                background-color: var(--card-bg);
                margin: 10% auto;
                padding: 30px;
                border-radius: var(--radius-lg);
                width: 90%;
                max-width: 440px;
                box-shadow: var(--shadow-lg);
                border: 1px solid var(--border-color);
                position: relative;
                animation: zoomIn 0.2s ease;
            }

            .close-modal {
                position: absolute;
                right: 20px;
                top: 15px;
                font-size: 22px;
                font-weight: bold;
                color: var(--text-secondary);
                cursor: pointer;
            }

                .close-modal:hover {
                    color: var(--text-primary);
                }

            .modal h3 {
                margin-bottom: 20px;
                font-size: 18px;
                color: var(--text-primary);
                font-weight: 800;
            }

            .following-list-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 8px 16px;
                transition: background-color 0.1s ease;
            }

                .following-list-item:hover {
                    background-color: var(--bg-color);
                }

            .following-store-info {
                display: flex;
                align-items: center;
                gap: 12px;
                cursor: pointer;
                text-decoration: none;
                color: inherit;
                flex-grow: 1;
                min-width: 0;
            }

            .following-store-logo {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                object-fit: cover;
                border: 1px solid var(--border-color);
                flex-shrink: 0;
            }

            .following-store-names {
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            .following-store-name {
                font-size: 14px;
                font-weight: 700;
                color: var(--text-primary);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .following-store-desc {
                font-size: 12px;
                color: var(--text-secondary);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .following-action-btn {
                background-color: var(--accent-light);
                border: 1px solid var(--border-color);
                color: var(--accent-color);
                font-weight: 700;
                font-size: 12px;
                padding: 5px 16px;
                border-radius: 50px;
                text-decoration: none;
                cursor: pointer;
                transition: all 0.15s;
                flex-shrink: 0;
            }

                .following-action-btn:hover {
                    background-color: var(--accent-color);
                    border-color: var(--accent-color);
                    color: #ffffff;
                }

            .blocked-shops-list {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

            .blocked-shop-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 10px 4px;
                border-bottom: 1px solid var(--border-color);
            }

                .blocked-shop-item:last-child {
                    border-bottom: none;
                }

                .blocked-shop-item .following-store-info {
                    opacity: 0.85;
                }

            .unblock-btn {
                background: none;
                border: 1px solid var(--error-color);
                color: var(--error-color);
                font-weight: 700;
                font-size: 12px;
                padding: 6px 16px;
                border-radius: 50px;
                cursor: pointer;
                transition: all 0.15s ease;
                flex-shrink: 0;
            }

                .unblock-btn:hover {
                    background-color: var(--error-color);
                    color: #ffffff;
                }

            /* ===================== Mobile bottom nav ===================== */
            .mobile-bottom-nav {
                display: flex !important;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 200;
                background: #ffffff;
                border-top: 1px solid var(--border-color);
                justify-content: space-between;
                gap: 2px;
                padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
                overflow-x: auto;
                box-shadow: 0 -2px 12px rgba(16, 24, 40, 0.05);
            }

                .mobile-bottom-nav a {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: 2px;
                    font-size: 10.5px;
                    color: #64748b;
                    text-decoration: none;
                    padding: 4px 6px;
                    flex-shrink: 0;
                    position: relative;
                    border-radius: 8px;
                    transition: background-color 0.15s ease, color 0.15s ease;
                }

                    .mobile-bottom-nav a i {
                        font-size: 17px;
                    }

                    .mobile-bottom-nav a:hover {
                        background: var(--accent-light);
                        color: var(--accent-color);
                    }

                    .mobile-bottom-nav a.active {
                        color: var(--accent-color) !important;
                        background: var(--accent-light) !important;
                        font-weight: 700;
                    }

            .unread-nav-badge {
                position: absolute;
                top: 2px;
                right: 18px;
                background: var(--accent-color);
                color: #fff;
                font-size: 10px;
                font-weight: 800;
                min-width: 16px;
                height: 16px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 4px;
            }

            .chat-icon-wrap {
                position: relative;
                display: inline-flex;
            }

                .chat-icon-wrap .chat-nav-dot {
                    position: absolute;
                    top: -2px;
                    right: -4px;
                    width: 9px;
                    height: 9px;
                    background: #ed4956;
                    border: 2px solid #fff;
                    border-radius: 50%;
                    box-sizing: content-box;
                }

            @@keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(6px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes zoomIn {
                from {
                    transform: scale(0.97);
                    opacity: 0;
                }

                to {
                    transform: scale(1);
                    opacity: 1;
                }
            }

            @@media (max-width: 992px) {
                .instagram-grid {
                    grid-template-columns: repeat(1, 1fr);
                    gap: 16px;
                }
            }

            @@media (max-width: 640px) {
                .ig-stats-row {
                    flex-wrap: wrap;
                }

                .ig-stat {
                    flex: 1 1 50%;
                }

                    .ig-stat:nth-child(2)::after {
                        display: none;
                    }
            }

            @@media (max-width: 480px) {
                .ig-name {
                    font-size: 20px;
                }

                .ig-avatar-ring {
                    width: 84px;
                    height: 84px;
                }

                .ig-avatar {
                    font-size: 30px;
                }

                .activity-detail-tab {
                    font-size: 11.5px;
                    padding: 8px 8px;
                }

                .activity-preview-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            footer {
                text-align: center;
                padding: 40px 20px;
                color: var(--text-secondary);
                font-size: 12.5px;
                font-family: var(--font-display);
                letter-spacing: 0.01em;
                border-top: 1px solid var(--border-color);
                margin-top: 40px;
            }

                footer i {
                    color: var(--accent-color);
                }
    </style>
</head>

<body>

    <partial name="_CustomerBottomNav" />

    <div class="profile-container">

        <div id="sidebarOverlay" class="sidebar-overlay" onclick="closeSidebar()"></div>

        <div class="profile-header-card">
            <div class="profile-cover"></div>

            <button type="button" class="header-menu-btn" onclick="openSidebar()" aria-label="Open menu">
                <i class="fas fa-bars"></i>
            </button>

            <div class="ig-top-row">
                <div class="ig-avatar-ring">
                    <div class="ig-avatar">
                        <i class="fas fa-user-astronaut"></i>
                    </div>
                    <span class="avatar-edit-badge" title="Edit avatar"><i class="fas fa-wand-magic-sparkles"></i></span>
                </div>
                <div class="ig-identity">
                    <div class="ig-name">
                        @Model.CustomerFullName
                        @if (Model.IsVerified)
                        {
                            <span class="sidebar-badge verified-badge" style="font-size:11.5px;">
                                <i class="fas fa-circle-check"></i> Verified
                            </span>
                        }
                    </div>
                    <div class="ig-joined">Customer since @Model.CreatedAt.ToString("MMM yyyy")</div>
                </div>
            </div>

            <div class="ig-badges">
                @if (Model.LoyaltyPoints > 0)
                {
                    <span class="sidebar-badge loyalty-badge">
                        <i class="fas fa-star"></i> @Model.LoyaltyPoints.ToString("N0") Points
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Gender) && !Model.Gender.Equals("Not Specified", StringComparison.OrdinalIgnoreCase))
                {
                    <span class="sidebar-badge">
                        <i class="fas fa-venus-mars"></i> @Model.Gender
                    </span>
                }
                @if (Model.CODBlocked)
                {
                    <span class="sidebar-badge restricted-badge">
                        <i class="fas fa-lock"></i> COD Restricted
                    </span>
                }
            </div>
        </div>

        <div class="ig-stats-row">
            <div class="ig-stat">
                <span class="ig-stat-icon orders-icon"><i class="fas fa-bag-shopping"></i></span>
                <div>
                    <span class="ig-stat-count">@Model.OrdersCount</span>
                    <span class="ig-stat-label">Orders</span>
                </div>
            </div>
            <div class="ig-stat clickable" onclick="openFollowingModal()">
                <span class="ig-stat-icon following-icon"><i class="fas fa-user-group"></i></span>
                <div>
                    <span class="ig-stat-count">@Model.FollowedStoresList.Count</span>
                    <span class="ig-stat-label">Following Stores</span>
                </div>
            </div>
            <div class="ig-stat">
                <span class="ig-stat-icon reviews-icon"><i class="fas fa-star"></i></span>
                <div>
                    <span class="ig-stat-count">@Model.ReviewsList.Count</span>
                    <span class="ig-stat-label">Reviews</span>
                </div>
            </div>
            <div class="ig-stat">
                <span class="ig-stat-icon wishlist-icon"><i class="fas fa-heart"></i></span>
                <div>
                    <span class="ig-stat-count">@Model.WishlistCount</span>
                    <span class="ig-stat-label">Wishlist</span>
                </div>
            </div>
        </div>

        <aside id="sidebar" class="profile-sidebar">

            <div class="sidebar-drawer-head">
                <span>Menu</span>
                <button type="button" class="sidebar-close-btn" onclick="closeSidebar()" aria-label="Close menu">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-nav-label">Dashboard</div>

                <button id="link-settings-tab" class="sidebar-link active" data-tab="settings-tab" onclick="selectTab('settings-tab')">
                    <i class="fas fa-sliders-h"></i> Management
                </button>
                <button id="link-activity-tab" class="sidebar-link" data-tab="activity-tab" onclick="selectTab('activity-tab')">
                    <i class="fas fa-clock-rotate-left"></i> Your Activity
                </button>
                <button id="link-wishlist-tab" class="sidebar-link" data-tab="wishlist-tab" onclick="selectTab('wishlist-tab')">
                    <i class="far fa-bookmark"></i> Wishlist
                </button>

                <div class="sidebar-divider"></div>
                <div class="sidebar-nav-label">Account</div>

                <a href="/EditProfile" class="sidebar-link">
                    <i class="fas fa-user-pen"></i> Edit Profile
                </a>
                <a href="/Identity/Account/Manage/ChangePassword" class="sidebar-link">
                    <i class="fas fa-gear"></i> Settings
                </a>

                <div class="sidebar-divider"></div>
                <div class="sidebar-nav-label">Support</div>

                <a href="/HelpCenter" class="sidebar-link">
                    <i class="fas fa-circle-question"></i> Help Center
                </a>
                <a href="/CustomerComplaint" class="sidebar-link">
                    <i class="fas fa-flag"></i> File a Complaint
                </a>

                <div class="sidebar-divider"></div>

                <form method="post" asp-page="/Identity/Account/Logout" asp-route-returnUrl="/" class="logout-form">
                    <button type="submit" class="sidebar-link logout">
                        <i class="fas fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </nav>
        </aside>

        <main class="main-content">

            @if (TempData["Success"] != null)
            {
                <div class="message success-message">@TempData["Success"]</div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="message error-message">Please check your information and try again.</div>
            }

            <div id="settings-tab" class="tab-content active">

                <div class="content-topbar">
                    <div class="page-heading">
                        <div class="eyebrow">Account</div>
                        <h1>Management</h1>
                        <p>Manage your account, access, and security.</p>
                    </div>
                </div>

                <div class="dashboard-grid">

                    <!-- Account & Security -->
                    <div class="dash-card">
                        <div class="dash-card-title"><i class="fas fa-shield-halved"></i> Account &amp; Security</div>

                        <div class="account-list">
                            <a href="/Identity/Account/Manage/ChangePassword" class="account-row">
                                <span class="account-row-icon"><i class="fas fa-lock"></i></span>
                                <div class="account-row-text">
                                    <h4>Change Password</h4>
                                    <p>Update your login password</p>
                                </div>
                                <i class="fas fa-chevron-right account-row-chevron"></i>
                            </a>

                            <a href="/CustomerAddresses" class="account-row">
                                <span class="account-row-icon"><i class="fas fa-location-dot"></i></span>
                                <div class="account-row-text">
                                    <h4>My Addresses</h4>
                                    <p>Manage your saved delivery addresses</p>
                                </div>
                                <i class="fas fa-chevron-right account-row-chevron"></i>
                            </a>

                            <a href="/CustomerComplaint" class="account-row">
                                <span class="account-row-icon"><i class="fas fa-comment-dots"></i></span>
                                <div class="account-row-text">
                                    <h4>File a Complaint</h4>
                                    <p>Report a problem or submit a complaint</p>
                                </div>
                                <i class="fas fa-chevron-right account-row-chevron"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Access & Roles -->
                    <div class="dash-card">
                        <div class="dash-card-title"><i class="fas fa-people-group"></i> Access &amp; Roles</div>

                        <div class="roles-grid">

                            <!-- Store Owner Access -->
                            <div class="role-card accent-store">
                                <div class="role-card-head">
                                    <i class="fas fa-store role-icon"></i>
                                    <h4>Store Owner Access</h4>
                                </div>

                                @if (Model.HasApprovedStoreOwnerAccount)
                                {
                                    <span class="status-pill approved"><i class="fas fa-circle-check"></i> Approved</span>
                                    <p class="role-desc">You can login to your Store Owner account and manage your store.</p>

                                    <input class="role-email-box" type="text" value="@Model.StoreOwnerAccountEmail" readonly tabindex="-1" />

                                    @if (!string.IsNullOrWhiteSpace(storeOwnerLoginError))
                                    {
                                        <div class="error-message" style="padding:10px; border-radius:8px; font-size:12.5px; margin-bottom:10px;">@storeOwnerLoginError</div>
                                    }

                                    <form method="post" asp-page-handler="StoreOwnerLogin" autocomplete="off">
                                        <div class="role-pass-wrap">
                                            <input asp-for="StoreOwnerPassword" type="password" placeholder="Enter your password" autocomplete="current-password" required />
                                        </div>
                                        <button type="submit" class="role-login-btn">
                                            <i class="fas fa-lock"></i> Login as Store Owner
                                        </button>
                                    </form>

                                    <a href="/StoreRequest" class="role-manage-link">Manage Store Access <i class="fas fa-arrow-right"></i></a>
                                }
                                else if (Model.HasPendingStoreRequest)
                                {
                                    <span class="status-pill pending"><i class="fas fa-clock"></i> Pending</span>
                                    <p class="role-desc">@Model.StoreAccessMessage</p>
                                    <button type="button" class="role-login-btn" disabled><i class="fas fa-clock"></i> Waiting for Approval</button>
                                }
                                else if (Model.HasRejectedStoreRequest)
                                {
                                    <span class="status-pill rejected"><i class="fas fa-circle-xmark"></i> Rejected</span>
                                    <p class="role-desc">@Model.StoreAccessMessage</p>
                                    <a href="/StoreRequest" class="role-login-btn" style="text-decoration:none;"><i class="fas fa-rotate-right"></i> Resubmit Request</a>
                                }
                                else if (!Model.HasStoreRequest)
                                {
                                    <span class="status-pill unavailable"><i class="fas fa-circle-info"></i> Not Requested</span>
                                    <p class="role-desc">@Model.StoreAccessMessage</p>
                                    <a href="/StoreRequest" class="role-login-btn" style="text-decoration:none;"><i class="fas fa-chalkboard-user"></i> Request Access</a>
                                }
                                else
                                {
                                    <span class="status-pill unavailable"><i class="fas fa-ban"></i> Unavailable</span>
                                    <p class="role-desc">@Model.StoreAccessMessage</p>
                                    <button type="button" class="role-login-btn" disabled><i class="fas fa-ban"></i> Access Unavailable</button>
                                }
                            </div>

                            <!-- Delivery Access -->
                            <div class="role-card accent-delivery">
                                <div class="role-card-head">
                                    <i class="fas fa-motorcycle role-icon"></i>
                                    <h4>Delivery Access</h4>
                                </div>

                                @if (Model.HasApprovedDeliveryAccount)
                                {
                                    <span class="status-pill approved"><i class="fas fa-circle-check"></i> Approved</span>
                                    <p class="role-desc">You can login to your Delivery account and manage deliveries.</p>

                                    <input class="role-email-box" type="text" value="@Model.DeliveryAccountEmail" readonly tabindex="-1" />

                                    @if (!string.IsNullOrWhiteSpace(deliveryLoginError))
                                    {
                                        <div class="error-message" style="padding:10px; border-radius:8px; font-size:12.5px; margin-bottom:10px;">@deliveryLoginError</div>
                                    }

                                    <form method="post" asp-page-handler="DeliveryLogin" autocomplete="off">
                                        <div class="role-pass-wrap">
                                            <input asp-for="DeliveryPassword" type="password" placeholder="Enter your password" autocomplete="current-password" required />
                                        </div>
                                        <button type="submit" class="role-login-btn">
                                            <i class="fas fa-lock"></i> Login as Delivery
                                        </button>
                                    </form>

                                    <a href="/DeliveryRequest" class="role-manage-link">Manage Delivery Access <i class="fas fa-arrow-right"></i></a>
                                }
                                else if (Model.HasPendingDeliveryRequest)
                                {
                                    <span class="status-pill pending"><i class="fas fa-clock"></i> Pending</span>
                                    <p class="role-desc">@Model.DeliveryAccessMessage</p>
                                    <button type="button" class="role-login-btn" disabled><i class="fas fa-clock"></i> Waiting for Approval</button>
                                }
                                else if (Model.HasRejectedDeliveryRequest)
                                {
                                    <span class="status-pill rejected"><i class="fas fa-circle-xmark"></i> Rejected</span>
                                    <p class="role-desc">@Model.DeliveryAccessMessage</p>
                                    <a href="/DeliveryRequest" class="role-login-btn" style="text-decoration:none;"><i class="fas fa-rotate-right"></i> Resubmit Request</a>
                                }
                                else
                                {
                                    <span class="status-pill unavailable"><i class="fas fa-circle-info"></i> Not Requested</span>
                                    <p class="role-desc">@Model.DeliveryAccessMessage</p>
                                    <a href="/DeliveryRequest" class="role-login-btn" style="text-decoration:none;"><i class="fas fa-id-card"></i> Request Access</a>
                                }
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Your Activity preview strip -->
                <div class="activity-preview-card">
                    <div class="activity-preview-head">
                        <div>
                            <h3>Your Activity</h3>
                            <p>Track your interactions across the platform.</p>
                        </div>
                        <button type="button" class="view-all-btn" onclick="selectTab('activity-tab')">
                            View All Activity <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>

                    <div class="activity-preview-grid">
                        <div class="activity-preview-tile">
                            <span class="activity-preview-icon reviews-icon"><i class="fas fa-star"></i></span>
                            <span class="activity-preview-count">@Model.ReviewsList.Count</span>
                            <span class="activity-preview-label">Reviews</span>
                            <button type="button" class="activity-preview-link" onclick="openActivityPanel('reviews')">View activity <i class="fas fa-arrow-right"></i></button>
                        </div>
                        <div class="activity-preview-tile">
                            <span class="activity-preview-icon likes-icon"><i class="fas fa-heart"></i></span>
                            <span class="activity-preview-count">@Model.LikesList.Count</span>
                            <span class="activity-preview-label">Likes</span>
                            <button type="button" class="activity-preview-link" onclick="openActivityPanel('likes')">View activity <i class="fas fa-arrow-right"></i></button>
                        </div>
                        <div class="activity-preview-tile">
                            <span class="activity-preview-icon comments-icon"><i class="fas fa-comment"></i></span>
                            <span class="activity-preview-count">@Model.CommentsList.Count</span>
                            <span class="activity-preview-label">Comments</span>
                            <button type="button" class="activity-preview-link" onclick="openActivityPanel('comments')">View activity <i class="fas fa-arrow-right"></i></button>
                        </div>
                        <div class="activity-preview-tile">
                            <span class="activity-preview-icon story-icon"><i class="fas fa-circle-play"></i></span>
                            <span class="activity-preview-count">@Model.StoryLikesList.Count</span>
                            <span class="activity-preview-label">Story Likes</span>
                            <button type="button" class="activity-preview-link" onclick="openActivityPanel('storyLikes')">View activity <i class="fas fa-arrow-right"></i></button>
                        </div>
                        <div class="activity-preview-tile">
                            <span class="activity-preview-icon reply-icon"><i class="fas fa-reply"></i></span>
                            <span class="activity-preview-count">@Model.StoryRepliesList.Count</span>
                            <span class="activity-preview-label">Story Replies</span>
                            <button type="button" class="activity-preview-link" onclick="openActivityPanel('storyReplies')">View activity <i class="fas fa-arrow-right"></i></button>
                        </div>
                    </div>
                </div>

            </div>

            <div id="activity-tab" class="tab-content">

                <div class="content-topbar">
                    <div class="page-heading">
                        <div class="eyebrow">Account</div>
                        <h1>Your Activity</h1>
                        <p>Reviews you've left, blocked shops, and language preferences.</p>
                    </div>
                </div>

                <div class="activity-section">
                    <h3 class="activity-section-title"><i class="fas fa-chart-simple"></i> Activity Overview</h3>

                    <div class="activity-tile-grid">
                        <button type="button" class="activity-tile" data-tile="reviews" onclick="openActivityPanel('reviews')">
                            <div class="activity-tile-icon reviews-icon"><i class="fas fa-star"></i></div>
                            <span class="activity-tile-count">@Model.ReviewsList.Count</span>
                            <span class="activity-tile-label">Reviews</span>
                        </button>

                        <button type="button" class="activity-tile" data-tile="likes" onclick="openActivityPanel('likes')">
                            <div class="activity-tile-icon likes-icon"><i class="fas fa-heart"></i></div>
                            <span class="activity-tile-count">@Model.LikesList.Count</span>
                            <span class="activity-tile-label">Likes</span>
                        </button>

                        <button type="button" class="activity-tile" data-tile="comments" onclick="openActivityPanel('comments')">
                            <div class="activity-tile-icon comments-icon"><i class="fas fa-comment"></i></div>
                            <span class="activity-tile-count">@Model.CommentsList.Count</span>
                            <span class="activity-tile-label">Comments</span>
                        </button>

                        <button type="button" class="activity-tile" data-tile="storyLikes" onclick="openActivityPanel('storyLikes')">
                            <div class="activity-tile-icon story-icon"><i class="fas fa-circle-play"></i></div>
                            <span class="activity-tile-count">@Model.StoryLikesList.Count</span>
                            <span class="activity-tile-label">Story Likes</span>
                        </button>

                        <button type="button" class="activity-tile" data-tile="storyReplies" onclick="openActivityPanel('storyReplies')">
                            <div class="activity-tile-icon reply-icon"><i class="fas fa-reply"></i></div>
                            <span class="activity-tile-count">@Model.StoryRepliesList.Count</span>
                            <span class="activity-tile-label">Story Replies</span>
                        </button>
                    </div>

                    <div id="activityDetailPanel" class="activity-detail-panel">
                        <div class="activity-detail-head">
                            <div class="activity-detail-tabs">
                                <button type="button" class="activity-detail-tab" data-index="0" onclick="goToActivityPage(0)">Reviews</button>
                                <button type="button" class="activity-detail-tab" data-index="1" onclick="goToActivityPage(1)">Likes</button>
                                <button type="button" class="activity-detail-tab" data-index="2" onclick="goToActivityPage(2)">Comments</button>
                                <button type="button" class="activity-detail-tab" data-index="3" onclick="goToActivityPage(3)">Story Likes</button>
                                <button type="button" class="activity-detail-tab" data-index="4" onclick="goToActivityPage(4)">Story Replies</button>
                            </div>
                            <button type="button" class="activity-detail-close" onclick="closeActivityPanel()" aria-label="Close">
                                <i class="fas fa-xmark"></i>
                            </button>
                        </div>

                        <div class="activity-swipe-track" id="activitySwipeTrack">

                            <div class="activity-swipe-page">
                                @if (Model.ReviewsList.Any())
                                {
                                    <form method="post" asp-page-handler="DeleteReviews" id="reviewsBulkForm">
                                        <div class="bulk-actions-bar">
                                            <label class="select-all-label">
                                                <input type="checkbox" class="select-all-checkbox" onclick="toggleSelectAll(this, 'reviewsBulkForm')" /> Select all
                                            </label>
                                            <button type="submit" class="bulk-delete-btn" onclick="return confirmBulkDelete('reviewsBulkForm', 'review')">
                                                <i class="fas fa-trash"></i> Delete Selected
                                            </button>
                                        </div>
                                        <div class="reviews-container">
                                            @{
                                                int reviewIndex = 0;
                                            }
                                            @foreach (var r in Model.ReviewsList)
                                            {
                                                var productName = CustomerProfileModel.GetSafeString(r.Product, new[] { "ProductName", "Name" }, "Product");
                                                var rating = CustomerProfileModel.GetSafeInt(r, new[] { "Rating", "Stars", "Score" }, 5);
                                                var comment = CustomerProfileModel.GetSafeString(r, new[] { "Comment", "Text", "ReviewText", "Description" }, "No feedback left.");
                                                var extraClass = reviewIndex >= 5 ? "extra-item" : "";

                                                <div class="review-row @extraClass">
                                                    <input type="checkbox" name="reviewIds" value="@r.ReviewID" class="item-checkbox" />
                                                    <div class="review-main">
                                                        <h4>@productName</h4>
                                                        <p>"@comment"</p>
                                                    </div>
                                                    <div class="review-meta">
                                                        <div class="stars-row">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                if (i <= rating)
                                                                {
                                                                    <i class="fas fa-star" style="color: #FFC107;"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="far fa-star" style="color: #dbdbdb;"></i>
                                                                }
                                                            }
                                                        </div>
                                                        <button type="submit" formaction="?handler=DeleteReview" name="reviewId" value="@r.ReviewID" class="trash-btn" title="Delete review" onclick="return confirm('Delete this review?')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                reviewIndex++;
                                            }
                                        </div>
                                        @if (Model.ReviewsList.Count > 5)
                                        {
                                            <button type="button" class="view-more-btn" data-more-label="View @(Model.ReviewsList.Count - 5) more" onclick="toggleViewMore(this)">View @(Model.ReviewsList.Count - 5) more</button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <div class="activity-empty-inline"><i class="fas fa-star"></i> You have not published any reviews yet.</div>
                                }
                            </div>

                            <div class="activity-swipe-page">
                                @if (Model.LikesList.Any())
                                {
                                    <form method="post" asp-page-handler="DeleteLikes" id="likesBulkForm">
                                        <div class="bulk-actions-bar">
                                            <label class="select-all-label">
                                                <input type="checkbox" class="select-all-checkbox" onclick="toggleSelectAll(this, 'likesBulkForm')" /> Select all
                                            </label>
                                            <button type="submit" class="bulk-delete-btn" onclick="return confirmBulkDelete('likesBulkForm', 'like')">
                                                <i class="fas fa-trash"></i> Delete Selected
                                            </button>
                                        </div>
                                        @{
                                            int likeIndex = 0;
                                        }
                                        @foreach (var like in Model.LikesList)
                                        {
                                            var likedPost = CustomerProfileModel.GetSafeObject(like, new[] { "ExplorePost", "Post" });
                                            var likedProduct = CustomerProfileModel.GetSafeObject(likedPost, new[] { "Product" });
                                            var postTitle = CustomerProfileModel.GetSafeString(likedPost, new[] { "Caption" },
                                                              CustomerProfileModel.GetSafeString(likedProduct, new[] { "ProductName", "Name" }, "a post"));
                                            var likedAt = CustomerProfileModel.GetSafeDateString(like, new[] { "CreatedAt" });
                                            var likeExtraClass = likeIndex >= 5 ? "extra-item" : "";

                                            <div class="activity-list-item @likeExtraClass">
                                                <input type="checkbox" name="postIds" value="@like.ExplorePostID" class="item-checkbox" />
                                                <div class="activity-list-main">
                                                    <h4><i class="fas fa-heart" style="color:#e0245e; font-size:12px; margin-right:6px;"></i>You liked @postTitle</h4>
                                                </div>
                                                <span class="activity-list-time">@likedAt</span>
                                                <button type="submit" formaction="?handler=DeleteLike" name="postId" value="@like.ExplorePostID" class="trash-btn" title="Remove like" onclick="return confirm('Remove this like?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                            likeIndex++;
                                        }
                                        @if (Model.LikesList.Count > 5)
                                        {
                                            <button type="button" class="view-more-btn" data-more-label="View @(Model.LikesList.Count - 5) more" onclick="toggleViewMore(this)">View @(Model.LikesList.Count - 5) more</button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <div class="activity-empty-inline"><i class="fas fa-heart"></i> You haven't liked any posts yet.</div>
                                }
                            </div>

                            <div class="activity-swipe-page">
                                @if (Model.CommentsList.Any())
                                {
                                    <form method="post" asp-page-handler="DeleteComments" id="commentsBulkForm">
                                        <div class="bulk-actions-bar">
                                            <label class="select-all-label">
                                                <input type="checkbox" class="select-all-checkbox" onclick="toggleSelectAll(this, 'commentsBulkForm')" /> Select all
                                            </label>
                                            <button type="submit" class="bulk-delete-btn" onclick="return confirmBulkDelete('commentsBulkForm', 'comment')">
                                                <i class="fas fa-trash"></i> Delete Selected
                                            </button>
                                        </div>
                                        @{
                                            int commentIndex = 0;
                                        }
                                        @foreach (var c in Model.CommentsList)
                                        {
                                            var commentedPost = CustomerProfileModel.GetSafeObject(c, new[] { "ExplorePost", "Post" });
                                            var commentedProduct = CustomerProfileModel.GetSafeObject(commentedPost, new[] { "Product" });
                                            var postTitle = CustomerProfileModel.GetSafeString(commentedPost, new[] { "Caption" },
                                                              CustomerProfileModel.GetSafeString(commentedProduct, new[] { "ProductName", "Name" }, "a post"));
                                            var commentText = CustomerProfileModel.GetSafeString(c, new[] { "CommentText", "Comment", "Text" }, "");
                                            var commentedAt = CustomerProfileModel.GetSafeDateString(c, new[] { "CreatedAt" });
                                            var commentId = CustomerProfileModel.GetSafeInt(c, new[] { "ExploreCommentID", "CommentID", "Id" }, 0);
                                            var commentExtraClass = commentIndex >= 5 ? "extra-item" : "";

                                            <div class="activity-list-item @commentExtraClass">
                                                <input type="checkbox" name="commentIds" value="@commentId" class="item-checkbox" />
                                                <div class="activity-list-main">
                                                    <h4>On @postTitle</h4>
                                                    <p>"@commentText"</p>
                                                </div>
                                                <span class="activity-list-time">@commentedAt</span>
                                                <button type="submit" formaction="?handler=DeleteComment" name="commentId" value="@commentId" class="trash-btn" title="Delete comment" onclick="return confirm('Delete this comment?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                            commentIndex++;
                                        }
                                        @if (Model.CommentsList.Count > 5)
                                        {
                                            <button type="button" class="view-more-btn" data-more-label="View @(Model.CommentsList.Count - 5) more" onclick="toggleViewMore(this)">View @(Model.CommentsList.Count - 5) more</button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <div class="activity-empty-inline"><i class="fas fa-comment"></i> You haven't left any comments yet.</div>
                                }
                            </div>

                            <div class="activity-swipe-page">
                                @if (Model.StoryLikesList.Any())
                                {
                                    <form method="post" asp-page-handler="DeleteStoryLikes" id="storyLikesBulkForm">
                                        <div class="bulk-actions-bar">
                                            <label class="select-all-label">
                                                <input type="checkbox" class="select-all-checkbox" onclick="toggleSelectAll(this, 'storyLikesBulkForm')" /> Select all
                                            </label>
                                            <button type="submit" class="bulk-delete-btn" onclick="return confirmBulkDelete('storyLikesBulkForm', 'story like')">
                                                <i class="fas fa-trash"></i> Delete Selected
                                            </button>
                                        </div>
                                        @{
                                            int storyLikeIndex = 0;
                                        }
                                        @foreach (var sl in Model.StoryLikesList)
                                        {
                                            var storeName = CustomerProfileModel.GetSafeString(sl, new[] { "StoreName" }, "a store");
                                            var likedAt = CustomerProfileModel.GetSafeDateString(sl, new[] { "CreatedAt" });
                                            var storyLikeStoryId = CustomerProfileModel.GetSafeInt(sl, new[] { "StoryID", "StoryId" }, 0);
                                            var storyLikeExtraClass = storyLikeIndex >= 5 ? "extra-item" : "";

                                            <div class="activity-list-item @storyLikeExtraClass">
                                                <input type="checkbox" name="storyIds" value="@storyLikeStoryId" class="item-checkbox" />
                                                <div class="activity-list-main">
                                                    <h4><i class="fas fa-circle-play" style="color:#6d28d9; font-size:12px; margin-right:6px;"></i>Liked a story from @storeName</h4>
                                                </div>
                                                <span class="activity-list-time">@likedAt</span>
                                                <button type="submit" formaction="?handler=DeleteStoryLike" name="storyId" value="@storyLikeStoryId" class="trash-btn" title="Remove story like" onclick="return confirm('Remove this story like?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                            storyLikeIndex++;
                                        }
                                        @if (Model.StoryLikesList.Count > 5)
                                        {
                                            <button type="button" class="view-more-btn" data-more-label="View @(Model.StoryLikesList.Count - 5) more" onclick="toggleViewMore(this)">View @(Model.StoryLikesList.Count - 5) more</button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <div class="activity-empty-inline"><i class="fas fa-circle-play"></i> You haven't liked any stories yet.</div>
                                }
                            </div>

                            <div class="activity-swipe-page">
                                @if (Model.StoryRepliesList.Any())
                                {
                                    <form method="post" asp-page-handler="DeleteStoryReplies" id="storyRepliesBulkForm">
                                        <div class="bulk-actions-bar">
                                            <label class="select-all-label">
                                                <input type="checkbox" class="select-all-checkbox" onclick="toggleSelectAll(this, 'storyRepliesBulkForm')" /> Select all
                                            </label>
                                            <button type="submit" class="bulk-delete-btn" onclick="return confirmBulkDelete('storyRepliesBulkForm', 'story reply')">
                                                <i class="fas fa-trash"></i> Delete Selected
                                            </button>
                                        </div>
                                        @{
                                            int storyReplyIndex = 0;
                                        }
                                        @foreach (var reply in Model.StoryRepliesList)
                                        {
                                            var storeName = CustomerProfileModel.GetSafeString(reply, new[] { "StoreName" }, "a store");
                                            var replyText = CustomerProfileModel.GetSafeString(reply, new[] { "ReplyText", "Content", "Text", "Message" }, "");
                                            var repliedAt = CustomerProfileModel.GetSafeDateString(reply, new[] { "CreatedAt" });
                                            var storyReplyStoryId = CustomerProfileModel.GetSafeInt(reply, new[] { "StoryID", "StoryId" }, 0);
                                            var storyReplyExtraClass = storyReplyIndex >= 5 ? "extra-item" : "";

                                            <div class="activity-list-item @storyReplyExtraClass">
                                                <input type="checkbox" name="storyIds" value="@storyReplyStoryId" class="item-checkbox" />
                                                <div class="activity-list-main">
                                                    <h4>Replied to a story from @storeName</h4>
                                                    <p>"@replyText"</p>
                                                </div>
                                                <span class="activity-list-time">@repliedAt</span>
                                                <button type="submit" formaction="?handler=DeleteStoryReply" name="storyId" value="@storyReplyStoryId" class="trash-btn" title="Delete reply" onclick="return confirm('Delete this story reply?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                            storyReplyIndex++;
                                        }
                                        @if (Model.StoryRepliesList.Count > 5)
                                        {
                                            <button type="button" class="view-more-btn" data-more-label="View @(Model.StoryRepliesList.Count - 5) more" onclick="toggleViewMore(this)">View @(Model.StoryRepliesList.Count - 5) more</button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <div class="activity-empty-inline"><i class="fas fa-reply"></i> You haven't replied to any stories yet.</div>
                                }
                            </div>

                        </div>

                        <div class="activity-swipe-dots">
                            <span class="activity-swipe-dot" data-dot="0"></span>
                            <span class="activity-swipe-dot" data-dot="1"></span>
                            <span class="activity-swipe-dot" data-dot="2"></span>
                            <span class="activity-swipe-dot" data-dot="3"></span>
                            <span class="activity-swipe-dot" data-dot="4"></span>
                        </div>
                    </div>
                </div>

                <div class="activity-section">
                    <h3 class="activity-section-title"><i class="fas fa-ban"></i> Blocked Shops</h3>

                    @if (Model.BlockedStoresList.Any())
                    {
                        <div class="blocked-shops-list">
                            @foreach (var store in Model.BlockedStoresList)
                            {
                                var storeName = CustomerProfileModel.GetSafeString(store, new[] { "StoreName", "Name" }, "Local Store");
                                var storeLogo = CustomerProfileModel.GetSafeString(store, new[] { "LogoURL", "LogoUrl", "Logo", "ImageUrl" }, "https://cdn-icons-png.flaticon.com/512/869/869636.png");
                                var ownerUserId = CustomerProfileModel.GetSafeInt(store, new[] { "OwnerUserID", "OwnerUserId" }, 0);

                                <div class="blocked-shop-item">
                                    <div class="following-store-info" style="cursor: default;">
                                        <img src="@storeLogo" alt="@storeName" class="following-store-logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/869/869636.png'" />
                                        <div class="following-store-names">
                                            <span class="following-store-name">@storeName</span>
                                            <span class="following-store-desc">Blocked — hidden from your feed and search</span>
                                        </div>
                                    </div>
                                    <form method="post" asp-page-handler="UnblockStore">
                                        <input type="hidden" name="blockedUserId" value="@ownerUserId" />
                                        <button type="submit" class="unblock-btn">Unblock</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state" style="padding: 40px 20px;">
                            <div class="empty-icon" style="font-size: 30px;"><i class="fas fa-store-slash"></i></div>
                            <h3 style="font-size: 16px;">No Blocked Shops</h3>
                            <p style="font-size: 13px;">Shops you block will stop appearing in your feed, search, and recommendations.</p>
                        </div>
                    }
                </div>

                <div class="activity-section">
                    <h3 class="activity-section-title"><i class="fas fa-globe"></i> Language Preference</h3>

                    <div class="dash-card" style="box-shadow: none; padding: 22px; margin-bottom: 0;">
                        <div class="form-group" style="max-width: 280px; margin-bottom: 16px;">
                            <label for="languageSelect" style="font-size:12.5px; font-weight:700; color:var(--text-secondary); display:block; margin-bottom:6px;">App Language</label>
                            <select id="languageSelect" style="padding:10px 12px; border:1px solid var(--border-color); border-radius:8px; width:100%; font-family:var(--font-family); font-size:14px;">
                                <option value="en">English</option>
                                <option value="ar">العربية (Arabic)</option>
                                <option value="fr">Français</option>
                            </select>
                        </div>
                        <button type="button" class="role-login-btn" style="width:auto; padding:10px 18px; display:inline-flex;" onclick="saveLanguagePreference()">
                            <i class="fas fa-check"></i> Save Language
                        </button>
                    </div>
                </div>

            </div>

            <div id="wishlist-tab" class="tab-content">

                <div class="content-topbar">
                    <div class="page-heading">
                        <div class="eyebrow">Account</div>
                        <h1>Wishlist</h1>
                        <p>Products you've saved to track and revisit.</p>
                    </div>
                </div>

                @if (Model.WishlistList.Any())
                {
                    <div class="instagram-grid">
                        @foreach (var wish in Model.WishlistList)
                        {
                            var productName = CustomerProfileModel.GetSafeString(wish.Product, new[] { "ProductName", "Name", "Title" }, "Marketplace Product");
                            var productPrice = CustomerProfileModel.GetSafeDecimal(wish.Product, new[] { "Price" }, 0.00m);
                            var productImage = CustomerProfileModel.GetPrimaryProductImageUrl(wish.Product)
                                ?? "https://cdn-icons-png.flaticon.com/512/1170/1170576.png";
                            var productId = CustomerProfileModel.GetSafeInt(wish.Product, new[] { "ProductID", "Id" }, 0);
                            var storeId = CustomerProfileModel.GetSafeInt(wish.Product, new[] { "StoreID", "StoreId" }, 0);
                            <div class="product-grid-item">
                                <img src="@productImage" alt="@productName" onerror="this.src='https://cdn-icons-png.flaticon.com/512/1170/1170576.png'" />
                                <div class="product-details">
                                    <h4>@productName</h4>
                                    <span class="price">$@productPrice.ToString("F2")</span>
                                    <a href="/StoreCustomerProfile?id=@storeId" class="view-btn">View Details</a>
                                    <form method="post" asp-page-handler="ToggleWishlist">
                                        <input type="hidden" name="productId" value="@productId" />
                                        <button type="submit" class="wishlist-btn"><i class="fas fa-heart"></i> Remove from Wishlist</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon"><i class="far fa-bookmark"></i></div>
                        <h3>Wishlist is Empty</h3>
                        <p>Save items you like to monitor price changes and purchase them easily.</p>
                    </div>
                }
            </div>

        </main>
    </div>

    <div id="followingModal" class="modal">
        <div class="modal-content" style="max-width: 400px; padding: 0; overflow: hidden; border-radius: 12px;">
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid var(--border-color);">
                <div style="width: 24px;"></div>
                <h3 style="margin: 0; font-size: 16px; font-weight: 800; text-align: center;">Following</h3>
                <span class="close-modal" onclick="closeFollowingModal()" style="font-size: 20px; font-weight: bold; color: #aaa; cursor: pointer; line-height: 1;">&times;</span>
            </div>
            <div style="max-height: 350px; overflow-y: auto; padding: 8px 0;">
                @if (Model.FollowedStoresList.Any())
                {
                    @foreach (var follow in Model.FollowedStoresList)
                    {
                        var storeName = CustomerProfileModel.GetSafeString(follow.Store, new[] { "StoreName", "Name", "Title" }, "Local Store");
                        var storeDesc = CustomerProfileModel.GetSafeString(follow.Store, new[] { "Description", "Bio", "About" }, "Favorite marketplace shop.");
                        var storeLogo = CustomerProfileModel.GetSafeString(follow.Store, new[] { "LogoUrl", "Logo", "ImageUrl", "LogoPath" }, "https://cdn-icons-png.flaticon.com/512/869/869636.png");
                        var storeId = CustomerProfileModel.GetSafeInt(follow.Store, new[] { "StoreID", "Id" }, 0);

                        <div class="following-list-item">
                            <a href="/StoreCustomerProfile?id=@storeId" class="following-store-info">
                                <img src="@storeLogo" alt="@storeName" class="following-store-logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/869/869636.png'" />
                                <div class="following-store-names">
                                    <span class="following-store-name">@storeName</span>
                                    <span class="following-store-desc">@storeDesc</span>
                                </div>
                            </a>
                            <a href="/StoreCustomerProfile?id=@storeId" class="following-action-btn">Visit</a>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 40px 20px; color: var(--text-secondary); font-size: 14px;">
                        You are not following any shops yet.
                    </div>
                }
            </div>
        </div>
    </div>

    <footer>
        <span>Realnest — your local marketplace companion <i class="fas fa-heart"></i></span>
    </footer>

    <script>
            const TAB_META = {
                "settings-tab": { title: "Management", subtitle: "Manage your account, access, and security." },
                "activity-tab": { title: "Your Activity", subtitle: "Reviews you've left, blocked shops, and language preferences." },
                "wishlist-tab": { title: "Wishlist", subtitle: "Products you've saved to track and revisit." }
            };

            function openFollowingModal() { document.getElementById("followingModal").style.display = "block"; }
            function closeFollowingModal() { document.getElementById("followingModal").style.display = "none"; }

            const ACTIVITY_TILE_TO_INDEX = { reviews: 0, likes: 1, comments: 2, storyLikes: 3, storyReplies: 4 };

            function toggleSelectAll(checkbox, formId) {
                const form = document.getElementById(formId);
                if (!form) return;
                form.querySelectorAll(".item-checkbox").forEach(function(item) { item.checked = checkbox.checked; });
            }

            function confirmBulkDelete(formId, itemLabel) {
                const form = document.getElementById(formId);
                if (!form) return false;
                const checkedCount = form.querySelectorAll(".item-checkbox:checked").length;
                if (checkedCount === 0) { alert("Select at least one " + itemLabel + " to delete."); return false; }
                return confirm("Delete " + checkedCount + " selected " + itemLabel + (checkedCount === 1 ? "" : "s") + "?");
            }

            function toggleViewMore(button) {
                const page = button.closest(".activity-swipe-page");
                if (!page) return;
                const isExpanded = button.dataset.expanded === "true";
                page.querySelectorAll(".extra-item").forEach(function(item) { item.style.display = isExpanded ? "none" : "flex"; });
                button.dataset.expanded = isExpanded ? "false" : "true";
                button.textContent = isExpanded ? button.dataset.moreLabel : "Show less";
            }

            function openActivityPanel(tileKey) {
                selectTab('activity-tab');
                const panel = document.getElementById("activityDetailPanel");
                if (!panel) return;
                panel.classList.add("open");
                const index = ACTIVITY_TILE_TO_INDEX[tileKey] ?? 0;
                window.setTimeout(function() {
                    goToActivityPage(index);
                    panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
                }, 50);
            }

            function closeActivityPanel() {
                const panel = document.getElementById("activityDetailPanel");
                if (panel) panel.classList.remove("open");
            }

            function goToActivityPage(index) {
                const track = document.getElementById("activitySwipeTrack");
                if (!track) return;
                const pageWidth = track.clientWidth;
                track.scrollTo({ left: pageWidth * index, behavior: "smooth" });
                setActiveActivityIndex(index);
            }

            function setActiveActivityIndex(index) {
                document.querySelectorAll(".activity-detail-tab").forEach(function(tab) {
                    tab.classList.toggle("active", Number(tab.dataset.index) === index);
                });
                document.querySelectorAll(".activity-swipe-dot").forEach(function(dot) {
                    dot.classList.toggle("active", Number(dot.dataset.dot) === index);
                });
                document.querySelectorAll(".activity-tile[data-tile]").forEach(function(tile) {
                    const key = tile.dataset.tile;
                    tile.classList.toggle("active", ACTIVITY_TILE_TO_INDEX[key] === index);
                });
            }

            (function initActivitySwipeSync() {
                const track = document.getElementById("activitySwipeTrack");
                if (!track) return;
                let scrollTimeout = null;
                track.addEventListener("scroll", function() {
                    if (scrollTimeout) window.clearTimeout(scrollTimeout);
                    scrollTimeout = window.setTimeout(function() {
                        const pageWidth = track.clientWidth || 1;
                        const index = Math.round(track.scrollLeft / pageWidth);
                        setActiveActivityIndex(index);
                    }, 80);
                });
                window.addEventListener("resize", function() {
                    const pageWidth = track.clientWidth || 1;
                    const index = Math.round(track.scrollLeft / pageWidth);
                    track.scrollTo({ left: pageWidth * index });
                });
            })();

            function saveLanguagePreference() {
                const select = document.getElementById("languageSelect");
                const label = select.options[select.selectedIndex].text;
                alert("Language set to " + label + " (placeholder — connect this to your backend to persist it).");
            }

            window.onclick = function(event) {
                ["followingModal"].forEach(function(id) {
                    const modal = document.getElementById(id);
                    if (event.target === modal) modal.style.display = "none";
                });
            }

            function openSidebar() {
                document.getElementById("sidebar").classList.add("open");
                document.getElementById("sidebarOverlay").classList.add("open");
                document.body.style.overflow = "hidden";
            }

            function closeSidebar() {
                document.getElementById("sidebar").classList.remove("open");
                document.getElementById("sidebarOverlay").classList.remove("open");
                document.body.style.overflow = "";
            }

            function switchTab(tabId) {
                document.querySelectorAll(".tab-content").forEach(tab => tab.classList.remove("active"));
                document.querySelectorAll(".sidebar-link[data-tab]").forEach(link => link.classList.remove("active"));

                document.getElementById(tabId).classList.add("active");

                const activeLink = document.getElementById("link-" + tabId);
                if (activeLink) activeLink.classList.add("active");

                const meta = TAB_META[tabId];
                if (meta) {
                    // no fixed page title element anymore — headings live inside each tab
                }
            }

            function selectTab(tabId) {
                switchTab(tabId);
                closeSidebar();
            }

            document.addEventListener("DOMContentLoaded", function() {
                const dpw = document.getElementById("DeliveryPassword");
                if (dpw) dpw.value = "";
                const spw = document.getElementById("StoreOwnerPassword");
                if (spw) spw.value = "";

                @if (!string.IsNullOrWhiteSpace(deliveryLoginError) || !string.IsNullOrWhiteSpace(storeOwnerLoginError))
                    {
                        <text>selectTab('settings-tab');</text>
                }
                    });
    </script>

</body>
</html>
