@page
@model Local_Multi_Store_Online_Marketplace.Pages.CustomerWishlistModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>My Wishlist | realnest</title>

    <!-- Google Fonts & FontAwesome Icons (Consistent with Customer Cart / Feed) -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-color: #faf9fc;
                --card-bg: #ffffff;
                --border-color: #ece8f6;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --like-color: #ef4444;
                --success-color: #10b981;
                --error-color: #dc2626;
                --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.04);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.08);
                --shadow-lg: 0 20px 40px rgba(109, 40, 217, 0.12);
                --bottom-nav-height: 64px;
                --content-max-width: 1100px;
                --content-side-padding: 16px;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-family);
                background-color: var(--bg-color);
                color: var(--text-primary);
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                padding-bottom: calc(var(--bottom-nav-height) + 34px);
            }

            /* ============================================================
                                               BOTTOM NAV — rendered by the shared _CustomerBottomNav
                                               partial. Styles below match Customer1/Chat/CustomerCart
                                               exactly (same class names) so the partial renders identically.
                                               ============================================================ */
            .mobile-bottom-nav {
                display: flex !important;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 200;
                background: #ffffff;
                border-top: 1px solid #ece8f6;
                justify-content: space-between;
                gap: 2px;
                padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
                overflow-x: auto;
                box-shadow: 0 -4px 20px rgba(30, 27, 46, 0.06);
            }

                .mobile-bottom-nav a {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: 2px;
                    font-size: 10.5px;
                    color: #6b6478;
                    text-decoration: none;
                    padding: 4px 6px;
                    flex-shrink: 0;
                    position: relative;
                    border-radius: 12px;
                    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
                }

                    .mobile-bottom-nav a i {
                        font-size: 17px;
                        transition: transform 0.2s ease;
                    }

                    .mobile-bottom-nav a:hover {
                        background: var(--accent-light);
                        color: var(--accent-color);
                    }

                    .mobile-bottom-nav a.active {
                        color: var(--accent-color) !important;
                        background: var(--accent-light) !important;
                        font-weight: 700;
                        transform: translateY(-2px);
                    }

                        .mobile-bottom-nav a.active i {
                            transform: scale(1.12);
                        }

            .unread-nav-badge {
                position: absolute;
                top: 2px;
                right: 18px;
                background: var(--accent-gradient);
                color: #fff;
                font-size: 10px;
                font-weight: 800;
                min-width: 16px;
                height: 16px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 4px;
                box-shadow: 0 3px 8px rgba(109, 40, 217, 0.3);
            }

            .chat-icon-wrap {
                position: relative;
                display: inline-flex;
            }

                .chat-icon-wrap .chat-nav-dot {
                    position: absolute;
                    top: -2px;
                    right: -4px;
                    width: 9px;
                    height: 9px;
                    background: #ed4956;
                    border: 2px solid #fff;
                    border-radius: 50%;
                    box-sizing: content-box;
                }

            /* PAGE HEADER */
            .wishlist-page {
                padding: 24px var(--content-side-padding) 20px;
                min-height: 100vh;
            }

            .wishlist-header {
                text-align: center;
                margin-bottom: 28px;
                max-width: 1100px;
                margin-left: auto;
                margin-right: auto;
            }

                .wishlist-header h2 {
                    font-family: 'Playfair Display', Georgia, serif;
                    font-size: 34px;
                    font-weight: 800;
                    margin: 0 0 8px;
                    color: var(--text-primary);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                }

                    .wishlist-header h2 i {
                        color: var(--like-color);
                    }

                .wishlist-header p {
                    margin: 0;
                    color: var(--text-secondary);
                    font-size: 15px;
                    font-weight: 500;
                }

            /* TOASTS (identical to Cart) */
            .toast-container {
                position: fixed;
                top: 24px;
                right: 24px;
                z-index: 30000;
                display: flex;
                flex-direction: column;
                gap: 12px;
                pointer-events: none;
            }

            .app-toast {
                width: min(390px, calc(100vw - 40px));
                padding: 16px 20px;
                border-radius: 14px;
                background: var(--card-bg);
                display: flex;
                align-items: flex-start;
                gap: 12px;
                box-shadow: 0 15px 35px rgba(30, 27, 46, 0.12);
                opacity: 0;
                transform: translateX(45px);
                transition: opacity 0.3s ease, transform 0.3s ease;
                pointer-events: auto;
                border-left: 5px solid var(--border-color);
            }

                .app-toast.show {
                    opacity: 1;
                    transform: translateX(0);
                }

                .app-toast.success {
                    border-left-color: var(--success-color);
                }

                    .app-toast.success .toast-icon {
                        background: #e6f7f0;
                        color: var(--success-color);
                    }

                .app-toast.error {
                    border-left-color: var(--error-color);
                }

                    .app-toast.error .toast-icon {
                        background: #fee2e2;
                        color: var(--error-color);
                    }

            .toast-icon {
                width: 28px;
                height: 28px;
                flex: 0 0 28px;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                font-weight: 800;
            }

            .toast-content {
                flex: 1;
            }

            .toast-title {
                display: block;
                margin-bottom: 3px;
                font-weight: 800;
                color: var(--text-primary);
            }

            .toast-message {
                display: block;
                font-size: 13px;
                font-weight: 600;
                line-height: 1.45;
                color: var(--text-secondary);
            }

            .toast-close {
                border: none;
                background: transparent;
                color: var(--text-secondary);
                padding: 0;
                font-size: 22px;
                cursor: pointer;
                line-height: 1;
                transition: color 0.15s ease;
            }

                .toast-close:hover {
                    color: var(--text-primary);
                }

            /* ============================================================
                                               WISHLIST TABLE — same purple/indigo palette + density as
                                               the tightened-up Cart list.
                                               ============================================================ */
            .wishlist-container {
                max-width: var(--content-max-width);
                margin: auto;
            }

            .wishlist-table-wrap {
                background: var(--card-bg);
                border-radius: 20px;
                padding: 8px 20px 20px;
                box-shadow: var(--shadow-md);
                border: 1px solid var(--border-color);
                overflow-x: auto;
            }

            .wishlist-table {
                width: 100%;
                border-collapse: collapse;
                min-width: 760px;
            }

                .wishlist-table thead th {
                    text-align: left;
                    font-size: 14px;
                    font-weight: 800;
                    letter-spacing: 0.4px;
                    text-transform: uppercase;
                    color: var(--accent-color);
                    padding: 16px 10px 12px;
                    border-bottom: 1px solid var(--border-color);
                    white-space: nowrap;
                }

                .wishlist-table tbody td {
                    padding: 12px 10px;
                    border-bottom: 1px solid var(--border-color);
                    vertical-align: middle;
                }

                .wishlist-table tbody tr:last-child td {
                    border-bottom: none;
                }

                .wishlist-table tbody tr {
                    transition: background-color 0.2s ease;
                }

                    .wishlist-table tbody tr:hover {
                        background-color: #fbfaff;
                    }

            .col-product {
                display: flex;
                align-items: center;
                gap: 12px;
                min-width: 240px;
            }

                .col-product img {
                    width: 52px;
                    height: 52px;
                    border-radius: 12px;
                    object-fit: cover;
                    background: #f3f0fa;
                    border: 1px solid var(--border-color);
                    flex-shrink: 0;
                }

            .product-name {
                font-size: 14.5px;
                font-weight: 800;
                color: var(--text-primary);
                margin-bottom: 3px;
                line-height: 1.3;
            }

            .product-store {
                font-size: 12px;
                color: var(--text-secondary);
                font-weight: 600;
            }

            .price-cell {
                font-weight: 800;
                font-size: 15px;
                color: var(--accent-color);
                white-space: nowrap;
            }

            .stock-status {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 12.5px;
                font-weight: 700;
                white-space: nowrap;
            }

                .stock-status.in-stock {
                    color: var(--success-color);
                }

                .stock-status.out-stock {
                    color: var(--error-color);
                }

            .action-cell {
                display: flex;
                align-items: center;
                gap: 8px;
                justify-content: flex-end;
            }

            /* VIEW button — now a labeled pill instead of a bare icon,
                                       so it reads clearly as "View" when clicked on the product */
            .icon-btn {
                height: 34px;
                padding: 0 14px;
                border-radius: 11px;
                border: 1px solid var(--border-color);
                background: var(--card-bg);
                color: var(--text-secondary);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                cursor: pointer;
                text-decoration: none;
                font-size: 12.5px;
                font-weight: 700;
                font-family: var(--font-family);
                white-space: nowrap;
                flex-shrink: 0;
                transition: all 0.2s ease;
            }

                .icon-btn:hover {
                    border-color: var(--accent-color);
                    color: var(--accent-color);
                    background: var(--accent-light);
                }

                /* Remove button stays a round icon-only button */
                .icon-btn.remove-icon-btn {
                    width: 34px;
                    padding: 0;
                    border-color: #ffd1cc;
                    color: var(--like-color);
                    background: #fff5f5;
                }

                    .icon-btn.remove-icon-btn:hover {
                        background: var(--like-color);
                        color: #ffffff;
                        border-color: var(--like-color);
                    }

            .add-cart-btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                background: var(--accent-gradient);
                color: #ffffff;
                border: none;
                border-radius: 50px;
                padding: 9px 16px;
                font-family: var(--font-family);
                font-weight: 800;
                font-size: 12.5px;
                white-space: nowrap;
                cursor: pointer;
                box-shadow: 0 8px 18px rgba(109, 40, 217, 0.25);
                transition: all 0.2s ease;
            }

                .add-cart-btn:hover {
                    opacity: 0.95;
                    transform: translateY(-1px);
                    box-shadow: 0 10px 22px rgba(109, 40, 217, 0.32);
                }

            /* QUANTITY STEPPER — how many the customer wants to add to
                                               cart. Purely client-side; capped server-side against stock
                                               inside OnPostMoveToCartAsync. */
            .qty-stepper {
                display: inline-flex;
                align-items: center;
                border: 1px solid var(--border-color);
                border-radius: 50px;
                overflow: hidden;
                background: var(--bg-color);
            }

            .qty-btn {
                width: 28px;
                height: 28px;
                border: none;
                background: transparent;
                color: var(--accent-color);
                font-size: 15px;
                font-weight: 800;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: background-color 0.15s ease;
            }

                .qty-btn:hover {
                    background: var(--accent-light);
                }

            .qty-value {
                width: 32px;
                text-align: center;
                border: none;
                background: transparent;
                font-family: var(--font-family);
                font-weight: 700;
                font-size: 13px;
                color: var(--text-primary);
                -moz-appearance: textfield;
            }

                .qty-value::-webkit-outer-spin-button,
                .qty-value::-webkit-inner-spin-button {
                    -webkit-appearance: none;
                    margin: 0;
                }

            /* EMPTY STATE (same visual language as Cart's empty state) */
            .empty-wishlist {
                max-width: 700px;
                margin: 40px auto;
                background: var(--card-bg);
                text-align: center;
                color: var(--text-secondary);
                padding: 60px 40px;
                border-radius: 20px;
                border: 2px dashed #ded4f5;
                box-shadow: var(--shadow-sm);
            }

                .empty-wishlist h3 {
                    color: var(--text-primary);
                    font-size: 22px;
                    font-weight: 800;
                    margin-bottom: 10px;
                }

            .shop-link {
                display: inline-block;
                margin-top: 20px;
                background: var(--accent-gradient);
                color: white;
                padding: 12px 28px;
                border-radius: 50px;
                text-decoration: none;
                font-weight: 800;
                box-shadow: 0 4px 12px rgba(109, 40, 217, 0.25);
                transition: all 0.25s ease;
            }

                .shop-link:hover {
                    opacity: 0.95;
                    box-shadow: 0 6px 15px rgba(109, 40, 217, 0.35);
                }

            @@media (max-width: 550px) {
                .wishlist-page {
                    padding: 20px 12px 16px;
                }

                .wishlist-table-wrap {
                    padding: 8px 12px 14px;
                }

                .action-cell {
                    justify-content: flex-start;
                }

                .toast-container {
                    top: 15px;
                    right: 15px;
                    left: 15px;
                }

                .app-toast {
                    width: 100%;
                }
            }
    </style>
</head>

<body>

    <!-- =====================================================
         SUCCESS AND ERROR TOASTERS
         ===================================================== -->
    <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true">

        @if (TempData["Success"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="app-toast success" data-toast>
                <span class="toast-icon">✓</span>
                <div class="toast-content">
                    <span class="toast-title">Success</span>
                    <span class="toast-message">@successMessage</span>
                </div>
                <button type="button" class="toast-close" aria-label="Close notification">&times;</button>
            </div>
        }

        @if (TempData["Error"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="app-toast error" data-toast>
                <span class="toast-icon">!</span>
                <div class="toast-content">
                    <span class="toast-title">Unable to continue</span>
                    <span class="toast-message">@errorMessage</span>
                </div>
                <button type="button" class="toast-close" aria-label="Close notification">&times;</button>
            </div>
        }
    </div>

    <partial name="_CustomerBottomNav" />

    <div class="wishlist-page">

        <div class="wishlist-header">
            <h2><i class="fa-regular fa-heart"></i> My Wishlist</h2>
            <p>Products you saved for future purchase.</p>
        </div>

        @if (Model.WishlistItems == null || !Model.WishlistItems.Any())
        {
            <div class="empty-wishlist">
                <h3>Your wishlist is empty</h3>
                <p>Save products you like and view them later.</p>
                <a href="/CustomerProducts" class="shop-link">Browse Products</a>
            </div>
        }
        else
        {
            <div class="wishlist-container">
                <div class="wishlist-table-wrap">
                    <table class="wishlist-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Price</th>
                                <th>Stock Status</th>
                                <th style="text-align:right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.WishlistItems)
                            {
                                <tr>
                                    <td>
                                        <div class="col-product">
                                            <img src="@item.ImageUrl"
                                                 alt="@item.ProductName"
                                                 onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                            <div>
                                                <div class="product-name">@item.ProductName</div>
                                                <div class="product-store">Store: @item.StoreName</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        @if (!item.IsOutOfStock)
                                        {
                                            <div class="qty-stepper">
                                                <button type="button" class="qty-btn qty-decrease" aria-label="Decrease quantity">−</button>
                                                <input type="number"
                                                       class="qty-value"
                                                       value="1"
                                                       min="1"
                                                       readonly />
                                                <button type="button" class="qty-btn qty-increase" aria-label="Increase quantity">+</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="product-store">—</span>
                                        }
                                    </td>

                                    <td class="price-cell">
                                        $@item.Price.ToString("N2")
                                    </td>

                                    <td>
                                        @if (!item.IsOutOfStock)
                                        {
                                            <span class="stock-status in-stock">
                                                <i class="fa-solid fa-check"></i> In Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="stock-status out-stock">
                                                <i class="fa-solid fa-xmark"></i> Out of Stock
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="action-cell">

                                            <!-- VIEW PRODUCT — adjust route to your actual product-details page -->
                                            <a href="/CustomerProductDetails?productId=@item.ProductID"
                                               class="icon-btn"
                                               title="View product"
                                               aria-label="View @item.ProductName">
                                                View
                                            </a>

                                            @if (!item.IsOutOfStock)
                                            {
                                                <form method="post"
                                                      asp-page-handler="MoveToCart"
                                                      asp-route-productId="@item.ProductID"
                                                      class="add-to-cart-form">
                                                    <input type="hidden" name="quantity" class="qty-hidden-input" value="1" />
                                                    <button type="submit" class="add-cart-btn">
                                                        <i class="fa-solid fa-cart-shopping"></i> Add to Cart
                                                    </button>
                                                </form>
                                            }

                                            <form method="post"
                                                  asp-page-handler="Remove"
                                                  asp-route-productId="@item.ProductID">
                                                <button type="submit"
                                                        class="icon-btn remove-icon-btn"
                                                        title="Remove from wishlist"
                                                        aria-label="Remove @item.ProductName from wishlist">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                initializeToasts();
                initializeWishlistQuantitySteppers();
            });

            // =====================================================
            // TOASTS
            // =====================================================
            function initializeToasts() {
                const toasts = document.querySelectorAll("[data-toast]");

                toasts.forEach(function(toast, index) {
                    window.setTimeout(function() {
                        toast.classList.add("show");
                    }, 100 + (index * 100));

                    const closeButton = toast.querySelector(".toast-close");

                    if (closeButton) {
                        closeButton.addEventListener("click", function() {
                            removeToast(toast);
                        });
                    }

                    window.setTimeout(function() {
                        removeToast(toast);
                    }, 5000 + (index * 300));
                });
            }

            function removeToast(toast) {
                if (!toast || !toast.isConnected) {
                    return;
                }

                toast.classList.remove("show");

                window.setTimeout(function() {
                    toast.remove();
                }, 300);
            }

            // =====================================================
            // WISHLIST QUANTITY STEPPERS
            // Purely client-side "how many do I want to add" control.
            // Synced into the hidden "quantity" input inside each
            // product's Add to Cart form. The server caps the final
            // value against actual stock in OnPostMoveToCartAsync.
            // =====================================================
            function initializeWishlistQuantitySteppers() {
                const steppers = document.querySelectorAll(".qty-stepper");

                steppers.forEach(function(stepper) {
                    const input = stepper.querySelector(".qty-value");
                    const decreaseBtn = stepper.querySelector(".qty-decrease");
                    const increaseBtn = stepper.querySelector(".qty-increase");

                    const row = stepper.closest("tr");
                    const hiddenInput = row
                        ? row.querySelector(".qty-hidden-input")
                        : null;

                    function syncHiddenInput() {
                        if (hiddenInput) {
                            hiddenInput.value = input.value;
                        }
                    }

                    decreaseBtn.addEventListener("click", function() {
                        const current = parseInt(input.value, 10) || 1;
                        if (current > 1) {
                            input.value = current - 1;
                            syncHiddenInput();
                        }
                    });

                    increaseBtn.addEventListener("click", function() {
                        const current = parseInt(input.value, 10) || 1;
                        input.value = current + 1;
                        syncHiddenInput();
                    });
                });
            }
    </script>

</body>
</html>