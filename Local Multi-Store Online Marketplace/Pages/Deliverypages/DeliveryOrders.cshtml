@page "/DeliveryOrders"
@model Local_Multi_Store_Online_Marketplace.Pages.Deliverypages.DeliveryOrdersModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Delivery Orders</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary: #6D28D9;
            --primary-hover: #4C1D95;
            --primary-light: #EDE9FE;
            --secondary: #ff6b35;
            --success: #22c55e;
            --success-bg: #dcfce7;
            --warning: #f59e0b;
            --warning-bg: #fef3c7;
            --danger: #ef4444;
            --danger-bg: #fee2e2;
            --status-blue: #7C3AED;
            --status-blue-bg: #F3E8FF;
            --info: #8B5CF6;
            --bg: #f4f6f9;
            --bg-2: #eef2f7;
            --surface: #ffffff;
            --ink-900: #0f172a;
            --ink-600: #64748b;
            --ink-400: #94a3b8;
            --border: #e2e8f0;
            --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
            --shadow-sm: 0 4px 14px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 12px 32px rgba(15, 23, 42, 0.08);
            --shadow-lg: 0 20px 45px rgba(15, 23, 42, 0.10);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: radial-gradient(circle at top left, rgba(109, 40, 217, 0.05), transparent 45%), var(--bg);
            font-family: 'Inter', Arial, sans-serif;
            color: var(--ink-900);
        }

        .page {
            min-height: 100vh;
            padding: 32px 24px 60px;
        }

        .shell {
            max-width: 1280px;
            margin: auto;
        }

        /* ================= HEADER ================= */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 26px;
            flex-wrap: wrap;
        }

        .header-title-group {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .header-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 14px;
            background: var(--primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: var(--shadow-sm);
        }

        .page-header h1 {
            margin: 0 0 6px;
            font-family: 'Sora', sans-serif;
            font-weight: 700;
            font-size: 25px;
            letter-spacing: -0.3px;
        }

        .page-header p {
            margin: 0;
            color: var(--ink-600);
            font-size: 13.5px;
        }

        .dashboard-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--primary);
            border: 1px solid var(--primary);
            color: #fff;
            padding: 13px 20px;
            border-radius: 13px;
            text-decoration: none;
            font-weight: 700;
            font-size: 13.5px;
            box-shadow: var(--shadow-sm);
            transition: all .16s ease;
        }

            .dashboard-link:hover {
                background: var(--primary-hover);
                border-color: var(--primary-hover);
                box-shadow: var(--shadow-md);
                transform: translateY(-1px);
            }

        /* ================= KPI ROW ================= */
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
            margin-bottom: 22px;
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: var(--shadow-xs);
            transition: all .18s ease;
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

            .kpi-card:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-2px);
            }

        .kpi-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
        }

        .kpi-icon-blue {
            background: var(--primary-light);
            color: var(--primary);
        }

        .kpi-icon-orange {
            background: var(--warning-bg);
            color: var(--warning);
        }

        .kpi-icon-lightblue {
            background: var(--status-blue-bg);
            color: var(--status-blue);
        }

        .kpi-icon-green {
            background: var(--success-bg);
            color: var(--success);
        }

        .kpi-icon-red {
            background: var(--danger-bg);
            color: var(--danger);
        }

        .kpi-content {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .kpi-label {
            color: var(--ink-600);
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .kpi-number {
            font-size: 24px;
            font-family: 'Sora', sans-serif;
            font-weight: 700;
            line-height: 1.25;
        }

        .kpi-desc {
            color: var(--ink-400);
            font-size: 11px;
            font-weight: 500;
        }

        /* ================= TOOLBAR ================= */
        .toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .search-box {
            flex: 1 1 260px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 12px 16px;
            box-shadow: var(--shadow-xs);
            transition: all .16s ease;
        }

            .search-box:focus-within {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.10);
            }

            .search-box i {
                color: var(--ink-400);
                font-size: 15px;
            }

            .search-box input {
                border: none;
                outline: none;
                width: 100%;
                font-family: 'Inter', sans-serif;
                font-size: 13.5px;
                color: var(--ink-900);
                background: transparent;
            }

                .search-box input::placeholder {
                    color: var(--ink-400);
                }

        .filters {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .filter-link {
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 999px;
            font-size: 12.5px;
            font-weight: 700;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--ink-600);
            transition: all .16s ease;
            white-space: nowrap;
        }

            .filter-link:hover {
                border-color: var(--primary);
                color: var(--primary);
                transform: translateY(-1px);
            }

            .filter-link.active {
                background: var(--primary);
                border-color: var(--primary);
                color: white;
                box-shadow: 0 6px 16px rgba(109, 40, 217, 0.25);
            }

        .sort-box {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--ink-600);
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 11px 14px;
            box-shadow: var(--shadow-xs);
        }

            .sort-box select {
                border: none;
                outline: none;
                background: transparent;
                font-family: 'Inter', sans-serif;
                font-weight: 700;
                font-size: 12.5px;
                color: var(--ink-900);
            }

        .message {
            padding: 14px 16px;
            border-radius: 14px;
            margin-bottom: 18px;
            font-weight: 700;
            font-size: 13.5px;
        }

        .error {
            background: var(--danger-bg);
            color: #991b1b;
            border: 1px solid #fca5a5;
        }

        /* ================= ORDER LIST ================= */
        .order-list {
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .order-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left: 5px solid var(--ink-400);
            border-radius: 20px;
            box-shadow: var(--shadow-sm);
            padding: 22px 24px;
            transition: all .18s ease;
        }

            .order-card:hover {
                box-shadow: var(--shadow-lg);
                transform: translateY(-2px);
            }

            .order-card.badge-assigned {
                border-left-color: var(--warning);
            }

            .order-card.badge-out {
                border-left-color: var(--status-blue);
            }

            .order-card.badge-delivered {
                border-left-color: var(--success);
            }

            .order-card.badge-cancelled {
                border-left-color: var(--danger);
            }

        /* ---- Top section ---- */
        .order-card-top {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            flex-wrap: wrap;
        }

        .order-icon-box {
            width: 50px;
            height: 50px;
            min-width: 50px;
            border-radius: 14px;
            background: var(--primary-light);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

            .order-icon-box.badge-assigned {
                background: var(--warning-bg);
                color: var(--warning);
            }

            .order-icon-box.badge-out {
                background: var(--status-blue-bg);
                color: var(--status-blue);
            }

            .order-icon-box.badge-delivered {
                background: var(--success-bg);
                color: var(--success);
            }

            .order-icon-box.badge-cancelled {
                background: var(--danger-bg);
                color: var(--danger);
            }

        .order-title-block {
            min-width: 0;
        }

        .order-number {
            font-weight: 700;
            font-size: 15px;
            font-family: 'JetBrains Mono', monospace;
            word-break: break-word;
        }

        .order-id {
            color: var(--ink-400);
            font-size: 11.5px;
            margin-top: 4px;
            font-weight: 500;
        }

        .order-store {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--primary);
            font-size: 12.5px;
            font-weight: 700;
            margin-top: 4px;
        }

            .order-store i {
                font-size: 12px;
            }

        .order-status-price {
            margin-left: auto;
            display: flex;
            align-items: flex-end;
            gap: 18px;
            flex-wrap: wrap;
        }

        .badge-stack {
            display: flex;
            flex-direction: column;
            gap: 6px;
            align-items: flex-end;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 13px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.2px;
            white-space: nowrap;
        }

            .badge i {
                font-size: 7px;
            }

            .badge.badge-assigned {
                background: var(--warning-bg);
                color: #92400e;
            }

            .badge.badge-out {
                background: var(--status-blue-bg);
                color: var(--status-blue);
            }

            .badge.badge-delivered {
                background: var(--success-bg);
                color: #166534;
            }

            .badge.badge-cancelled {
                background: var(--danger-bg);
                color: #991b1b;
            }

            .badge.badge-default {
                background: var(--bg-2);
                color: var(--ink-600);
            }

        .order-amount {
            font-family: 'Sora', sans-serif;
            font-weight: 700;
            font-size: 20px;
            text-align: right;
            white-space: nowrap;
        }

        .hide-order-form {
            flex-shrink: 0;
            display: flex;
            align-items: flex-start;
        }

        .hide-order-btn {
            width: 30px;
            height: 30px;
            min-width: 30px;
            border-radius: 50%;
            background: var(--surface);
            border: 1.5px solid #fecaca;
            color: var(--danger);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            cursor: pointer;
            transition: all .16s ease;
            padding: 0;
        }

            .hide-order-btn:hover {
                background: var(--danger-bg);
                border-color: var(--danger);
                transform: scale(1.08);
            }

            .hide-order-btn:active {
                transform: scale(0.92);
            }

        /* =====================================================
                           TOAST NOTIFICATIONS
                           (same component/animation as Customer Cart's toast
                           system, mapped to this page's own color variables)
                           ===================================================== */
        .toast-container {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 30000;
            display: flex;
            flex-direction: column;
            gap: 12px;
            pointer-events: none;
        }

        .app-toast {
            width: min(390px, calc(100vw - 40px));
            padding: 16px 20px;
            border-radius: 14px;
            background: var(--surface);
            display: flex;
            align-items: flex-start;
            gap: 12px;
            box-shadow: var(--shadow-lg);
            opacity: 0;
            transform: translateX(45px);
            transition: opacity 0.3s ease, transform 0.3s ease;
            pointer-events: auto;
            border-left: 5px solid var(--border);
        }

            .app-toast.show {
                opacity: 1;
                transform: translateX(0);
            }

            .app-toast.success {
                border-left-color: var(--success);
                color: var(--ink-900);
            }

                .app-toast.success .toast-icon {
                    background: var(--success-bg);
                    color: var(--success);
                }

            .app-toast.error {
                border-left-color: var(--danger);
                color: var(--ink-900);
            }

                .app-toast.error .toast-icon {
                    background: var(--danger-bg);
                    color: var(--danger);
                }

        .toast-icon {
            width: 28px;
            height: 28px;
            flex: 0 0 28px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: 800;
        }

        .toast-content {
            flex: 1;
        }

        .toast-title {
            display: block;
            margin-bottom: 3px;
            font-weight: 800;
            color: var(--ink-900);
        }

        .toast-message {
            display: block;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.45;
            color: var(--ink-600);
        }

        .toast-close {
            border: none;
            background: transparent;
            color: var(--ink-600);
            padding: 0;
            font-size: 22px;
            cursor: pointer;
            line-height: 1;
            transition: color 0.15s ease;
        }

            .toast-close:hover {
                color: var(--ink-900);
            }

        /* =====================================================
                           CONFIRMATION MODAL
                           (same component as Customer Cart's Remove Item modal,
                           reused here for "Hide this order?")
                           ===================================================== */
        body.modal-open {
            overflow: hidden;
        }

        .app-modal {
            position: fixed;
            inset: 0;
            z-index: 20000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(5px);
        }

            .app-modal.open {
                display: flex;
            }

        .modal-card {
            width: min(420px, 100%);
            background: var(--surface);
            border-radius: 20px;
            padding: 30px;
            box-shadow: var(--shadow-lg);
            transform: translateY(15px) scale(0.98);
            opacity: 0;
            transition: 0.2s ease;
            border: 1px solid var(--border);
        }

        .app-modal.open .modal-card {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        .modal-icon {
            width: 54px;
            height: 54px;
            margin: 0 auto 15px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            background: var(--primary-light);
            color: var(--primary);
        }

        .modal-title {
            margin: 0 0 8px;
            text-align: center;
            color: var(--ink-900);
            font-family: 'Sora', sans-serif;
            font-size: 20px;
            font-weight: 700;
        }

        .modal-description {
            margin: 0 0 20px;
            text-align: center;
            color: var(--ink-600);
            font-size: 13.5px;
            line-height: 1.55;
        }

        .modal-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 20px;
        }

        .modal-cancel,
        .modal-confirm {
            border: none;
            border-radius: 50px;
            padding: 12px 16px;
            font-weight: 700;
            font-size: 13.5px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .modal-cancel {
            background: var(--bg-2);
            border: 1px solid var(--border);
            color: var(--ink-600);
        }

        .modal-confirm {
            background: var(--primary);
            color: white;
        }

        .modal-cancel:hover {
            background: var(--border);
            color: var(--ink-900);
        }

        .modal-confirm:hover {
            background: var(--primary-hover);
        }

        .modal-confirm:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

        @@media (max-width: 550px) {
            .toast-container {
                top: 15px;
                right: 15px;
                left: 15px;
            }

            .app-toast {
                width: 100%;
            }

            .modal-actions {
                grid-template-columns: 1fr;
            }
        }

        /* ---- Middle section ---- */
        .order-card-mid {
            display: flex;
            gap: 22px;
            flex-wrap: wrap;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #f1f5f9;
        }

        .order-info-item {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            color: var(--ink-600);
            font-size: 12.5px;
            line-height: 1.4;
        }

            .order-info-item i {
                color: var(--ink-400);
                font-size: 14px;
                margin-top: 1px;
            }

        /* ---- Timeline ---- */
        .delivery-timeline {
            margin-top: 18px;
            padding-top: 18px;
            border-top: 1px solid #f1f5f9;
        }

        .timeline-track {
            display: flex;
            align-items: center;
        }

        .timeline-node {
            width: 26px;
            height: 26px;
            min-width: 26px;
            border-radius: 50%;
            background: var(--surface);
            border: 2px solid var(--border);
            color: var(--ink-400);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

            .timeline-node.done.badge-assigned {
                background: var(--warning);
                border-color: var(--warning);
                color: #fff;
            }

            .timeline-node.done.badge-out {
                background: var(--status-blue);
                border-color: var(--status-blue);
                color: #fff;
            }

            .timeline-node.done.badge-delivered {
                background: var(--success);
                border-color: var(--success);
                color: #fff;
            }

        .timeline-line {
            flex: 1;
            height: 3px;
            background: var(--border);
            margin: 0 4px;
            border-radius: 2px;
        }

            .timeline-line.done.badge-assigned {
                background: var(--warning);
            }

            .timeline-line.done.badge-out {
                background: var(--status-blue);
            }

            .timeline-line.done.badge-delivered {
                background: var(--success);
            }

        .timeline-labels {
            display: flex;
            margin-top: 8px;
        }

        .timeline-label {
            flex: 1;
            font-size: 11px;
            color: var(--ink-600);
            font-weight: 600;
        }

            .timeline-label:last-child {
                text-align: right;
            }

            .timeline-label:not(:first-child):not(:last-child) {
                text-align: center;
            }

            .timeline-label span {
                display: block;
                color: var(--ink-400);
                font-weight: 500;
                font-size: 10.5px;
                margin-top: 2px;
            }

        .cancelled-banner {
            margin-top: 18px;
            padding: 12px 16px;
            border-radius: 12px;
            background: var(--danger-bg);
            color: #991b1b;
            font-weight: 700;
            font-size: 12.5px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-top: 1px solid transparent;
        }

        /* ---- Bottom section ---- */
        .order-card-bottom {
            margin-top: 18px;
            padding-top: 18px;
            border-top: 1px dashed var(--border);
            display: flex;
            align-items: flex-end;
            gap: 16px;
            flex-wrap: wrap;
        }

        .detail-grid {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 12px;
        }

        .detail-item {
            min-width: 0;
        }

        .detail-label {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--ink-400);
            font-size: 10.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.2px;
            margin-bottom: 5px;
        }

            .detail-label i {
                font-size: 12px;
            }

        .detail-item strong {
            color: var(--ink-900);
            font-size: 12.5px;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            word-break: break-word;
        }

        .order-actions {
            min-width: 190px;
        }

        .action-link {
            display: inline-flex;
            width: 100%;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            padding: 13px 20px;
            border-radius: 13px;
            font-size: 13px;
            font-weight: 700;
            background: var(--primary);
            color: white;
            transition: all .16s ease;
            white-space: nowrap;
        }

            .action-link:hover {
                background: var(--primary-hover);
                transform: translateY(-1px);
                box-shadow: 0 8px 18px rgba(109, 40, 217, 0.28);
            }

        .empty-box {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 60px 20px;
            text-align: center;
            color: var(--ink-400);
            box-shadow: var(--shadow-sm);
        }

            .empty-box i {
                font-size: 34px;
                color: var(--ink-400);
                margin-bottom: 10px;
                display: block;
            }

            .empty-box h3 {
                margin: 0 0 8px;
                color: var(--ink-900);
                font-family: 'Sora', sans-serif;
            }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 1080px) {
            .kpi-row {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 900px) {
            .kpi-row {
                grid-template-columns: repeat(2, 1fr);
            }

            .order-status-price {
                margin-left: 0;
                width: 100%;
                justify-content: space-between;
            }

            .hide-order-form {
                margin-left: auto;
            }

            .badge-stack {
                align-items: flex-start;
            }

            .order-actions {
                width: 100%;
            }

            .action-link {
                width: 100%;
            }
        }

        @@media (max-width: 650px) {
            .page {
                padding: 20px 12px;
            }

            .kpi-row {
                grid-template-columns: 1fr;
            }

            .kpi-card {
                border-radius: 16px;
            }

            .order-card {
                padding: 18px;
                border-radius: 16px;
            }

            .order-card-mid {
                flex-direction: column;
                gap: 10px;
            }

            .detail-grid {
                grid-template-columns: 1fr 1fr;
            }

            .timeline-label {
                font-size: 10px;
            }

                .timeline-label span {
                    font-size: 9.5px;
                }

            .header-title-group {
                width: 100%;
            }

            .dashboard-link {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 400px) {
            .detail-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div id="toastContainer"
         class="toast-container"
         aria-live="polite"
         aria-atomic="true">

        @if (TempData["Success"] is string successMessage &&
        !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="app-toast success" data-toast>
                <span class="toast-icon">✓</span>

                <div class="toast-content">
                    <span class="toast-title">
                        Success
                    </span>

                    <span class="toast-message">
                        @successMessage
                    </span>
                </div>

                <button type="button"
                        class="toast-close"
                        aria-label="Close notification">
                    &times;
                </button>
            </div>
        }

        @if (TempData["Error"] is string errorMessage &&
        !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="app-toast error" data-toast>
                <span class="toast-icon">!</span>

                <div class="toast-content">
                    <span class="toast-title">
                        Unable to continue
                    </span>

                    <span class="toast-message">
                        @errorMessage
                    </span>
                </div>

                <button type="button"
                        class="toast-close"
                        aria-label="Close notification">
                    &times;
                </button>
            </div>
        }
    </div>

    <partial name="_DeliveryNav" />

    <div class="page">
        <div class="shell">

            <div class="page-header">
                <div class="header-title-group">
                    <div class="header-icon">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div>
                        <h1>My Delivery Orders</h1>
                        <p>
                            View assigned, active, completed, and cancelled deliveries.
                        </p>
                    </div>
                </div>

                <a href="/DeliveryDashboard" class="dashboard-link">
                    <i class="bi bi-grid-1x2-fill"></i> Open Dashboard
                </a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="message error">
                    @Model.ErrorMessage
                </div>
            }

            <div class="kpi-row">
                <div class="kpi-card">
                    <div class="kpi-icon kpi-icon-blue"><i class="bi bi-box-seam-fill"></i></div>
                    <div class="kpi-content">
                        <span class="kpi-label">Total Orders</span>
                        <strong class="kpi-number">@Model.TotalCount</strong>
                        <span class="kpi-desc">All time</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon kpi-icon-orange"><i class="bi bi-person-fill"></i></div>
                    <div class="kpi-content">
                        <span class="kpi-label">Assigned</span>
                        <strong class="kpi-number">@Model.AssignedCount</strong>
                        <span class="kpi-desc">Needs pickup</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon kpi-icon-lightblue"><i class="bi bi-truck"></i></div>
                    <div class="kpi-content">
                        <span class="kpi-label">Out for Delivery</span>
                        <strong class="kpi-number">@Model.OutForDeliveryCount</strong>
                        <span class="kpi-desc">On the way</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon kpi-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                    <div class="kpi-content">
                        <span class="kpi-label">Delivered</span>
                        <strong class="kpi-number">@Model.DeliveredCount</strong>
                        <span class="kpi-desc">Completed</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon kpi-icon-red"><i class="bi bi-x-circle-fill"></i></div>
                    <div class="kpi-content">
                        <span class="kpi-label">Cancelled / Failed</span>
                        <strong class="kpi-number">@Model.CancelledCount</strong>
                        <span class="kpi-desc">No failed orders</span>
                    </div>
                </div>
            </div>

            <div class="toolbar">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search Order ID, customer, address..." />
                </div>

                <div class="filters">
                    <a href="/DeliveryOrders?StatusFilter=All"
                       class="filter-link @(Model.StatusFilter == "All" ? "active" : "")">
                        All
                    </a>

                    <a href="/DeliveryOrders?StatusFilter=Assigned"
                       class="filter-link @(Model.StatusFilter == "Assigned" ? "active" : "")">
                        Assigned
                    </a>

                    <a href="/DeliveryOrders?StatusFilter=OutForDelivery"
                       class="filter-link @(Model.StatusFilter == "OutForDelivery" ? "active" : "")">
                        Out for Delivery
                    </a>

                    <a href="/DeliveryOrders?StatusFilter=Delivered"
                       class="filter-link @(Model.StatusFilter == "Delivered" ? "active" : "")">
                        Delivered
                    </a>

                    <a href="/DeliveryOrders?StatusFilter=Cancelled"
                       class="filter-link @(Model.StatusFilter == "Cancelled" ? "active" : "")">
                        Cancelled / Failed
                    </a>
                </div>

                <div class="sort-box">
                    <span>Sort by:</span>
                    <select>
                        <option>Newest First</option>
                    </select>
                </div>
            </div>

            @if (Model.Orders == null || !Model.Orders.Any())
            {
                <div class="empty-box">
                    <i class="bi bi-inbox"></i>
                    <h3>No delivery orders found</h3>
                    <p>
                        Orders assigned by the admin will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="order-list">

                    @foreach (var order in Model.Orders)
                    {
                        var cleanStatus = order.AssignmentStatus?.Trim();

                        var badgeClass =
                        cleanStatus == "Assigned"
                        ? "badge-assigned"
                        : cleanStatus == "OutForDelivery"
                        ? "badge-out"
                        : cleanStatus == "Delivered"
                        ? "badge-delivered"
                        : cleanStatus == "Cancelled" ||
                        cleanStatus == "Failed"
                        ? "badge-cancelled"
                        : "badge-default";

                        var displayStatus =
                        cleanStatus == "OutForDelivery"
                        ? "Out for Delivery"
                        : cleanStatus;

                        <div class="order-card @badgeClass">

                            <div class="order-card-top">

                                <div class="order-icon-box @badgeClass">
                                    <i class="bi bi-box-seam-fill"></i>
                                </div>

                                <div class="order-title-block">
                                    <div class="order-number">
                                        @order.OrderNumber
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(order.StoreNames))
                                    {
                                        <div class="order-store">
                                            <i class="bi bi-shop"></i> @order.StoreNames
                                        </div>
                                    }

                                    <div class="order-id">
                                        Order ID: @order.OrderID
                                    </div>
                                </div>

                                <div class="order-status-price">
                                    <div class="badge-stack">
                                        <span class="badge @badgeClass">
                                            <i class="bi bi-circle-fill"></i> @displayStatus
                                        </span>

                                        @if ((order.OrderStatus?.Trim().ToUpperInvariant()) != (displayStatus?.Trim().ToUpperInvariant()))
                                        {
                                            <span class="badge badge-default">
                                                @order.OrderStatus
                                            </span>
                                        }
                                    </div>

                                    <div class="order-amount">
                                        $@order.TotalAmount.ToString("0.00")
                                    </div>
                                </div>

                                @if (badgeClass == "badge-delivered" || badgeClass == "badge-cancelled")
                                {
                                    <form id="hideOrderForm-@order.AssignmentID"
                                          method="post"
                                          asp-page-handler="HideOrder"
                                          class="hide-order-form">
                                        <input type="hidden" name="assignmentId" value="@order.AssignmentID" />
                                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                        <button type="button"
                                                class="hide-order-btn hide-order-trigger"
                                                data-form-id="hideOrderForm-@order.AssignmentID"
                                                data-order-number="@order.OrderNumber"
                                                title="Hide from my list"
                                                aria-label="Hide this order from my list">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                }

                            </div>

                            <div class="order-card-mid">
                                <div class="order-info-item">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <span>@order.CustomerAddress</span>
                                </div>

                                <div class="order-info-item">
                                    <i class="bi bi-clock-fill"></i>
                                    <span>Assigned @Model.FormatLocalTime(order.AssignedAt)</span>
                                </div>
                            </div>

                            @if (badgeClass != "badge-cancelled")
                            {
                                <div class="delivery-timeline">
                                    <div class="timeline-track">
                                        <div class="timeline-node done @badgeClass">
                                            <i class="bi bi-check-lg"></i>
                                        </div>
                                        <div class="timeline-line @(badgeClass == "badge-out" || badgeClass == "badge-delivered" ? "done " + badgeClass : "")"></div>
                                        <div class="timeline-node @(badgeClass == "badge-out" || badgeClass == "badge-delivered" ? "done " + badgeClass : "")">
                                            @if (badgeClass == "badge-out" || badgeClass == "badge-delivered")
                                            {
                                                <i class="bi bi-check-lg"></i>
                                            }
                                        </div>
                                        <div class="timeline-line @(badgeClass == "badge-delivered" ? "done " + badgeClass : "")"></div>
                                        <div class="timeline-node @(badgeClass == "badge-delivered" ? "done " + badgeClass : "")">
                                            @if (badgeClass == "badge-delivered")
                                            {
                                                <i class="bi bi-check-lg"></i>
                                            }
                                        </div>
                                    </div>

                                    <div class="timeline-labels">
                                        <div class="timeline-label">
                                            Assigned
                                            <span>@Model.FormatLocalTime(order.AssignedAt)</span>
                                        </div>
                                        <div class="timeline-label">
                                            Picked Up
                                            <span>@(badgeClass == "badge-out" || badgeClass == "badge-delivered" ? Model.FormatLocalTime(order.PickupTime) : "—")</span>
                                        </div>
                                        <div class="timeline-label">
                                            Delivered
                                            <span>@(badgeClass == "badge-delivered" ? Model.FormatLocalTime(order.DeliveryTime) : "—")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="cancelled-banner">
                                    <i class="bi bi-x-circle-fill"></i> This order was @(displayStatus?.ToLower())
                                </div>
                            }

                            <div class="order-card-bottom">

                                <div class="detail-grid">

                                    <div class="detail-item">
                                        <span class="detail-label"><i class="bi bi-credit-card-fill"></i> Payment Method</span>
                                        <strong>@order.PaymentMethod</strong>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label"><i class="bi bi-check2-square"></i> Payment Status</span>
                                        <strong>@order.PaymentStatus</strong>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label"><i class="bi bi-box-arrow-up-right"></i> Pickup Time</span>
                                        <strong>@Model.FormatLocalTime(order.PickupTime)</strong>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label"><i class="bi bi-flag-fill"></i> Delivery Time</span>
                                        <strong>@Model.FormatLocalTime(order.DeliveryTime)</strong>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label"><i class="bi bi-hash"></i> Assignment Number</span>
                                        <strong>#@order.AssignmentID</strong>
                                    </div>

                                </div>

                                @if (cleanStatus == "Assigned" ||
                               cleanStatus == "OutForDelivery")
                                {
                                    <div class="order-actions">
                                        <a href="/DeliveryDashboard"
                                           class="action-link">
                                            <i class="bi bi-truck"></i> Manage Delivery
                                        </a>
                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

        </div>
    </div>

    <!-- =====================================================
         HIDE ORDER CONFIRMATION MODAL
         (same component/behavior as Customer Cart's Remove
         Item modal, reused here for "Hide this order?")
         ===================================================== -->
    <div id="hideOrderModal"
         class="app-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="hideOrderModalTitle"
         aria-hidden="true">

        <div class="modal-card">

            <div class="modal-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <h3 id="hideOrderModalTitle" class="modal-title">
                Hide Order?
            </h3>

            <p id="hideOrderModalDescription" class="modal-description">
                Hide this order from your list? This will not delete the order.
            </p>

            <div class="modal-actions">
                <button id="cancelHideOrderButton" type="button" class="modal-cancel">
                    Cancel
                </button>

                <button id="confirmHideOrderButton" type="button" class="modal-confirm">
                    Hide Order
                </button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            initializeToasts();
            initializeHideOrderModal();
        });

        // =====================================================
        // TOASTS (same behavior as Customer Cart)
        // =====================================================
        function initializeToasts() {
            const toasts = document.querySelectorAll("[data-toast]");

            toasts.forEach(function (toast, index) {
                window.setTimeout(function () {
                    toast.classList.add("show");
                }, 100 + (index * 100));

                const closeButton = toast.querySelector(".toast-close");

                if (closeButton) {
                    closeButton.addEventListener("click", function () {
                        removeToast(toast);
                    });
                }

                window.setTimeout(function () {
                    removeToast(toast);
                }, 5000 + (index * 300));
            });
        }

        function removeToast(toast) {
            if (!toast || !toast.isConnected) {
                return;
            }

            toast.classList.remove("show");

            window.setTimeout(function () {
                toast.remove();
            }, 300);
        }

        // =====================================================
        // SHARED MODAL FUNCTIONS (same behavior as Customer Cart)
        // =====================================================
        function openModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.add("open");
            modal.setAttribute("aria-hidden", "false");

            document.body.classList.add("modal-open");
        }

        function closeModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.remove("open");
            modal.setAttribute("aria-hidden", "true");

            if (!document.querySelector(".app-modal.open")) {
                document.body.classList.remove("modal-open");
            }
        }

        // =====================================================
        // HIDE ORDER MODAL (adapted from Customer Cart's
        // initializeRemoveModal, same trigger/confirm pattern)
        // =====================================================
        function initializeHideOrderModal() {
            const modal = document.getElementById("hideOrderModal");
            const description = document.getElementById("hideOrderModalDescription");
            const cancelButton = document.getElementById("cancelHideOrderButton");
            const confirmButton = document.getElementById("confirmHideOrderButton");
            const hideButtons = document.querySelectorAll(".hide-order-trigger");

            if (!modal || !description || !cancelButton || !confirmButton) {
                return;
            }

            let pendingHideForm = null;
            let lastHideButton = null;

            hideButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const formId = button.dataset.formId;
                    const orderNumber = button.dataset.orderNumber || "this order";

                    pendingHideForm = document.getElementById(formId);
                    lastHideButton = button;

                    description.textContent =
                        `Hide order "${orderNumber}" from your list? This will not delete the order.`;

                    openModal(modal);
                    cancelButton.focus();
                });
            });

            cancelButton.addEventListener("click", function () {
                pendingHideForm = null;
                closeModal(modal);

                if (lastHideButton) {
                    lastHideButton.focus();
                }
            });

            confirmButton.addEventListener("click", function () {
                if (!pendingHideForm) {
                    closeModal(modal);
                    return;
                }

                confirmButton.disabled = true;
                confirmButton.textContent = "Hiding...";

                pendingHideForm.requestSubmit();
            });

            modal.addEventListener("click", function (event) {
                if (event.target === modal) {
                    pendingHideForm = null;
                    closeModal(modal);
                }
            });
        }
    </script>

</body>
</html>
