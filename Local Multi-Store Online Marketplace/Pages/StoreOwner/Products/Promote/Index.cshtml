@page
@model Local_Multi_Store_Online_Marketplace.Pages.StoreOwner.Products.Promote.IndexModel

@{
    ViewData["Title"] = "Promote";
    Layout = "/Pages/StoreOwner/Shared/_StoreOwnerLayout.cshtml";
}

@section Styles {
    <style>
        :root {
            /* -------- Brand colors (Purple / Indigo) -------- */
            --accent-color: #6d28d9;
            --accent-hover: #5b21b6;
            --accent-light: #f3effe;
            --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
            /* -------- Neutral palette -------- */
            --bg-color: #f8f7fc;
            --card-bg: #ffffff;
            --text-primary: #1e1b2e;
            --text-secondary: #6b6478;
            --text-muted: #9691a4;
            --border-color: #ece8f6;
            /* -------- Semantic -------- */
            --success-color: #10b981;
            --error-color: #dc2626;
            --warning-color: #f59e0b;
            /* -------- Shadows -------- */
            --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.06);
            --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.10);
        }

        .explore-page {
            max-width: 1200px;
            margin: 0 auto;
        }

        .explore-page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 25px;
        }

            .explore-page-header h1 {
                margin: 0 0 7px;
                color: var(--text-primary);
                font-size: 26px;
                font-weight: 800;
                letter-spacing: -0.4px;
            }

            .explore-page-header p {
                margin: 0;
                color: var(--text-secondary);
                font-size: 14px;
            }

        .create-post-btn {
            min-height: 46px;
            padding: 0 20px;
            border-radius: 30px;
            background: var(--accent-gradient);
            color: white;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            box-shadow: 0 10px 24px rgba(109, 40, 217, 0.25);
            white-space: nowrap;
            transition: all 0.25s ease;
        }

            .create-post-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 30px rgba(109, 40, 217, 0.32);
                color: white;
            }

        .filter-card {
            margin-bottom: 25px;
            padding: 18px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 18px;
            box-shadow: var(--shadow-sm);
        }

        .filter-form {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 14px;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .filter-select {
            width: 100%;
            min-height: 44px;
            padding: 9px 14px;
            border: 1.5px solid var(--border-color);
            border-radius: 12px;
            background: var(--bg-color);
            color: var(--text-primary);
            font: inherit;
            transition: all 0.2s ease;
        }

            .filter-select:focus {
                outline: none;
                border-color: var(--accent-color);
                background: var(--card-bg);
                box-shadow: 0 0 0 4px rgba(109, 40, 217, 0.10);
            }

        .filter-btn {
            min-height: 44px;
            padding: 0 22px;
            border: none;
            border-radius: 12px;
            background: var(--accent-gradient);
            color: white;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
            transition: all 0.2s ease;
        }

            .filter-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(109, 40, 217, 0.28);
            }

        .message {
            margin-bottom: 20px;
            padding: 14px 17px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 14px;
        }

        .message-success {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .message-error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .explore-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 22px;
        }

        .explore-card {
            overflow: hidden;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: var(--shadow-sm);
            transition: 0.25s ease;
        }

            .explore-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--shadow-md);
                border-color: var(--accent-color);
            }

        .media-box {
            position: relative;
            height: 290px;
            overflow: hidden;
            background: var(--bg-color);
        }

            .media-box img,
            .media-box video {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .type-badge,
        .status-badge,
        .media-count,
        .featured-badge {
            position: absolute;
            z-index: 2;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            backdrop-filter: blur(8px);
        }

        .type-badge {
            top: 12px;
            left: 12px;
            padding: 7px 10px;
            background: rgba(30, 27, 46, 0.82);
            color: white;
        }

        .status-badge {
            top: 12px;
            right: 12px;
            padding: 7px 10px;
        }

        .status-active {
            color: #065f46;
            background: rgba(236, 253, 245, 0.95);
        }

        .status-inactive {
            color: #991b1b;
            background: rgba(254, 242, 242, 0.95);
        }

        .media-count {
            right: 12px;
            bottom: 12px;
            padding: 6px 9px;
            background: rgba(30, 27, 46, 0.78);
            color: white;
        }

        .featured-badge {
            left: 12px;
            bottom: 12px;
            padding: 6px 10px;
            background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
            color: white;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .card-content {
            padding: 17px;
        }

        .post-caption {
            min-height: 46px;
            margin: 0 0 14px;
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.55;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .empty-caption {
            color: var(--text-muted);
            font-style: italic;
        }

        .linked-product {
            margin-bottom: 14px;
            padding: 11px 12px;
            border-radius: 12px;
            background: var(--accent-light);
            color: var(--accent-hover);
            font-size: 12px;
            font-weight: 700;
        }

        .post-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            margin-bottom: 14px;
            padding: 12px 0;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
        }

        .stat-item {
            text-align: center;
            color: var(--text-secondary);
            font-size: 12px;
        }

            .stat-item strong {
                display: block;
                margin-bottom: 2px;
                color: var(--text-primary);
                font-size: 15px;
            }

        .post-date {
            margin-bottom: 15px;
            color: var(--text-muted);
            font-size: 11px;
        }

        .card-actions {
            display: grid;
            grid-template-columns: 1fr 1fr 44px;
            gap: 9px;
        }

        .action-btn {
            min-height: 42px;
            border: none;
            border-radius: 12px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

        .edit-btn {
            background: var(--accent-light);
            color: var(--accent-color);
        }

            .edit-btn:hover {
                background: var(--accent-color);
                color: white;
            }

        .status-btn {
            background: var(--bg-color);
            color: var(--text-secondary);
            border: 1.5px solid var(--border-color) !important;
        }

            .status-btn:hover {
                border-color: var(--accent-color) !important;
                color: var(--accent-color);
                background: var(--accent-light);
            }

        .delete-btn {
            width: 44px;
            background: #fef2f2;
            color: #b91c1c;
        }

            .delete-btn:hover {
                background: var(--error-color);
                color: white;
            }

        .delete-form {
            margin: 0;
        }

        /* =====================================================
                                   ACTIVITY PANEL (who liked / what they commented)
                                   ===================================================== */
        .hidden {
            display: none !important;
        }

        .activity-toggle {
            width: 100%;
            margin-top: 10px;
            padding: 10px 0;
            border: none;
            border-top: 1px solid var(--border-color);
            background: transparent;
            color: var(--text-secondary);
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .activity-toggle:hover {
                color: var(--accent-color);
            }

            .activity-toggle .toggle-caret {
                font-size: 10px;
                transition: transform 0.2s ease;
            }

            .activity-toggle[aria-expanded="true"] .toggle-caret {
                transform: rotate(180deg);
            }

        .activity-panel {
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px dashed var(--border-color);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .activity-section h4 {
            margin: 0 0 8px;
            color: var(--text-primary);
            font-size: 12px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .activity-section h4 i {
                color: var(--accent-color);
                font-size: 11px;
            }

        .activity-empty {
            margin: 0;
            color: var(--text-muted);
            font-size: 12px;
            font-style: italic;
        }

        .like-list,
        .comment-list {
            list-style: none;
            margin: 0;
            padding: 0;
            max-height: 180px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .like-list li {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                gap: 8px;
                font-size: 12.5px;
                color: var(--text-primary);
            }

                .like-list li small {
                    color: var(--text-muted);
                    font-size: 10.5px;
                    white-space: nowrap;
                }

            .comment-list li {
                padding: 8px 10px;
                border-radius: 10px;
                background: var(--bg-color);
            }

        .comment-list-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 8px;
            margin-bottom: 3px;
        }

            .comment-list-header strong {
                font-size: 12.5px;
                color: var(--text-primary);
            }

            .comment-list-header small {
                color: var(--text-muted);
                font-size: 10.5px;
                white-space: nowrap;
            }

        .comment-list li p {
            margin: 0;
            color: var(--text-secondary);
            font-size: 12.5px;
            line-height: 1.5;
        }

        @@media (max-width: 500px) {
            .activity-panel {
                grid-template-columns: 1fr;
            }
        }

        .empty-state {
            padding: 65px 25px;
            border: 1px dashed var(--border-color);
            border-radius: 22px;
            background: var(--card-bg);
            text-align: center;
        }

            .empty-state i {
                margin-bottom: 16px;
                color: var(--accent-color);
                opacity: 0.6;
                font-size: 52px;
            }

            .empty-state h2 {
                margin: 0 0 9px;
                color: var(--text-primary);
                font-weight: 800;
            }

            .empty-state p {
                margin: 0 0 20px;
                color: var(--text-secondary);
            }

        @@media (max-width: 1050px) {
            .explore-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 700px) {
            .explore-page-header {
                flex-direction: column;
            }

            .filter-form {
                grid-template-columns: 1fr;
            }

            .explore-grid {
                grid-template-columns: 1fr;
            }

            .create-post-btn {
                width: 100%;
                justify-content: center;
            }
        }

        /* =====================================================
                                   DELETE CONFIRM TOAST
                                   ===================================================== */
        .toast-stack {
            position: fixed;
            right: 20px;
            top: 20px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }

        .confirm-toast {
            pointer-events: auto;
            width: 320px;
            max-width: calc(100vw - 40px);
            padding: 16px 18px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            display: flex;
            flex-direction: column;
            gap: 12px;
            animation: toast-in 0.2s ease;
        }

        @@keyframes toast-in {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .confirm-toast-body {
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

            .confirm-toast-body i {
                margin-top: 2px;
                color: var(--error-color);
                font-size: 16px;
            }

            .confirm-toast-body p {
                margin: 0;
                color: var(--text-primary);
                font-size: 13.5px;
                font-weight: 600;
                line-height: 1.45;
            }

        .confirm-toast-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .confirm-toast-btn {
            min-height: 36px;
            padding: 0 16px;
            border: none;
            border-radius: 10px;
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .confirm-toast-cancel {
            background: var(--bg-color);
            color: var(--text-secondary);
            border: 1.5px solid var(--border-color);
        }

            .confirm-toast-cancel:hover {
                background: var(--border-color);
            }

        .confirm-toast-confirm {
            background: var(--error-color);
            color: white;
        }

            .confirm-toast-confirm:hover {
                background: #b91c1c;
            }

        /* =====================================================
                                   RESULT TOAST (success / error messages)
                                   ===================================================== */
        .result-toast {
            pointer-events: auto;
            width: 320px;
            max-width: calc(100vw - 40px);
            padding: 14px 17px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 13.5px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            box-shadow: var(--shadow-md);
            animation: toast-in 0.2s ease;
        }

            .result-toast i {
                margin-top: 1px;
                font-size: 15px;
            }

        .result-toast-success {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .result-toast-error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }
    </style>
}

<div class="explore-page">

    <partial name="_ProductsNav" model="@("Promote")" />

    <div class="explore-page-header">
        <div>
            <h1>Promote</h1>

            <p>
                Manage the images, carousels and reels published
                by @Model.StoreName.
            </p>
        </div>

        <a asp-page="/StoreOwner/Products/Promote/Create"
           class="create-post-btn">
            <i class="fas fa-plus"></i>
            Create New Post
        </a>
    </div>

    <div class="filter-card">
        <form method="get" class="filter-form">

            <label for="typeFilterSelect" class="sr-only">Filter by post type</label>
            <select asp-for="TypeFilter"
                    id="typeFilterSelect"
                    class="filter-select">
                <option value="">All post types</option>
                <option value="Image">Images</option>
                <option value="Carousel">Carousels</option>
                <option value="Reel">Reels</option>
            </select>

            <label for="statusFilterSelect" class="sr-only">Filter by status</label>
            <select asp-for="StatusFilter"
                    id="statusFilterSelect"
                    class="filter-select">
                <option value="">All statuses</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>

            <button type="submit" class="filter-btn">
                <i class="fas fa-filter"></i>
                Filter
            </button>
        </form>
    </div>

    @if (Model.Posts.Any())
    {
        <div class="explore-grid">

            @foreach (var post in Model.Posts)
            {
                <article class="explore-card">

                    <div class="media-box">

                        @if (post.MediaType == "Video")
                        {
                            <video muted
                                   playsinline
                                   preload="metadata"
                                   poster="@post.ThumbnailUrl">
                                <source src="@post.MediaUrl" />
                            </video>
                        }
                        else
                        {
                            <img src="@post.MediaUrl"
                                 alt="Explore post"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/no-image.png';" />
                        }

                        <span class="type-badge">
                            @if (post.PostType == "Reel")
                            {
                                <i class="fas fa-video"></i>
                            }
                            else if (post.PostType == "Carousel")
                            {
                                <i class="fas fa-images"></i>
                            }
                            else
                            {
                                <i class="fas fa-image"></i>
                            }

                            @post.PostType
                        </span>

                        <span class="status-badge @(post.IsActive ? "status-active" : "status-inactive")">
                            @(post.IsActive ? "Active" : "Inactive")
                        </span>

                        @if (post.MediaCount > 1)
                        {
                            <span class="media-count">
                                <i class="fas fa-layer-group"></i>
                                @post.MediaCount
                            </span>
                        }

                        @if (post.IsFeatured)
                        {
                            <span class="featured-badge">
                                <i class="fas fa-star"></i>
                                Featured
                            </span>
                        }
                    </div>

                    <div class="card-content">

                        @if (string.IsNullOrWhiteSpace(post.Caption))
                        {
                            <p class="post-caption empty-caption">
                                No caption added.
                            </p>
                        }
                        else
                        {
                            <p class="post-caption">
                                @post.Caption
                            </p>
                        }

                        @if (post.ProductID.HasValue)
                        {
                            <div class="linked-product">
                                <i class="fas fa-bag-shopping"></i>

                                @post.ProductName

                                @if (post.ProductPrice.HasValue)
                                {
                                    <span>
                                        — $@post.ProductPrice.Value.ToString("N2")
                                    </span>
                                }
                            </div>
                        }

                        <div class="post-stats">

                            <div class="stat-item">
                                <strong>@post.ViewCount</strong>
                                Views
                            </div>

                            <div class="stat-item">
                                <strong>@post.LikeCount</strong>
                                Likes
                            </div>

                            <div class="stat-item">
                                <strong>@post.CommentCount</strong>
                                Comments
                            </div>

                        </div>

                        <div class="post-date">
                            Published @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </div>

                        <div class="card-actions">

                            <a asp-page="/StoreOwner/Products/Promote/Edit"
                               asp-route-id="@post.ExplorePostID"
                               class="action-btn edit-btn">
                                <i class="fas fa-pen"></i>
                                Edit
                            </a>

                            <form method="post"
                                  asp-page-handler="ToggleStatus"
                                  asp-route-postId="@post.ExplorePostID"
                                  asp-route-typeFilter="@Model.TypeFilter"
                                  asp-route-statusFilter="@Model.StatusFilter">

                                <button type="submit"
                                        class="action-btn status-btn">
                                    <i class="fas @(post.IsActive ? "fa-eye-slash" : "fa-eye")"></i>

                                    @(post.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>

                            <form method="post"
                                  asp-page-handler="Delete"
                                  asp-route-postId="@post.ExplorePostID"
                                  asp-route-typeFilter="@Model.TypeFilter"
                                  asp-route-statusFilter="@Model.StatusFilter"
                                  class="delete-form">

                                <button type="submit"
                                        class="action-btn delete-btn"
                                        title="Delete post">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>

                        </div>

                        <button type="button"
                                class="activity-toggle"
                                data-activity-toggle="activity-@post.ExplorePostID">
                            <i class="fas fa-comments"></i>
                            View comments &amp; likes
                            <i class="fas fa-chevron-down toggle-caret"></i>
                        </button>

                        <div id="activity-@post.ExplorePostID" class="activity-panel hidden">

                            <div class="activity-section">
                                <h4>
                                    <i class="fas fa-heart"></i>
                                    Liked by (@post.LikeCount)
                                </h4>

                                @if (post.Likes.Any())
                                {
                                    <ul class="like-list">
                                        @foreach (var like in post.Likes)
                                        {
                                            <li>
                                                <span>@like.CustomerName</span>
                                                <small>@like.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</small>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="activity-empty">No likes yet.</p>
                                }
                            </div>

                            <div class="activity-section">
                                <h4>
                                    <i class="fas fa-comment"></i>
                                    Comments (@post.CommentCount)
                                </h4>

                                @if (post.Comments.Any())
                                {
                                    <ul class="comment-list">
                                        @foreach (var comment in post.Comments)
                                        {
                                            <li>
                                                <div class="comment-list-header">
                                                    <strong>@comment.CustomerName</strong>
                                                    <small>@comment.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</small>
                                                </div>
                                                <p>@comment.CommentText</p>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="activity-empty">No comments yet.</p>
                                }
                            </div>
                        </div>
                    </div>

                </article>
            }

        </div>
    }
    else if (Model.HasAnyPosts)
    {
        <div class="empty-state">
            <i class="fas fa-filter-circle-xmark"></i>

            <h2>No posts match these filters</h2>

            <p>
                Try a different type or status, or clear your filters
                to see everything you've posted.
            </p>

            <a asp-page="/StoreOwner/Products/Promote/Index"
               class="action-btn status-btn"
               style="display:inline-flex; min-height:46px; padding:0 22px; font-size:14px;">
                <i class="fas fa-rotate-left"></i>
                Clear filters
            </a>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-photo-film"></i>

            <h2>No Explore posts yet</h2>

            <p>
                Create an image post, carousel, or reel for customers.
            </p>

            <a asp-page="/StoreOwner/Products/Promote/Create"
               class="create-post-btn">
                <i class="fas fa-plus"></i>
                Create First Post
            </a>
        </div>
    }

</div>

@section Scripts {
    <script>
        // Shared toast stack, used both for the delete confirmation and
        // for showing the TempData success/error message as a toast
        // instead of a static banner.
        var toastStack = document.createElement('div');
        toastStack.className = 'toast-stack';
        document.body.appendChild(toastStack);

        function showResultToast(message, isSuccess) {
            var toast = document.createElement('div');
            toast.className = 'result-toast ' +
                (isSuccess ? 'result-toast-success' : 'result-toast-error');
            toast.innerHTML =
                '<i class="fas ' + (isSuccess ? 'fa-circle-check' : 'fa-circle-exclamation') + '"></i>' +
                '<span></span>';
            toast.querySelector('span').textContent = message;

            toastStack.appendChild(toast);

            setTimeout(function() {
                toast.remove();
            }, 5000);
        }

        // Toggle each post's "View comments & likes" panel open/closed.
        (function() {
            document.querySelectorAll('[data-activity-toggle]').forEach(function(button) {
                button.setAttribute('aria-expanded', 'false');

                button.addEventListener('click', function() {
                    var panel = document.getElementById(
                        button.getAttribute('data-activity-toggle')
                    );

                    if (!panel) {
                        return;
                    }

                    var isHidden = panel.classList.toggle('hidden');
                    button.setAttribute('aria-expanded', (!isHidden).toString());
                });
            });
        })();

        // Confirm before permanently deleting a post — via a toast
        // instead of the native confirm() dialog.
        (function() {
            function showDeleteConfirmToast(onConfirm) {
                var toast = document.createElement('div');
                toast.className = 'confirm-toast';
                toast.innerHTML =
                    '<div class="confirm-toast-body">' +
                    '<i class="fas fa-triangle-exclamation"></i>' +
                    '<p>Delete this Explore post permanently? This can\'t be undone.</p>' +
                    '</div>' +
                    '<div class="confirm-toast-actions">' +
                    '<button type="button" class="confirm-toast-btn confirm-toast-cancel">Cancel</button>' +
                    '<button type="button" class="confirm-toast-btn confirm-toast-confirm">Delete</button>' +
                    '</div>';

                toastStack.appendChild(toast);

                var timeoutId = setTimeout(function() {
                    toast.remove();
                }, 8000);

                toast.querySelector('.confirm-toast-cancel')
                    .addEventListener('click', function() {
                        clearTimeout(timeoutId);
                        toast.remove();
                    });

                toast.querySelector('.confirm-toast-confirm')
                    .addEventListener('click', function() {
                        clearTimeout(timeoutId);
                        toast.remove();
                        onConfirm();
                    });
            }

            document.querySelectorAll('.delete-form').forEach(function(form) {
                form.addEventListener('submit', function(e) {
                    if (form.dataset.confirmed === 'true') {
                        return;
                    }

                    e.preventDefault();

                    showDeleteConfirmToast(function() {
                        form.dataset.confirmed = 'true';
                        form.requestSubmit
                            ? form.requestSubmit()
                            : form.submit();
                    });
                });
            });
        })();

        // Show TempData success/error message (if any) as a toast on load.
        (function() {
            var successMessage = @Html.Raw(Json.Serialize(TempData["SuccessMessage"] as string));
            var errorMessage = @Html.Raw(Json.Serialize(TempData["ErrorMessage"] as string));

            if (successMessage) {
                showResultToast(successMessage, true);
            }

            if (errorMessage) {
                showResultToast(errorMessage, false);
            }
        })();
    </script>
}
