@page
@model Local_Multi_Store_Online_Marketplace.Pages.StoreOwner.Products.CreateModel
@{
    ViewData["Title"] = "Add New Product";
    Layout = "/Pages/StoreOwner/Shared/_StoreOwnerLayout.cshtml";
    var selectedCategoryPath = Model.ProductVM.CategoryID > 0
        ? Local_Multi_Store_Online_Marketplace.Pages.StoreOwner.Products.CreateModel.FindCategoryPath(Model.CategoryTree, Model.ProductVM.CategoryID)
        : null;
}

@section Styles {
    <style>
        /* ============================================================
                   ROOT VARIABLES — consistent brand palette
                   ============================================================ */
        :root {
            --accent-color: #6d28d9;
            --accent-hover: #5b21b6;
            --accent-light: #f3effe;
            --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
            --bg-color: #f8f7fc;
            --card-bg: #ffffff;
            --text-primary: #1e1b2e;
            --text-secondary: #6b6478;
            --text-muted: #9691a4;
            --border-color: #ece8f6;
            --input-bg: #f8f7fc;
            --success-color: #10b981;
            --error-color: #dc2626;
            --warning-color: #f59e0b;
            --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.06);
            --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.10);
            --shadow-lg: 0 20px 50px rgba(30, 27, 46, 0.18);
            --radius-md: 12px;
            --radius-lg: 20px;
            --transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-color);
            color: var(--text-primary);
            -webkit-font-smoothing: antialiased;
        }

        /* ============================================================
                   PAGE WRAPPER
                   ============================================================ */
        .page-wrapper {
            max-width: 820px;
            margin: 0 auto;
            padding: 32px 20px 60px;
        }

        /* ============================================================
                   HEADER
                   ============================================================ */
        .page-header {
            margin-bottom: 28px;
        }

            .page-header h2 {
                margin: 0;
                font-size: 26px;
                font-weight: 800;
                letter-spacing: -0.4px;
                color: var(--text-primary);
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .page-header h2 i {
                    color: var(--accent-color);
                }

            .page-header p {
                margin: 6px 0 0;
                color: var(--text-secondary);
                font-size: 15px;
            }

        /* ============================================================
                   FORM CARD — matches dashboard/orders card style
                   ============================================================ */
        .form-card {
            position: relative;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 36px 36px 32px;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
            overflow: hidden;
        }

            .form-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: var(--accent-gradient);
            }

            .form-card:hover {
                box-shadow: var(--shadow-md);
            }

        /* ============================================================
                   VALIDATION SUMMARY
                   ============================================================ */
        .validation-summary-errors {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: var(--radius-md);
            padding: 14px 18px;
            margin-bottom: 22px;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 18px;
            }

            .validation-summary-errors li {
                color: var(--error-color);
                font-size: 13px;
                font-weight: 600;
                line-height: 1.6;
            }

            .validation-summary-errors:empty {
                display: none;
            }

        /* ============================================================
                   FORM ELEMENTS
                   ============================================================ */
        .form-section-title {
            font-size: 12px;
            font-weight: 800;
            color: var(--accent-color);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin: 28px 0 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .form-section-title .section-index {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: var(--accent-light);
                color: var(--accent-color);
                font-size: 10px;
                font-weight: 800;
            }

            .form-section-title:first-of-type {
                margin-top: 4px;
            }

        .form-group {
            margin-bottom: 22px;
        }

            .form-group:last-child {
                margin-bottom: 0;
            }

            .form-group label {
                display: block;
                margin-bottom: 6px;
                font-weight: 700;
                font-size: 13px;
                color: var(--text-primary);
                letter-spacing: 0.2px;
            }

                .form-group label .required {
                    color: var(--error-color);
                    margin-left: 2px;
                }

            .form-group input:not([type="checkbox"]),
            .form-group textarea,
            .form-group select {
                width: 100%;
                padding: 11px 15px;
                border: 1.5px solid var(--border-color);
                border-radius: var(--radius-md);
                font-size: 14px;
                font-family: inherit;
                background: var(--input-bg);
                color: var(--text-primary);
                transition: var(--transition);
            }

                .form-group input:not([type="checkbox"])::placeholder,
                .form-group textarea::placeholder {
                    color: var(--text-muted);
                    opacity: 0.7;
                }

                .form-group input:not([type="checkbox"]):focus,
                .form-group textarea:focus,
                .form-group select:focus {
                    outline: none;
                    border-color: var(--accent-color);
                    background: var(--card-bg);
                    box-shadow: 0 0 0 4px rgba(109, 40, 217, 0.10);
                }

            .form-group input[type="checkbox"] {
                width: 18px;
                height: 18px;
                accent-color: var(--accent-color);
                cursor: pointer;
                margin-right: 8px;
                vertical-align: middle;
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .text-danger {
            color: var(--error-color);
            font-size: 13px;
            font-weight: 600;
            margin-top: 4px;
            display: block;
        }

        .help-text {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 4px;
            display: block;
        }

        /* ============================================================
                   PRICE INPUTS — $ prefix
                   ============================================================ */
        .price-input-wrapper {
            position: relative;
        }

            .price-input-wrapper::before {
                content: "$";
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-weight: 700;
                font-size: 14px;
                pointer-events: none;
            }

            .price-input-wrapper input {
                padding-left: 28px !important;
            }

        /* ============================================================
                   CATEGORY PICKER
                   ============================================================ */
        .category-picker {
            position: relative;
        }

        .category-picker-trigger {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 11px 15px;
            border: 1.5px solid var(--border-color);
            border-radius: var(--radius-md);
            background: var(--input-bg);
            font-size: 14px;
            font-family: inherit;
            color: var(--text-primary);
            cursor: pointer;
            transition: var(--transition);
            text-align: left;
        }

            .category-picker-trigger .picker-placeholder {
                color: var(--text-muted);
            }

            .category-picker-trigger #categoryPickerLabel {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .category-picker-trigger .trigger-icons {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-shrink: 0;
            }

            .category-picker-trigger .clear-selection {
                display: none;
                align-items: center;
                justify-content: center;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                color: var(--text-muted);
                background: var(--border-color);
                font-size: 11px;
                transition: background 0.15s, color 0.15s;
            }

                .category-picker-trigger .clear-selection:hover {
                    background: var(--error-color);
                    color: #fff;
                }

            .category-picker-trigger.has-value .clear-selection {
                display: inline-flex;
            }

            .category-picker-trigger:hover,
            .category-picker-trigger.open {
                border-color: var(--accent-color);
                background: var(--card-bg);
            }

            .category-picker-trigger.open {
                box-shadow: 0 0 0 4px rgba(109, 40, 217, 0.10);
            }

            .category-picker-trigger i.chevron {
                color: var(--text-muted);
                font-size: 12px;
                transition: transform 0.2s ease;
                flex-shrink: 0;
            }

            .category-picker-trigger.open i.chevron {
                transform: rotate(180deg);
                color: var(--accent-color);
            }

        .category-picker-panel {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
            z-index: 30;
            display: none;
            overflow: hidden;
        }

            .category-picker-panel.open {
                display: block;
            }

        .category-picker-search {
            width: 100%;
            border: none;
            border-bottom: 1px solid var(--border-color);
            padding: 12px 15px;
            font-size: 13px;
            font-family: inherit;
            background: var(--bg-color);
        }

            .category-picker-search:focus {
                outline: none;
                background: var(--accent-light);
            }

        .category-picker-tree {
            max-height: 260px;
            overflow-y: auto;
            padding: 6px;
            background: linear-gradient(var(--card-bg) 30%, rgba(255,255,255,0)), linear-gradient(rgba(255,255,255,0), var(--card-bg) 70%) bottom, radial-gradient(farthest-side at 50% 0, rgba(30,27,46,0.08), rgba(0,0,0,0)), radial-gradient(farthest-side at 50% 100%, rgba(30,27,46,0.08), rgba(0,0,0,0)) bottom;
            background-repeat: no-repeat;
            background-size: 100% 24px, 100% 24px, 100% 8px, 100% 8px;
            background-attachment: local, local, scroll, scroll;
        }

        .category-option {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 10px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13.5px;
            color: var(--text-primary);
            transition: background 0.12s ease;
        }

            .category-option:hover {
                background: var(--accent-light);
            }

            .category-option.selected {
                background: var(--accent-light);
                color: var(--accent-color);
                font-weight: 700;
            }

                .category-option.selected .option-branch-icon {
                    color: var(--accent-color);
                }

            .category-option.hidden-by-search {
                display: none;
            }

        .option-connector-icon {
            font-size: 10px;
            color: var(--border-color);
            width: 12px;
            flex-shrink: 0;
            text-align: center;
        }

        .option-branch-icon {
            font-size: 12px;
            color: var(--text-muted);
            width: 14px;
            flex-shrink: 0;
            text-align: center;
        }

        .option-root-icon {
            color: var(--accent-color);
        }

        .option-name {
            flex: 1;
        }

        .option-count {
            font-size: 10px;
            font-weight: 700;
            color: var(--accent-color);
            background: rgba(109, 40, 217, 0.10);
            padding: 1px 7px;
            border-radius: 20px;
        }

        .category-picker-empty {
            padding: 20px 15px;
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
        }

        /* ============================================================
                   IMAGE UPLOAD
                   ============================================================ */
        .image-upload-area {
            border: 2px dashed var(--border-color);
            border-radius: var(--radius-md);
            padding: 32px 20px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            background: var(--bg-color);
            margin-top: 6px;
        }

            .image-upload-area:hover,
            .image-upload-area.drag-active {
                border-color: var(--accent-color);
                background: var(--accent-light);
            }

            .image-upload-area i {
                font-size: 40px;
                color: var(--accent-color);
                opacity: 0.5;
                margin-bottom: 10px;
                display: block;
            }

            .image-upload-area p {
                color: var(--text-secondary);
                font-size: 14px;
                font-weight: 500;
                margin: 0;
            }

            .image-upload-area .sub-text {
                font-size: 12px;
                color: var(--text-muted);
                margin-top: 4px;
            }

        .image-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 18px;
        }

        .preview-item {
            position: relative;
            width: 110px;
            height: 110px;
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-color);
            transition: var(--transition);
        }

            .preview-item:hover {
                box-shadow: var(--shadow-md);
                border-color: var(--accent-color);
            }

            .preview-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .preview-item .primary-badge {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                background: var(--accent-gradient);
                color: #fff;
                font-size: 10px;
                font-weight: 700;
                text-align: center;
                padding: 3px 0;
                letter-spacing: 0.3px;
            }

            .preview-item .remove-preview {
                position: absolute;
                top: 6px;
                right: 6px;
                background: var(--error-color);
                color: #fff;
                border: none;
                border-radius: 50%;
                width: 24px;
                height: 24px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                font-weight: 700;
                box-shadow: 0 2px 8px rgba(0,0,0,0.25);
                transition: transform 0.15s ease;
                line-height: 1;
            }

                .preview-item .remove-preview:hover {
                    transform: scale(1.1);
                }

        /* ============================================================
                   BUTTONS
                   ============================================================ */
        .form-actions {
            display: flex;
            gap: 14px;
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid var(--border-color);
            flex-wrap: wrap;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 28px;
            background: var(--accent-gradient);
            color: #fff;
            border: none;
            border-radius: 40px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(109, 40, 217, 0.25);
            transition: var(--transition);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 30px rgba(109, 40, 217, 0.35);
                color: #fff;
            }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 28px;
            background: var(--card-bg);
            color: var(--text-secondary);
            border: 1.5px solid var(--border-color);
            border-radius: 40px;
            font-weight: 700;
            font-size: 14px;
            text-decoration: none;
            transition: var(--transition);
        }

            .btn-secondary:hover {
                border-color: var(--accent-color);
                color: var(--accent-color);
                background: var(--accent-light);
            }

        /* ============================================================
                   RESPONSIVE
                   ============================================================ */
        @@media (max-width: 768px) {
            .page-wrapper {
                padding: 20px 16px 40px;
            }

            .form-card {
                padding: 24px 20px;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .form-actions {
                flex-direction: column;
            }

            .btn-primary,
            .btn-secondary {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 480px) {
            .image-upload-area {
                padding: 24px 16px;
            }

            .preview-item {
                width: 90px;
                height: 90px;
            }
        }
    </style>
}

<div class="page-wrapper">

    <!-- ========== HEADER ========== -->
    <div class="page-header">
        <h2><i class="fas fa-plus-circle"></i> Add New Product</h2>
        <p>Fill in the details below to add a new product to your store.</p>
    </div>

    <!-- ========== FORM CARD ========== -->
    <div class="form-card">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger" style="margin-bottom:20px;"></div>

            <!-- ===== PRODUCT DETAILS ===== -->
            <div class="form-section-title"><span class="section-index">1</span> Product Details</div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ProductVM.ProductName">Product Name <span class="required">*</span></label>
                    <input asp-for="ProductVM.ProductName" placeholder="e.g., iPhone 15 Pro" />
                    <span asp-validation-for="ProductVM.ProductName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Category <span class="required">*</span></label>

                    <div class="category-picker" id="categoryPicker">
                        <button type="button" class="category-picker-trigger@(!string.IsNullOrEmpty(selectedCategoryPath) ? " has-value" : "")" id="categoryPickerTrigger">
                            <span id="categoryPickerLabel">
                                @if (!string.IsNullOrEmpty(selectedCategoryPath))
                                {
                                    @selectedCategoryPath
                                }
                                else
                                {
                                    <span class="picker-placeholder">-- Select Category --</span>
                                }
                            </span>
                            <span class="trigger-icons">
                                <span class="clear-selection" id="categoryPickerClear" title="Clear selection">
                                    <i class="fas fa-times"></i>
                                </span>
                                <i class="fas fa-chevron-down chevron"></i>
                            </span>
                        </button>

                        <div class="category-picker-panel" id="categoryPickerPanel">
                            <input type="text" class="category-picker-search" id="categoryPickerSearch" placeholder="🔍 Search categories...">
                            <div class="category-picker-tree" id="categoryPickerTree">
                                @if (Model.CategoryTree.Any())
                                {
                                    @foreach (var root in Model.CategoryTree)
                                    {
                                        <partial name="_CategoryOption" model="root" />
                                    }
                                }
                                else
                                {
                                    <div class="category-picker-empty">No categories yet — ask the administrator to create some.</div>
                                }
                            </div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="ProductVM.CategoryID" id="categoryIdInput" />
                    <span asp-validation-for="ProductVM.CategoryID" class="text-danger"></span>
                    <span class="help-text">Categories are managed by the administrator.</span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ProductVM.Description">Description <span class="required">*</span></label>
                <textarea asp-for="ProductVM.Description" rows="5" placeholder="Describe your product in detail..."></textarea>
                <span asp-validation-for="ProductVM.Description" class="text-danger"></span>
            </div>

            <!-- ===== PRICING ===== -->
            <div class="form-section-title"><span class="section-index">2</span> Pricing</div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ProductVM.Price">Selling Price <span class="required">*</span></label>
                    <div class="price-input-wrapper">
                        <input asp-for="ProductVM.Price" type="number" step="0.01" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="ProductVM.Price" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ProductVM.CompareAtPrice">Compare at Price</label>
                    <div class="price-input-wrapper">
                        <input asp-for="ProductVM.CompareAtPrice" type="number" step="0.01" placeholder="0.00" />
                    </div>
                    <span class="help-text">Original price for discount display (e.g., $99.99)</span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ProductVM.OriginalPrice">Your Cost Price <span class="required">*</span></label>
                    <div class="price-input-wrapper">
                        <input asp-for="ProductVM.OriginalPrice" type="number" step="0.01" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="ProductVM.OriginalPrice" class="text-danger"></span>
                    <span class="help-text">What you paid per unit – used for profit calculation</span>
                </div>
                <div class="form-group">
                    <label asp-for="ProductVM.Quantity">Stock Quantity <span class="required">*</span></label>
                    <input asp-for="ProductVM.Quantity" type="number" min="0" />
                    <span asp-validation-for="ProductVM.Quantity" class="text-danger"></span>
                </div>
            </div>

            <!-- ===== INVENTORY & SHIPPING ===== -->
            <div class="form-section-title"><span class="section-index">3</span> Inventory &amp; Shipping</div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ProductVM.LowStockThreshold">Low Stock Threshold</label>
                    <input asp-for="ProductVM.LowStockThreshold" type="number" min="0" placeholder="e.g., 10" />
                    <span class="help-text">You'll be notified when stock reaches this level</span>
                </div>
                <div class="form-group">
                    <label asp-for="ProductVM.Weight">Weight (kg)</label>
                    <input asp-for="ProductVM.Weight" type="number" step="0.01" placeholder="0.00" />
                </div>
            </div>

            <div class="form-group">
                <label>
                    <input asp-for="ProductVM.IsActive" type="checkbox" /> Active
                </label>
                <span class="help-text">Inactive products won't be visible to customers.</span>
            </div>

            <!-- ===== IMAGES ===== -->
            <div class="form-section-title"><span class="section-index">4</span> Images</div>

            <div class="form-group">
                <label>Product Images</label>
                <div class="image-upload-area" id="imageUploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Click or drag images here to upload</p>
                    <span class="sub-text">Supports JPG, PNG, WEBP (max 5 images)</span>
                    <input asp-for="ProductVM.UploadedImages" type="file" id="imageInput" multiple accept="image/*" style="display: none;" />
                </div>
                <div class="image-preview" id="imagePreview"></div>
                <span class="help-text">First image will be used as the primary image.</span>
            </div>

            <!-- ===== ACTIONS ===== -->
            <div class="form-actions">
                <button type="submit" class="btn-primary">
                    <i class="fas fa-save"></i> Create Product
                </button>
                <a href="/StoreOwner/Products/Index" class="btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            /* ── Category picker ──────────────────────────────────────── */
            const picker = document.getElementById('categoryPicker');
            const trigger = document.getElementById('categoryPickerTrigger');
            const panel = document.getElementById('categoryPickerPanel');
            const label = document.getElementById('categoryPickerLabel');
            const search = document.getElementById('categoryPickerSearch');
            const hiddenInput = document.getElementById('categoryIdInput');
            const clearBtn = document.getElementById('categoryPickerClear');
            const options = Array.from(document.querySelectorAll('.category-option'));

            function openPanel() {
                panel.classList.add('open');
                trigger.classList.add('open');
                search.value = '';
                options.forEach(o => o.classList.remove('hidden-by-search'));
                search.focus();
            }

            function closePanel() {
                panel.classList.remove('open');
                trigger.classList.remove('open');
            }

            trigger.addEventListener('click', function(e) {
                e.stopPropagation();
                if (panel.classList.contains('open')) {
                    closePanel();
                } else {
                    openPanel();
                }
            });

            options.forEach(opt => {
                opt.addEventListener('click', function() {
                    hiddenInput.value = this.dataset.id;
                    label.textContent = this.dataset.path;
                    trigger.classList.add('has-value');
                    options.forEach(o => o.classList.remove('selected'));
                    this.classList.add('selected');
                    closePanel();
                });
            });

            clearBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                hiddenInput.value = '';
                label.innerHTML = '<span class="picker-placeholder">-- Select Category --</span>';
                trigger.classList.remove('has-value');
                options.forEach(o => o.classList.remove('selected'));
                closePanel();
            });

            search.addEventListener('input', function() {
                const term = this.value.toLowerCase().trim();
                options.forEach(o => {
                    const name = (o.dataset.name || '').toLowerCase();
                    o.classList.toggle('hidden-by-search', term.length > 0 && !name.includes(term));
                });
            });

            search.addEventListener('click', e => e.stopPropagation());

            document.addEventListener('click', function(e) {
                if (!picker.contains(e.target)) closePanel();
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closePanel();
            });

            // Mark the pre-selected option (e.g. after a validation error) as selected.
            if (hiddenInput.value) {
                const preselected = options.find(o => o.dataset.id === hiddenInput.value);
                if (preselected) preselected.classList.add('selected');
            }

            /* ── Image upload ─────────────────────────────────────────── */
            const uploadArea = document.getElementById('imageUploadArea');
            const imageInput = document.getElementById('imageInput');
            const preview = document.getElementById('imagePreview');

            function handleFiles(files) {
                preview.innerHTML = '';
                let index = 0;
                for (let file of files) {
                    if (!file.type.startsWith('image/')) continue;
                    const isPrimary = index === 0;
                    index++;
                    const reader = new FileReader();
                    reader.onload = function(ev) {
                        const div = document.createElement('div');
                        div.className = 'preview-item';
                        div.innerHTML = `
                            <img src="${ev.target.result}" alt="Preview" />
                            ${isPrimary ? '<span class="primary-badge">Primary</span>' : ''}
                            <button type="button" class="remove-preview" onclick="this.parentElement.remove()">×</button>
                        `;
                        preview.appendChild(div);
                    };
                    reader.readAsDataURL(file);
                }
            }

            uploadArea.addEventListener('click', () => imageInput.click());

            uploadArea.addEventListener('dragover', e => {
                e.preventDefault();
                uploadArea.classList.add('drag-active');
            });

            uploadArea.addEventListener('dragleave', e => {
                e.preventDefault();
                uploadArea.classList.remove('drag-active');
            });

            uploadArea.addEventListener('drop', e => {
                e.preventDefault();
                uploadArea.classList.remove('drag-active');
                const files = e.dataTransfer.files;
                imageInput.files = files;
                handleFiles(files);
            });

            imageInput.addEventListener('change', e => {
                handleFiles(e.target.files);
            });
        })();
    </script>
}
