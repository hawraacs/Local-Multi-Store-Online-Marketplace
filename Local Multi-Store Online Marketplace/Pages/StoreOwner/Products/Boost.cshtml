@page
@model Local_Multi_Store_Online_Marketplace.Pages.StoreOwner.Products.BoostModel
@{
    ViewData["Title"] = "Boost Product";
    Layout = "/Pages/StoreOwner/Shared/_StoreOwnerLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ============================================================
                   Uses the same purple accent as the rest of the Store Owner
                   section, for visual consistency across pages. Amber is kept only
                   for the "payment pending" status indicator, matching the app's
                   existing warning/pending color used elsewhere.
                   ============================================================ */
        :root {
            --ink: #1e1b2e;
            --ink-soft: #6b6478;
            --ink-faint: #9691a4;
            --paper: #f8f7fc;
            --surface: #ffffff;
            --border: #ece8f6;
            --accent: #6d28d9;
            --accent-hover: #5b21b6;
            --accent-light: #f3effe;
            --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
            --pending-100: #fef3c7;
            --pending-600: #d97706;
            --pending-700: #b45309;
            --success: #10b981;
            --success-bg: #dcfce7;
            --error: #dc2626;
            --error-bg: #fee2e2;
            --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.06);
            --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.10);
            --radius-sm: 10px;
            --radius-md: 16px;
            --radius-lg: 22px;
            --font-display: 'Fraunces', 'Georgia', serif;
            --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        body {
            background: var(--paper);
            font-family: var(--font-body);
        }

        .boost-page {
            max-width: 640px;
            margin: 32px auto;
            padding: 0 24px;
        }

        .boost-back-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink-soft);
            text-decoration: none;
            margin-bottom: 22px;
        }

            .boost-back-link:hover {
                color: var(--accent);
            }

        .boost-eyebrow {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--accent);
            margin: 0 0 6px;
        }

        /* ---- Alerts ---- */
        .boost-alert {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 16px;
            border-radius: var(--radius-sm);
            font-size: 13.5px;
            font-weight: 600;
            margin-bottom: 20px;
        }

            .boost-alert.success {
                background: var(--success-bg);
                color: #065f46;
            }

            .boost-alert.error {
                background: var(--error-bg);
                color: #991b1b;
            }

        /* ---- Product header ---- */
        .boost-header {
            display: flex;
            align-items: center;
            gap: 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px 22px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 20px;
        }

        .boost-product-thumb {
            width: 60px;
            height: 60px;
            border-radius: var(--radius-md);
            object-fit: cover;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }

        .boost-header-info {
            min-width: 0;
        }

            .boost-header-info h1 {
                font-family: var(--font-display);
                font-size: 19px;
                font-weight: 600;
                color: var(--ink);
                margin: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .boost-price-pill {
            margin-left: auto;
            flex-shrink: 0;
            background: var(--accent-light);
            color: var(--accent);
            font-weight: 800;
            font-size: 14px;
            padding: 7px 14px;
            border-radius: 999px;
        }

        /* ---- Feed-position preview (signature element) ----
                   Shows, don't tells: two muted "other listings" rows and, above
                   them, this product glowing amber with a Boosted tag — the
                   actual thing being purchased, seen before it's described in
                   pricing terms. */
        .boost-preview {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 22px 24px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 20px;
        }

            .boost-preview > p.boost-preview-caption {
                font-size: 13px;
                color: var(--ink-soft);
                margin: 12px 0 0;
            }

        .preview-stack {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .preview-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: 12px;
            border: 1px solid transparent;
        }

            .preview-row.boosted {
                background: var(--accent-light);
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.14);
                animation: preview-lift 0.5s cubic-bezier(.2, .8, .2, 1) both;
            }

            .preview-row.ghost {
                background: var(--paper);
            }

        @@keyframes preview-lift {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .preview-thumb {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            background: var(--border);
            flex-shrink: 0;
        }

        .preview-row.boosted .preview-thumb {
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 11px;
        }

        .preview-lines {
            display: flex;
            flex-direction: column;
            gap: 5px;
            flex: 1;
            min-width: 0;
        }

            .preview-lines span {
                display: block;
                height: 6px;
                border-radius: 3px;
                background: var(--border);
            }

                .preview-lines span:first-child {
                    width: 58%;
                }

                .preview-lines span:last-child {
                    width: 32%;
                }

        .preview-boosted-label {
            font-size: 11.5px;
            font-weight: 800;
            color: var(--accent);
            white-space: nowrap;
        }

        /* ---- Active / pending status card ---- */
        .boost-status-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left: 4px solid var(--success);
            border-radius: var(--radius-lg);
            padding: 20px 22px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .boost-status-card.pending {
                border-left-color: var(--pending-600);
            }

        .boost-status-icon {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: var(--success-bg);
            color: var(--success);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            flex-shrink: 0;
        }

            .boost-status-icon.pending {
                background: var(--pending-100);
                color: var(--pending-700);
            }

        .boost-status-info h3 {
            font-family: var(--font-display);
            font-size: 15.5px;
            font-weight: 600;
            color: var(--ink);
            margin: 0 0 3px;
        }

        .boost-status-info p {
            font-size: 13px;
            color: var(--ink-soft);
            margin: 0;
        }

        .boost-status-badge {
            margin-left: auto;
            font-size: 10.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 6px 13px;
            border-radius: 20px;
            background: var(--success-bg);
            color: #047857;
            flex-shrink: 0;
        }

            .boost-status-badge.pending {
                background: var(--pending-100);
                color: var(--pending-700);
            }

        /* ---- Duration picker ---- */
        .boost-form-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: var(--shadow-sm);
        }

            .boost-form-card > p.boost-form-sub {
                font-size: 13.5px;
                color: var(--ink-soft);
                margin: 0 0 18px;
            }

        .boost-options-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 22px;
        }

        @@media (max-width: 560px) {
            .boost-options-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .boost-option {
            position: relative;
        }

            .boost-option input[type="radio"] {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

        .boost-option-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
            border: 2px solid var(--border);
            border-radius: var(--radius-md);
            padding: 16px 8px;
            cursor: pointer;
            transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
            text-align: center;
        }

            .boost-option-label:hover {
                border-color: var(--accent);
                background: var(--accent-light);
            }

        .boost-option input[type="radio"]:checked + .boost-option-label {
            border-color: var(--accent);
            background: var(--accent-light);
            box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.16);
        }

        .boost-option input[type="radio"]:focus-visible + .boost-option-label {
            outline: 2px solid var(--accent-hover);
            outline-offset: 2px;
        }

        .boost-option-days {
            font-family: var(--font-display);
            font-size: 21px;
            font-weight: 600;
            color: var(--ink);
        }

        .boost-option-price {
            font-size: 14px;
            font-weight: 700;
            color: var(--accent);
        }

        .boost-option-perday {
            font-size: 10.5px;
            color: var(--ink-faint);
        }

        .boost-submit-btn {
            width: 100%;
            background: var(--accent-gradient);
            color: #fff;
            border: none;
            padding: 14px 0;
            border-radius: var(--radius-sm);
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

            .boost-submit-btn:hover {
                transform: translateY(-1px);
                box-shadow: var(--shadow-md);
                color: #fff;
            }

        .boost-note {
            font-size: 12px;
            color: var(--ink-faint);
            text-align: center;
            margin-top: 12px;
        }

        /* ---- Accessibility ---- */
        a:focus-visible,
        button:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition-duration: 0.001ms !important;
                animation-duration: 0.001ms !important;
            }
        }
    </style>
}

<div class="boost-page">

    @* Tab strip intentionally not shown on the Boost page — Boost is a
       focused, single-purpose flow reached from a product card, not one of
       the tabbed sections itself, so the Catalog/Promote strip is omitted
       here rather than highlighting either one. *@

    <a asp-page="/StoreOwner/Home" class="boost-back-link">
        <i class="fas fa-arrow-left"></i> Back to my products
    </a>

    @if (TempData["Success"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="boost-alert success"><i class="fas fa-circle-check"></i> @successMessage</div>
    }
    @if (TempData["Error"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="boost-alert error"><i class="fas fa-circle-exclamation"></i> @errorMessage</div>
    }

    <!-- ========== PRODUCT HEADER ========== -->
    <div class="boost-header">
        @{
            var thumb = Model.Product.Images?
                .OrderByDescending(i => i.IsPrimary)
                .ThenBy(i => i.DisplayOrder)
                .Select(i => i.ImageUrl)
                .FirstOrDefault() ?? "/images/no-image.png";
        }
        <img class="boost-product-thumb" src="@thumb" alt="@Model.Product.ProductName" />
        <div class="boost-header-info">
            <p class="boost-eyebrow">Boosting</p>
            <h1>@Model.Product.ProductName</h1>
        </div>
        <!-- BUGFIX: was missing .ToString("N2"), same inconsistency fixed earlier
             on the Home page — could show "$9.5" instead of "$9.50". -->
        <div class="boost-price-pill">$@Model.Product.Price.ToString("N2")</div>
    </div>

    <!-- ========== CURRENT / PENDING BOOST STATUS ========== -->
    @if (Model.ExistingBoost != null)
    {
        var boost = Model.ExistingBoost;
        var isActive = boost.Status == "Active";
        <div class="boost-status-card @(isActive ? "" : "pending")">
            <div class="boost-status-icon @(isActive ? "" : "pending")">
                <i class="fas @(isActive ? "fa-bolt" : "fa-hourglass-half")"></i>
            </div>
            <div class="boost-status-info">
                @if (isActive)
                {
                    <h3>Boosted right now</h3>
                    <p>Runs until @(boost.EndDate.HasValue ? boost.EndDate.Value.ToString("dd MMM yyyy, h:mm tt") : "an upcoming date")</p>
                }
                else
                {
                    <h3>Payment pending</h3>
                    <p>Finish paying to activate your @boost.DurationDays-day boost.</p>
                }
            </div>
            <span class="boost-status-badge @(isActive ? "" : "pending")">@boost.Status</span>
        </div>

        @if (!isActive && boost.StorePaymentId.HasValue)
        {
            <div class="boost-form-card">
                <h2 style="font-family:var(--font-display); font-size:16.5px; font-weight:600; color:var(--ink); margin:0 0 5px;">
                    Finish setting up your boost
                </h2>
                <p class="boost-form-sub">Your @boost.DurationDays-day boost for $@boost.AmountPaid.ToString("N2") is waiting on payment.</p>

                <a class="boost-submit-btn"
                   href="@Url.Page("/StoreOwner/StoreOwnerPayment", new
                   {
                       paymentId = boost.StorePaymentId,
                       returnUrl = Url.Page("/StoreOwner/Products/Boost", new { ProductId = Model.ProductId }),
                       boostId = boost.ProductBoostID
                   })"
                   style="text-decoration:none;">
                    <i class="fas fa-credit-card"></i> Continue payment
                </a>

                <p class="boost-note">
                    You'll be taken to a secure payment page to finish activating this boost.
                </p>
            </div>
        }
    }
    else
    {
        <!-- ========== FEED-POSITION PREVIEW ========== -->
        <div class="boost-preview" aria-hidden="true">
            <p class="boost-eyebrow">What boosting does</p>
            <div class="preview-stack">
                <div class="preview-row boosted">
                    <span class="preview-thumb"><i class="fas fa-bolt"></i></span>
                    <span class="preview-lines"><span></span><span></span></span>
                    <span class="preview-boosted-label">Boosted</span>
                </div>
                <div class="preview-row ghost">
                    <span class="preview-thumb"></span>
                    <span class="preview-lines"><span></span><span></span></span>
                </div>
                <div class="preview-row ghost">
                    <span class="preview-thumb"></span>
                    <span class="preview-lines"><span></span><span></span></span>
                </div>
            </div>
            <p class="boost-preview-caption">Your product moves to the top of the customer feed and carries a Boosted tag for as long as it runs.</p>
        </div>

        <!-- ========== DURATION PICKER FORM (only when no active/pending boost) ========== -->
        <div class="boost-form-card">
            <p class="boost-eyebrow">Choose a duration</p>
            <p class="boost-form-sub">Pick how many days to keep it at the top. Ends automatically — no auto-renewal.</p>

            <form method="post" asp-page-handler="StartBoost">
                <input type="hidden" asp-for="ProductId" />

                <div class="boost-options-grid">
                    @for (int i = 0; i < Model.PricingOptions.Count; i++)
                    {
                        var opt = Model.PricingOptions[i];
                        // BUGFIX: cheap defensive guard — these are fixed pricing tiers
                        // so DurationDays should never be 0, but a future config slip
                        // would otherwise throw DivideByZeroException for the whole page.
                        var perDay = opt.DurationDays > 0 ? opt.Price / opt.DurationDays : 0;
                        <div class="boost-option">
                            <input type="radio"
                                   id="duration_@opt.DurationDays"
                                   name="SelectedDurationDays"
                                   value="@opt.DurationDays"
                                   checked="@(i == 0 ? "checked" : null)" />
                            <label class="boost-option-label" for="duration_@opt.DurationDays">
                                <span class="boost-option-days">@opt.DurationDays</span>
                                <span class="boost-option-price">$@opt.Price.ToString("N2")</span>
                                <span class="boost-option-perday">$@perDay.ToString("N2")/day</span>
                            </label>
                        </div>
                    }
                </div>

                <button type="submit" class="boost-submit-btn">
                    <i class="fas fa-bolt"></i> Start boost
                </button>

                <p class="boost-note">
                    We'll charge your saved card, or take you to a secure payment page if you don't have one on file.
                </p>
            </form>
        </div>
    }

</div>
