@* Shared tab strip for the two navigable faces of "Products": the catalog
   itself, and the Explore-style content that promotes it. Usage:
   <partial name="_ProductsNav" model="@("Catalog")" /> — pass "Catalog" or
   "Promote" as the active tab.

   REMOVED: the third "Boost" tab. Boost was never a page you navigate to
   directly — it's a per-product action launched from a button on a product
   card (on both the Home page and the Catalog page), not a standalone
   section with its own list view. Keeping a permanently-disabled tab here
   just to represent that wasn't adding anything — it only ever looked like
   a broken/unfinished link. If a genuine "all your boosts" list page gets
   built later, add a real, clickable tab back in for it then. *@
@model string
@{
    var active = Model ?? "Catalog";
}
<div class="products-tabs" role="tablist" aria-label="Products sections">
    <a href="/StoreOwner/Products/Index"
       class="products-tab @(active == "Catalog" ? "active" : "")"
       role="tab" aria-selected="@(active == "Catalog" ? "true" : "false")">
        <i class="fas fa-cube"></i> Catalog
    </a>
    <a href="/StoreOwner/Products/Promote/Index"
       class="products-tab @(active == "Promote" ? "active" : "")"
       role="tab" aria-selected="@(active == "Promote" ? "true" : "false")">
        <i class="fas fa-photo-film"></i> Promote
    </a>
</div>

<style>
    .products-tabs {
        display: flex;
        gap: 4px;
        margin-bottom: 24px;
        border-bottom: 1px solid #ece8f6;
    }

    .products-tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 700;
        color: #6b6478;
        text-decoration: none;
        border-bottom: 3px solid transparent;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

        .products-tab:hover {
            color: #6d28d9;
        }

        .products-tab.active {
            color: #6d28d9;
            border-bottom-color: #6d28d9;
        }
</style>
