@page "{customerId:int}"
@model Local_Multi_Store_Online_Marketplace.Pages.StoreViewCustomerModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Customer Profile | Realnest</title>

    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --bg-color: #faf9fc;
                --card-bg: #ffffff;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                --text-muted: #9691a4;
                --border-color: #ece8f6;
                --danger-color: #dc2626;
                --success-color: #10b981;
                --warning-color: #f59e0b;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.06);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.10);
                --shadow-lg: 0 20px 50px rgba(30, 27, 46, 0.14);
                --radius-md: 14px;
                --radius-lg: 22px;
                --font-display: 'Fraunces', Georgia, serif;
                --transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                background: radial-gradient(ellipse 800px 460px at 12% -6%, rgba(109, 40, 217, 0.05), transparent), radial-gradient(ellipse 640px 460px at 100% 8%, rgba(99, 102, 241, 0.05), transparent), var(--bg-color);
                background-attachment: fixed;
                color: var(--text-primary);
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
            }

            .profile-container {
                max-width: 900px;
                width: 100%;
                margin: 36px auto 60px;
                padding: 0 20px;
            }

            /* ============================================================
                           PROFILE HEADER
                           ============================================================ */
            .profile-header {
                display: flex;
                align-items: flex-start;
                gap: 22px;
                padding: 28px 30px 30px;
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-md);
                margin-bottom: 22px;
                position: relative;
            }

            .back-arrow-btn {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                border: 1px solid var(--border-color);
                background: #ffffff;
                color: var(--text-secondary);
                font-size: 14px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                flex-shrink: 0;
                transition: var(--transition);
                margin-top: 2px;
            }

                .back-arrow-btn:hover {
                    background: var(--accent-color);
                    border-color: var(--accent-color);
                    color: #ffffff;
                    transform: translateX(-2px);
                }

            .profile-avatar-and-details {
                display: flex;
                align-items: flex-start;
                gap: 26px;
                flex: 1;
                min-width: 0;
            }

            .profile-avatar {
                width: 96px;
                height: 96px;
                border-radius: 26px;
                background: var(--accent-gradient);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 42px;
                color: #ffffff;
                flex-shrink: 0;
                box-shadow: 0 10px 24px rgba(109, 40, 217, 0.28);
            }

            .profile-details {
                flex-grow: 1;
                min-width: 0;
                padding-top: 2px;
            }

            .profile-username-row {
                display: flex;
                align-items: center;
                gap: 14px;
                flex-wrap: wrap;
                margin-bottom: 6px;
            }

            .profile-username {
                font-family: var(--font-display);
                font-size: 25px;
                font-weight: 600;
                letter-spacing: -0.2px;
                color: var(--text-primary);
                display: flex;
                align-items: center;
            }

            .follow-status-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 700;
            }

            .following-yes {
                background: #dcfce7;
                color: #166534;
            }

            .following-no {
                background: var(--accent-light);
                color: var(--accent-color);
            }

            .profile-contact-line {
                display: flex;
                flex-wrap: wrap;
                gap: 4px 18px;
                font-size: 13.5px;
                color: var(--text-secondary);
                margin-bottom: 18px;
            }

                .profile-contact-line span {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

                .profile-contact-line i {
                    color: var(--text-muted);
                    font-size: 12.5px;
                }

            /* ----- stat tiles (order count / review count) + message CTA,
                                   all in one row so the panel reads as a single toolbar
                                   instead of stacked loose text. ----- */
            .profile-toolbar {
                display: flex;
                flex-wrap: wrap;
                align-items: stretch;
                gap: 10px;
                margin-bottom: 18px;
            }

            .stat-tile {
                display: flex;
                align-items: center;
                gap: 10px;
                background: var(--bg-color);
                border: 1px solid var(--border-color);
                border-radius: 14px;
                padding: 10px 16px;
                cursor: pointer;
                transition: var(--transition);
            }

                .stat-tile:hover {
                    border-color: var(--accent-color);
                    background: var(--accent-light);
                    transform: translateY(-1px);
                }

                .stat-tile .stat-icon {
                    width: 30px;
                    height: 30px;
                    border-radius: 9px;
                    background: var(--accent-light);
                    color: var(--accent-color);
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 13px;
                    flex-shrink: 0;
                }

                .stat-tile:hover .stat-icon {
                    background: #ffffff;
                }

                .stat-tile .stat-text {
                    line-height: 1.25;
                }

                .stat-tile .stat-count {
                    display: block;
                    font-family: var(--font-display);
                    font-weight: 700;
                    font-size: 17px;
                    color: var(--text-primary);
                }

                .stat-tile .stat-label {
                    display: block;
                    font-size: 11.5px;
                    font-weight: 600;
                    color: var(--text-muted);
                    text-transform: uppercase;
                    letter-spacing: 0.3px;
                }

            .message-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: var(--accent-gradient);
                color: #ffffff !important;
                text-decoration: none;
                padding: 0 20px;
                border-radius: 14px;
                font-weight: 700;
                font-size: 13.5px;
                box-shadow: 0 8px 18px rgba(109, 40, 217, 0.25);
                transition: var(--transition);
            }

                .message-btn:hover {
                    opacity: 0.95;
                    transform: translateY(-1px);
                    box-shadow: 0 10px 22px rgba(109, 40, 217, 0.32);
                }

            .bio-badges {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

            .bio-badge {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                background: var(--accent-light);
                padding: 5px 12px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 700;
                color: var(--accent-color);
            }

            .post-menu {
                position: absolute;
                top: 22px;
                right: 22px;
                display: inline-block;
            }

            .post-menu-btn {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                border: 1px solid var(--border-color);
                background: #ffffff;
                cursor: pointer;
                font-size: 17px;
                color: var(--text-secondary);
                display: grid;
                place-items: center;
                transition: var(--transition);
            }

                .post-menu-btn:hover {
                    border-color: var(--accent-color);
                    color: var(--accent-color);
                }

            .post-menu-dropdown {
                display: none;
                position: absolute;
                right: 0;
                top: 48px;
                background: white;
                border: 1px solid var(--border-color);
                border-radius: 12px;
                box-shadow: var(--shadow-md);
                min-width: 190px;
                z-index: 999;
                overflow: hidden;
            }

                .post-menu-dropdown form {
                    margin: 0;
                }

                .post-menu-dropdown button {
                    width: 100%;
                    padding: 12px 14px;
                    background: none;
                    border: none;
                    text-align: left;
                    cursor: pointer;
                    font-size: 13px;
                    font-weight: 600;
                    color: var(--text-primary);
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

                    .post-menu-dropdown button:hover {
                        background: var(--accent-light);
                    }

                    .post-menu-dropdown button.danger-option {
                        color: var(--danger-color);
                    }

                        .post-menu-dropdown button.danger-option:hover {
                            background: #fef2f2;
                        }

            /* ============================================================
                           SECTION CARDS — Orders & Reviews now sit inside proper
                           card shells with a header bar, matching the rest of the
                           Store Owner pages instead of floating bare tables/lists.
                           ============================================================ */
            .section-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-sm);
                overflow: hidden;
                margin-bottom: 22px;
                transition: box-shadow 0.25s ease;
                scroll-margin-top: 20px;
            }

                .section-card:hover {
                    box-shadow: var(--shadow-md);
                }

            .section-card-header {
                background: var(--bg-color);
                border-bottom: 1px solid var(--border-color);
                padding: 16px 22px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
            }

            .section-card-heading {
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: var(--font-display);
                font-size: 16.5px;
                font-weight: 600;
                color: var(--text-primary);
            }

                .section-card-heading .icon-box {
                    width: 32px;
                    height: 32px;
                    border-radius: 9px;
                    background: var(--accent-light);
                    color: var(--accent-color);
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 14px;
                    flex-shrink: 0;
                }

            .section-card-count {
                font-size: 12px;
                font-weight: 700;
                color: var(--text-muted);
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                padding: 4px 10px;
                border-radius: 20px;
                flex-shrink: 0;
            }

            .section-card-body {
                padding: 20px 22px;
            }

            .section-hint {
                font-size: 12px;
                color: var(--text-muted);
                margin-bottom: 14px;
            }

            /* ============================================================
                           ORDERS TABLE
                           ============================================================ */
            .orders-table {
                width: 100%;
                border-collapse: collapse;
            }

                .orders-table th,
                .orders-table td {
                    text-align: left;
                    padding: 12px 8px;
                    font-size: 13.5px;
                    border-bottom: 1px solid var(--border-color);
                }

                .orders-table th {
                    color: var(--text-muted);
                    font-weight: 700;
                    font-size: 11px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                .orders-table tr:last-child td {
                    border-bottom: none;
                }

                .orders-table tbody tr {
                    transition: background-color 0.15s ease;
                }

                    .orders-table tbody tr:hover td {
                        background-color: var(--accent-light);
                    }

            .status-badge {
                display: inline-block;
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 11.5px;
                font-weight: 700;
                white-space: nowrap;
            }

                .status-badge.status-pending {
                    background: #fef3c7;
                    color: #92400e;
                }

                .status-badge.status-confirmed {
                    background: #e0e7ff;
                    color: #3730a3;
                }

                .status-badge.status-preparing {
                    background: var(--accent-light);
                    color: var(--accent-color);
                }

                .status-badge.status-outfordelivery {
                    background: #dbeafe;
                    color: #1d4ed8;
                }

                .status-badge.status-delivered {
                    background: #dcfce7;
                    color: #166534;
                }

                .status-badge.status-cancelled {
                    background: #fee2e2;
                    color: #b91c1c;
                }

                .status-badge.status-default {
                    background: var(--bg-color);
                    color: var(--text-secondary);
                }

            .order-view-link {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                color: var(--accent-color);
                text-decoration: none;
                font-weight: 700;
                font-size: 12.5px;
                white-space: nowrap;
            }

                .order-view-link:hover {
                    text-decoration: underline;
                }

            /* ============================================================
                           REVIEWS — collapsible list past 5, product deep-links,
                           double-click (or trash icon) to delete.
                           ============================================================ */
            .reviews-container {
                display: flex;
                flex-direction: column;
            }

            .review-row {
                border-bottom: 1px solid var(--border-color);
                padding: 16px 4px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 16px;
                transition: background-color 0.15s ease;
                cursor: default;
                user-select: none;
            }

            .reviews-container .review-row:last-of-type {
                border-bottom: none;
            }

            .review-row:hover {
                background-color: var(--bg-color);
            }

            .review-row.extra-review {
                display: none;
            }

            .review-main {
                flex-grow: 1;
                min-width: 0;
            }

                .review-main h4 {
                    font-size: 14.5px;
                    font-weight: 700;
                    color: var(--text-primary);
                    margin-bottom: 4px;
                }

                .review-main p {
                    font-size: 13.5px;
                    color: var(--text-secondary);
                    line-height: 1.5;
                    font-style: italic;
                }

            .review-product-link {
                color: var(--text-primary);
                text-decoration: none;
                border-bottom: 1px dashed var(--border-color);
                transition: color 0.15s ease, border-color 0.15s ease;
            }

                .review-product-link:hover {
                    color: var(--accent-color);
                    border-color: var(--accent-color);
                }

            .review-side {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-shrink: 0;
            }

            .stars-row {
                display: flex;
                gap: 2px;
                font-size: 12.5px;
            }

            .review-goto-btn {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                border: none;
                background: var(--accent-light);
                color: var(--accent-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-size: 11.5px;
                text-decoration: none;
                transition: var(--transition);
                opacity: 0;
            }

            .review-row:hover .review-goto-btn {
                opacity: 1;
            }

            .review-goto-btn:hover {
                background: var(--accent-color);
                color: #ffffff;
                transform: translateY(-2px);
            }

            .review-delete-btn {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                border: none;
                background: #fee2e2;
                color: var(--danger-color);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-size: 12px;
                transition: var(--transition);
                opacity: 0;
            }

            .review-row:hover .review-delete-btn {
                opacity: 1;
            }

            .review-delete-btn:hover {
                background: var(--danger-color);
                color: #ffffff;
                transform: translateY(-2px);
            }

            .review-delete-form {
                display: none;
            }

            .reviews-more-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                width: 100%;
                margin-top: 14px;
                padding: 11px;
                background: var(--bg-color);
                border: 1px dashed var(--border-color);
                border-radius: 12px;
                color: var(--accent-color);
                font-family: inherit;
                font-weight: 700;
                font-size: 13px;
                cursor: pointer;
                transition: background-color 0.15s ease, border-color 0.15s ease;
            }

                .reviews-more-btn:hover {
                    background: var(--accent-light);
                    border-color: var(--accent-color);
                }

                .reviews-more-btn i {
                    font-size: 11px;
                    transition: transform 0.2s ease;
                }

                .reviews-more-btn.expanded i {
                    transform: rotate(180deg);
                }

            /* ============================================================
                           EMPTY / STATUS STATES
                           ============================================================ */
            .empty-state {
                text-align: center;
                padding: 30px 10px;
                color: var(--text-muted);
            }

            .empty-icon {
                font-size: 32px;
                margin-bottom: 10px;
                color: var(--accent-color);
                opacity: 0.4;
            }

            .empty-state h3 {
                font-family: var(--font-display);
                font-size: 15.5px;
                font-weight: 600;
                color: var(--text-primary);
                margin-bottom: 4px;
            }

            .empty-state p {
                font-size: 12.5px;
                max-width: 320px;
                margin: 0 auto;
                line-height: 1.5;
            }

            .warning-banner {
                background: #fff7ed;
                color: #9a3412;
                border: 1px solid #fed7aa;
                padding: 14px 18px;
                border-radius: 12px;
                font-weight: 700;
                margin-top: 40px;
                text-align: center;
            }

            .server-message {
                padding: 13px 18px;
                border-radius: 12px;
                font-weight: 700;
                font-size: 13.5px;
                margin-bottom: 18px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .server-message.success {
                    background: #dcfce7;
                    color: #166534;
                }

                .server-message.error {
                    background: #fee2e2;
                    color: #b91c1c;
                }

            footer {
                text-align: center;
                padding: 30px 20px 10px;
                color: var(--text-muted);
                font-size: 12px;
            }

            @@media (max-width: 768px) {
                .profile-header {
                    flex-direction: column;
                    gap: 16px;
                    padding: 22px 18px 20px;
                }

                .back-arrow-btn {
                    align-self: flex-start;
                }

                .profile-avatar-and-details {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 14px;
                }

                .profile-toolbar {
                    width: 100%;
                }

                .stat-tile {
                    flex: 1;
                }

                .message-btn {
                    padding: 10px 18px;
                }

                .post-menu {
                    top: 14px;
                    right: 14px;
                }

                .section-card-body {
                    padding: 16px;
                }

                .orders-table {
                    display: block;
                    overflow-x: auto;
                }

                .review-row {
                    flex-direction: column;
                }

                .review-side {
                    justify-content: space-between;
                    width: 100%;
                }

                .review-goto-btn,
                .review-delete-btn {
                    opacity: 1;
                }
            }
    </style>
</head>

<body>

    <div class="profile-container">

        @if (TempData["Success"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="server-message success">
                <i class="fa-solid fa-circle-check"></i>
                @successMessage
            </div>
        }

        @if (TempData["Error"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="server-message error">
                <i class="fa-solid fa-circle-exclamation"></i>
                @errorMessage
            </div>
        }

        @if (Model.StoreOwnerHasNoStore)
        {
            <div class="warning-banner">
                <i class="fas fa-exclamation-triangle"></i>
                We couldn't find a store linked to your account.
            </div>
        }
        else if (Model.CustomerNotFound)
        {
            <div class="warning-banner">
                <i class="fas fa-exclamation-triangle"></i>
                This customer could not be found.
            </div>
        }
        else
        {
            <!-- Profile Header -->
            <div class="profile-header">

                <div class="post-menu">
                    <button type="button" class="post-menu-btn" onclick="toggleMenu(this)">
                        <i class="fa-solid fa-ellipsis-vertical"></i>
                    </button>

                    <div class="post-menu-dropdown">
                        <button type="button" onclick="openReportModal('reportCustomerModal', @Model.CustomerId)">
                            <i class="fa-regular fa-flag"></i> Report Customer
                        </button>

                        @if (!Model.IsBlocked)
                        {
                            <form method="post" asp-page-handler="BlockCustomer" asp-route-customerId="@Model.CustomerId">
                                <button type="submit" class="danger-option" onclick="return confirm('Block this customer? They will no longer be able to message you or view your store.');">
                                    <i class="fa-solid fa-ban"></i> Block Customer
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" disabled>
                                <i class="fa-solid fa-ban"></i> Already Blocked
                            </button>
                        }
                    </div>
                </div>

                <button type="button" class="back-arrow-btn" onclick="goBack()" title="Back" aria-label="Go back">
                    <i class="fas fa-arrow-left"></i>
                </button>

                <div class="profile-avatar-and-details">
                    <div class="profile-avatar">
                        <i class="fas fa-user-astronaut"></i>
                    </div>

                    <div class="profile-details">
                        <div class="profile-username-row">
                            <h2 class="profile-username">
                                @Model.CustomerFullName
                                @if (Model.IsVerified)
                                {
                                    <span title="Verified Customer">
                                        <i class="fas fa-check-circle" style="color: #6d28d9; font-size: 16px; margin-left: 6px;"></i>
                                    </span>
                                }
                            </h2>

                            @if (Model.IsFollowingThisStore)
                            {
                                <span class="follow-status-badge following-yes">
                                    <i class="fas fa-heart"></i> Follows Your Store
                                </span>
                            }
                            else
                            {
                                <span class="follow-status-badge following-no">
                                    <i class="far fa-heart"></i> Not Following
                                </span>
                            }
                        </div>

                        <div class="profile-contact-line">
                            <span><i class="fas fa-envelope"></i> @Model.CustomerEmail</span>
                            <span><i class="fas fa-phone"></i> @Model.CustomerPhone</span>
                        </div>

                        <div class="profile-toolbar">
                            <div class="stat-tile" onclick="scrollToSection('ordersSection')" title="Jump to orders">
                                <span class="stat-icon"><i class="fas fa-receipt"></i></span>
                                <span class="stat-text">
                                    <span class="stat-count">@Model.OrdersWithThisStoreCount</span>
                                    <span class="stat-label">Orders</span>
                                </span>
                            </div>

                            <div class="stat-tile" onclick="scrollToSection('reviewsSection')" title="Jump to reviews">
                                <span class="stat-icon"><i class="fas fa-star"></i></span>
                                <span class="stat-text">
                                    <span class="stat-count">@Model.ReviewsForThisStore.Count</span>
                                    <span class="stat-label">Reviews</span>
                                </span>
                            </div>

                            <a href="/ChatConversation?userId=@Model.CustomerUserId" class="message-btn">
                                <i class="fas fa-comment-dots"></i> Message
                            </a>
                        </div>

                        <div class="bio-badges">
                            <span class="bio-badge">
                                <i class="fas fa-calendar-alt"></i> Joined @Model.CreatedAt.ToString("MMM yyyy")
                            </span>
                            @if (Model.CODBlocked)
                            {
                                <span class="bio-badge" style="background:#fee2e2; color:#b91c1c;">
                                    <i class="fas fa-ban"></i> COD Restricted
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Orders with this store -->
            <div class="section-card" id="ordersSection">
                <div class="section-card-header">
                    <div class="section-card-heading">
                        <span class="icon-box"><i class="fas fa-receipt"></i></span>
                        Orders With Your Store
                    </div>
                    <span class="section-card-count">@Model.OrdersWithThisStoreCount total</span>
                </div>

                <div class="section-card-body">
                    @if (Model.OrdersWithThisStore.Any())
                    {
                        <table class="orders-table">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.OrdersWithThisStore)
                                {
                                    var statusClass = order.Status?.Replace(" ", "").ToLowerInvariant() switch
                                    {
                                        "pending" => "status-pending",
                                        "confirmed" => "status-confirmed",
                                        "preparing" => "status-preparing",
                                        "outfordelivery" => "status-outfordelivery",
                                        "delivered" => "status-delivered",
                                        "cancelled" => "status-cancelled",
                                        _ => "status-default"
                                    };

                                    <tr>
                                        <td><strong>@order.OrderNumber</strong></td>
                                        <td>@order.OrderDate.ToString("MMM d, yyyy")</td>
                                        <td><span class="status-badge @statusClass">@order.Status</span></td>
                                        <td>$@order.TotalAmount.ToString("N2")</td>
                                        <td>
                                            <a href="/StoreOwner/Order/Details?id=@order.OrderID" class="order-view-link">
                                                View <i class="fas fa-arrow-right" style="font-size:10px;"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-icon"><i class="fas fa-receipt"></i></div>
                            <h3>No Orders Yet</h3>
                            <p>This customer hasn't placed any orders with your store yet.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Reviews for this store's products -->
            <div class="section-card" id="reviewsSection">
                <div class="section-card-header">
                    <div class="section-card-heading">
                        <span class="icon-box"><i class="fas fa-star"></i></span>
                        Reviews on Your Products
                    </div>
                    <span class="section-card-count">@Model.ReviewsForThisStore.Count total</span>
                </div>

                <div class="section-card-body">
                    @if (Model.ReviewsForThisStore.Any())
                    {
                        <p class="section-hint">Double-click a review, or use the trash icon, to remove it.</p>

                        <div class="reviews-container" id="storeReviewsContainer">
                            @{
                                int reviewIndex = 0;
                            }
                            @foreach (var r in Model.ReviewsForThisStore)
                            {
                                var productName = Local_Multi_Store_Online_Marketplace.Pages.StoreViewCustomerModel.GetSafeString(r.Product, new[] { "ProductName", "Name" }, "Store Review");
                                var rating = Local_Multi_Store_Online_Marketplace.Pages.StoreViewCustomerModel.GetSafeInt(r, new[] { "Rating", "Stars", "Score" }, 5);
                                var comment = Local_Multi_Store_Online_Marketplace.Pages.StoreViewCustomerModel.GetSafeString(r, new[] { "Comment", "Text", "ReviewText", "Description" }, "No feedback left.");
                                var extraClass = reviewIndex >= 5 ? "extra-review" : "";

                                <div class="review-row @extraClass" ondblclick="confirmDeleteReview(@r.ReviewID)">
                                    <div class="review-main">
                                        @if (r.ProductID.HasValue && r.ProductID.Value > 0)
                                        {
                                            <h4>
                                                <a asp-page="/StoreOwner/Home"
                                                   asp-route-productId="@r.ProductID"
                                                   class="review-product-link"
                                                   onclick="event.stopPropagation()">
                                                    @productName
                                                </a>
                                            </h4>
                                        }
                                        else
                                        {
                                            <h4>@productName</h4>
                                        }
                                        <p>"@comment"</p>
                                    </div>
                                    <div class="review-side">
                                        <div class="stars-row">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= rating)
                                                {
                                                    <i class="fas fa-star" style="color: #f59e0b;"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star" style="color: var(--border-color);"></i>
                                                }
                                            }
                                        </div>
                                        <a href="@(Url.Page("/StoreReviews", new { storeId = Model.StoreId }))#review-@r.ReviewID"
                                           class="review-goto-btn"
                                           title="View this review on your Store Reviews page"
                                           onclick="event.stopPropagation()">
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                        </a>
                                        <button type="button" class="review-delete-btn" title="Delete review" onclick="event.stopPropagation(); confirmDeleteReview(@r.ReviewID)">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>

                                    <form method="post" asp-page-handler="DeleteReview" class="review-delete-form" id="deleteReviewForm-@r.ReviewID">
                                        <input type="hidden" name="customerId" value="@Model.CustomerId" />
                                        <input type="hidden" name="reviewId" value="@r.ReviewID" />
                                    </form>
                                </div>

                                reviewIndex++;
                            }
                        </div>

                        @if (Model.ReviewsForThisStore.Count > 5)
                        {
                            <button type="button"
                                    class="reviews-more-btn"
                                    data-more-label="Show @(Model.ReviewsForThisStore.Count - 5) more review@(Model.ReviewsForThisStore.Count - 5 == 1 ? "" : "s")"
                                    onclick="toggleMoreReviews(this)">
                                <span class="label">Show @(Model.ReviewsForThisStore.Count - 5) more review@(Model.ReviewsForThisStore.Count - 5 == 1 ? "" : "s")</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-icon"><i class="far fa-star"></i></div>
                            <h3>No Reviews Yet</h3>
                            <p>This customer hasn't reviewed any of your products yet.</p>
                        </div>
                    }
                </div>
            </div>
        }

    </div>

    <footer>
        Realnest — your local marketplace companion
    </footer>
    @{
        var reportCustomerModalModel = new
        {
            ModalId = "reportCustomerModal",
            PageHandler = "ReportCustomer",
            TargetIdFieldName = "customerId",
            TargetId = Model.CustomerId,
            Title = $"Report {Model.CustomerFullName}"
        };
    }

    <partial name="_ReportModal" model="reportCustomerModalModel" />

    <script>
            // ============================================
            // Back button — returns to whatever page the store owner was
            // on before opening this profile, instead of always jumping
            // to the Dashboard. Falls back to the Dashboard only if there
            // is no usable browser history (e.g. opened in a new tab).
            // ============================================
            function goBack() {
                if (window.history.length > 1 && document.referrer && document.referrer.indexOf(window.location.origin) === 0) {
                    window.history.back();
                } else {
                    window.location.href = "/StoreOwner/Dashboard";
                }
            }

            // Clicking the order/review stat tiles jumps straight to that
            // section further down the same page.
            function scrollToSection(id) {
                const el = document.getElementById(id);
                if (el) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }

            function toggleMenu(btn) {
                const menu = btn.nextElementSibling;

                document.querySelectorAll('.post-menu-dropdown').forEach(m => {
                    if (m !== menu) m.style.display = 'none';
                });

                menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
            }

            document.addEventListener('click', function(e) {
                if (!e.target.closest('.post-menu')) {
                    document.querySelectorAll('.post-menu-dropdown')
                        .forEach(m => m.style.display = 'none');
                }
            });

            // ============================================
            // Reviews — "Show N more" toggle + double-click/trash delete
            // ============================================
            function toggleMoreReviews(button) {
                const container = document.getElementById('storeReviewsContainer');
                if (!container) return;

                const isExpanded = button.classList.contains('expanded');

                container.querySelectorAll('.extra-review').forEach(function(row) {
                    row.style.display = isExpanded ? 'none' : 'flex';
                });

                button.classList.toggle('expanded', !isExpanded);
                button.querySelector('.label').textContent = isExpanded
                    ? button.dataset.moreLabel
                    : 'Show fewer reviews';
            }

            function confirmDeleteReview(reviewId) {
                if (confirm('Delete this review? This cannot be undone.')) {
                    const form = document.getElementById('deleteReviewForm-' + reviewId);
                    if (form) form.submit();
                }
            }
    </script>

</body>
</html>
