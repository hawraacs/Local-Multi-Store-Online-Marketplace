@page "{storeId:int}"
@model Local_Multi_Store_Online_Marketplace.Pages.CreateReviewModel

@{
    Layout = null;

    var reviewCount = Model.Reviews.Count;
    var averageRating = reviewCount > 0
        ? Model.Reviews.Average(r => r.Rating)
        : 0;
    var positiveCount = Model.Reviews.Count(r => r.Rating >= 4);
    var attentionCount = Model.Reviews.Count(r => r.Rating <= 2);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Store Reviews</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
            /* ============================================================
                       Same restrained design system as StoreReviews / Promotions —
                       flat header, stat cards, table-card sections — instead of a
                       glossy purple hero. Kept as one consistent visual language
                       across the store-owner and customer-facing review pages.
                       ============================================================ */
            :root {
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --bg-color: #f8f7fc;
                --card-bg: #ffffff;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                --text-muted: #9691a4;
                --border-color: #ece8f6;
                --star-color: #f59e0b;
                --success-color: #10b981;
                --error-color: #dc2626;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.06);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.10);
                --radius-md: 12px;
                --radius-lg: 20px;
                --transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
                --font-display: 'Fraunces', 'Georgia', serif;
                --content-max-width: 1100px;
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                margin: 0;
                min-height: 100%;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                background: var(--bg-color);
                color: var(--text-primary);
                -webkit-font-smoothing: antialiased;
            }

            button, input, textarea, select {
                font: inherit;
            }

            .page-shell {
                width: 100%;
                max-width: var(--content-max-width);
                margin: 0 auto;
                padding: 28px 20px 70px;
            }

            /* ============================================================
                       HEADER
                       ============================================================ */
            .reviews-header {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 24px;
            }

            .back-link {
                width: 40px;
                height: 40px;
                display: grid;
                place-items: center;
                border: 1px solid var(--border-color);
                border-radius: 50%;
                background: var(--card-bg);
                color: var(--text-secondary);
                text-decoration: none;
                box-shadow: var(--shadow-sm);
                transition: var(--transition);
                flex-shrink: 0;
            }

                .back-link:hover {
                    border-color: var(--accent-color);
                    color: var(--accent-color);
                }

            .reviews-header h2 {
                margin: 0;
                font-family: var(--font-display);
                font-size: 24px;
                font-weight: 600;
                letter-spacing: -0.2px;
                color: var(--text-primary);
            }

            .reviews-header p {
                margin: 2px 0 0;
                color: var(--text-secondary);
                font-size: 13.5px;
            }

            /* ============================================================
                       STATS ROW
                       ============================================================ */
            .stats-row {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                gap: 16px;
                margin-bottom: 24px;
            }

            .stat-mini {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 14px 18px;
                box-shadow: var(--shadow-sm);
                transition: var(--transition);
                text-align: center;
            }

                .stat-mini:hover {
                    border-color: var(--accent-color);
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                }

                .stat-mini .icon {
                    color: var(--accent-color);
                    opacity: 0.5;
                    font-size: 18px;
                    margin-right: 4px;
                }

                .stat-mini .number {
                    font-size: 22px;
                    font-weight: 800;
                    color: var(--text-primary);
                    line-height: 1.2;
                }

                .stat-mini .label {
                    font-size: 11.5px;
                    font-weight: 600;
                    color: var(--text-muted);
                    text-transform: uppercase;
                    letter-spacing: 0.4px;
                }

                .stat-mini.attention .number {
                    color: var(--error-color);
                }

            /* ============================================================
                       ALERTS
                       ============================================================ */
            .alert {
                border-radius: var(--radius-md);
                padding: 13px 18px;
                font-weight: 600;
                font-size: 13.5px;
                border: 1px solid transparent;
                margin-bottom: 22px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .alert-success {
                background: #ecfdf5;
                color: #065f46;
                border-color: #a7f3d0;
            }

                .alert-success i {
                    color: var(--success-color);
                }

            .alert-danger {
                background: #fef2f2;
                color: #991b1b;
                border-color: #fecaca;
            }

                .alert-danger i {
                    color: var(--error-color);
                }

            /* ============================================================
                       TABLE-CARD SECTIONS (form + review list)
                       ============================================================ */
            .table-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-sm);
                overflow: hidden;
                margin-bottom: 24px;
                transition: var(--transition);
            }

                .table-card:hover {
                    box-shadow: var(--shadow-md);
                }

                .table-card .card-header {
                    background: var(--bg-color);
                    border-bottom: 1px solid var(--border-color);
                    padding: 15px 22px;
                    font-weight: 700;
                    font-size: 14.5px;
                    color: var(--text-primary);
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

                    .table-card .card-header i {
                        color: var(--accent-color);
                        font-size: 17px;
                    }

                .table-card .card-body {
                    padding: 22px;
                }

            /* ----- Review form ----- */
            .field-label {
                display: block;
                font-size: 11.5px;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-bottom: 8px;
            }

            .star-rating-input {
                display: flex;
                flex-direction: row-reverse;
                justify-content: flex-end;
                gap: 6px;
                margin-bottom: 18px;
            }

                .star-rating-input input {
                    display: none;
                }

                .star-rating-input label {
                    font-size: 24px;
                    color: #e3ddef;
                    cursor: pointer;
                    transition: color 0.15s ease;
                }

                    .star-rating-input label:hover,
                    .star-rating-input label:hover ~ label {
                        color: var(--star-color);
                    }

                .star-rating-input input:checked ~ label {
                    color: var(--star-color);
                }

            textarea.review-textarea {
                width: 100%;
                min-height: 90px;
                padding: 12px 14px;
                border-radius: 10px;
                border: 1px solid var(--border-color);
                background: var(--bg-color);
                resize: vertical;
                font-size: 13.5px;
                line-height: 1.6;
                outline: none;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
                margin-bottom: 16px;
            }

                textarea.review-textarea:focus {
                    border-color: var(--accent-color);
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.10);
                }

            .btn-primary {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                width: 100%;
                padding: 11px 22px;
                background: var(--accent-gradient);
                color: #fff;
                border: none;
                border-radius: 40px;
                font-weight: 700;
                font-size: 13.5px;
                cursor: pointer;
                box-shadow: 0 4px 16px rgba(109, 40, 217, 0.22);
                transition: var(--transition);
            }

                .btn-primary:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 8px 22px rgba(109, 40, 217, 0.3);
                }

            /* ----- Review rows (identical component to StoreReviews) ----- */
            .review-row {
                display: flex;
                align-items: flex-start;
                gap: 14px;
                padding: 20px 22px;
                border-bottom: 1px solid var(--border-color);
                transition: background-color 0.2s ease;
            }

                .review-row:last-child {
                    border-bottom: none;
                }

                .review-row:hover {
                    background-color: var(--accent-light);
                }

            .reviewer-avatar {
                width: 42px;
                height: 42px;
                border-radius: 14px;
                background: var(--accent-gradient);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 15px;
                flex-shrink: 0;
                box-shadow: 0 4px 10px rgba(109, 40, 217, 0.2);
            }

            .review-row-content {
                min-width: 0;
                flex: 1;
            }

            .review-row-head {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                gap: 10px;
                flex-wrap: wrap;
                margin-bottom: 4px;
            }

            .reviewer-name {
                font-weight: 700;
                color: var(--text-primary);
                font-size: 14.5px;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

            .own-review-badge {
                display: inline-flex;
                align-items: center;
                padding: 2px 9px;
                border-radius: 20px;
                background: var(--accent-light);
                color: var(--accent-color);
                font-size: 10.5px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 0.3px;
            }

            .review-date {
                font-size: 12px;
                color: var(--text-muted);
                font-weight: 500;
                white-space: nowrap;
            }

            .review-stars {
                display: flex;
                gap: 2px;
                color: var(--star-color);
                font-size: 13px;
                margin-bottom: 8px;
            }

            .review-comment {
                color: var(--text-secondary);
                line-height: 1.6;
                font-size: 14px;
                margin: 0;
            }

            /* ----- Delete own review — same circular icon-only style used
                       on StoreReviews for deleting as the store owner. ----- */
            .btn-delete-review {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                border: none;
                background: #fee2e2;
                color: #dc2626;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: var(--transition);
                flex-shrink: 0;
                margin-left: 8px;
            }

                .btn-delete-review:hover {
                    background: #dc2626;
                    color: white;
                    transform: translateY(-2px);
                }

                .btn-delete-review i {
                    font-size: 13px;
                }

            /* ----- "View N older reviews" ----- */
            .extra-review {
                display: none;
            }

            .view-older-btn {
                display: block;
                width: 100%;
                padding: 13px;
                background: var(--bg-color);
                border: none;
                border-top: 1px solid var(--border-color);
                color: var(--accent-color);
                font-family: 'Inter', sans-serif;
                font-weight: 700;
                font-size: 13px;
                cursor: pointer;
                transition: var(--transition);
            }

                .view-older-btn:hover {
                    background: var(--accent-light);
                }

            /* ----- Empty state ----- */
            .empty-state {
                padding: 50px 20px;
                text-align: center;
                color: var(--text-secondary);
            }

                .empty-state i {
                    font-size: 32px;
                    color: var(--accent-color);
                    opacity: 0.3;
                    margin-bottom: 12px;
                    display: block;
                }

                .empty-state h4 {
                    font-family: var(--font-display);
                    font-size: 17px;
                    font-weight: 600;
                    color: var(--text-primary);
                    margin: 0 0 4px;
                }

                .empty-state p {
                    margin: 0;
                    font-size: 13.5px;
                }

            @@media (prefers-reduced-motion: reduce) {
                *, *::before, *::after {
                    transition-duration: 0.001ms !important;
                }
            }

            @@media (max-width: 768px) {
                .stats-row {
                    grid-template-columns: repeat(2, 1fr);
                    gap: 12px;
                }

                .stat-mini .number {
                    font-size: 19px;
                }

                .table-card .card-body {
                    padding: 16px;
                }

                .review-row {
                    padding: 16px;
                }
            }
    </style>
</head>
<body>

    <div class="page-shell">

        <!-- ========== HEADER ========== -->
        <div class="reviews-header">
            <a class="back-link" href="javascript:history.back()" aria-label="Back">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h2>Store Reviews</h2>
                <p>Share your experience and see what other customers think.</p>
            </div>
        </div>

        <!-- ========== STATS ROW ========== -->
        <div class="stats-row">
            <div class="stat-mini">
                <span class="icon"><i class="fas fa-comments"></i></span>
                <div class="number">@reviewCount</div>
                <div class="label">Total Reviews</div>
            </div>
            <div class="stat-mini">
                <span class="icon"><i class="fas fa-star"></i></span>
                <div class="number">@averageRating.ToString("0.0")</div>
                <div class="label">Avg. Rating</div>
            </div>
            <div class="stat-mini">
                <span class="icon"><i class="fas fa-thumbs-up"></i></span>
                <div class="number">@positiveCount</div>
                <div class="label">4–5 Star</div>
            </div>
            <div class="stat-mini attention">
                <span class="icon"><i class="fas fa-triangle-exclamation"></i></span>
                <div class="number">@attentionCount</div>
                <div class="label">1–2 Star</div>
            </div>
        </div>

        <!-- ========== TEMPDATA ALERTS ========== -->
        @if (TempData["Success"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @successMessage
            </div>
        }

        @if (TempData["Error"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> @errorMessage
            </div>
        }

        <!-- ========== LEAVE A REVIEW ========== -->
        <div class="table-card">
            <div class="card-header">
                <i class="fas fa-pen-to-square"></i> Leave a Review
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="StoreId" />

                    <span class="field-label">Your rating</span>
                    <div class="star-rating-input">
                        <input type="radio" id="star5" asp-for="Rating" value="5" />
                        <label for="star5" title="5 stars"><i class="fa-solid fa-star"></i></label>

                        <input type="radio" id="star4" asp-for="Rating" value="4" />
                        <label for="star4" title="4 stars"><i class="fa-solid fa-star"></i></label>

                        <input type="radio" id="star3" asp-for="Rating" value="3" />
                        <label for="star3" title="3 stars"><i class="fa-solid fa-star"></i></label>

                        <input type="radio" id="star2" asp-for="Rating" value="2" />
                        <label for="star2" title="2 stars"><i class="fa-solid fa-star"></i></label>

                        <input type="radio" id="star1" asp-for="Rating" value="1" />
                        <label for="star1" title="1 star"><i class="fa-solid fa-star"></i></label>
                    </div>

                    <span class="field-label">Your comment</span>
                    <textarea asp-for="Comment" class="review-textarea" placeholder="What did you think?" maxlength="1000"></textarea>

                    <button type="submit" class="btn-primary">
                        <i class="fa-solid fa-paper-plane"></i> Submit Review
                    </button>
                </form>
            </div>
        </div>

        <!-- ========== REVIEWS LIST ========== -->
        <div class="table-card">
            <div class="card-header">
                <i class="fas fa-comments"></i> Other Reviews
            </div>
            <div class="card-body" style="padding: 0;">
                @if (!Model.Reviews.Any())
                {
                    <div class="empty-state">
                        <i class="fa-regular fa-comment-dots"></i>
                        <h4>No Reviews Yet</h4>
                        <p>Be the first to share your experience with this store.</p>
                    </div>
                }
                else
                {
                    int reviewIndex = 0;
                    @foreach (var r in Model.Reviews)
                    {
                        var fullName = r.Customer?.User?.FullName;
                        var userName = r.Customer?.User?.UserName;
                        var reviewerLabel = !string.IsNullOrWhiteSpace(fullName)
                            ? fullName
                            : (!string.IsNullOrWhiteSpace(userName) ? userName : "Verified Customer");

                        var initial = reviewerLabel.Length > 0 ? reviewerLabel.Substring(0, 1).ToUpper() : "?";
                        var extraClass = reviewIndex >= 5 ? "extra-review" : "";
                        var isOwnReview = Model.CurrentCustomerId > 0 && r.CustomerID == Model.CurrentCustomerId;

                        <div class="review-row @extraClass">
                            <div class="reviewer-avatar">@initial</div>
                            <div class="review-row-content">
                                <div class="review-row-head">
                                    <span class="reviewer-name">
                                        @reviewerLabel
                                        @if (isOwnReview)
                                        {
                                            <span class="own-review-badge">You</span>
                                        }
                                    </span>
                                    <span class="review-date">@r.CreatedAt.ToString("MMM d, yyyy")</span>
                                </div>
                                <div class="review-stars">
                                    @for (int i = 0; i < r.Rating; i++)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    @for (int i = r.Rating; i < 5; i++)
                                    {
                                        <i class="fa-regular fa-star"></i>
                                    }
                                </div>
                                <p class="review-comment">@r.Comment</p>
                            </div>

                            @if (isOwnReview)
                            {
                                <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete your review?');">
                                    <input type="hidden" name="reviewId" value="@r.ReviewID" />
                                    <input type="hidden" name="storeId" value="@Model.StoreId" />
                                    <button type="submit" class="btn-delete-review" title="Delete your review">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            }
                        </div>
                        reviewIndex++;
                    }

                    @if (Model.Reviews.Count > 5)
                    {
                        <button type="button" class="view-older-btn" data-more-label="View @(Model.Reviews.Count - 5) older review@(Model.Reviews.Count - 5 == 1 ? "" : "s")" onclick="toggleOlderReviews(this)">
                            View @(Model.Reviews.Count - 5) older review@(Model.Reviews.Count - 5 == 1 ? "" : "s")
                        </button>
                    }
                }
            </div>
        </div>

    </div>

    <script>
            function toggleOlderReviews(button) {
                var card = button.closest('.table-card');
                if (!card) return;

                var isExpanded = button.dataset.expanded === 'true';

                card.querySelectorAll('.extra-review').forEach(function(row) {
                    row.style.display = isExpanded ? 'none' : 'flex';
                });

                button.dataset.expanded = isExpanded ? 'false' : 'true';
                button.textContent = isExpanded ? button.dataset.moreLabel : 'Show fewer reviews';
            }
    </script>

</body>
</html>
