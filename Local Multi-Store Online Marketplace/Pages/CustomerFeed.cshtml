@page
@model Local_Multi_Store_Online_Marketplace.Pages.CustomerFeedModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>My Feed | realnest</title>

    <!-- Fonts & icon library -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Page styles -->
    <link rel="stylesheet" href="~/css/stories.css" />
    <link rel="stylesheet" href="~/css/customer-feed.css" asp-append-version="true" />

    <!-- NEW — styles for the avatar dropdown menu (My Profile / Logout)
         and the back-arrow nav item. customer-feed.css doesn't define
         these, so they're added inline here rather than editing a file
         we don't have. -->
    <style>
            .menu-wrap {
                position: relative;
            }

            .tile-menu-dropdown {
                position: absolute;
                top: 46px;
                right: 0;
                z-index: 300;
                min-width: 190px;
                background: #ffffff;
                border: 1px solid var(--border-color, #ece8f6);
                border-radius: 14px;
                box-shadow: 0 16px 36px rgba(67, 46, 110, 0.18);
                padding: 6px;
                display: none;
            }

                .tile-menu-dropdown.open {
                    display: block;
                }

            .tile-menu-item {
                display: flex;
                align-items: center;
                gap: 10px;
                width: 100%;
                border: none;
                background: transparent;
                padding: 10px 12px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 700;
                color: var(--text-primary, #1e1b2e);
                cursor: pointer;
                text-align: left;
                text-decoration: none;
                font-family: inherit;
            }

                .tile-menu-item i {
                    width: 16px;
                    text-align: center;
                    color: #8d859c;
                    font-size: 13px;
                }

                .tile-menu-item:hover {
                    background: var(--accent-light, #f3effe);
                }

                .tile-menu-item.danger {
                    color: #dc2626;
                }

                    .tile-menu-item.danger i {
                        color: #dc2626;
                    }

                    .tile-menu-item.danger:hover {
                        background: #fdeeec;
                    }

            .avatar-menu-dropdown {
                top: 50px;
                right: 0;
            }

            .app-topbar-avatar {
                border: none;
                cursor: pointer;
                font: inherit;
            }

            /* Icon-only back button, sits above the sidebar nav list. */
            .app-nav-back-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                margin-bottom: 6px;
                border: 1px solid var(--border-color, #ece8f6);
                border-radius: 50%;
                background: #ffffff;
                color: var(--text-primary, #1e1b2e);
                font-size: 14px;
                cursor: pointer;
            }

                .app-nav-back-btn:hover {
                    border-color: var(--accent-color, #6d28d9);
                    color: var(--accent-color, #6d28d9);
                }

            /* Real-promotion banner extras not covered by the old
                       "Up to 60% Off" markup. */
            .promo-banner-code {
                margin-top: 8px;
                font-size: 12.5px;
                font-weight: 700;
                opacity: 0.9;
            }

            .promo-banner-empty {
                font-size: 13px;
                opacity: 0.85;
            }
    </style>
</head>
<body>

    <!-- =========================================================
         TOAST NOTIFICATIONS (server-side success/error messages)
         ========================================================= -->
    <div class="toast-container">
        @if (TempData["Success"] != null)
        {
            <div class="toast toast-success">
                <i class="fa-solid fa-circle-check"></i>
                <div class="toast-message">@TempData["Success"]</div>
                <button type="button" class="toast-close" onclick="this.parentElement.remove()">&times;</button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="toast toast-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                <div class="toast-message">@TempData["Error"]</div>
                <button type="button" class="toast-close" onclick="this.parentElement.remove()">&times;</button>
            </div>
        }
    </div>

    <!-- Mobile-only tab bar (hidden at desktop, see customer-feed.css §14) -->
    <partial name="_CustomerBottomNav" />

    <!-- NEW — hidden logout form, submitted from the avatar dropdown. -->
    <form id="logoutForm" method="post" asp-page="/Account/Logout" asp-area="Identity" asp-route-returnUrl="/CustomerFeed">
        @Html.AntiForgeryToken()
    </form>

    @{
        var hasActiveFilters = Model.CategoryId.HasValue || Model.StoreId.HasValue
            || !string.IsNullOrEmpty(Model.Area) || Model.MinPrice.HasValue || Model.MaxPrice.HasValue;
    }

    <div class="app-shell">

        <!-- =====================================================
             LEFT SIDEBAR — logo, primary nav, categories, seller CTA
             (hidden below 992px; bottom tab bar takes over there)
             ===================================================== -->
        <aside class="app-sidebar">

            <a class="app-logo" asp-page="/CustomerFeed">

            </a>

            <!-- CHANGED — "For You" toggle removed; an icon-only back
                 arrow now sits above the nav list so the customer can
                 return to wherever they came from. The nav list itself
                 now matches Customer1's sidebar exactly. -->
            <button type="button" class="app-nav-back-btn" onclick="history.back()" aria-label="Go back">
                <i class="fa-solid fa-arrow-left"></i>
            </button>

            <nav class="app-sidebar-nav" aria-label="Primary">
                <a asp-page="/Customer1" class="app-nav-link">
                    <i class="fa-solid fa-compass"></i> Explore
                </a>
                <a asp-page="/CustomerWishlist" class="app-nav-link">
                    <i class="fa-regular fa-heart"></i> Wishlist
                </a>
                <a asp-page="/CustomerFeed" class="app-nav-link active">
                    <i class="fa-regular fa-bookmark"></i> Following
                </a>
                <a asp-page="/CustomerCart" class="app-nav-link">
                    <i class="fa-solid fa-store"></i> Cart
                </a>
                <a asp-page="/CustomerPromotions" class="app-nav-link">
                    <i class="fa-solid fa-grip"></i> Offers
                </a>
            </nav>

            <div class="app-sidebar-heading">Categories</div>
            <div class="app-sidebar-categories">
                <a asp-page="/CustomerFeed" asp-route-viewMode="@Model.ViewMode"
                   class="app-sidebar-cat @(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                    <i class="fa-solid fa-border-all"></i> All
                </a>
                @foreach (var category in Model.NavbarCategories.Where(c => c != "All"))
                {
                    var isActive = Model.SelectedCategory == category;
                    <a asp-page="/CustomerFeed"
                       asp-route-category="@category"
                       asp-route-viewMode="@Model.ViewMode"
                       class="app-sidebar-cat @(isActive ? "active" : "")">
                        <i class="fa-solid @GetCategoryIcon(category)"></i> @category
                    </a>
                }
            </div>

            <!-- CHANGED — routes to the seller's own dashboard if they
                 already own a store, otherwise to the seller signup /
                 store-request flow (mirrors Customer1). -->
            <div class="app-seller-cta">
                <div class="app-seller-cta-icon">🏬</div>
                <h4>Become a Seller</h4>
                <p>Start your store and reach thousands of customers.</p>
                @if (Model.CustomerHasStore)
                {
                    <a asp-page="/StoreDashboard" class="app-seller-cta-btn">Go to My Store</a>
                }
                else
                {
                    <a asp-page="/StoreRequest" class="app-seller-cta-btn">Get Started</a>
                }
            </div>

        </aside>

        <!-- =====================================================
             MAIN COLUMN — top bar + content + right sidebar
             ===================================================== -->
        <div class="app-main">

            <header class="app-topbar">
                <form method="get" asp-page="/CustomerFeed" class="app-topbar-search">
                    <input type="hidden" name="ViewMode" value="@Model.ViewMode" />
                    <input type="hidden" name="category" value="@Model.SelectedCategory" />
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="feedSearch" name="SearchTerm" value="@Model.SearchTerm"
                           placeholder="Search products or stores..." />
                    <button type="submit"><span>Search</span></button>
                </form>

                <button type="button" class="app-topbar-filters" id="filtersToggle"
                        aria-expanded="@(hasActiveFilters ? "true" : "false")"
                        aria-controls="advancedFilters">
                    <i class="fa-solid fa-sliders"></i> Filters
                </button>

                <!-- CHANGED — Wishlist / Messages / Notifications now route
                     to real pages, and the avatar is a dropdown trigger
                     (My Profile / Logout) instead of a plain link. Matches
                     Customer1's topbar. -->
                <div class="app-topbar-icons">
                    <a asp-page="/CustomerWishlist" class="app-topbar-icon-btn" aria-label="Wishlist">
                        <i class="fa-regular fa-heart"></i>
                    </a>

                    <a asp-page="/Chat" class="app-topbar-icon-btn" aria-label="Messages">
                        <i class="fa-regular fa-comment-dots"></i>
                    </a>

                    <a asp-page="/ReportUpdates" class="app-topbar-icon-btn" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                    </a>

                    <div class="menu-wrap avatar-menu-wrap">
                        <button type="button"
                                class="app-topbar-avatar"
                                id="avatarMenuTrigger"
                                aria-haspopup="true"
                                aria-expanded="false"
                                onclick="event.stopPropagation(); toggleAvatarMenu()"
                                aria-label="Your profile">
                            <i class="fa-solid fa-user"></i>
                        </button>

                        <div class="tile-menu-dropdown avatar-menu-dropdown" id="avatarMenuDropdown">
                            <a asp-page="/CustomerProfile" class="tile-menu-item">
                                <i class="fa-regular fa-user"></i> My Profile
                            </a>

                            <button type="button" class="tile-menu-item danger"
                                    onclick="event.stopPropagation(); document.getElementById('logoutForm').submit();">
                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <div class="app-body">

                <!-- ================================================
                     CENTER CONTENT — categories, tabs, stories,
                     filters, feed
                     ================================================ -->
                <div class="app-content">

                    <!-- Category icon row -->
                    <section class="category-icon-row" aria-label="Browse by category">
                        <a asp-page="/CustomerFeed" asp-route-viewMode="@Model.ViewMode"
                           class="category-icon-chip @(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                            <span class="category-icon-circle"><i class="fa-solid fa-border-all"></i></span>
                            <span class="category-icon-label">All</span>
                        </a>
                        @foreach (var category in Model.NavbarCategories.Where(c => c != "All"))
                        {
                            var isActive = Model.SelectedCategory == category;
                            <a asp-page="/CustomerFeed"
                               asp-route-category="@category"
                               asp-route-viewMode="@Model.ViewMode"
                               class="category-icon-chip @(isActive ? "active" : "")">
                                <span class="category-icon-circle"><i class="fa-solid @GetCategoryIcon(category)"></i></span>
                                <span class="category-icon-label">@category</span>
                            </a>
                        }
                    </section>

                    <!-- REMOVED — "For You" / "All Stores" tabs. -->
                    <!-- Story bar (only if the customer follows stores with active stories) -->
                    @if (Model.FollowedStoryGroups.Any())
                    {
                        <partial name="_StoryBarCustomer" model="Model.FollowedStoryGroups" />
                        <partial name="_StoryViewer" />
                    }

                    <!-- Collapsible advanced filters (search box now lives in the top bar) -->
                    <section class="discovery-bar">
                        <form method="get" asp-page="/CustomerFeed">
                            <input type="hidden" name="ViewMode" value="@Model.ViewMode" />
                            <input type="hidden" name="category" value="@Model.SelectedCategory" />
                            <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />

                            <div class="discovery-filters @(hasActiveFilters ? "" : "is-collapsed")" id="advancedFilters">

                                <div class="discovery-field">
                                    <label for="feedCategory">Category</label>
                                    <select id="feedCategory" name="CategoryId">
                                        <option value="">All categories</option>
                                        @foreach (var filterCategory in Model.FilterCategories)
                                        {
                                            <option value="@filterCategory.CategoryID"
                                                    selected="@(Model.CategoryId == filterCategory.CategoryID ? "selected" : null)">
                                                @filterCategory.CategoryName
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="discovery-field">
                                    <label for="feedStore">Store</label>
                                    <select id="feedStore" name="StoreId">
                                        <option value="">All stores</option>
                                        @foreach (var filterStore in Model.FilterStores)
                                        {
                                            <option value="@filterStore.StoreID"
                                                    selected="@(Model.StoreId == filterStore.StoreID ? "selected" : null)">
                                                @filterStore.StoreName
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="discovery-field">
                                    <label for="feedArea">Area</label>
                                    <select id="feedArea" name="Area">
                                        <option value="">All areas</option>
                                        @foreach (var filterArea in Model.FilterAreas)
                                        {
                                            <option value="@filterArea" selected="@(Model.Area == filterArea ? "selected" : null)">@filterArea</option>
                                        }
                                    </select>
                                </div>

                                <div class="discovery-field">
                                    <label for="feedMinPrice">Price range</label>
                                    <div style="display:flex; gap:6px;">
                                        <input id="feedMinPrice" type="number" min="0" step="0.01"
                                               name="MinPrice" value="@Model.MinPrice" placeholder="Min" />
                                        <input id="feedMaxPrice" type="number" min="0" step="0.01"
                                               name="MaxPrice" value="@Model.MaxPrice" placeholder="Max" />
                                    </div>
                                </div>

                                <div class="discovery-actions">
                                    <span class="discovery-result-note">
                                        @(Model.ShowingAllProducts
                                            ? "Showing products from all approved stores, including stores you do not follow."
                                            : "Showing products from stores you follow.")
                                    </span>
                                    <a asp-page="/CustomerFeed" asp-route-viewMode="@Model.ViewMode" class="discovery-clear">
                                        <i class="fa-solid fa-rotate-left"></i> Clear filters
                                    </a>
                                </div>

                            </div>
                        </form>
                    </section>

                    <!-- =============================================
                         PRODUCT FEED
                         ============================================= -->
                    <div class="feed-container">

                        @if (Model.Products != null && Model.Products.Any())
                        {
                            foreach (var product in Model.Products)
                            {
                                var productImages = (product.Images ?? new List<Multi_Store.Core.Entities.ProductImage>())
                                    .OrderBy(pi => pi.DisplayOrder)
                                    .ToList();
                                var isFollowing = Model.FollowingStoreIds.Contains(product.StoreID);
                                var isBoosted = Model.BoostedProductIds.Contains(product.ProductID);

                                var approvedReviews = (product.Reviews ?? new List<Multi_Store.Core.Entities.Review>())
                                    .Where(r => r.Status == "Approved")
                                    .OrderByDescending(r => r.CreatedAt)
                                    .ToList();
                                var reviewCount = approvedReviews.Count;
                                var avgRating = reviewCount > 0 ? approvedReviews.Average(r => r.Rating) : 0;
                                var fullStars = (int)Math.Round(avgRating);
                                var visibleReviewCount = 2;

                                <article class="post" data-product-id="@product.ProductID" data-product-name="@product.ProductName" data-price="@product.Price">

                                    <!-- Post header: store identity + follow / overflow menu -->
                                    <div class="post-header">

                                        <div class="store-profile">
                                            <div class="store-avatar">
                                                <span>
                                                    @if (!string.IsNullOrEmpty(product.Store?.StoreName))
                                                    {
                                                        @product.Store.StoreName.Substring(0, 1).ToUpper()
                                                    }
                                                    else
                                                    {
                                                        @:S
                                                    }
                                                </span>
                                            </div>
                                            <div class="store-name-row">
                                                <a class="store-name"
                                                   asp-page="/StoreCustomerProfile"
                                                   asp-route-id="@product.StoreID">
                                                    @product.Store?.StoreName
                                                    <i class="fa-solid fa-circle-check" title="Approved store"></i>
                                                    @if (isBoosted)
                                                    {
                                                        <span class="boosted-badge"><i class="fa-solid fa-bolt"></i> Boosted</span>
                                                    }
                                                </a>
                                                <span class="post-timestamp">@GetRelativeTime(product.CreatedAt)</span>
                                            </div>
                                        </div>

                                        <div class="post-header-actions">

                                            @if (isFollowing)
                                            {
                                                <form method="post"
                                                      asp-page-handler="UnfollowStore"
                                                      asp-route-storeId="@product.StoreID"
                                                      style="margin: 0;">
                                                    <button class="btn-follow-action btn-unfollow">Following</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post"
                                                      asp-page-handler="FollowStore"
                                                      asp-route-storeId="@product.StoreID"
                                                      style="margin: 0;">
                                                    <button class="btn-follow-action btn-follow">Follow</button>
                                                </form>
                                            }

                                            <div class="post-menu">
                                                <button type="button" class="post-menu-btn" onclick="toggleMenu(this)" aria-label="More options">
                                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                                </button>

                                                <div class="post-menu-dropdown">
                                                    <form method="post" asp-page-handler="BlockPost">
                                                        <input type="hidden" name="storeId" value="@product.StoreID" />
                                                        <button type="submit">Block Store</button>
                                                    </form>

                                                    <form method="post" asp-page-handler="ReportPost">
                                                        <input type="hidden" name="productId" value="@product.ProductID" />
                                                        <button type="submit">Report</button>
                                                    </form>

                                                    <form method="post" asp-page-handler="NotInterested" class="ajax-not-interested-form">
                                                        <input type="hidden" name="productId" value="@product.ProductID" />
                                                        <button type="submit">Not Interested</button>
                                                    </form>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                    <!-- Post image(s) — swipeable carousel when a product has more than one -->
                                    <div class="post-image-container" data-carousel>
                                        <div class="post-image-track">
                                            @if (productImages.Any())
                                            {
                                                @foreach (var image in productImages)
                                                {
                                                    <div class="post-image-slide">
                                                        <img class="post-image" src="@image.ImageUrl" alt="@product.ProductName" loading="lazy"
                                                             onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="post-image-slide">
                                                    <img class="post-image" src="/images/no-image.png" alt="@product.ProductName" loading="lazy" />
                                                </div>
                                            }
                                        </div>

                                        @if (productImages.Count > 1)
                                        {
                                            <button type="button" class="post-image-nav prev" aria-label="Previous image">
                                                <i class="fa-solid fa-chevron-left"></i>
                                            </button>
                                            <button type="button" class="post-image-nav next" aria-label="Next image">
                                                <i class="fa-solid fa-chevron-right"></i>
                                            </button>

                                            <div class="post-image-dots">
                                                @for (var d = 0; d < productImages.Count; d++)
                                                {
                                                    <span class="post-image-dot @(d == 0 ? "active" : "")"></span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="post-body">

                                        <!-- Product details -->
                                        <div class="product-meta">
                                            <div class="product-title-row">
                                                <span class="product-name">@product.ProductName</span>
                                                <span class="product-price">$@product.Price</span>
                                            </div>
                                            <p class="product-description">@product.Description</p>
                                        </div>

                                        <!-- Shop Now CTA row — CHANGED: posts to this page's own
                                             AddToCart handler, which always redirects to
                                             /CustomerCart instead of bouncing back to Customer1. -->
                                        <div class="post-cta-row">
                                            <form method="post"
                                                  asp-page-handler="AddToCart"
                                                  asp-route-productId="@product.ProductID"
                                                  style="margin: 0;">
                                                <button class="btn-shop-now">Shop Now</button>
                                            </form>
                                        </div>

                                        <!-- Actions: wishlist / comments / share -->
                                        <div class="actions">

                                            <form method="post"
                                                  asp-page-handler="AddWishlist"
                                                  asp-route-productId="@product.ProductID"
                                                  style="margin: 0;">
                                                <button class="btn-action btn-feed-wishlist">
                                                    <i class="fa-regular fa-heart"></i> Wishlist
                                                </button>
                                            </form>

                                            <button type="button" class="btn-action btn-feed-comments" disabled>
                                                <i class="fa-regular fa-comment"></i> @reviewCount
                                            </button>

                                            <div class="menu-wrap feed-share-wrap">
                                                <button type="button" class="btn-action btn-feed-share" onclick="toggleMenu(this)">
                                                    <i class="fa-regular fa-paper-plane"></i> Share
                                                </button>

                                                <div class="dropdown post-menu-dropdown">
                                                    <button type="button" onclick="shareFeedProductWhatsApp(this)">
                                                        <i class="fa-brands fa-whatsapp"></i> Share on WhatsApp
                                                    </button>

                                                    <form method="post" asp-page-handler="ShareToStore"
                                                          asp-route-productId="@product.ProductID"
                                                          asp-route-storeOwnerId="@product.Store.OwnerUserID">
                                                        <button type="submit"><i class="fa-regular fa-message"></i> Send in chat</button>
                                                    </form>

                                                    <button type="button" onclick="copyFeedProductLink(this)">
                                                        <i class="fa-regular fa-copy"></i> Copy link
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="post-menu">
                                                <span></span>
                                            </div>

                                        </div>

                                        <!-- Review summary -->
                                        @if (reviewCount > 0)
                                        {
                                            <div class="product-review-summary">
                                                <strong>@avgRating.ToString("0.0")</strong>
                                                <span>
                                                    <span class="product-review-stars">
                                                        @for (var s = 0; s < 5; s++)
                                                        {
                                                            if (s < fullStars)
                                                            {
                                                                <i class="fa-solid fa-star"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fa-regular fa-star"></i>
                                                            }
                                                        }
                                                    </span>
                                                    <small>@reviewCount review@(reviewCount == 1 ? "" : "s")</small>
                                                </span>
                                            </div>
                                        }

                                        <!-- Review composer -->
                                        <form method="post" asp-page-handler="AddReview" class="product-review-form">
                                            <input type="hidden" name="productId" value="@product.ProductID" />
                                            <input type="hidden" name="rating" value="0" class="product-review-rating-input" />

                                            <span class="product-review-form-label">Write a review</span>

                                            <div class="product-review-form-stars">
                                                <button type="button" class="star-pick" data-star="1" aria-label="1 star">
                                                    <i class="fa-regular fa-star"></i>
                                                </button>
                                                <button type="button" class="star-pick" data-star="2" aria-label="2 stars">
                                                    <i class="fa-regular fa-star"></i>
                                                </button>
                                                <button type="button" class="star-pick" data-star="3" aria-label="3 stars">
                                                    <i class="fa-regular fa-star"></i>
                                                </button>
                                                <button type="button" class="star-pick" data-star="4" aria-label="4 stars">
                                                    <i class="fa-regular fa-star"></i>
                                                </button>
                                                <button type="button" class="star-pick" data-star="5" aria-label="5 stars">
                                                    <i class="fa-regular fa-star"></i>
                                                </button>
                                                <span class="product-review-form-hint">Tap a star</span>
                                            </div>

                                            <div class="product-review-form-row">
                                                <input type="text"
                                                       name="comment"
                                                       class="product-review-comment-input"
                                                       placeholder="Share your thoughts about this product..."
                                                       required />

                                                <button type="submit" class="product-review-submit">
                                                    <i class="fa-solid fa-paper-plane"></i> Post
                                                </button>
                                            </div>
                                        </form>

                                        <!-- Reviews list -->
                                        <div class="comments-section">
                                            @if (reviewCount > 0)
                                            {
                                                <div class="comments-header-label">Reviews (@reviewCount)</div>

                                                <div class="reviews-list" data-reviews-list>
                                                    @for (var i = 0; i < approvedReviews.Count; i++)
                                                    {
                                                        var review = approvedReviews[i];

                                                        <div class="comment @(i >= visibleReviewCount ? "review-hidden" : "")">
                                                            <div class="comment-author-row">
                                                                <div class="comment-author-meta">
                                                                    <span class="comment-author">@review.Customer?.User?.FullName</span>
                                                                    <span class="comment-stars">
                                                                        @for (var s = 0; s < review.Rating; s++)
                                                                        {
                                                                            @:⭐
                                                                        }
                                                                    </span>
                                                                </div>

                                                                @if (review.CustomerID == Model.CurrentCustomerId)
                                                                {
                                                                    <form method="post"
                                                                          asp-page-handler="DeleteReview"
                                                                          class="review-delete-form"
                                                                          onsubmit="return confirm('Delete your review? This cannot be undone.');">
                                                                        <input type="hidden" name="reviewId" value="@review.ReviewID" />
                                                                        <button type="submit" class="review-delete-btn" aria-label="Delete your review" title="Delete your review">
                                                                            <i class="fa-solid fa-trash"></i>
                                                                        </button>
                                                                    </form>
                                                                }
                                                            </div>
                                                            <div class="comment-text">@review.Comment</div>
                                                        </div>
                                                    }
                                                </div>

                                                @if (reviewCount > visibleReviewCount)
                                                {
                                                    <button type="button"
                                                            class="show-more-reviews-btn"
                                                            data-toggle-reviews
                                                            data-expanded="false"
                                                            data-show-label="Show all @reviewCount reviews">
                                                        Show all @reviewCount reviews
                                                    </button>
                                                }
                                            }
                                        </div>

                                    </div>
                                </article>
                            }
                        }
                        else
                        {
                            <div class="empty-message">
                                <div class="empty-icon">
                                    <i class="fa-regular fa-folder-open"></i>
                                </div>
                                <h3>@(Model.ShowingAllProducts ? "No Products Found" : "Your Feed is Empty")</h3>
                                <p>
                                    @(Model.ShowingAllProducts
                                        ? "Try changing the search term or clearing one of the filters."
                                        : "Follow local stores, or open All Products to browse every approved store.")
                                </p>
                            </div>
                        }

                    </div>

                </div>

                <!-- ================================================
                     RIGHT SIDEBAR — real promotion banner, Top Stores,
                     Popular Now (hidden below 992px)
                     ================================================ -->
                <aside class="app-rightbar">

                    <!-- CHANGED — the old hardcoded "Mega Sale / Up to 60%
                         Off" banner now shows a real promotion pulled from
                         the customer's actual PromotionRecipient records
                         (the same source CustomerPromotions.cshtml uses),
                         picking the most relevant unread one first. -->
                    @if (Model.FeaturedPromotion?.Promotion != null)
                    {
                        <div class="promo-banner">
                            <div class="promo-banner-eyebrow">
                                @(Model.FeaturedPromotion.Promotion.Store?.StoreName ?? "Special Offer")
                            </div>
                            <h3>@Model.FeaturedPromotion.Promotion.Title</h3>
                            <p>@Model.FeaturedPromotion.Promotion.Message</p>
                            @if (!string.IsNullOrWhiteSpace(Model.FeaturedPromotion.Promotion.CouponCode))
                            {
                                <p class="promo-banner-code">
                                    Code: <strong>@Model.FeaturedPromotion.Promotion.CouponCode</strong>
                                </p>
                            }
                            <a asp-page="/CustomerPromotions" class="promo-banner-btn">View Offer</a>
                        </div>
                    }
                    else
                    {
                        <div class="promo-banner">
                            <div class="promo-banner-eyebrow">Promotions</div>
                            <h3>Nothing new yet</h3>
                            <p class="promo-banner-empty">Follow local stores to start seeing their offers here.</p>
                            <a asp-page="/CustomerPromotions" class="promo-banner-btn">View Offers</a>
                        </div>
                    }

                    @if (Model.FilterStores.Any())
                    {
                        <div class="widget-card">
                            <div class="widget-card-header">
                                <h4>Top Stores</h4>
                                <a asp-page="/Customer1">View all</a>
                            </div>
                            @foreach (var store in Model.FilterStores.Take(4))
                            {
                                var storeIsFollowing = Model.FollowingStoreIds.Contains(store.StoreID);
                                <div class="top-store-row">
                                    <span class="top-store-avatar">
                                        @(string.IsNullOrEmpty(store.StoreName) ? "S" : store.StoreName.Substring(0, 1).ToUpper())
                                    </span>
                                    <a class="top-store-name" asp-page="/StoreCustomerProfile" asp-route-id="@store.StoreID">
                                        @store.StoreName
                                    </a>
                                    <form method="post"
                                          asp-page-handler="@(storeIsFollowing ? "UnfollowStore" : "FollowStore")"
                                          asp-route-storeId="@store.StoreID"
                                          style="margin:0;">
                                        <button type="submit" class="top-store-follow-btn @(storeIsFollowing ? "is-following" : "")">
                                            @(storeIsFollowing ? "Following" : "Follow")
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }

                    @{
                        var popularProducts = Model.Products
                            .OrderByDescending(p => Model.BoostedProductIds.Contains(p.ProductID))
                            .ThenByDescending(p => p.CreatedAt)
                            .Take(3)
                            .ToList();
                    }
                    @if (popularProducts.Any())
                    {
                        <div class="widget-card">
                            <div class="widget-card-header">
                                <h4>Popular Now</h4>
                            </div>
                            <div class="popular-grid">
                                @foreach (var product in popularProducts)
                                {
                                    var thumb = (product.Images ?? new List<Multi_Store.Core.Entities.ProductImage>())
                                        .OrderBy(pi => pi.DisplayOrder)
                                        .Select(pi => pi.ImageUrl)
                                        .FirstOrDefault() ?? "/images/no-image.png";

                                    <a class="popular-item" asp-page="/StoreCustomerProfile" asp-route-id="@product.StoreID">
                                        <img class="popular-item-img" src="@thumb" alt="@product.ProductName"
                                             onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                        <span>
                                            <span class="popular-item-name">@product.ProductName</span><br />
                                            <span class="popular-item-price">$@product.Price</span>
                                        </span>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                </aside>

            </div>
        </div>
    </div>

    <!-- Page scripts -->
    <script src="~/js/stories.js"></script>
    <script src="~/js/customer-feed.js" asp-append-version="true"></script>

    <script>
            // =====================================================
            // MULTI-IMAGE CAROUSEL — swipe (native scroll-snap) + dot sync
            // + prev/next arrow buttons for products with more than one image.
            // =====================================================
            (function() {
                function initCarousel(container) {
                    var track = container.querySelector('.post-image-track');
                    var dots = Array.from(container.querySelectorAll('.post-image-dot'));
                    var prevBtn = container.querySelector('.post-image-nav.prev');
                    var nextBtn = container.querySelector('.post-image-nav.next');

                    if (!track) return;

                    function updateActiveDot() {
                        if (!dots.length || !track.clientWidth) return;

                        var index = Math.round(track.scrollLeft / track.clientWidth);

                        dots.forEach(function(dot, i) {
                            dot.classList.toggle('active', i === index);
                        });
                    }

                    var scrollTimeout = null;
                    track.addEventListener('scroll', function() {
                        if (scrollTimeout) window.clearTimeout(scrollTimeout);
                        scrollTimeout = window.setTimeout(updateActiveDot, 60);
                    });

                    prevBtn?.addEventListener('click', function() {
                        track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' });
                    });

                    nextBtn?.addEventListener('click', function() {
                        track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
                    });
                }

                document.querySelectorAll('[data-carousel]').forEach(initCarousel);
            })();
    </script>

    <script>
            // =====================================================
            // AVATAR DROPDOWN MENU (My Profile / Logout)
            // =====================================================
            (function() {
                var trigger = document.getElementById('avatarMenuTrigger');
                var dropdown = document.getElementById('avatarMenuDropdown');
                if (!trigger || !dropdown) return;

                window.toggleAvatarMenu = function() {
                    var isOpen = dropdown.classList.contains('open');
                    dropdown.classList.toggle('open', !isOpen);
                    trigger.setAttribute('aria-expanded', (!isOpen).toString());
                };

                document.addEventListener('click', function(event) {
                    if (!dropdown.contains(event.target) && event.target !== trigger) {
                        dropdown.classList.remove('open');
                        trigger.setAttribute('aria-expanded', 'false');
                    }
                });
            })();
    </script>

</body>
</html>

@functions {
    // Maps a category name to a Font Awesome glyph for the sidebar/icon-row.
    // Falls back to a generic tag icon for categories not in this list.
    string GetCategoryIcon(string name)
    {
        return name?.Trim().ToLowerInvariant() switch
        {
            "women" => "fa-person-dress",
            "men" => "fa-person",
            "electronics" => "fa-laptop",
            "shoes" => "fa-shoe-prints",
            "bags" => "fa-bag-shopping",
            "beauty" => "fa-spa",
            "home" => "fa-house",
            "kids" => "fa-child-reaching",
            "accessories" => "fa-glasses",
            "sports" => "fa-dumbbell",
            _ => "fa-tag"
        };
    }

    // Lightweight "2h ago" style relative-time label for post timestamps.
    string GetRelativeTime(DateTime createdAt)
    {
        var span = DateTime.UtcNow - createdAt.ToUniversalTime();
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return createdAt.ToString("MMM d");
    }
}
