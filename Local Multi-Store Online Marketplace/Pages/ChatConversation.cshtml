@page
@model Local_Multi_Store_Online_Marketplace.Pages.ChatConversationModel

@{
    Layout = null;

    var isStoreOwner = User.IsInRole("StoreOwner");
    var isDelivery = User.IsInRole("Delivery");
    var chatRole = isStoreOwner ? "store" : (isDelivery ? "delivery" : "customer");

    var displayName = Model.OtherUser?.FullName
        ?? Model.OtherUser?.UserName
        ?? "User";

    var avatarLetter = !string.IsNullOrWhiteSpace(displayName)
        ? displayName.Substring(0, 1).ToUpper()
        : "U";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chat</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <style>
            :root {
                --bg-color: #faf9fc;
                --card-bg: #ffffff;
                --border-color: #ece8f6;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --error-color: #dc2626;
                --online-color: #10b981;
                --offline-color: #94a3b8;
                --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.05);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.09);
                --shadow-lg: 0 20px 40px rgba(109, 40, 217, 0.14);
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-family);
                background-color: var(--bg-color);
                color: var(--text-primary);
                line-height: 1.5;
                -webkit-font-smoothing: antialiased;
                min-height: 100vh;
                background: linear-gradient(135deg, #f3effe 0%, #faf9fc 45%, #ece8f6 100%);
            }

            .page-shell {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 18px;
            }

            .wrapper {
                width: 100%;
                max-width: 900px;
                height: calc(100vh - 36px);
                display: flex;
                flex-direction: column;
                background: rgba(255, 255, 255, 0.97);
                border: 1px solid var(--border-color);
                border-radius: 28px;
                overflow: hidden;
                box-shadow: var(--shadow-lg);
                backdrop-filter: blur(18px);
            }

            /* HEADER TOPBAR */
            .topbar {
                padding: 18px 26px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid var(--border-color);
                background: rgba(255, 255, 255, 0.95);
                z-index: 10;
            }

            .user {
                display: flex;
                gap: 14px;
                align-items: center;
                min-width: 0;
            }

            .avatar {
                width: 48px;
                height: 48px;
                border-radius: 16px;
                background: var(--accent-gradient);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                font-size: 18px;
                box-shadow: 0 4px 14px rgba(109, 40, 217, 0.28);
                border: 1.5px solid rgba(255, 255, 255, 0.85);
            }

            .user-meta {
                min-width: 0;
            }

            .user-name {
                font-family: 'Playfair Display', Georgia, serif;
                font-weight: 800;
                color: var(--text-primary);
                max-width: 320px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                font-size: 17px;
            }

            .online {
                color: var(--online-color);
                font-size: 12px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 5px;
                margin-top: 2px;
            }

            .offline {
                color: var(--offline-color);
                font-size: 12px;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 5px;
                margin-top: 2px;
            }

            .status-indicator {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: currentColor;
                display: inline-block;
            }

            .delete {
                background: #fff5f5;
                border: 1px solid #ffd1cc;
                color: var(--error-color);
                padding: 10px 18px;
                border-radius: 50px;
                cursor: pointer;
                font-weight: 800;
                font-size: 13px;
                font-family: var(--font-family);
                transition: all 0.2s ease;
            }

                .delete:hover {
                    background: var(--error-color);
                    color: white;
                    border-color: var(--error-color);
                }

            /* MESSAGES STREAM */
            .messages {
                flex: 1;
                padding: 22px;
                overflow: auto;
                background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.06), transparent 38%), radial-gradient(circle at bottom right, rgba(79, 70, 229, 0.06), transparent 38%), var(--bg-color);
            }

            .msg {
                display: flex;
                width: 100%;
            }

            .me {
                justify-content: flex-end;
            }

            .other {
                justify-content: flex-start;
            }

            .bubble {
                max-width: 70%;
                padding: 13px 17px;
                border-radius: 20px;
                font-size: 14px;
                line-height: 1.55;
                word-break: break-word;
                box-shadow: var(--shadow-sm);
            }

            .me .bubble {
                background: var(--accent-gradient);
                color: white;
                border-bottom-right-radius: 4px;
            }

            .other .bubble {
                background: white;
                color: var(--text-primary);
                border: 1px solid var(--border-color);
                border-bottom-left-radius: 4px;
            }

            /* Product bubbles need to sit flush (no colored bubble
                       padding fighting with the card's own background/shadow) */
            .msg .bubble:has(.product-card) {
                background: transparent !important;
                border: none !important;
                box-shadow: none !important;
                padding: 0;
            }

            .time {
                font-size: 10.5px;
                opacity: 0.85;
                margin-top: 7px;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 5px;
            }

            .other .time {
                justify-content: flex-start;
                color: var(--text-secondary);
            }

            .seen-status {
                font-weight: 800;
                font-size: 10.5px;
            }

            .me .seen-status.sent {
                color: rgba(255, 255, 255, 0.72);
            }

            .me .seen-status.seen {
                color: rgba(255, 255, 255, 0.98);
            }

            .delete-message-btn {
                background: none;
                border: none;
                color: rgba(255, 255, 255, 0.65);
                font-size: 10.5px;
                margin-top: 7px;
                cursor: pointer;
                font-weight: 800;
                font-family: var(--font-family);
                text-transform: uppercase;
                letter-spacing: 0.5px;
                transition: color 0.2s ease;
                display: block;
                margin-left: auto;
            }

            .other .delete-message-btn {
                color: var(--error-color);
                margin-left: 0;
                margin-right: auto;
            }

            .me .delete-message-btn:hover {
                color: #ffffff;
            }

            /* ============================================================
                       SHARED PRODUCT CARD — redesigned. Now a distinct, self-
                       contained card (not squeezed inside a message bubble),
                       with a "Shared product" eyebrow badge, bigger image, price
                       pill, and a proper button instead of a bare text link.
                       ============================================================ */
            .product-card {
                background: var(--card-bg);
                border-radius: 20px;
                overflow: hidden;
                width: 290px;
                border: 1px solid var(--border-color);
                color: var(--text-primary);
                box-shadow: var(--shadow-md);
            }

            .product-card-media {
                position: relative;
            }

                .product-card-media img {
                    width: 100%;
                    height: 190px;
                    object-fit: cover;
                    display: block;
                    background: var(--accent-light);
                }

            .product-card-eyebrow {
                position: absolute;
                top: 12px;
                left: 12px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: rgba(30, 27, 46, 0.55);
                backdrop-filter: blur(6px);
                color: #ffffff;
                font-size: 10.5px;
                font-weight: 800;
                letter-spacing: 0.3px;
                text-transform: uppercase;
                padding: 5px 10px;
                border-radius: 50px;
            }

            .product-card-price-badge {
                position: absolute;
                bottom: 12px;
                right: 12px;
                background: var(--accent-gradient);
                color: #ffffff;
                font-weight: 800;
                font-size: 14px;
                padding: 6px 12px;
                border-radius: 50px;
                box-shadow: 0 6px 16px rgba(109, 40, 217, 0.35);
            }

            .product-body {
                padding: 16px;
            }

            .product-title {
                font-weight: 800;
                font-size: 15px;
                margin-bottom: 6px;
                line-height: 1.3;
            }

            .product-price {
                display: none; /* price now lives in the badge over the image */
            }

            .product-desc {
                font-size: 12.5px;
                color: var(--text-secondary);
                line-height: 1.5;
                margin-bottom: 12px;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .product-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                width: 100%;
                padding: 10px 14px;
                background: var(--accent-gradient);
                color: #ffffff !important;
                border-radius: 12px;
                font-weight: 800;
                font-size: 13px;
                text-decoration: none;
                box-shadow: 0 6px 16px rgba(109, 40, 217, 0.22);
                transition: all 0.2s ease;
            }

                .product-link:hover {
                    opacity: 0.95;
                    transform: translateY(-1px);
                    box-shadow: 0 8px 20px rgba(109, 40, 217, 0.3);
                }

                .product-link::after {
                    content: "\2192";
                    font-weight: 900;
                }

            .chat-image {
                max-width: 260px;
                border-radius: 14px;
                display: block;
                box-shadow: var(--shadow-sm);
            }

            .file-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: white;
                color: var(--accent-color);
                padding: 11px 16px;
                border-radius: 12px;
                border: 1px solid var(--border-color);
                font-weight: 800;
                text-decoration: none;
                transition: all 0.2s ease;
                font-size: 13px;
            }

                .file-link:hover {
                    border-color: var(--accent-color);
                    background: var(--accent-light);
                }

            audio {
                max-width: 260px;
                width: 100%;
                border-radius: 50px;
            }

            /* COMPOSER FIELD */
            .composer-area {
                border-top: 1px solid var(--border-color);
                background: #ffffff;
            }

            .attach-preview {
                display: none;
                padding: 11px 20px;
                border-bottom: 1px solid var(--border-color);
                background: var(--accent-light);
                color: var(--accent-color);
                font-size: 13px;
                font-weight: 800;
            }

            .preview-row {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .preview-text {
                flex: 1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .preview-remove {
                background: var(--error-color);
                color: white;
                border: none;
                width: 26px;
                height: 26px;
                flex: 0 0 26px;
                border-radius: 50%;
                cursor: pointer;
                font-weight: 900;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 15px;
                line-height: 1;
                transition: background 0.2s ease, transform 0.2s ease;
            }

                .preview-remove:hover {
                    background: #b91c1c;
                    transform: scale(1.05);
                }

            /* VOICE COMPONENT */
            .voice-panel {
                display: none;
                padding: 13px 20px;
                border-bottom: 1px solid var(--border-color);
                background: #fff5f5;
            }

            .voice-recording-row {
                display: flex;
                align-items: center;
                gap: 12px;
                color: var(--error-color);
                font-weight: 800;
                font-size: 13px;
            }

            .record-dot {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: var(--error-color);
                animation: pulse 1s infinite;
            }

            @@keyframes pulse {
                0% {
                    opacity: 1;
                }

                50% {
                    opacity: 0.35;
                }

                100% {
                    opacity: 1;
                }
            }

            .voice-ready-row {
                display: none;
                align-items: center;
                gap: 12px;
            }

                .voice-ready-row audio {
                    flex: 1;
                    width: 100%;
                }

            /* IOS VIRTUAL KEYBOARD PANEL */
            .ios-keyboard {
                display: none;
                padding: 12px 14px 16px;
                background: var(--accent-light);
                border-bottom: 1px solid var(--border-color);
            }

                .ios-keyboard.show {
                    display: block;
                }

            .suggestions {
                display: flex;
                justify-content: flex-start;
                gap: 8px;
                padding: 12px 20px 12px;
                overflow-x: auto;
                scrollbar-width: none;
                background: #ffffff;
                border-top: 1px solid var(--border-color);
            }

                .suggestions::-webkit-scrollbar {
                    display: none;
                }

            .suggestion-chip {
                flex-shrink: 0;
                height: 34px;
                padding: 0 18px;
                border: 1px solid var(--border-color);
                border-radius: 50px;
                background: #ffffff;
                color: var(--text-primary);
                font-family: var(--font-family);
                font-size: 12.5px;
                font-weight: 700;
                cursor: pointer;
                box-shadow: var(--shadow-sm);
                transition: all 0.2s ease;
                white-space: nowrap;
            }

                .suggestion-chip:hover {
                    background: var(--accent-light);
                    border-color: var(--accent-color);
                    color: var(--accent-color);
                    transform: translateY(-1px);
                }

                .suggestion-chip:active {
                    transform: translateY(0);
                    background: var(--accent-light);
                }

            .key-row {
                display: flex;
                justify-content: center;
                gap: 6px;
                margin-bottom: 8px;
            }

            .middle-row {
                padding: 0 20px;
            }

            .key-btn {
                min-width: 32px;
                flex-grow: 1;
                height: 42px;
                border: none;
                border-radius: 10px;
                background: #ffffff;
                color: var(--text-primary);
                font-family: var(--font-family);
                font-size: 16px;
                font-weight: 700;
                cursor: pointer;
                box-shadow: 0 2px 0 var(--border-color);
                transition: background 0.1s ease, transform 0.1s ease;
            }

                .key-btn:active {
                    background: var(--accent-light);
                    transform: translateY(1px);
                    box-shadow: none;
                }

            .special-key {
                min-width: 54px;
                background: #ded8f0;
                font-size: 13px;
                color: var(--text-primary);
            }

            .space-key {
                flex-grow: 8;
                max-width: 300px;
                font-size: 13px;
            }

            .emoji-key {
                min-width: 44px;
                background: #ded8f0;
                font-size: 16px;
            }

            .bottom-row {
                padding: 0 4px;
            }

            .keyboard-toggle-active {
                background: var(--accent-color) !important;
                color: white !important;
            }

            /* EMOJI COMPONENT */
            .emoji-panel {
                display: none;
                grid-template-columns: repeat(8, 1fr);
                gap: 8px;
                padding: 12px 6px 4px;
                max-height: 180px;
                overflow-y: auto;
                border-top: 1px solid var(--border-color);
                margin-top: 10px;
            }

                .emoji-panel.show {
                    display: grid;
                }

            .emoji-btn {
                height: 38px;
                border: none;
                border-radius: 10px;
                background: #ffffff;
                font-size: 20px;
                cursor: pointer;
                box-shadow: var(--shadow-sm);
                transition: transform 0.1s ease;
            }

                .emoji-btn:active {
                    background: var(--accent-light);
                    transform: translateY(1px);
                }

            /* COMPOSER FORM */
            .composer {
                display: flex;
                padding: 16px 20px;
                gap: 10px;
                align-items: flex-end;
                background: #ffffff;
            }

            .message-input {
                flex: 1;
                min-height: 42px;
                max-height: 98px;
                padding: 11px 18px;
                border-radius: 24px;
                border: 1px solid var(--border-color);
                outline: none;
                resize: none;
                font-size: 14px;
                background: var(--bg-color);
                transition: all 0.25s ease;
                font-family: var(--font-family);
            }

                .message-input:focus {
                    background: white;
                    border-color: var(--accent-color);
                    box-shadow: 0 0 0 4px rgba(109, 40, 217, 0.1);
                }

            .send,
            .icon-btn {
                background: var(--accent-color);
                border: none;
                color: white;
                height: 42px;
                border-radius: 50%;
                cursor: pointer;
                font-weight: 800;
                transition: all 0.2s ease;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .send {
                padding: 0 22px;
                border-radius: 24px;
                box-shadow: 0 8px 18px rgba(109, 40, 217, 0.28);
                font-size: 14px;
                font-family: var(--font-family);
                background: var(--accent-gradient);
            }

                .send:hover {
                    opacity: 0.95;
                    transform: translateY(-1px);
                    box-shadow: 0 10px 22px rgba(109, 40, 217, 0.35);
                }

            .icon-btn:hover {
                background: var(--accent-gradient);
                color: #ffffff;
                border-color: transparent;
            }

            .icon-btn {
                width: 42px;
                padding: 0;
                font-size: 16px;
                box-shadow: var(--shadow-sm);
                background: var(--bg-color);
                color: var(--text-primary);
                border: 1px solid var(--border-color);
            }

                .icon-btn i {
                    font-size: 16px;
                    line-height: 1;
                    pointer-events: none;
                }

            .recording-btn {
                background: var(--error-color) !important;
                color: #ffffff !important;
                border-color: var(--error-color) !important;
            }

            /* =====================================================
                       CHAT TOAST NOTIFICATIONS
                       ===================================================== */

            .chat-toast-container {
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 999999;
                display: flex;
                flex-direction: column;
                gap: 12px;
                pointer-events: none;
            }

            .chat-toast {
                width: min(390px, calc(100vw - 40px));
                padding: 15px 16px;
                border-radius: 15px;
                display: flex;
                align-items: flex-start;
                gap: 12px;
                color: #ffffff;
                font-family: var(--font-family);
                box-shadow: 0 18px 45px rgba(30, 27, 46, 0.28);
                opacity: 0;
                transform: translateX(45px);
                transition: opacity 0.28s ease, transform 0.28s ease;
                pointer-events: auto;
            }

                .chat-toast.show {
                    opacity: 1;
                    transform: translateX(0);
                }

            .chat-toast-error {
                background: linear-gradient(135deg, #b91c1c, #dc2626);
            }

            .chat-toast-warning {
                background: linear-gradient(135deg, #b45309, #d97706);
            }

            .chat-toast-info {
                background: var(--accent-gradient);
            }

            .chat-toast-icon {
                width: 34px;
                height: 34px;
                flex: 0 0 34px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
                font-weight: 900;
            }

            .chat-toast-content {
                flex: 1;
                min-width: 0;
            }

            .chat-toast-title {
                display: block;
                margin-bottom: 3px;
                font-size: 14px;
                font-weight: 900;
            }

            .chat-toast-message {
                display: block;
                font-size: 13px;
                font-weight: 600;
                line-height: 1.5;
            }

            .chat-toast-close {
                border: none;
                background: transparent;
                color: #ffffff;
                padding: 0;
                font-size: 23px;
                line-height: 1;
                cursor: pointer;
            }

            @@media (max-width: 680px) {
                .page-shell {
                    padding: 0;
                }

                .wrapper {
                    height: 100vh;
                    border-radius: 0;
                    max-width: none;
                }

                .bubble {
                    max-width: 84%;
                }

                .send {
                    padding: 0 16px;
                }

                .icon-btn {
                    width: 38px;
                    height: 38px;
                }

                .key-btn {
                    min-width: 25px;
                    height: 38px;
                    font-size: 14px;
                }

                .special-key {
                    min-width: 42px;
                }

                .emoji-panel {
                    grid-template-columns: repeat(7, 1fr);
                }

                .chat-toast-container {
                    top: 12px;
                    right: 12px;
                    left: 12px;
                }

                .chat-toast {
                    width: 100%;
                }
            }
    </style>
</head>
<body data-chat-role="@chatRole">

    <div class="chat-toast-container" id="chatToastContainer"></div>

    <div class="page-shell">

        <div class="wrapper">

            <!-- HEADER TOPBAR -->
            <div class="topbar">

                <div class="user">

                    <div class="avatar">
                        @avatarLetter
                    </div>

                    <div class="user-meta">

                        <div class="user-name">
                            @displayName
                        </div>

                        <div class="@(Model.IsOnlineUser ? "online" : "offline")">
                            <span class="status-indicator"></span>
                            @(Model.IsOnlineUser ? "Online" : "Offline")
                        </div>

                    </div>

                </div>

                <div class="actions">

                    <form method="post" asp-page-handler="DeleteChat" asp-route-userId="@Model.OtherUser?.Id" style="display:inline;">
                        <button type="submit" class="delete" onclick="return confirm('Are you sure you want to delete this conversation? This action cannot be undone.');">
                            Delete
                        </button>
                    </form>

                </div>

            </div>

            <!-- MESSAGES STREAM -->
            <div class="messages" id="messagesBox">

                @foreach (var msg in Model.Messages)
                {
                    <div class="msg @(msg.SenderID == Model.CurrentUserId ? "me" : "other")" style="margin-bottom: 14px;">

                        <div class="bubble">

                            @if (msg.Product != null)
                            {
                                var image =
                                msg.Product.Images?
                                .FirstOrDefault()?
                                .ImageUrl
                                ?? "/images/product-placeholder.svg";

                                <div class="product-card">

                                    <div class="product-card-media">
                                        <img src="@image" alt="Product Image" />

