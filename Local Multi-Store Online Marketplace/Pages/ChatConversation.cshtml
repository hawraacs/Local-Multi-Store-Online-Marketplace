                                        {
                                            <a asp-page="/StoreOwner/Home"
                                               asp-route-productId="@msg.Product.ProductID"
                                               class="product-link">
                                                View Product
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-page="/StoreCustomerProfile"
