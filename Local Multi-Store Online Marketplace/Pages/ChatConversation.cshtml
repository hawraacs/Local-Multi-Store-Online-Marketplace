                    ".suggestion-chip");

            let mediaRecorder;
            let audioChunks = [];
            let isRecording = false;
            let timerInterval;
            let seconds = 0;
            let currentStream = null;
            let cancelVoice = false;

            let uppercaseMode = false;
            let numbersMode = false;

            const letterValues = [
                "q", "w", "e", "r", "t", "y",
                "u", "i", "o", "p",
                "a", "s", "d", "f", "g", "h",
                "j", "k", "l",
                "z", "x", "c", "v", "b", "n", "m"
            ];

            const numberValues = [
                "1", "2", "3", "4", "5", "6",
                "7", "8", "9", "0",
                ".", "?", "!", "#", "$",
                "%", "&", "-",
                "+", "(", ")", "/", "'", ":", ";"
