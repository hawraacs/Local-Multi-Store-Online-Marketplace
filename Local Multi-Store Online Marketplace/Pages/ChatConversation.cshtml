                                               asp-route-productId="@msg.Product.ProductID"
                                               class="product-link">
                                                View Product
                                            </a>
                                        }

                                    </div>

                                </div>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(msg.ImageUrl))
                                {
                                    var lowerUrl =
                                    msg.ImageUrl.ToLower();

                                    if (msg.MessageText == "[VOICE]")
                                    {
                                        <audio src="@msg.ImageUrl" controls></audio>

                                    }
                                    else if (
                                    msg.MessageText == "[IMAGE]" ||
                                    lowerUrl.EndsWith(".jpg") ||
                                    lowerUrl.EndsWith(".jpeg") ||
                                    lowerUrl.EndsWith(".png") ||
                                    lowerUrl.EndsWith(".gif") ||
                                    lowerUrl.EndsWith(".webp"))
                                    {
                                        <img src="@msg.ImageUrl" class="chat-image" alt="Uploaded Image" />

                                        @if (!string.IsNullOrWhiteSpace(msg.MessageText) &&
                                       msg.MessageText != "[IMAGE]")
                                        {
                                            <p style="margin-top: 6px;">
                                                @msg.MessageText
                                            </p>
                                        }
                                    }
                                    else
                                    {
                                        var fileName =
                                        msg.MessageText
                                        .Replace("[FILE]", "")
                                        .Trim();

                                        if (string.IsNullOrWhiteSpace(fileName))
                                        {
                                            fileName = "Download file";
                                        }

