            // =====================================================
            // ROLE-SPECIFIC SUGGESTED MESSAGES
            // Each role gets its own realistic phrase bank + its own
            // default (empty-input) trio of chips. Chosen automatically
            // from the body's data-chat-role attribute set server-side.
            // =====================================================
            const chatRole =
                document.body.getAttribute("data-chat-role") || "customer";

            const suggestionBanks = {
                customer: {
                    defaults: ["hello", "is this available", "how much"],
                    phrases: [
                        "hello",
                        "hi",
                        "how are you",
                        "how much",
                        "how much is delivery",
                        "is this available",
                        "available",
                        "price",
                        "discount",
                        "can you offer a discount",
                        "delivery",
                        "delivery fee",
                        "delivery time",
                        "when will it arrive",
                        "order",
                        "order status",
                        "order number",
                        "my order",
                        "track order",
                        "payment",
                        "cash on delivery",
                        "online payment",
                        "address",
                        "change address",
                        "do you have other sizes",
                        "do you have other colors",
                        "is this authentic",
                        "can I return this",
                        "thank you",
                        "thanks",
                        "okay",
                        "yes",
                        "no",
                        "please",
                        "can you help me",
                        "I want this product",
                        "send me details"
                    ]
                },
                store: {
                    defaults: ["thanks for reaching out", "yes it's available", "here's the price"],
                    phrases: [
                        "thanks for reaching out",
                        "hello, how can I help",
                        "yes it's available",
                        "here's the price",
                        "sorry, that item is out of stock",
                        "we'll have more stock soon",
                        "here's a discount for you",
                        "the delivery fee is",
                        "it usually arrives within",
                        "your order has been confirmed",
                        "your order has shipped",
                        "your order is being prepared",
                        "could you confirm your delivery address",
                        "we accept cash on delivery",
                        "we accept online payment",
                        "sorry for the delay",
                        "thanks for your patience",
                        "let me check and get back to you",
                        "yes, we offer returns",
                        "yes, we have other colors",
                        "yes, we have other sizes",
                        "thank you for your order",
                        "thank you for shopping with us",
                        "is there anything else I can help with",
                        "okay",
                        "yes",
                        "no",
                        "you're welcome"
                    ]
                },
                delivery: {
                    defaults: ["I'm on my way", "I've arrived", "please confirm delivery"],
                    phrases: [
                        "I'm on my way",
                        "I've arrived",
                        "please confirm delivery",
                        "please confirm your address",
                        "running a bit late",
                        "I'm nearby",
                        "could not reach you, please call back",
                        "delivered successfully",
                        "please come down to collect your order",
                        "leaving the package at the door",
                        "do you have exact change",
                        "cash on delivery accepted",
                        "thank you for your order",
                        "have a great day",
                        "okay",
                        "yes",
                        "no",
                        "please",
                        "thank you",
                        "thanks",
                        "sorry for the delay",
                        "on the way now"
                    ]
                }
            };

            const activeBank =
                suggestionBanks[chatRole] || suggestionBanks.customer;

            const smartSuggestions =
                activeBank.phrases;

            if (messagesBox) {
                messagesBox.scrollTop =
                    messagesBox.scrollHeight;
            }

            if (messageInput) {
                messageInput.focus();

                messageInput.addEventListener(
                    "input",
                    function() {
                        resizeMessageInput();
                        updateSmartSuggestions();
                    });

                messageInput.addEventListener(
                    "keydown",
                    function(event) {
                        if (event.key === "Enter" &&
                            !event.shiftKey) {

                            event.preventDefault();

                            if (chatForm) {
                                chatForm.requestSubmit();
                            }
                        }
                    });
            }

            function formatMessageTime(date) {
                const now =
                    new Date();

                const today =
                    new Date(
                        now.getFullYear(),
                        now.getMonth(),
                        now.getDate());

                const messageDay =
                    new Date(
                        date.getFullYear(),
                        date.getMonth(),
                        date.getDate());

                const diffDays =
                    Math.floor(
                        (today - messageDay) /
                        86400000);

                const timeText =
                    date.toLocaleTimeString(
                        [],
                        {
                            hour: "2-digit",
                            minute: "2-digit"
                        });

                if (diffDays === 0) {
                    return "Today " + timeText;
                }

                if (diffDays === 1) {
                    return "Yesterday " + timeText;
                }

                return date.toLocaleDateString(
                    [],
                    {
                        day: "2-digit",
                        month: "short"
                    }) +
                    " " +
                    timeText;
            }

            function updateMessageTimes() {
                const timeElements =
                    document.querySelectorAll(
                        ".message-time");

                timeElements.forEach(
                    function(element) {
                        const utcValue =
                            element.getAttribute(
                                "data-utc");

                        if (!utcValue) {
                            return;
                        }

                        const date =
                            new Date(utcValue);

                        if (isNaN(date.getTime())) {
                            return;
                        }

                        element.innerText =
                            formatMessageTime(date);
                    });
            }

            function resizeMessageInput() {
                if (!messageInput) {
                    return;
                }

                messageInput.style.height =
                    "40px";

                messageInput.style.height =
                    Math.min(
                        messageInput.scrollHeight,
                        98) +
                    "px";
            }

            function updateSmartSuggestions() {
                if (!messageInput ||
                    suggestionChips.length === 0) {
                    return;
                }

                const text =
                    messageInput.value
                        .trim()
                        .toLowerCase();

                const words =
                    text.split(/\s+/);

                const lastWord =
                    words[words.length - 1] || "";

                let results = [];

                if (lastWord.length === 0) {
                    results = activeBank.defaults;
                }
                else {
                    results =
                        smartSuggestions
                            .filter(item =>
                                item
                                    .toLowerCase()
                                    .startsWith(lastWord))
                            .slice(0, 3);
                }

                if (results.length === 0 &&
                    text.length > 0) {

                    results =
                        smartSuggestions
                            .filter(item =>
                                item
                                    .toLowerCase()
                                    .includes(lastWord))
                            .slice(0, 3);
                }

                if (results.length === 0) {
                    results = [
                        "okay",
                        "thanks",
                        "please"
                    ];
                }

                suggestionChips.forEach(
                    function(chip, index) {
                        const value =
                            results[index] || "";

                        if (value) {
                            chip.innerText =
                                value;

                            chip.setAttribute(
                                "data-suggestion",
                                value);

                            chip.style.visibility =
                                "visible";
                        }
                        else {
                            chip.innerText = "";

                            chip.setAttribute(
                                "data-suggestion",
                                "");

                            chip.style.visibility =
                                "hidden";
                        }
                    });
            }

            function insertIntoMessage(text) {
                if (!messageInput || !text) {
                    return;
                }

                const start =
                    messageInput.selectionStart;

                const end =
                    messageInput.selectionEnd;

                const value =
                    messageInput.value;

                messageInput.value =
                    value.substring(0, start) +
                    text +
                    value.substring(end);

                const newPosition =
                    start + text.length;

                messageInput.focus();

                messageInput.setSelectionRange(
                    newPosition,
                    newPosition);

                resizeMessageInput();
                updateSmartSuggestions();
            }

            suggestionChips.forEach(
                function(chip) {
                    chip.addEventListener(
                        "click",
                        function() {
                            const suggestion =
                                chip.getAttribute(
                                    "data-suggestion");

                            if (!suggestion ||
                                !messageInput) {
                                return;
                            }

                            // Populate the suggestion directly into the input
                            messageInput.value = suggestion;

                            // Send immediately by programmatically clicking the "Send" button
                            if (chatForm) {
                                const sendButton = chatForm.querySelector('button[type="submit"]') || chatForm.querySelector('.send');
                                if (sendButton) {
                                    sendButton.click();
                                } else {
                                    chatForm.requestSubmit();
                                }
                            }
                        });
                });

            function backspaceMessage() {
                if (!messageInput) {
                    return;
                }

                const start =
                    messageInput.selectionStart;

                const end =
                    messageInput.selectionEnd;

                const value =
                    messageInput.value;

                if (start !== end) {
                    messageInput.value =
                        value.substring(0, start) +
                        value.substring(end);

                    messageInput.setSelectionRange(
                        start,
                        start);
                }
                else if (start > 0) {
                    messageInput.value =
                        value.substring(0, start - 1) +
                        value.substring(start);

                    messageInput.setSelectionRange(
                        start - 1,
                        start - 1);
                }

                messageInput.focus();
                resizeMessageInput();
                updateSmartSuggestions();
            }

            function setLetterKeyboard() {
                numbersMode = false;

                letterKeys.forEach(
                    function(button, index) {
                        const value =
                            letterValues[index];

                        if (value) {
                            const finalValue =
                                uppercaseMode
                                    ? value.toUpperCase()
                                    : value;

                            button.setAttribute(
                                "data-key",
                                finalValue);

                            button.innerText =
                                finalValue;

                            button.style.visibility =
                                "visible";
                        }
                    });

                if (numbersKey) {
                    numbersKey.innerText =
                        "123";
                }
            }

            function setNumberKeyboard() {
                numbersMode = true;

                letterKeys.forEach(
                    function(button, index) {
                        const value =
                            numberValues[index];

                        if (value) {
                            button.setAttribute(
                                "data-key",
                                value);

                            button.innerText =
                                value;

                            button.style.visibility =
                                "visible";
                        }
                        else {
                            button.style.visibility =
                                "hidden";
                        }
                    });

                if (numbersKey) {
                    numbersKey.innerText =
                        "ABC";
                }
            }

            if (keyboardToggleBtn &&
                iosKeyboard) {

                keyboardToggleBtn.addEventListener(
                    "click",
                    function() {
                        iosKeyboard.classList.toggle(
                            "show");

                        keyboardToggleBtn.classList.toggle(
                            "keyboard-toggle-active");

                        if (messageInput) {
                            messageInput.focus();
                        }
                    });
            }

            keyButtons.forEach(
                function(button) {
                    button.addEventListener(
                        "click",
                        function() {
                            const key =
                                button.getAttribute(
                                    "data-key");

                            insertIntoMessage(key);
                        });
                });

            if (backspaceKey) {
                backspaceKey.addEventListener(
                    "click",
                    backspaceMessage);
            }

            if (spaceKey) {
                spaceKey.addEventListener(
                    "click",
                    function() {
                        insertIntoMessage(" ");
                    });
            }

            if (returnKey) {
                returnKey.addEventListener(
                    "click",
                    function() {
                        insertIntoMessage("\n");
                    });
            }

            if (shiftKey) {
                shiftKey.addEventListener(
                    "click",
                    function() {
                        uppercaseMode =
                            !uppercaseMode;

                        shiftKey.classList.toggle(
                            "keyboard-toggle-active");

                        if (!numbersMode) {
                            setLetterKeyboard();
                        }
                    });
            }

            if (numbersKey) {
                numbersKey.addEventListener(
                    "click",
                    function() {
                        if (numbersMode) {
                            setLetterKeyboard();
                        }
                        else {
                            setNumberKeyboard();
                        }

                        if (emojiPanel) {
                            emojiPanel.classList.remove(
                                "show");
                        }
                    });
            }

            if (emojiKey &&
                emojiPanel) {

                emojiKey.addEventListener(
                    "click",
                    function() {
                        emojiPanel.classList.toggle(
                            "show");

                        if (messageInput) {
                            messageInput.focus();
                        }
                    });
            }

            emojiButtons.forEach(
                function(button) {
                    button.addEventListener(
                        "click",
                        function() {
                            const emoji =
                                button.getAttribute(
                                    "data-emoji");

                            if (emoji) {
                                insertIntoMessage(
                                    emoji);
                            }
                        });
                });

            function showAttachPreview(text) {
                if (attachPreview &&
                    previewText) {

                    attachPreview.style.display =
                        "block";

                    previewText.innerText =
                        text;
                }
            }

            function hideAttachPreview() {
                if (attachPreview &&
                    previewText) {

                    attachPreview.style.display =
                        "none";

                    previewText.innerText =
                        "";
                }
            }

            function clearAttachment() {
                if (attachmentFile) {
                    attachmentFile.value =
                        "";
                }

                hideAttachPreview();

                if (voicePanel) {
                    voicePanel.style.display =
                        "none";
                }

                if (voiceRecordingRow) {
                    voiceRecordingRow.style.display =
                        "none";
                }

                if (voiceReadyRow) {
                    voiceReadyRow.style.display =
                        "none";
                }

                if (voiceAudio) {
                    voiceAudio.removeAttribute(
                        "src");

                    voiceAudio.load();
                }
            }

            if (attachmentFile) {
                attachmentFile.addEventListener(
                    "change",
                    function() {
                        if (this.files &&
                            this.files.length > 0) {

                            if (voicePanel) {
                                voicePanel.style.display =
                                    "none";
                            }

                            showAttachPreview(
                                "Attached: " +
                                this.files[0].name);
                        }
                    });
            }

            if (clearAttachmentBtn) {
                clearAttachmentBtn.addEventListener(
                    "click",
                    clearAttachment);
            }

            if (removeVoiceBtn) {
                removeVoiceBtn.addEventListener(
                    "click",
                    clearAttachment);
            }

            function formatTime(totalSeconds) {
                const minutes =
                    Math.floor(
                        totalSeconds / 60)
                        .toString()
                        .padStart(2, "0");

                const sec =
                    (totalSeconds % 60)
                        .toString()
                        .padStart(2, "0");

                return minutes +
                    ":" +
                    sec;
            }

            function startTimer() {
                seconds = 0;

                if (recordTimer) {
                    recordTimer.innerText =
                        "00:00";
                }

                timerInterval =
                    setInterval(
                        function() {
                            seconds++;

                            if (recordTimer) {
                                recordTimer.innerText =
                                    formatTime(seconds);
                            }
                        },
                        1000);
            }

            function stopTimer() {
                clearInterval(
                    timerInterval);
            }

            function stopMicrophone() {
                if (currentStream) {
                    currentStream
                        .getTracks()
                        .forEach(
                            track =>
                                track.stop());

                    currentStream =
                        null;
                }
            }

            function setRecordButtonNormal() {
                if (!recordBtn) {
                    return;
                }

                recordBtn.innerHTML =
                    '🎤';

                recordBtn.classList.remove(
                    "recording-btn");

                recordBtn.style.background = "";
            }

            function setRecordButtonRecording() {
                if (!recordBtn) {
                    return;
                }

                recordBtn.innerHTML =
                    '⏹';

                recordBtn.classList.add(
                    "recording-btn");

                recordBtn.style.background = "";
            }

            if (recordBtn) {
                recordBtn.addEventListener(
                    "click",
                    async function() {
                        if (!isRecording) {
                            try {
                                clearAttachment();

                                cancelVoice =
                                    false;

                                currentStream =
                                    await navigator
                                        .mediaDevices
                                        .getUserMedia({
                                            audio: true
                                        });

                                mediaRecorder =
                                    new MediaRecorder(
                                        currentStream);

                                audioChunks = [];

                                mediaRecorder.ondataavailable =
                                    function(event) {
                                        if (event.data &&
                                            event.data.size > 0) {

                                            audioChunks.push(
                                                event.data);
                                        }
                                    };

                                mediaRecorder.onstop =
                                    function() {
                                        stopTimer();
                                        stopMicrophone();
                                        setRecordButtonNormal();

                                        isRecording =
                                            false;

                                        if (cancelVoice) {
                                            clearAttachment();
                                            return;
                                        }

                                        if (!audioChunks ||
                                            audioChunks.length === 0) {

                                            clearAttachment();
                                            return;
                                        }

                                        const audioBlob =
                                            new Blob(
                                                audioChunks,
                                                {
                                                    type:
                                                        "audio/webm"
                                                });

                                        const audioFile =
                                            new File(
                                                [audioBlob],
                                                "voice-message.webm",
                                                {
                                                    type:
                                                        "audio/webm"
                                                });

                                        const dataTransfer =
                                            new DataTransfer();

                                        dataTransfer.items.add(
                                            audioFile);

                                        if (attachmentFile) {
                                            attachmentFile.files =
                                                dataTransfer.files;
                                        }

                                        const audioUrl =
                                            URL.createObjectURL(
                                                audioBlob);

                                        if (voiceAudio) {
                                            voiceAudio.src =
                                                audioUrl;

                                            voiceAudio.load();
                                        }

                                        if (voicePanel) {
                                            voicePanel.style.display =
                                                "block";
                                        }

                                        if (voiceRecordingRow) {
                                            voiceRecordingRow.style.display =
                                                "none";
                                        }

                                        if (voiceReadyRow) {
                                            voiceReadyRow.style.display =
                                                "flex";
                                        }

                                        showAttachPreview(
                                            "Voice ready: " +
                                            formatTime(seconds) +
                                            " — press Send.");
                                    };

                                mediaRecorder.start();

                                isRecording =
                                    true;

                                if (voicePanel) {
                                    voicePanel.style.display =
                                        "block";
                                }

                                if (voiceRecordingRow) {
                                    voiceRecordingRow.style.display =
                                        "flex";
                                }

                                if (voiceReadyRow) {
                                    voiceReadyRow.style.display =
                                        "none";
                                }

                                setRecordButtonRecording();
                                startTimer();
                            }
                            catch (error) {
                                console.error(
                                    "Microphone access failed:",
                                    error);

                                showChatToast(
                                    "Please allow microphone access in your browser settings, then try again.",
                                    "error",
                                    "Microphone permission required");
                            }
                        }
                        else {
                            cancelVoice =
                                false;

                            if (mediaRecorder &&
                                mediaRecorder.state !==
                                "inactive") {

                                mediaRecorder.stop();
                            }
                        }
                    });
            }

            if (cancelVoiceBtn) {
                cancelVoiceBtn.addEventListener(
                    "click",
                    function() {
                        cancelVoice =
                            true;

                        if (mediaRecorder &&
                            mediaRecorder.state !==
                            "inactive") {

                            mediaRecorder.stop();
                        }
                        else {
                            clearAttachment();
                            stopTimer();
                            stopMicrophone();
                            setRecordButtonNormal();

                            isRecording =
                                false;
                        }
                    });
            }

            if (chatForm) {
                chatForm.addEventListener(
                    "submit",
                    function(event) {
                        if (isRecording) {
                            event.preventDefault();

                            showChatToast(
                                "Stop the voice recording first, then press Send.",
                                "warning",
                                "Recording is still active");

                            return;
                        }

                        const hasText =
                            messageInput &&
                            messageInput.value &&
                            messageInput.value
                                .trim()
                                .length > 0;

                        const hasFile =
                            attachmentFile &&
                            attachmentFile.files &&
                            attachmentFile.files.length > 0;

                        if (!hasText &&
                            !hasFile) {

                            event.preventDefault();
                            return;
                        }
                    });
            }

            updateMessageTimes();
            updateSmartSuggestions();
    </script>
</body>
</html>