@page "{storeId:int}"
@model Local_Multi_Store_Online_Marketplace.Pages.StoreReviewsModel

@{
    ViewData["Title"] = "Store Reviews";
    Layout = "/Pages/StoreOwner/Shared/_StoreOwnerLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ============================================================
                   ROOT VARIABLES — matching the Promotions page exactly, so
                   this page reads as part of the same design system rather
                   than a one-off purple-gradient banner.
                   ============================================================ */
        :root {
            --accent-color: #6d28d9;
            --accent-hover: #5b21b6;
            --accent-light: #f3effe;
            --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
            --bg-color: #f8f7fc;
            --card-bg: #ffffff;
            --text-primary: #1e1b2e;
            --text-secondary: #6b6478;
            --text-muted: #9691a4;
            --border-color: #ece8f6;
            --star-color: #f59e0b;
            --success-color: #10b981;
            --error-color: #dc2626;
            --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.06);
            --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.10);
            --radius-md: 12px;
            --radius-lg: 20px;
            --transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
            --font-display: 'Fraunces', 'Georgia', serif;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-color);
            color: var(--text-primary);
            -webkit-font-smoothing: antialiased;
        }

        /* ============================================================
                   HEADER
                   ============================================================ */
        .reviews-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

            .reviews-header h2 {
                margin: 0;
                font-family: var(--font-display);
                font-size: 27px;
                font-weight: 600;
                letter-spacing: -0.2px;
                color: var(--text-primary);
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .reviews-header h2 i {
                    color: var(--accent-color);
                }

            .reviews-header p {
                margin: 4px 0 0;
                color: var(--text-secondary);
                font-size: 14px;
            }

        /* ============================================================
                   STATS ROW
                   ============================================================ */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-mini {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 14px 18px;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
            text-align: center;
        }

            .stat-mini:hover {
                border-color: var(--accent-color);
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

            .stat-mini .number {
                font-size: 24px;
                font-weight: 800;
                color: var(--text-primary);
                line-height: 1.2;
            }

            .stat-mini .label {
                font-size: 12px;
                font-weight: 600;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.4px;
            }

            .stat-mini .icon {
                color: var(--accent-color);
                opacity: 0.5;
                font-size: 18px;
                margin-right: 4px;
            }

            .stat-mini.attention .number {
                color: var(--error-color);
            }

        /* ============================================================
                   ALERTS
                   ============================================================ */
        .alert {
            border-radius: var(--radius-md);
            padding: 14px 20px;
            font-weight: 600;
            font-size: 14px;
            border: 1px solid transparent;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-success {
            background: #ecfdf5;
            color: #065f46;
            border-color: #a7f3d0;
        }

            .alert-success i {
                color: var(--success-color);
            }

        /* ============================================================
                   CARD (reviews list wrapper)
                   ============================================================ */
        .table-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: var(--transition);
        }

            .table-card:hover {
                box-shadow: var(--shadow-md);
            }

            .table-card .card-header {
                background: var(--bg-color);
                border-bottom: 1px solid var(--border-color);
                padding: 16px 22px;
                font-weight: 700;
                font-size: 15px;
                color: var(--text-primary);
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .table-card .card-header i {
                    color: var(--accent-color);
                    font-size: 18px;
                }

            .table-card .card-body {
                padding: 0;
            }

        /* ============================================================
                   REVIEW ROWS
                   ============================================================ */
        .review-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            padding: 22px;
            border-bottom: 1px solid var(--border-color);
            transition: background-color 0.2s ease;
        }

            .review-row:last-child {
                border-bottom: none;
            }

            .review-row:hover {
                background-color: var(--accent-light);
            }

        .review-row-main {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            min-width: 0;
            flex: 1;
        }

        .customer-avatar {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: var(--accent-gradient);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            box-shadow: 0 4px 10px rgba(109, 40, 217, 0.2);
            flex-shrink: 0;
        }

        .review-row-content {
            min-width: 0;
            flex: 1;
        }

        .review-row-head {
            display: flex;
            align-items: baseline;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 4px;
        }

        .customer-name {
            font-weight: 700;
            color: var(--text-primary);
            text-decoration: none;
            font-size: 15px;
            transition: var(--transition);
        }

            .customer-name:hover {
                color: var(--accent-color);
            }

        .review-date {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .stars-container {
            display: flex;
            gap: 2px;
            color: var(--star-color);
            font-size: 13px;
            margin-bottom: 8px;
        }

        .review-comment {
            color: var(--text-secondary);
            line-height: 1.6;
            font-size: 14.5px;
            margin: 0;
        }

        /* ----- Delete button — same circular icon-only style used for
                   deleting a Promotion, for visual consistency across the
                   store-owner section. ----- */
        .btn-delete-review {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: none;
            background: #fee2e2;
            color: #dc2626;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            flex-shrink: 0;
        }

            .btn-delete-review:hover {
                background: #dc2626;
                color: white;
                transform: translateY(-2px);
            }

            .btn-delete-review i {
                font-size: 14px;
            }

        /* ----- "View N older reviews" — hides everything past the 5th
                   review by default; the button reveals them via JS. ----- */
        .extra-review {
            display: none;
        }

        .view-older-btn {
            display: block;
            width: 100%;
            padding: 14px;
            background: var(--bg-color);
            border: none;
            border-top: 1px solid var(--border-color);
            color: var(--accent-color);
            font-family: 'Inter', sans-serif;
            font-weight: 700;
            font-size: 13.5px;
            cursor: pointer;
            transition: var(--transition);
        }

            .view-older-btn:hover {
                background: var(--accent-light);
            }


        /* ============================================================
                   EMPTY STATE — identical pattern to Promotions' empty state
                   ============================================================ */
        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: var(--text-secondary);
        }

            .empty-state i {
                font-size: 36px;
                color: var(--accent-color);
                opacity: 0.3;
                margin-bottom: 12px;
                display: block;
            }

            .empty-state h4 {
                font-family: var(--font-display);
                font-size: 19px;
                font-weight: 600;
                color: var(--text-primary);
                margin: 0 0 4px;
            }

            .empty-state p {
                margin: 0;
                font-size: 14px;
            }

        /* ============================================================
                   ACCESSIBILITY
                   ============================================================ */
        a:focus-visible,
        button:focus-visible {
            outline: 2px solid var(--accent-color);
            outline-offset: 2px;
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition-duration: 0.001ms !important;
            }
        }

        /* ============================================================
                   RESPONSIVE
                   ============================================================ */
        @@media (max-width: 768px) {
            .reviews-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .stats-row {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .stat-mini .number {
                font-size: 20px;
            }

            .review-row {
                padding: 16px;
            }
        }

        @@media (max-width: 480px) {
            .stats-row {
                grid-template-columns: 1fr 1fr;
            }

            .review-row-main {
                gap: 10px;
            }

            .customer-avatar {
                width: 38px;
                height: 38px;
                font-size: 14px;
            }
        }
    </style>
}

<div class="container mt-4">

    <!-- ========== HEADER ========== -->
    <div class="reviews-header">
        <div>
            <h2><i class="fas fa-comments"></i> Customer Feedback</h2>
            <p>Monitor and manage your store's reputation.</p>
        </div>
    </div>

    <!-- ========== STATS ROW ========== -->
    @{
        var totalReviews = Model.Reviews.Count;
        var avgRating = Model.Reviews.Any()
            ? Model.Reviews.Average(r => r.Rating).ToString("F1")
            : "0.0";
        var positiveCount = Model.Reviews.Count(r => r.Rating >= 4);
        var attentionCount = Model.Reviews.Count(r => r.Rating <= 2);
    }

    <div class="stats-row">
        <div class="stat-mini">
            <span class="icon"><i class="fas fa-comments"></i></span>
            <div class="number">@totalReviews</div>
            <div class="label">Total Reviews</div>
        </div>
        <div class="stat-mini">
            <span class="icon"><i class="fas fa-star"></i></span>
            <div class="number">@avgRating</div>
            <div class="label">Avg. Rating</div>
        </div>
        <div class="stat-mini">
            <span class="icon"><i class="fas fa-thumbs-up"></i></span>
            <div class="number">@positiveCount</div>
            <div class="label">4–5 Star</div>
        </div>
        <div class="stat-mini attention">
            <span class="icon"><i class="fas fa-triangle-exclamation"></i></span>
            <div class="number">@attentionCount</div>
            <div class="label">1–2 Star</div>
        </div>
    </div>

    <!-- ========== TEMPDATA ALERT ========== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- ========== REVIEWS CARD ========== -->
    <div class="table-card">
        <div class="card-header">
            <i class="fas fa-comments"></i> Customer Reviews
        </div>
        <div class="card-body">
            @if (!Model.Reviews.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-comment-slash"></i>
                    <h4>No Reviews Yet</h4>
                    <p>Customer feedback will appear here once orders are completed.</p>
                </div>
            }
            else
            {
                int reviewIndex = 0;
                @foreach (var r in Model.Reviews)
                {
                    var fullName = r.Customer?.User?.FullName;
                    var userName = r.Customer?.User?.UserName;
                    var customerName = !string.IsNullOrWhiteSpace(fullName)
                        ? fullName
                        : (!string.IsNullOrWhiteSpace(userName) ? userName : "Verified Customer");
                    var initial = customerName.Length > 0 ? customerName.Substring(0, 1).ToUpper() : "?";
                    var extraClass = reviewIndex >= 5 ? "extra-review" : "";

                    <div class="review-row @extraClass">
                        <div class="review-row-main">
                            <div class="customer-avatar">@initial</div>
                            <div class="review-row-content">
                                <div class="review-row-head">
                                    <a asp-page="/StoreViewCustomer" asp-route-customerId="@r.CustomerID" class="customer-name">
                                        @customerName
                                    </a>
                                    <span class="review-date">@r.CreatedAt.ToString("MMMM dd, yyyy")</span>
                                </div>

                                <div class="stars-container">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        if (i < r.Rating)
                                        {
                                            <i class="fa-solid fa-star"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-regular fa-star" style="opacity: 0.3;"></i>
                                        }
                                    }
                                </div>

                                <p class="review-comment">@r.Comment</p>
                            </div>
                        </div>

                        <form method="post" asp-page-handler="Delete">
                            <input type="hidden" name="reviewId" value="@r.ReviewID" />
                            <button type="submit" class="btn-delete-review" title="Delete review">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </form>
                    </div>
                    reviewIndex++;
                }

                @if (Model.Reviews.Count > 5)
                {
                    <button type="button" class="view-older-btn" data-more-label="View @(Model.Reviews.Count - 5) older review@(Model.Reviews.Count - 5 == 1 ? "" : "s")" onclick="toggleOlderReviews(this)">
                        View @(Model.Reviews.Count - 5) older review@(Model.Reviews.Count - 5 == 1 ? "" : "s")
                    </button>
                }
            }
        </div>
    </div>

</div>

<script>
    function toggleOlderReviews(button) {
        var card = button.closest('.table-card');
        if (!card) return;

        var isExpanded = button.dataset.expanded === 'true';

        card.querySelectorAll('.extra-review').forEach(function(row) {
            row.style.display = isExpanded ? 'none' : 'flex';
        });

        button.dataset.expanded = isExpanded ? 'false' : 'true';
        button.textContent = isExpanded ? button.dataset.moreLabel : 'Show fewer reviews';
    }
</script>
