@page
@model Local_Multi_Store_Online_Marketplace.Pages.InvoiceModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice</title>

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --accent: #7C5CFA;
            --accent-dark: #5B3FD9;
            --accent-darker: #3B2A80;
            --bg-tint: #F6F4FF;
            --card-border: #ECE8FB;
            --text-main: #1F2937;
            --text-muted: #6B7280;
            --success-bg: #E8FBF0;
            --success-text: #16A34A;
            --success-border: #BBF3D3;
            --pending-bg: #FFF6E5;
            --pending-text: #B45309;
            --pending-border: #FCE3AE;
        }

        body {
            margin: 0;
            background: radial-gradient(circle at top right, rgba(124, 92, 250, 0.14), transparent 40%), linear-gradient(160deg, #FAF9FF 0%, #F1EDFE 100%);
            font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
            color: var(--text-main);
        }

        .invoice-page {
            padding: 48px 22px;
            min-height: 100vh;
        }

        .invoice-box {
            max-width: 980px;
            margin: auto;
            background: white;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(91, 63, 217, 0.14), 0 4px 12px rgba(31, 41, 55, 0.04);
            border: 1px solid var(--card-border);
        }

        .top-band {
            background: linear-gradient(120deg, #3B2A80 0%, #5B3FD9 55%, #7C5CFA 100%);
            color: white;
            padding: 34px 38px;
            display: flex;
            justify-content: space-between;
            gap: 20px;
            align-items: flex-start;
            position: relative;
            overflow: hidden;
        }

            .top-band::after {
                content: "";
                position: absolute;
                right: -60px;
                top: -80px;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.06);
            }

        .brand-block {
            display: flex;
            align-items: center;
            gap: 14px;
            position: relative;
            z-index: 1;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .brand-logo svg {
                width: 24px;
                height: 24px;
            }

        .brand-title {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.2px;
        }

        .brand-subtitle {
            margin-top: 3px;
            color: rgba(255, 255, 255, 0.75);
            font-weight: 500;
            font-size: 13px;
        }

        .invoice-label {
            text-align: right;
            position: relative;
            z-index: 1;
        }

            .invoice-label h1 {
                margin: 0;
                font-size: 32px;
                font-weight: 800;
                letter-spacing: 2px;
            }

            .invoice-label .invoice-number {
                color: rgba(255, 255, 255, 0.8);
                font-weight: 700;
                font-size: 13px;
                letter-spacing: 0.5px;
                margin-top: 4px;
            }

        .content {
            padding: 34px 38px 38px;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 26px;
        }

        .info-card {
            background: var(--bg-tint);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 20px 22px;
            transition: box-shadow 0.2s ease, transform 0.2s ease;
        }

            .info-card:hover {
                box-shadow: 0 12px 28px rgba(91, 63, 217, 0.10);
                transform: translateY(-2px);
            }

            .info-card h3 {
                margin: 0 0 14px 0;
                font-size: 15px;
                font-weight: 700;
                color: var(--accent-darker);
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .info-card h3 svg {
                    width: 17px;
                    height: 17px;
                    color: var(--accent);
                }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            border-bottom: 1px solid var(--card-border);
            padding: 10px 0;
            color: var(--text-muted);
            font-size: 13.5px;
        }

            .info-row:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

            .info-row strong {
                color: var(--text-main);
                font-weight: 600;
                text-align: right;
            }

        .badge {
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 11.5px;
            font-weight: 700;
            display: inline-block;
            letter-spacing: 0.2px;
        }

        .paid {
            color: var(--success-text);
            background: var(--success-bg);
            border: 1px solid var(--success-border);
        }

        .pending {
            color: var(--pending-text);
            background: var(--pending-bg);
            border: 1px solid var(--pending-border);
        }

        .status-delivered {
            color: #1D4ED8;
            background: #EAF0FE;
            border: 1px solid #C7D8FC;
        }

        .status-pending {
            color: var(--pending-text);
            background: var(--pending-bg);
            border: 1px solid var(--pending-border);
        }

        .status-cancelled {
            color: #B91C1C;
            background: #FDEAEA;
            border: 1px solid #F6C4C4;
        }

        .status-processing,
        .status-shipped {
            color: var(--accent-dark);
            background: #F0ECFE;
            border: 1px solid #DCD2FC;
        }

        .items-section {
            margin-top: 28px;
            border: 1px solid var(--card-border);
            border-radius: 18px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: var(--bg-tint);
            color: var(--accent-darker);
            text-align: left;
            padding: 15px 16px;
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.3px;
            text-transform: uppercase;
            border-bottom: 1px solid var(--card-border);
        }

        td {
            padding: 15px 16px;
            border-bottom: 1px solid #F3F1FC;
            color: var(--text-muted);
            font-size: 14px;
        }

        tbody tr {
            transition: background 0.15s ease;
        }

            tbody tr:hover {
                background: #FBFAFF;
            }

            tbody tr:nth-child(even) {
                background: #FCFBFF;
            }

                tbody tr:nth-child(even):hover {
                    background: #F8F6FF;
                }

        tr:last-child td {
            border-bottom: none;
        }

        .product-name {
            font-weight: 700;
            color: var(--text-main);
        }

        .totals-wrap {
            display: flex;
            justify-content: flex-end;
            margin-top: 26px;
        }

        .totals {
            width: 360px;
            background: white;
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 20px 22px;
            box-shadow: 0 14px 34px rgba(91, 63, 217, 0.08);
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 9px 0;
            font-weight: 500;
            color: var(--text-muted);
            font-size: 14px;
        }

        .totals-divider {
            border: none;
            border-top: 1px solid var(--card-border);
            margin: 8px 0;
        }

        .grand-total {
            background: var(--bg-tint);
            border-radius: 12px;
            padding: 12px 14px;
            margin-top: 6px;
            font-size: 20px;
            font-weight: 800;
            color: var(--accent-darker);
        }

        .footer-note {
            margin-top: 26px;
            background: var(--bg-tint);
            border: 1px solid var(--card-border);
            color: var(--accent-darker);
            padding: 16px 18px;
            border-radius: 16px;
            font-weight: 600;
            font-size: 13px;
            line-height: 1.5;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

            .footer-note svg {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                margin-top: 1px;
                color: var(--accent);
            }

        .actions {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-top: 28px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 13px 22px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
        }

            .btn svg {
                width: 16px;
                height: 16px;
            }

        .btn-back {
            background: white;
            color: var(--accent-dark);
            border: 1.5px solid var(--accent);
        }

            .btn-back:hover {
                background: var(--bg-tint);
                transform: translateY(-1px);
            }

        .btn-print {
            background: linear-gradient(120deg, var(--accent-dark), var(--accent));
            color: white;
            box-shadow: 0 12px 26px rgba(124, 92, 250, 0.32);
        }

            .btn-print:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 32px rgba(124, 92, 250, 0.4);
            }

        .error-box {
            max-width: 700px;
            margin: 60px auto;
            background: white;
            color: #B91C1C;
            border: 1px solid #F6C4C4;
            padding: 28px;
            border-radius: 20px;
            text-align: center;
            font-weight: 700;
            box-shadow: 0 20px 50px rgba(91, 63, 217, 0.10);
        }

            .error-box .btn {
                margin-top: 18px;
                display: inline-flex;
            }

        @@media print {
            body {
                background: white;
            }

            .invoice-page {
                padding: 0;
            }

            .invoice-box {
                box-shadow: none;
                border: none;
                border-radius: 0;
            }

            .actions {
                display: none;
            }
        }

        @@media (max-width: 750px) {
            .top-band {
                flex-direction: column;
            }

            .invoice-label {
                text-align: left;
            }

            .meta-grid {
                grid-template-columns: 1fr;
            }

            .items-section {
                overflow-x: auto;
            }

            table {
                min-width: 700px;
            }

            .totals {
                width: 100%;
            }

            .actions {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>
    <div class="invoice-page">
        @if (Model.Order == null)
        {
            <div class="error-box">
                Invoice not found or you are not allowed to view it.
                <br />
                <a href="/CustomerOrders" class="btn btn-back">Back to Orders</a>
            </div>
        }
        else
        {
            var paymentClass = Model.Order.PaymentStatus == "Paid" ? "paid" : "pending";
            var statusClass = Model.Order.Status?.ToLower() switch
            {
                "delivered" => "status-delivered",
                "cancelled" => "status-cancelled",
                "processing" => "status-processing",
                "shipped" => "status-shipped",
                _ => "status-pending"
            };

            <div class="invoice-box">
                <div class="top-band">
                    <div class="brand-block">
                        <div class="brand-logo">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                        </div>
                        <div>
                            <div class="brand-title">Local Multi Store</div>
                            <div class="brand-subtitle">Online Marketplace Invoice</div>
                        </div>
                    </div>

                    <div class="invoice-label">
                        <h1>INVOICE</h1>
                        <div class="invoice-number">INV-@Model.Order.OrderID</div>
                    </div>
                </div>

                <div class="content">
                    <div class="meta-grid">
                        <div class="info-card">
                            <h3>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                Customer Details
                            </h3>

                            <div class="info-row">
                                <span>Name</span>
                                <strong>@Model.CustomerName</strong>
                            </div>

                            <div class="info-row">
                                <span>Delivery Address</span>
                                <strong>@Model.AddressText</strong>
                            </div>

                            <div class="info-row">
                                <span>Payment Method</span>
                                <strong>@Model.Order.PaymentMethod</strong>
                            </div>

                            <div class="info-row">
                                <span>Payment Status</span>
                                <strong><span class="badge @paymentClass">@Model.Order.PaymentStatus</span></strong>
                            </div>
                        </div>

                        <div class="info-card">
                            <h3>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6l1 4H8l1-4Z"></path><path d="M4 7h16l-1.2 13.1a2 2 0 0 1-2 1.9H7.2a2 2 0 0 1-2-1.9L4 7Z"></path></svg>
                                Order Details
                            </h3>

                            <div class="info-row">
                                <span>Order Number</span>
                                <strong>@Model.Order.OrderNumber</strong>
                            </div>

                            <div class="info-row">
                                <span>Order Date</span>
                                <strong>@Model.Order.OrderDate.ToString("dd MMM yyyy HH:mm")</strong>
                            </div>

                            <div class="info-row">
                                <span>Order Status</span>
                                <strong><span class="badge @statusClass">@Model.Order.Status</span></strong>
                            </div>

                            <div class="info-row">
                                <span>Invoice Number</span>
                                <strong>INV-@Model.Order.OrderID</strong>
                            </div>
                        </div>
                    </div>

                    <div class="items-section">
                        <table>
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Unit Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Order.OrderItems)
                                {
                                    <tr>
                                        <td class="product-name">@item.ProductName</td>
                                        <td>$@item.ProductPrice.ToString("N2")</td>
                                        <td>@item.Quantity</td>
                                        <td>$@item.TotalPrice.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="totals-wrap">
                        <div class="totals">
                            <div class="total-row">
                                <span>Subtotal</span>
                                <span>$@Model.Order.Subtotal.ToString("N2")</span>
                            </div>

                            <div class="total-row">
                                <span>Delivery Fee</span>
                                <span>$@Model.Order.DeliveryFee.ToString("N2")</span>
                            </div>

                            <div class="total-row">
                                <span>Discount</span>
                                <span>-$@Model.Order.DiscountAmount.ToString("N2")</span>
                            </div>

                            <div class="total-row">
                                <span>Tax</span>
                                <span>$@Model.Order.TaxAmount.ToString("N2")</span>
                            </div>

                            <hr class="totals-divider" />

                            <div class="total-row grand-total">
                                <span>Total</span>
                                <span>$@Model.Order.TotalAmount.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <div class="footer-note">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                        <span>This invoice was generated automatically after successful payment or completed delivery.</span>
                    </div>

                    <div class="actions">
                        <a href="/CustomerOrders" class="btn btn-back">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
                            Back to Orders
                        </a>
                        <button type="button" class="btn btn-print" onclick="window.print()">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 14h12v8H6z"></path></svg>
                            Print Invoice
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</body>
</html>
