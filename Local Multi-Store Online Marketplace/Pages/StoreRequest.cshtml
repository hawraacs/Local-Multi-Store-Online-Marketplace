@page "/StoreRequest"
@model Local_Multi_Store_Online_Marketplace.Pages.StoreRequestModel
@using System.Text.Json

@{
    Layout = null;

    var pageTitle =
        Model.IsResubmission
            ? "Update and Resubmit Store Request"
            : "Request to Become a Store Owner";

    var toastMessages =
        new List<Dictionary<string, string>>();

    if (TempData["Error"] is string errorMessage &&
        !string.IsNullOrWhiteSpace(errorMessage))
    {
        toastMessages.Add(
            new Dictionary<string, string>
            {
                ["type"] = "error",
                ["message"] = errorMessage
            });
    }

    if (TempData["Success"] is string successMessage &&
        !string.IsNullOrWhiteSpace(successMessage))
    {
        toastMessages.Add(
            new Dictionary<string, string>
            {
                ["type"] = "success",
                ["message"] = successMessage
            });
    }

    foreach (var modelStateEntry in
             ViewData.ModelState.Values)
    {
        foreach (var modelError in
                 modelStateEntry.Errors)
        {
            var message =
                !string.IsNullOrWhiteSpace(
                    modelError.ErrorMessage)
                    ? modelError.ErrorMessage
                    : "Please check the submitted information.";

            if (!toastMessages.Any(x =>
                    x["message"] == message))
            {
                toastMessages.Add(
                    new Dictionary<string, string>
                    {
                        ["type"] = "error",
                        ["message"] = message
                    });
            }
        }
    }

    var isPhoneAlreadyVerified =
        Model.IsPhoneVerified &&
        string.Equals(
            Model.VerifiedPhoneNumber,
            Model.Input.PhoneNumber,
            StringComparison.Ordinal);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle | realnest</title>

    <!-- Google Fonts (matches Login / Delivery Request page) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap"
          rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
            /* ============================================================
                                   ROOT VARIABLES — same palette as the Login / Delivery page
                                   ============================================================ */
            :root {
                /* -------- Brand colors (Purple / Indigo) -------- */
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-steel: #4f46e5;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                /* -------- Neutral palette -------- */
                --bg-color: #f8f7fc;
                --card-bg: #ffffff;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                --text-muted: #9691a4;
                --border-color: #ece8f6;
                --input-bg: #f8f7fc;
                /* -------- Semantic -------- */
                --success-color: #10b981;
                --error-color: #dc2626;
                /* -------- Shadows -------- */
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.06);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.10);
                --shadow-lg: 0 20px 50px rgba(30, 27, 46, 0.18);
                /* -------- Typography -------- */
                --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: var(--font-family);
                background: var(--bg-color);
                background-image: radial-gradient(circle at 15% 0%, rgba(109, 40, 217, 0.05), transparent 40%);
                color: var(--text-primary);
            }

            .page-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                padding: 50px 15px 60px;
            }

            .card {
                background: var(--card-bg);
                width: 900px;
                max-width: 100%;
                padding: 42px 44px;
                border-radius: 22px;
                box-shadow: var(--shadow-lg);
                border: 1px solid var(--border-color);
            }

            /* -------- Header -------- */
            .header-box {
                margin-bottom: 32px;
                padding-bottom: 24px;
                border-bottom: 1px solid var(--border-color);
            }

                .header-box h2 {
                    margin: 0 0 10px;
                    font-size: 26px;
                    font-weight: 800;
                    letter-spacing: -0.4px;
                    color: var(--accent-color);
                    display: flex;
                    align-items: center;
                    gap: 12px;
                }

                .header-box .header-icon {
                    font-size: 20px;
                    width: 42px;
                    height: 42px;
                    flex-shrink: 0;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 12px;
                    background: var(--accent-light);
                    color: var(--accent-color);
                }

                .header-box p {
                    margin: 0;
                    color: var(--text-secondary);
                    font-size: 13px;
                    line-height: 1.7;
                    max-width: 620px;
                }

            /* -------- Section blocks (organization) -------- */
            .form-section {
                margin-bottom: 28px;
                padding-bottom: 26px;
                border-bottom: 1px solid var(--border-color);
            }

                .form-section:last-of-type {
                    border-bottom: none;
                    margin-bottom: 0;
                    padding-bottom: 0;
                }

            .section-heading {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 18px;
            }

                .section-heading .step-num {
                    width: 26px;
                    height: 26px;
                    flex-shrink: 0;
                    border-radius: 50%;
                    background: var(--accent-light);
                    color: var(--accent-color);
                    font-size: 13px;
                    font-weight: 800;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .section-heading h3 {
                    margin: 0;
                    font-size: 15px;
                    font-weight: 700;
                    color: var(--text-primary);
                    letter-spacing: 0.2px;
                }

                .section-heading .section-icon {
                    color: var(--accent-color);
                    font-size: 14px;
                }

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 18px;
            }

            .form-group {
                width: 100%;
            }

                .form-group.full {
                    grid-column: 1 / -1;
                }

            label {
                display: block;
                margin-bottom: 7px;
                font-size: 13px;
                font-weight: 600;
                color: var(--text-primary);
                letter-spacing: 0.2px;
            }

            input,
            select,
            textarea {
                width: 100%;
                padding: 13px 16px;
                border: 1.5px solid var(--border-color);
                border-radius: 14px;
                outline: none;
                font-family: var(--font-family);
                font-size: 14px;
                background: var(--input-bg);
                color: var(--text-primary);
                transition: all 0.2s ease;
            }

            textarea {
                min-height: 105px;
                resize: vertical;
            }

                input:focus,
                select:focus,
                textarea:focus {
                    border-color: var(--accent-color);
                    box-shadow: 0 0 0 4px rgba(109, 40, 217, 0.10);
                    background: #ffffff;
                }

                input::placeholder,
                textarea::placeholder {
                    color: var(--text-muted);
                }

            .hint {
                display: block;
                margin-top: 6px;
                font-size: 12px;
                color: var(--text-muted);
                line-height: 1.5;
            }

            .existing-file {
                margin-top: 8px;
                padding: 10px 14px;
                background: var(--accent-light);
                border: 1px solid #ddd6fe;
                border-radius: 12px;
                font-size: 13px;
                color: var(--accent-hover);
            }

                .existing-file a {
                    color: var(--accent-color);
                    font-weight: 700;
                }

            /* -------- Validation -------- */
            .validation-box,
            .validation-summary-errors {
                color: #991b1b;
                background: #fef2f2;
                border: 1px solid #fecaca;
                padding: 13px 16px;
                border-radius: 12px;
                margin-bottom: 20px;
                font-size: 13px;
                font-weight: 600;
                line-height: 1.5;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 20px;
                }

            .validation-summary-valid,
            .field-validation-valid {
                display: none;
            }

            .field-validation-error {
                display: block;
                margin-top: 5px;
                color: var(--error-color);
                font-size: 12px;
                font-weight: 600;
            }

            /* -------- OTP -------- */
            .otp-section {
                margin-top: 12px;
            }

            .otp-btn {
                padding: 11px 16px;
                border: none;
                border-radius: 12px;
                background: var(--accent-gradient);
                color: white;
                font-weight: 700;
                font-size: 13px;
                cursor: pointer;
                font-family: var(--font-family);
                box-shadow: 0 4px 16px rgba(109, 40, 217, 0.2);
                transition: all 0.2s ease;
            }

                .otp-btn:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 6px 20px rgba(109, 40, 217, 0.3);
                }

                .otp-btn:disabled {
                    opacity: .6;
                    cursor: not-allowed;
                    transform: none;
                }

            .otp-code-group {
                display: none;
                gap: 10px;
                margin-top: 12px;
                align-items: center;
            }

            .otp-code-input {
                width: auto;
                flex: 1;
            }

            .otp-status {
                margin-top: 8px;
            }

                .otp-status.verified {
                    color: var(--success-color);
                    font-weight: 700;
                }

            /* -------- Location / Map -------- */
            .location-panel {
                background: var(--input-bg);
                border: 1.5px solid var(--border-color);
                border-radius: 16px;
                padding: 18px;
            }

            .location-actions {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
                margin-bottom: 14px;
            }

            .map-btn {
                padding: 11px 16px;
                border: none;
                border-radius: 12px;
                background: var(--accent-gradient);
                color: white;
                font-weight: 700;
                font-size: 13px;
                cursor: pointer;
                font-family: var(--font-family);
                box-shadow: 0 4px 16px rgba(109, 40, 217, 0.2);
                transition: all 0.2s ease;
            }

                .map-btn:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 6px 20px rgba(109, 40, 217, 0.3);
                }

                .map-btn:disabled {
                    opacity: .6;
                    cursor: not-allowed;
                    transform: none;
                }

            #storeMap {
                width: 100%;
                height: 360px;
                border-radius: 14px;
                border: 1.5px solid var(--border-color);
                background: #e5e7eb;
            }

            .map-message {
                margin-top: 12px;
                padding: 10px 14px;
                border-radius: 12px;
                background: #ffffff;
                border: 1px solid var(--border-color);
                color: var(--text-secondary);
                font-size: 13px;
                font-weight: 600;
            }

            .coordinate-box {
                display: none;
                margin-top: 10px;
                padding: 10px 14px;
                border-radius: 12px;
                background: var(--accent-light);
                border: 1px solid #ddd6fe;
                color: var(--accent-hover);
                font-size: 13px;
                font-weight: 700;
            }

            /* -------- File upload -------- */
            .file-drop {
                border: 1.5px dashed var(--border-color);
                border-radius: 14px;
                padding: 18px;
                background: var(--input-bg);
                transition: all 0.2s ease;
            }

                .file-drop:focus-within {
                    border-color: var(--accent-color);
                    background: #ffffff;
                }

            /* -------- Confirmation -------- */
            .confirmation {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                padding: 16px;
                border: 1.5px solid var(--border-color);
                border-radius: 14px;
                background: var(--input-bg);
            }

                .confirmation input {
                    width: 18px;
                    height: 18px;
                    margin-top: 2px;
                    flex: 0 0 auto;
                }

                .confirmation label {
                    margin: 0;
                    line-height: 1.6;
                    font-weight: 500;
                    color: var(--text-secondary);
                }

            /* -------- Submit -------- */
            .submit-btn {
                margin-top: 8px;
                width: 100%;
                padding: 16px;
                border: none;
                border-radius: 14px;
                background: var(--accent-gradient);
                color: #ffffff;
                font-size: 15px;
                font-weight: 700;
                cursor: pointer;
                letter-spacing: 0.3px;
                box-shadow: 0 4px 20px rgba(109, 40, 217, 0.25);
                transition: all 0.25s ease;
                font-family: var(--font-family);
            }

                .submit-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 30px rgba(109, 40, 217, 0.35);
                    background: linear-gradient(135deg, #5b21b6 0%, #6d28d9 55%, #4338ca 100%);
                }

                .submit-btn:active {
                    transform: translateY(0);
                }

                .submit-btn:disabled {
                    opacity: .65;
                    cursor: not-allowed;
                    transform: none;
                }

            /* -------- Back link -------- */
            .back-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                margin-top: 24px;
                padding: 10px 20px;
                border-radius: 12px;
                background: var(--accent-light);
                color: var(--accent-color);
                text-decoration: none;
                font-size: 13px;
                font-weight: 700;
                transition: all 0.25s ease;
            }

                .back-link:hover {
                    background: var(--accent-color);
                    color: #ffffff;
                    transform: translateX(-2px);
                }

            @@media (max-width: 760px) {
                .form-grid {
                    grid-template-columns: 1fr;
                }

                .card {
                    padding: 26px;
                    border-radius: 20px;
                }

                .header-box h2 {
                    font-size: 24px;
                }

                #storeMap {
                    height: 300px;
                }

                .otp-code-group {
                    flex-wrap: wrap;
                }
            }

            /* -------- Toasts -------- */
            .toast-container {
                position: fixed;
                top: 22px;
                right: 22px;
                z-index: 99999;
                display: flex;
                flex-direction: column;
                gap: 12px;
                width: min(390px, calc(100vw - 32px));
                pointer-events: none;
            }

            .toast {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                padding: 15px 16px;
                border-radius: 14px;
                color: white;
                box-shadow: var(--shadow-md);
                transform: translateX(120%);
                opacity: 0;
                transition: transform .28s ease, opacity .28s ease;
                pointer-events: auto;
            }

                .toast.show {
                    transform: translateX(0);
                    opacity: 1;
                }

            .toast-error {
                background: var(--error-color);
            }

            .toast-success {
                background: var(--success-color);
            }

            .toast-icon {
                flex: 0 0 auto;
                font-size: 18px;
                line-height: 1.3;
            }

            .toast-message {
                flex: 1;
                font-size: 13px;
                font-weight: 600;
                line-height: 1.5;
            }

            .toast-close {
                flex: 0 0 auto;
                border: 0;
                background: transparent;
                color: white;
                cursor: pointer;
                font-size: 19px;
                line-height: 1;
                padding: 0;
                opacity: .85;
            }

                .toast-close:hover {
                    opacity: 1;
                }
    </style>
</head>

<body>

    <div class="page-wrapper">
        <div class="card">

            <div class="header-box">
                <h2><i class="fa-solid fa-store header-icon"></i> @pageTitle</h2>

                <p>
                    Submit accurate business information, upload the business
                    license, and select the exact store location. Our admin
                    team will review the request before activating the store.
                </p>
            </div>

            <div id="toastContainer"
                 class="toast-container"
                 aria-live="polite"
                 aria-atomic="true">
            </div>

            <form method="post"
                  enctype="multipart/form-data"
                  id="storeRequestForm">

                <!-- ============ SECTION 1: STORE INFORMATION ============ -->
                <div class="form-section">
                    <div class="section-heading">
                        <span class="step-num">1</span>
                        <i class="fa-solid fa-shop section-icon"></i>
                        <h3>Store Information</h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label asp-for="Input.StoreName">
                                Store Name
                            </label>

                            <input asp-for="Input.StoreName"
                                   maxlength="100"
                                   placeholder="Example: Fatima Shop" />

                            <span asp-validation-for="Input.StoreName"></span>
                        </div>

                        <div class="form-group full">
                            <label asp-for="Input.Description">
                                Store Description
                            </label>

                            <textarea asp-for="Input.Description"
                                      maxlength="1000"
                                      placeholder="Describe the products and business activity..."></textarea>

                            <span asp-validation-for="Input.Description"></span>
                        </div>
                    </div>
                </div>

                <!-- ============ SECTION 2: CONTACT & VERIFICATION ============ -->
                <div class="form-section">
                    <div class="section-heading">
                        <span class="step-num">2</span>
                        <i class="fa-solid fa-id-card section-icon"></i>
                        <h3>Contact &amp; Verification</h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label asp-for="Input.Email">
                                Business Contact Email
                            </label>

                            <input asp-for="Input.Email"
                                   type="email"
                                   maxlength="150"
                                   autocomplete="email"
                                   placeholder="example@store.com" />

                            <span asp-validation-for="Input.Email"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.PhoneNumber">
                                Business Phone Number
                            </label>

                            <input asp-for="Input.PhoneNumber"
                                   type="tel"
                                   maxlength="20"
                                   autocomplete="tel"
                                   placeholder="+96178123456" />

                            <span asp-validation-for="Input.PhoneNumber"></span>

                            <span class="hint">
                                Accepted formats include 78123456,
                                0096178123456, or +96178123456.
                            </span>

                            <div class="otp-section" id="otpSection">
                                <button type="button"
                                        class="otp-btn"
                                        id="sendOtpButton"
                                        onclick="sendOtp()">
                                    <i class="fa-solid fa-paper-plane" style="margin-right: 6px;"></i>Send Verification Code
                                </button>

                                <div class="otp-code-group" id="otpCodeGroup">
                                    <input type="text"
                                           id="otpCodeInput"
                                           class="otp-code-input"
                                           maxlength="6"
                                           inputmode="numeric"
                                           placeholder="Enter 6-digit code" />

                                    <button type="button"
                                            class="otp-btn"
                                            id="verifyOtpButton"
                                            onclick="verifyOtp()">
                                        Verify Code
                                    </button>
                                </div>

                                <div id="otpStatus"
                                     class="hint otp-status @(isPhoneAlreadyVerified ? "verified" : "")">
                                    @(isPhoneAlreadyVerified
                                        ? "✓ Phone number verified."
                                        : "")
                                </div>
                            </div>

                            <input type="hidden"
                                   id="PhoneVerifiedFlag"
                                   value="@(isPhoneAlreadyVerified ? "true" : "false")" />
                        </div>
                    </div>
                </div>

                <!-- ============ SECTION 3: LOCATION ============ -->
                <div class="form-section">
                    <div class="section-heading">
                        <span class="step-num">3</span>
                        <i class="fa-solid fa-location-dot section-icon"></i>
                        <h3>Store Location</h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group full">
                            <label asp-for="Input.AddressLine1">
                                Store Address
                            </label>

                            <input asp-for="Input.AddressLine1"
                                   id="StoreAddress"
                                   maxlength="250"
                                   placeholder="Street, building, floor, nearby landmark" />

                            <span asp-validation-for="Input.AddressLine1"></span>

                            <span class="hint">
                                Enter the address manually or select the exact
                                location using the map.
                            </span>
                        </div>

                        <input asp-for="Input.Latitude"
                               type="hidden"
                               id="StoreLatitude" />

                        <input asp-for="Input.Longitude"
                               type="hidden"
                               id="StoreLongitude" />

                        <div class="form-group">
                            <label asp-for="Input.City">
                                City
                            </label>

                            <select asp-for="Input.City"
                                    id="StoreCity">
                                <option value="">Select city</option>
                                <option value="Beirut">Beirut</option>
                                <option value="Tripoli">Tripoli</option>
                                <option value="Saida">Saida</option>
                                <option value="Tyre">Tyre</option>
                                <option value="Zahle">Zahle</option>
                                <option value="Jounieh">Jounieh</option>
                                <option value="Byblos">Byblos</option>
                                <option value="Nabatieh">Nabatieh</option>
                                <option value="Aley">Aley</option>
                                <option value="Baabda">Baabda</option>
                            </select>

                            <span asp-validation-for="Input.City"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Area">
                                Governorate / Area
                            </label>

                            <select asp-for="Input.Area"
                                    id="StoreArea"
                                    data-selected-area="@Model.Input.Area">
                                <option value="">Select area</option>
                            </select>

                            <span asp-validation-for="Input.Area"></span>
                        </div>

                        <div class="form-group full">
                            <label>Store Location on Map</label>

                            <div class="location-panel">
                                <div class="location-actions">
                                    <button type="button"
                                            class="map-btn"
                                            onclick="useCurrentStoreLocation()">
                                        <i class="fa-solid fa-location-crosshairs" style="margin-right: 6px;"></i>Use My Current Location
                                    </button>
                                </div>

                                <div id="storeMap"></div>

                                <div id="storeMapMessage"
                                     class="map-message">
                                    Click the map, drag the marker, or use
                                    your current location.
                                </div>

                                <div id="storeCoordinateBox"
                                     class="coordinate-box">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ============ SECTION 4: CONFIRMATION ============ -->
                <div class="form-section">
                    <div class="section-heading">
                        <span class="step-num">4</span>
                        <i class="fa-solid fa-circle-check section-icon"></i>
                        <h3>Confirmation</h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group full">
                            <div class="confirmation">
                                <input asp-for="Input.ConfirmInformation"
                                       type="checkbox" />

                                <label asp-for="Input.ConfirmInformation">
                                    I confirm that the submitted store,
                                    contact, license, address, and location
                                    information is accurate.
                                </label>
                            </div>

                            <span asp-validation-for="Input.ConfirmInformation"></span>
                        </div>
                    </div>
                </div>

                <button type="submit"
                        class="submit-btn"
                        id="submitStoreRequestButton">
                    <i class="fa-solid fa-paper-plane" style="margin-right: 8px;"></i>
                    @(Model.IsResubmission
                        ? "Update and Resubmit Store Request"
                        : "Submit Store Owner Request")
                </button>

            </form>

            <a href="/CustomerProfile"
               class="back-link">
                <i class="fa-solid fa-arrow-left-long"></i> Back to My Profile
            </a>

        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
            const serverToasts =
                                @Html.Raw(
                                                                                    JsonSerializer.Serialize(
                                                                                                    toastMessages));

            const cityAreaMap = {
                "Beirut": "Beirut",
                "Tripoli": "North Lebanon",
                "Saida": "South Lebanon",
                "Tyre": "South Lebanon",
                "Zahle": "Bekaa",
                "Jounieh": "Mount Lebanon",
                "Byblos": "Mount Lebanon",
                "Nabatieh": "Nabatieh",
                "Aley": "Mount Lebanon",
                "Baabda": "Mount Lebanon"
            };

            let storeMap;
            let storeMarker;

            document.addEventListener(
                "DOMContentLoaded",
                function() {
                    configureAreaOptions();
                    initStoreMap();
                    configureSubmitProtection();
                    configurePhoneVerificationReset();

                    serverToasts.forEach(
                        toast =>
                            showToast(
                                toast.message,
                                toast.type));
                });

            document
                .getElementById("StoreCity")
                .addEventListener(
                    "change",
                    function() {
                        configureAreaOptions(true);
                    });

            function configureAreaOptions(clearSelection) {
                const citySelect =
                    document.getElementById("StoreCity");

                const areaSelect =
                    document.getElementById("StoreArea");

                if (!citySelect || !areaSelect) {
                    return;
                }

                const previousArea =
                    clearSelection
                        ? ""
                        : areaSelect.dataset.selectedArea || areaSelect.value;

                areaSelect.innerHTML =
                    '<option value="">Select area</option>';

                const expectedArea =
                    cityAreaMap[citySelect.value];

                if (!expectedArea) {
                    return;
                }

                const option =
                    document.createElement("option");

                option.value =
                    expectedArea;

                option.textContent =
                    expectedArea;

                areaSelect.appendChild(
                    option);

                if (previousArea === expectedArea) {
                    areaSelect.value =
                        expectedArea;
                }
                else {
                    areaSelect.value =
                        expectedArea;
                }
            }

            function initStoreMap() {
                const defaultLat =
                    33.8938;

                const defaultLng =
                    35.5018;

                const latitudeInput =
                    document.getElementById("StoreLatitude");

                const longitudeInput =
                    document.getElementById("StoreLongitude");

                const savedLat =
                    Number.parseFloat(
                        latitudeInput.value);

                const savedLng =
                    Number.parseFloat(
                        longitudeInput.value);

                const hasSavedCoordinates =
                    Number.isFinite(savedLat) &&
                    Number.isFinite(savedLng) &&
                    savedLat !== 0 &&
                    savedLng !== 0;

                const initialLat =
                    hasSavedCoordinates
                        ? savedLat
                        : defaultLat;

                const initialLng =
                    hasSavedCoordinates
                        ? savedLng
                        : defaultLng;

                storeMap =
                    L.map(
                        "storeMap",
                        {
                            maxBounds: [
                                [32.8, 34.8],
                                [35.0, 36.8]
                            ],
                            maxBoundsViscosity: 1.0
                        })
                        .setView(
                            [initialLat, initialLng],
                            hasSavedCoordinates
                                ? 15
                                : 9);

                L.tileLayer(
                    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                    {
                        maxZoom: 19,
                        attribution:
                            "&copy; OpenStreetMap contributors"
                    })
                    .addTo(storeMap);

                storeMarker =
                    L.marker(
                        [initialLat, initialLng],
                        {
                            draggable: true
                        })
                        .addTo(storeMap);

                if (hasSavedCoordinates) {
                    setStoreCoordinates(
                        savedLat,
                        savedLng);
                }

                storeMap.on(
                    "click",
                    function(event) {
                        updateStoreLocation(
                            event.latlng.lat,
                            event.latlng.lng,
                            true);
                    });

                storeMarker.on(
                    "dragend",
                    function() {
                        const position =
                            storeMarker.getLatLng();

                        updateStoreLocation(
                            position.lat,
                            position.lng,
                            true);
                    });
            }

            function updateStoreLocation(
                latitude,
                longitude,
                shouldReverseGeocode) {
                storeMarker.setLatLng(
                    [latitude, longitude]);

                setStoreCoordinates(
                    latitude,
                    longitude);

                if (shouldReverseGeocode) {
                    reverseStoreGeocode(
                        latitude,
                        longitude);
                }
            }

            function setStoreCoordinates(
                latitude,
                longitude) {
                document
                    .getElementById("StoreLatitude")
                    .value =
                    latitude.toFixed(7);

                document
                    .getElementById("StoreLongitude")
                    .value =
                    longitude.toFixed(7);

                document
                    .getElementById("storeMapMessage")
                    .innerText =
                    "Selected location: " +
                    latitude.toFixed(6) +
                    ", " +
                    longitude.toFixed(6);

                const coordinateBox =
                    document.getElementById(
                        "storeCoordinateBox");

                coordinateBox.style.display =
                    "block";

                coordinateBox.innerText =
                    "Coordinates captured: " +
                    latitude.toFixed(6) +
                    ", " +
                    longitude.toFixed(6);
            }

            function useCurrentStoreLocation() {
                const message =
                    document.getElementById(
                        "storeMapMessage");

                if (!navigator.geolocation) {
                    message.innerText =
                        "Location is not supported. Select the location manually on the map.";

                    return;
                }

                message.innerText =
                    "Detecting location...";

                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        const latitude =
                            position.coords.latitude;

                        const longitude =
                            position.coords.longitude;

                        storeMap.setView(
                            [latitude, longitude],
                            15);

                        updateStoreLocation(
                            latitude,
                            longitude,
                            true);
                    },
                    function() {
                        message.innerText =
                            "Location permission was denied or unavailable. Select the location manually on the map.";
                    },
                    {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 0
                    });
            }

            async function reverseStoreGeocode(
                latitude,
                longitude) {
                try {
                    const url =
                        "https://nominatim.openstreetmap.org/reverse" +
                        "?format=jsonv2" +
                        "&lat=" +
                        encodeURIComponent(latitude) +
                        "&lon=" +
                        encodeURIComponent(longitude);

                    const response =
                        await fetch(
                            url,
                            {
                                headers: {
                                    "Accept-Language": "en"
                                }
                            });

                    if (!response.ok) {
                        throw new Error(
                            "Reverse geocoding failed.");
                    }

                    const data =
                        await response.json();

                    if (data?.display_name) {
                        document
                            .getElementById("StoreAddress")
                            .value =
                            data.display_name;
                    }
                }
                catch {
                    document
                        .getElementById("storeMapMessage")
                        .innerText =
                        "The map location was saved. Enter the address manually if needed.";
                }
            }

            // =====================================================
            // OTP VERIFICATION
            // =====================================================
            function getAntiForgeryToken() {
                const tokenInput =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]');

                return tokenInput
                    ? tokenInput.value
                    : "";
            }

            function configurePhoneVerificationReset() {
                const phoneInput =
                    document.querySelector(
                        '[name="Input.PhoneNumber"]');

                if (!phoneInput) {
                    return;
                }

                phoneInput.addEventListener(
                    "input",
                    function() {
                        document.getElementById(
                            "PhoneVerifiedFlag").value = "false";

                        const statusEl =
                            document.getElementById("otpStatus");

                        statusEl.innerText = "";
                        statusEl.classList.remove("verified");

                        document.getElementById(
                            "otpCodeGroup").style.display = "none";
                    });
            }

            async function sendOtp() {
                const phoneInput =
                    document.querySelector(
                        '[name="Input.PhoneNumber"]');

                const statusEl =
                    document.getElementById("otpStatus");

                const sendButton =
                    document.getElementById("sendOtpButton");

                const phoneNumber =
                    phoneInput.value.trim();

                if (!phoneNumber) {
                    showToast(
                        "Enter a phone number first.",
                        "error");

                    return;
                }

                sendButton.disabled = true;
                sendButton.innerHTML = "Sending...";

                try {
                    const formData = new FormData();
                    formData.append("phoneNumber", phoneNumber);

                    const response = await fetch(
                        "/StoreRequest?handler=SendOtp",
                        {
                            method: "POST",
                            headers: {
                                "RequestVerificationToken":
                                    getAntiForgeryToken()
                            },
                            body: formData
                        });

                    const data = await response.json();

                    if (data.success) {
                        document.getElementById(
                            "otpCodeGroup").style.display = "flex";

                        statusEl.classList.remove("verified");
                        statusEl.innerText =
                            "Code sent. Enter it below.";

                        document.getElementById(
                            "PhoneVerifiedFlag").value = "false";

                        showToast(
                            "Verification code sent.",
                            "success");
                    }
                    else {
                        showToast(
                            data.message ||
                            "Could not send the verification code.",
                            "error");
                    }
                }
                catch (err) {
                    showToast(
                        "Could not send the verification code.",
                        "error");
                }
                finally {
                    sendButton.disabled = false;
                    sendButton.innerHTML =
                        '<i class="fa-solid fa-paper-plane" style="margin-right: 6px;"></i>Send Verification Code';
                }
            }

            async function verifyOtp() {
                const phoneInput =
                    document.querySelector(
                        '[name="Input.PhoneNumber"]');

                const codeInput =
                    document.getElementById("otpCodeInput");

                const statusEl =
                    document.getElementById("otpStatus");

                const verifyButton =
                    document.getElementById("verifyOtpButton");

                const phoneNumber =
                    phoneInput.value.trim();

                const code =
                    codeInput.value.trim();

                if (!code) {
                    showToast(
                        "Enter the verification code.",
                        "error");

                    return;
                }

                verifyButton.disabled = true;
                verifyButton.textContent = "Verifying...";

                try {
                    const formData = new FormData();
                    formData.append("phoneNumber", phoneNumber);
                    formData.append("code", code);

                    const response = await fetch(
                        "/StoreRequest?handler=VerifyOtp",
                        {
                            method: "POST",
                            headers: {
                                "RequestVerificationToken":
                                    getAntiForgeryToken()
                            },
                            body: formData
                        });

                    const data = await response.json();

                    if (data.success) {
                        statusEl.classList.add("verified");
                        statusEl.innerText =
                            "✓ Phone number verified.";

                        document.getElementById(
                            "PhoneVerifiedFlag").value = "true";

                        showToast(
                            "Phone number verified.",
                            "success");
                    }
                    else {
                        showToast(
                            data.message ||
                            "Verification failed.",
                            "error");
                    }
                }
                catch (err) {
                    showToast(
                        "Verification failed.",
                        "error");
                }
                finally {
                    verifyButton.disabled = false;
                    verifyButton.textContent = "Verify Code";
                }
            }

            function configureSubmitProtection() {
                const form =
                    document.getElementById(
                        "storeRequestForm");

                const submitButton =
                    document.getElementById(
                        "submitStoreRequestButton");

                if (!form || !submitButton) {
                    return;
                }

                form.addEventListener(
                    "submit",
                    function(event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();

                            const invalidFields =
                                Array.from(
                                    form.querySelectorAll(
                                        ":invalid"));

                            const shownMessages =
                                new Set();

                            invalidFields.forEach(
                                field => {
                                    const message =
                                        field.validationMessage ||
                                        "Please complete the required information.";

                                    if (!shownMessages.has(
                                        message)) {
                                        shownMessages.add(
                                            message);

                                        showToast(
                                            message,
                                            "error");
                                    }
                                });

                            if (invalidFields.length > 0) {
                                invalidFields[0].focus();
                            }

                            return;
                        }

                        const phoneVerifiedFlag =
                            document.getElementById(
                                "PhoneVerifiedFlag");

                        if (!phoneVerifiedFlag ||
                            phoneVerifiedFlag.value !== "true") {
                            event.preventDefault();

                            showToast(
                                "Please verify your phone number before submitting.",
                                "error");

                            return;
                        }

                        submitButton.disabled =
                            true;

                        submitButton.innerHTML =
                            "Submitting Request...";
                    });
            }

            function showToast(
                message,
                type) {
                if (!message) {
                    return;
                }

                const container =
                    document.getElementById(
                        "toastContainer");

                if (!container) {
                    return;
                }

                const toast =
                    document.createElement(
                        "div");

                const safeType =
                    type === "success"
                        ? "success"
                        : "error";

                toast.className =
                    `toast toast-${safeType}`;

                const icon =
                    safeType === "success"
                        ? "✓"
                        : "!";

                toast.innerHTML =
                    `<span class="toast-icon">${icon}</span>` +
                    `<span class="toast-message"></span>` +
                    `<button type="button" class="toast-close" aria-label="Close">×</button>`;

                toast
                    .querySelector(
                        ".toast-message")
                    .textContent =
                    message;

                const removeToast =
                    () => {
                        toast.classList.remove(
                            "show");

                        window.setTimeout(
                            () => toast.remove(),
                            280);
                    };

                toast
                    .querySelector(
                        ".toast-close")
                    .addEventListener(
                        "click",
                        removeToast);

                container.appendChild(
                    toast);

                window.requestAnimationFrame(
                    () =>
                        toast.classList.add(
                            "show"));

                window.setTimeout(
                    removeToast,
                    safeType === "success"
                        ? 4500
                        : 6500);
            }
    </script>

</body>
</html>
