@page
@model Local_Multi_Store_Online_Marketplace.Pages.CustomerPromotionsModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>My Promotions | realnest</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-color: #faf9fc;
                --card-bg: #ffffff;
                --border-color: #ece8f6;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --success-color: #10b981;
                --danger-color: #ef4444;
                --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.04);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.08);
                --shadow-lg: 0 20px 40px rgba(109, 40, 217, 0.12);
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-family);
                background-color: var(--bg-color);
                color: var(--text-primary);
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                padding-bottom: 100px;
            }

            /* ============================================================
                                               BOTTOM NAV — rendered by the shared _CustomerBottomNav partial.
                                               Styles below match every other customer page exactly (same
                                               class names), so the partial renders identically here.
                                               ============================================================ */
            .mobile-bottom-nav {
                display: flex !important;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 200;
                background: #ffffff;
                border-top: 1px solid #ece8f6;
                justify-content: space-between;
                gap: 2px;
                padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
                overflow-x: auto;
                box-shadow: 0 -4px 20px rgba(30, 27, 46, 0.06);
            }

                .mobile-bottom-nav a {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: 2px;
                    font-size: 10.5px;
                    color: #6b6478;
                    text-decoration: none;
                    padding: 4px 6px;
                    flex-shrink: 0;
                    position: relative;
                    border-radius: 12px;
                    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
                }

                    .mobile-bottom-nav a i {
                        font-size: 17px;
                        transition: transform 0.2s ease;
                    }

                    .mobile-bottom-nav a:hover {
                        background: var(--accent-light);
                        color: var(--accent-color);
                    }

                    .mobile-bottom-nav a.active {
                        color: var(--accent-color) !important;
                        background: var(--accent-light) !important;
                        font-weight: 700;
                        transform: translateY(-2px);
                    }

                        .mobile-bottom-nav a.active i {
                            transform: scale(1.12);
                        }

            /* Cart badge (used by _CartCountBadge partial inside _CustomerBottomNav) */
            .unread-nav-badge {
                position: absolute;
                top: 2px;
                right: 18px;
                background: var(--accent-gradient);
                color: #fff;
                font-size: 10px;
                font-weight: 800;
                min-width: 16px;
                height: 16px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 4px;
                box-shadow: 0 3px 8px rgba(109, 40, 217, 0.3);
            }

            /* Chat unread dot (used inside _CustomerBottomNav) */
            .chat-icon-wrap {
                position: relative;
                display: inline-flex;
            }

                .chat-icon-wrap .chat-nav-dot {
                    position: absolute;
                    top: -2px;
                    right: -4px;
                    width: 9px;
                    height: 9px;
                    background: #ed4956;
                    border: 2px solid #fff;
                    border-radius: 50%;
                    box-sizing: content-box;
                }

            /* PAGE CONTENT */
            .promotions-page {
                padding: 40px 16px;
                min-height: 100vh;
            }

            .promotions-box {
                max-width: 1100px;
                margin: 0 auto;
            }

            .promotions-heading {
                text-align: center;
                margin-bottom: 8px;
            }

                .promotions-heading h2 {
                    font-family: 'Playfair Display', Georgia, serif;
                    font-size: 34px;
                    font-weight: 800;
                    color: var(--text-primary);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 12px;
                }

                    .promotions-heading h2 i {
                        font-size: 28px;
                        color: var(--accent-color);
                    }

            .promo-toolbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                flex-wrap: wrap;
                margin-bottom: 8px;
            }

            .mark-all-btn {
                border: 1px solid var(--border-color);
                background: var(--card-bg);
                color: var(--accent-color);
                padding: 9px 18px;
                border-radius: 50px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                flex-shrink: 0;
                white-space: nowrap;
                transition: all 0.2s ease;
                box-shadow: var(--shadow-sm);
            }

                .mark-all-btn:hover:not(:disabled) {
                    background: var(--accent-color);
                    color: #fff;
                    border-color: var(--accent-color);
                }

                .mark-all-btn:disabled {
                    opacity: 0.4;
                    cursor: not-allowed;
                }

            .promotions-subtext {
                text-align: center;
                color: var(--text-secondary);
                font-size: 15px;
                font-weight: 500;
                margin-bottom: 24px;
            }

            .promo-filter-tabs {
                display: flex;
                justify-content: flex-start;
                gap: 12px;
                overflow-x: auto;
                padding: 4px 4px 4px 0;
                margin-bottom: 28px;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
            }

                .promo-filter-tabs::-webkit-scrollbar {
                    display: none;
                }

                .promo-filter-tabs button {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 9px;
                    min-width: 130px;
                    border: 1px solid var(--border-color);
                    background: var(--card-bg);
                    color: var(--text-secondary);
                    font-family: inherit;
                    font-size: 14px;
                    font-weight: 700;
                    padding: 15px 22px;
                    border-radius: 18px;
                    cursor: pointer;
                    flex-shrink: 0;
                    box-shadow: var(--shadow-sm);
                    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
                }

                    .promo-filter-tabs button i {
                        font-size: 18px;
                        color: var(--accent-color);
                        transition: color 0.2s ease;
                    }

                    .promo-filter-tabs button:hover:not(.active) {
                        transform: translateY(-2px);
                        box-shadow: var(--shadow-md);
                        border-color: var(--accent-color);
                        color: var(--accent-color);
                    }

                    .promo-filter-tabs button.active {
                        background: var(--accent-gradient);
                        color: #fff;
                        border-color: transparent;
                        box-shadow: 0 8px 20px rgba(109, 40, 217, 0.28);
                    }

                        .promo-filter-tabs button.active i {
                            color: #fff;
                        }

            .promotions-empty {
                max-width: 700px;
                margin: 20px auto;
                background: var(--card-bg);
                text-align: center;
                color: var(--text-secondary);
                padding: 60px 40px;
                border-radius: 20px;
                border: 2px dashed #ded4f5;
                box-shadow: var(--shadow-sm);
            }

                .promotions-empty .empty-icon {
                    width: 64px;
                    height: 64px;
                    margin: 0 auto 18px;
                    border-radius: 50%;
                    background: var(--accent-light);
                    color: var(--accent-color);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 26px;
                }

                .promotions-empty h3 {
                    color: var(--text-primary);
                    font-size: 20px;
                    font-weight: 800;
                    margin-bottom: 8px;
                }

            .promotions-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
                gap: 24px;
            }

            .promo-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: 22px;
                padding: 30px;
                min-height: 220px;
                display: flex;
                flex-direction: column;
                box-shadow: var(--shadow-sm);
                transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
            }

                .promo-card:hover {
                    transform: translateY(-3px);
                    box-shadow: var(--shadow-md);
                }

                .promo-card.unread {
                    border-color: var(--accent-color);
                    box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.08), var(--shadow-sm);
                }

                .promo-card.is-hidden {
                    display: none;
                }

            .promo-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 10px;
                margin-bottom: 10px;
            }

            .promo-title {
                font-size: 19px;
                font-weight: 800;
                color: var(--text-primary);
            }

            .promo-new-badge {
                flex-shrink: 0;
                background: var(--accent-gradient);
                color: #fff;
                font-size: 11px;
                font-weight: 800;
                padding: 4px 10px;
                border-radius: 999px;
                white-space: nowrap;
            }

            .promo-message {
                font-size: 15px;
                color: var(--text-secondary);
                line-height: 1.6;
                margin-bottom: 16px;
            }

            .promo-coupon {
                background: #ecfdf5;
                border: 1px solid #d1fae5;
                color: var(--success-color);
                padding: 10px 14px;
                border-radius: 12px;
                font-size: 13px;
                font-weight: 700;
                margin-bottom: 14px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
            }

                .promo-coupon .copy-code-btn {
                    border: none;
                    background: rgba(16, 185, 129, 0.12);
                    color: var(--success-color);
                    font-size: 11.5px;
                    font-weight: 800;
                    padding: 5px 10px;
                    border-radius: 8px;
                    cursor: pointer;
                    white-space: nowrap;
                }

                    .promo-coupon .copy-code-btn:hover {
                        background: var(--success-color);
                        color: #fff;
                    }

            .promo-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                margin-top: auto;
                padding-top: 6px;
            }

            .promo-date {
                display: block;
                font-size: 12px;
                color: var(--text-secondary);
                font-weight: 600;
            }

            .promo-mark-read-btn {
                border: 1px solid var(--border-color);
                background: var(--accent-light);
                color: var(--accent-color);
                padding: 8px 16px;
                border-radius: 50px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .promo-mark-read-btn:hover:not(:disabled) {
                    background: var(--accent-color);
                    color: #ffffff;
                    border-color: var(--accent-color);
                }

                .promo-mark-read-btn:disabled {
                    opacity: 0.6;
                    cursor: wait;
                }

            /* Toast */
            .promo-toast {
                position: fixed;
                left: 50%;
                bottom: 90px;
                transform: translateX(-50%) translateY(20px);
                background: var(--text-primary);
                color: #fff;
                font-size: 13.5px;
                font-weight: 600;
                padding: 12px 20px;
                border-radius: 50px;
                box-shadow: var(--shadow-lg);
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.25s ease, transform 0.25s ease;
                z-index: 300;
            }

                .promo-toast.visible {
                    opacity: 1;
                    transform: translateX(-50%) translateY(0);
                    pointer-events: auto;
                }

            /* ============================================================
                                   NOTIFICATION DEEP-LINK HIGHLIGHT (NEW) — briefly pulses
                                   and scrolls to the promo card referenced by a clicked
                                   Promotion notification (?highlightPromoId=).
                                   ============================================================ */
            @@keyframes promoHighlightPulse {
                0% {
                    box-shadow: 0 0 0 3px var(--accent-color), var(--shadow-md);
                }

                70% {
                    box-shadow: 0 0 0 3px var(--accent-color), var(--shadow-md);
                }

                100% {
                    box-shadow: var(--shadow-sm);
                }
            }

            .promo-card-highlight {
                animation: promoHighlightPulse 2.4s ease;
            }

            @@media (max-width: 780px) {
                .promotions-grid {
                    grid-template-columns: 1fr;
                }

                .promo-toolbar {
                    justify-content: center;
                }

                .mark-all-btn {
                    width: 100%;
                    justify-content: center;
                }

                .promo-filter-tabs button {
                    min-width: 110px;
                    padding: 13px 18px;
                    font-size: 13px;
                }
            }
    </style>
</head>

<body>

    <partial name="_CustomerBottomNav" />

    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

    <div class="promotions-page">
        <div class="promotions-box">

            <div class="promotions-heading">
                <h2><i class="fa-solid fa-gift"></i> My Promotions</h2>
            </div>

            @if (Model.Promotions != null && Model.Promotions.Any())
            {
                <p class="promotions-subtext" id="promoSubtext">
                    <span id="unreadCount">@Model.Promotions.Count(p => !p.IsRead)</span> unread of @Model.Promotions.Count total offers
                </p>

                <div class="promo-toolbar">
                    <div class="promo-filter-tabs">
                        <button type="button" class="active" data-filter="all">
                            <i class="fa-solid fa-layer-group"></i>
                            <span>All</span>
                        </button>
                        <button type="button" data-filter="unread">
                            <i class="fa-solid fa-envelope"></i>
                            <span>Unread</span>
                        </button>
                    </div>

                    @if (Model.Promotions.Any(p => !p.IsRead))
                    {
                        <button type="button" class="mark-all-btn" id="markAllBtn">
                            <i class="fa-solid fa-check-double"></i> Mark all as read
                        </button>
                    }
                </div>
            }

            @if (Model.Promotions == null || !Model.Promotions.Any())
            {
                <div class="promotions-empty">
                    <div class="empty-icon"><i class="fa-regular fa-bell"></i></div>
                    <h3>No promotions yet</h3>
                    <p>Offers and coupons from stores you follow will show up here.</p>
                </div>
            }
            else
            {
                <div class="promotions-grid" id="promotionsGrid">
                    @foreach (var item in Model.Promotions)
                    {
                        <div class="promo-card @(item.IsRead ? "" : "unread")" id="promo-@item.PromotionRecipientID" data-promo-id="@item.PromotionRecipientID" data-promotion-id="@item.Promotion?.PromotionID" data-read="@item.IsRead.ToString().ToLower()">

                            <div class="promo-header">
                                <span class="promo-title">@item.Promotion?.Title</span>

                                @if (!item.IsRead)
                                {
                                    <span class="promo-new-badge">New</span>
                                }
                            </div>

                            <p class="promo-message">@item.Promotion?.Message</p>

                            @if (!string.IsNullOrWhiteSpace(item.Promotion?.CouponCode))
                            {
                                <div class="promo-coupon">
                                    <span>Coupon Code: <strong>@item.Promotion.CouponCode</strong></span>
                                    <button type="button" class="copy-code-btn" data-code="@item.Promotion.CouponCode">Copy</button>
                                </div>
                            }

                            <div class="promo-footer">
                                <small class="promo-date">
                                    Sent: @item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </small>

                                @if (!item.IsRead)
                                {
                                    <button type="button" class="promo-mark-read-btn" data-id="@item.PromotionRecipientID">
                                        Mark as read
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>

    <div class="promo-toast" id="promoToast" role="status" aria-live="polite"></div>

    <script>
            (function() {
                const grid = document.getElementById('promotionsGrid');
                const toast = document.getElementById('promoToast');
                const unreadCountEl = document.getElementById('unreadCount');
                const markAllBtn = document.getElementById('markAllBtn');
                const tokenInput = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');

                function showToast(message) {
                    if (!toast) return;
                    toast.textContent = message;
                    toast.classList.add('visible');
                    clearTimeout(showToast._t);
                    showToast._t = setTimeout(() => toast.classList.remove('visible'), 2200);
                }

                function updateUnreadCount(delta) {
                    if (!unreadCountEl) return;
                    const next = Math.max(0, parseInt(unreadCountEl.textContent, 10) + delta);
                    unreadCountEl.textContent = next;
                    if (next === 0 && markAllBtn) markAllBtn.remove();
                }

                async function markAsRead(id, btn) {
                    if (!tokenInput) return false;
                    if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }

                    try {
                        const formData = new FormData();
                        formData.append('__RequestVerificationToken', tokenInput.value);
                        formData.append('promotionRecipientId', id);

                        const response = await fetch('?handler=MarkAsRead', {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (!response.ok) throw new Error('Request failed');
                        return true;
                    } catch (err) {
                        showToast('Could not update. Please try again.');
                        if (btn) { btn.disabled = false; btn.textContent = 'Mark as read'; }
                        return false;
                    }
                }

                if (grid) {
                    grid.addEventListener('click', async function(e) {
                        const copyBtn = e.target.closest('.copy-code-btn');
                        if (copyBtn) {
                            const code = copyBtn.dataset.code;
                            try {
                                await navigator.clipboard.writeText(code);
                                showToast('Coupon code copied');
                            } catch {
                                showToast('Copy this code: ' + code);
                            }
                            return;
                        }

                        const readBtn = e.target.closest('.promo-mark-read-btn');
                        if (readBtn) {
                            const card = readBtn.closest('.promo-card');
                            const id = readBtn.dataset.id;
                            const ok = await markAsRead(id, readBtn);
                            if (ok && card) {
                                card.classList.remove('unread');
                                card.dataset.read = 'true';
                                const badge = card.querySelector('.promo-new-badge');
                                if (badge) badge.remove();
                                readBtn.remove();
                                updateUnreadCount(-1);
                                showToast('Marked as read');
                            }
                        }
                    });
                }

                if (markAllBtn) {
                    markAllBtn.addEventListener('click', async function() {
                        const unreadButtons = Array.from(document.querySelectorAll('.promo-mark-read-btn'));
                        markAllBtn.disabled = true;
                        markAllBtn.textContent = 'Marking all…';

                        for (const btn of unreadButtons) {
                            const card = btn.closest('.promo-card');
                            const id = btn.dataset.id;
                            const ok = await markAsRead(id, btn);
                            if (ok && card) {
                                card.classList.remove('unread');
                                const badge = card.querySelector('.promo-new-badge');
                                if (badge) badge.remove();
                                btn.remove();
                            }
                        }
                        if (unreadCountEl) unreadCountEl.textContent = '0';
                        showToast('All promotions marked as read');
                    });
                }

                const filterTabs = document.querySelectorAll('.promo-filter-tabs button');
                filterTabs.forEach(tab => {
                    tab.addEventListener('click', function() {
                        filterTabs.forEach(t => t.classList.remove('active'));
                        tab.classList.add('active');
                        const filter = tab.dataset.filter;
                        document.querySelectorAll('.promo-card').forEach(card => {
                            const isUnread = card.dataset.read === 'false';
                            card.classList.toggle('is-hidden', filter === 'unread' && !isUnread);
                        });
                    });
                });

                // ============================================================
                // NOTIFICATION DEEP-LINK (NEW) — if we arrived here from a
                // Promotion notification (?highlightPromoId=123), scroll to
                // that card and pulse it, then clean the URL.
                // ============================================================
                (function() {
                    const params = new URLSearchParams(window.location.search);
                    const highlightId = params.get('highlightPromoId');
                    if (!highlightId) return;

                    // Primary match: card's own PromotionRecipientID (the
                    // intended id). Fallback: the underlying PromotionID,
                    // in case the notification's ReferenceID was set to
                    // that instead — this way the highlight still works
                    // either way, no server-side change required.
                    let card = document.getElementById('promo-' + highlightId);
                    if (!card) {
                        card = document.querySelector('.promo-card[data-promotion-id="' + highlightId + '"]');
                    }
                    if (!card) return;

                    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    card.classList.add('promo-card-highlight');
                    setTimeout(function() { card.classList.remove('promo-card-highlight'); }, 2500);

                    if (window.history.replaceState) {
                        const url = new URL(window.location.href);
                        url.searchParams.delete('highlightPromoId');
                        window.history.replaceState({}, '', url);
                    }
                })();
            })();
    </script>

</body>
</html>
