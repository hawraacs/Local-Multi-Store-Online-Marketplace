@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6D28D9;
            --primary-hover: #5B21B6;
            --light-purple: #8B5CF6;
            --very-light-purple: #F5F3FF;
            --soft-lavender: #EDE9FE;
            --dark-text: #111827;
            --secondary-text: #6B7280;
            --border: #E5E7EB;
            --white: #FFFFFF;
            --success: #22C55E;
            --error: #EF4444;
            --warning: #F59E0B;
            --radius-card: 26px;
            --radius-input: 14px;
            --shadow-card: 0 20px 50px rgba(17, 24, 39, .08), 0 4px 14px rgba(17, 24, 39, .04);
        }

        html, body {
            height: 100%;
        }

        body {
            min-height: 100vh;
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--dark-text);
            background: linear-gradient(180deg, #ffffff 0%, var(--very-light-purple) 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 48px 20px;
        }

        .auth-shell {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .card {
            position: relative;
            width: 100%;
            max-width: 720px;
            background: var(--white);
            border-radius: var(--radius-card);
            padding: 60px;
            box-shadow: var(--shadow-card);
            border: 1px solid rgba(17, 24, 39, .04);
            overflow: hidden;
        }

        .card-inner {
            position: relative;
            z-index: 1;
        }

        /* Decorative shapes (front-end only, non-interactive) */
        .decor-wave {
            position: absolute;
            left: -10%;
            bottom: -14%;
            width: 70%;
            height: 40%;
            background: radial-gradient(ellipse at 30% 70%, var(--soft-lavender) 0%, rgba(237, 233, 254, 0) 70%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
        }

        .decor-dots {
            position: absolute;
            right: 6%;
            bottom: 8%;
            width: 74px;
            height: 74px;
            background-image: radial-gradient(var(--soft-lavender) 1.4px, transparent 1.4px);
            background-size: 10px 10px;
            opacity: .8;
            pointer-events: none;
            z-index: 0;
        }

        /* Stepper */
        .stepper {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            margin-bottom: 34px;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            flex: 0 0 auto;
        }

        .step-circle {
            width: 37px;
            height: 37px;
            border-radius: 50%;
            background: var(--white);
            border: 2px solid var(--border);
            color: var(--secondary-text);
            font-size: 14.5px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: none;
        }

            .step-circle.is-active {
                background: var(--primary);
                border-color: var(--primary);
                color: #fff;
            }

            .step-circle.is-complete {
                background: var(--primary);
                border-color: var(--primary);
                color: #fff;
            }

        .step-label {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--secondary-text);
            text-transform: none;
            letter-spacing: .01em;
            white-space: nowrap;
        }

            .step-label.is-active {
                color: var(--primary);
            }

        .step-connector {
            flex: 1 1 32px;
            min-width: 6px;
            max-width: 44px;
            height: 2px;
            background: var(--border);
            margin-top: 17px;
        }

            .step-connector.is-complete {
                background: var(--primary);
            }

        /* Header icon */
        .header-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--soft-lavender);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 26px;
        }

            .header-icon svg {
                width: 34px;
                height: 34px;
            }

        h1.page-title {
            font-size: 36px;
            font-weight: 700;
            color: var(--dark-text);
            text-align: center;
            margin-bottom: 14px;
            letter-spacing: -0.01em;
        }

        .page-subtitle {
            font-size: 17.5px;
            font-weight: 400;
            color: var(--secondary-text);
            text-align: center;
            line-height: 1.55;
            margin-bottom: 30px;
        }

        /* Validation summary */
        div.text-danger {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: #FEF2F2;
            border: 1px solid #FECACA;
            color: var(--error);
            border-radius: var(--radius-input);
            padding: 14px 17px;
            font-size: 15px;
            line-height: 1.5;
            margin-bottom: 20px;
        }

            div.text-danger::before {
                content: "!";
                flex: 0 0 auto;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: var(--error);
                color: #fff;
                font-size: 12px;
                font-weight: 800;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-top: 1px;
            }

            div.text-danger.validation-summary-valid {
                display: none;
                padding: 0;
                margin: 0;
                border: none;
                background: none;
            }

                div.text-danger.validation-summary-valid::before {
                    content: none;
                }

            div.text-danger ul {
                list-style: none;
                margin: 0;
                padding: 0;
            }

        /* Fields */
        .field {
            margin-bottom: 22px;
        }

            .field label {
                display: block;
                font-size: 15px;
                font-weight: 600;
                color: var(--dark-text);
                margin-bottom: 8px;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap .leading-icon {
                position: absolute;
                left: 18px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--secondary-text);
                display: flex;
                pointer-events: none;
            }

                .input-wrap .leading-icon svg {
                    width: 22px;
                    height: 22px;
                }

        .form-control {
            width: 100%;
            height: 60px;
            padding: 0 18px;
            border-radius: var(--radius-input);
            border: 1px solid var(--border);
            font: inherit;
            font-size: 17px;
            color: var(--dark-text);
            background: var(--white);
            transition: border-color .15s ease, box-shadow .15s ease;
        }

            .form-control.with-icon {
                padding-left: 48px;
            }

            .form-control::placeholder {
                color: #9CA3AF;
            }

            .form-control:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.10);
            }

            .form-control.input-validation-error {
                border-color: var(--error);
            }

        span.text-danger {
            display: block;
            font-size: 14.5px;
            margin-top: 6px;
            font-weight: 500;
            color: var(--error);
        }

            span.text-danger:empty {
                display: none;
            }

        /* Buttons */
        .btn-primary {
            width: 100%;
            height: 60px;
            border: none;
            border-radius: var(--radius-input);
            background: var(--primary);
            color: #fff;
            font-weight: 600;
            font-size: 17.5px;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
            box-shadow: 0 10px 22px rgba(109, 40, 217, .20);
        }

            .btn-primary:hover {
                background: var(--primary-hover);
                transform: translateY(-1px);
                box-shadow: 0 12px 26px rgba(109, 40, 217, .26);
            }

            .btn-primary:active {
                transform: translateY(0);
            }

            .btn-primary:disabled {
                opacity: .65;
                cursor: not-allowed;
                transform: none;
            }

            .btn-primary .spinner {
                width: 16px;
                height: 16px;
                border-radius: 50%;
                border: 2px solid rgba(255, 255, 255, .4);
                border-top-color: #fff;
                display: none;
            }

            .btn-primary.is-loading .spinner {
                display: inline-block;
                animation: spin .7s linear infinite;
            }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 26px 0 22px;
            color: var(--secondary-text);
            font-size: 14px;
        }

            .divider::before, .divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        .back-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: var(--primary);
            text-decoration: none;
            font-size: 15.5px;
            font-weight: 600;
        }

            .back-link:hover {
                color: var(--primary-hover);
            }

            .back-link svg {
                width: 18px;
                height: 18px;
            }

        /* Tablet */
        @@media (max-width: 1023px) {
            .card {
                max-width: 600px;
                padding: 44px;
            }

            h1.page-title {
                font-size: 30px;
            }

            .form-control, .btn-primary {
                height: 56px;
            }
        }

        /* Mobile */
        @@media (max-width: 767px) {
            .card {
                width: calc(100% - 32px);
                max-width: none;
                padding: 32px;
                border-radius: 20px;
            }

            h1.page-title {
                font-size: 27px;
            }

            .page-subtitle {
                font-size: 16px;
            }

            .form-control, .btn-primary {
                height: 54px;
            }

            .header-icon {
                width: 70px;
                height: 70px;
                margin-bottom: 18px;
            }

                .header-icon svg {
                    width: 30px;
                    height: 30px;
                }
        }

        /* Very small */
        @@media (max-width: 480px) {
            .card {
                width: calc(100% - 24px);
                padding: 18px;
            }

            .step-item {
                gap: 3px;
            }

            .step-connector {
                max-width: 14px;
            }
        }

        @@media (max-width: 360px) {
            .step-label {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
            }
        }
    </style>
</head>

<body>

    <div class="auth-shell">
        <div class="card">
            <div class="decor-wave" aria-hidden="true"></div>
            <div class="decor-dots" aria-hidden="true"></div>

            <div class="card-inner">

                <div class="header-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="11" width="14" height="9" rx="2"></rect>
                        <path d="M8 11V7a4 4 0 018 0v4"></path>
                    </svg>
                </div>

                <div class="stepper" aria-hidden="true">
                    <div class="step-item">
                        <div class="step-circle is-active">1</div>
                        <span class="step-label is-active">Request</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">2</div>
                        <span class="step-label">Verify</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">3</div>
                        <span class="step-label">Reset</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">4</div>
                        <span class="step-label">New Password</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">5</div>
                        <span class="step-label">Complete</span>
                    </div>
                </div>

                <h1 class="page-title">Forgot your password?</h1>

                <p class="page-subtitle">
                    Enter your email address or phone number and we'll send you a code to reset your password.
                </p>

                <form method="post">

                    <div asp-validation-summary="All" class="text-danger" aria-live="polite"></div>

                    <div class="field">
                        <label asp-for="Input.Identifier">Email or Phone Number</label>
                        <div class="input-wrap">
                            <span class="leading-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="M3 7l9 6 9-6"></path>
                                </svg>
                            </span>
                            <input asp-for="Input.Identifier"
                                   class="form-control with-icon"
                                   placeholder="name@@email.com"
                                   autocomplete="email"
                                   autofocus
                                   required />
                        </div>
                        <span asp-validation-for="Input.Identifier" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-primary">
                        <span class="spinner"></span>
                        <span class="btn-label">Send Code</span>
                    </button>

                </form>

                <div class="divider">or</div>

                <a href="/Identity/Account/Login" class="back-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5M12 19l-7-7 7-7"></path>
                    </svg>
                    Back to login
                </a>

            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            var form = document.querySelector('form[method="post"]');
            if (!form) { return; }

            form.addEventListener('submit', function () {
                if (window.jQuery && typeof jQuery(form).valid === 'function' && !jQuery(form).valid()) {
                    return;
                }
                var btn = form.querySelector('button[type="submit"]');
                if (btn && !btn.classList.contains('is-loading')) {
                    btn.classList.add('is-loading');
                    btn.querySelector('.btn-label').textContent = 'Processing...';
                    btn.disabled = true;
                }
            });
        })();
    </script>

</body>
</html>
