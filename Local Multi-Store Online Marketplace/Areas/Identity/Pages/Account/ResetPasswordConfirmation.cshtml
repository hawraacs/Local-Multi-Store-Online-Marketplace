@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6D28D9;
            --primary-hover: #5B21B6;
            --light-purple: #8B5CF6;
            --very-light-purple: #F5F3FF;
            --soft-lavender: #EDE9FE;
            --dark-text: #111827;
            --secondary-text: #6B7280;
            --border: #E5E7EB;
            --white: #FFFFFF;
            --success: #22C55E;
            --error: #EF4444;
            --warning: #F59E0B;
            --radius-card: 26px;
            --radius-input: 14px;
            --shadow-card: 0 20px 50px rgba(17, 24, 39, .08), 0 4px 14px rgba(17, 24, 39, .04);
        }

        html, body {
            height: 100%;
        }

        body {
            min-height: 100vh;
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--dark-text);
            background: linear-gradient(180deg, #ffffff 0%, var(--very-light-purple) 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 48px 20px;
        }

        .auth-shell {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .card {
            position: relative;
            width: 100%;
            max-width: 720px;
            background: var(--white);
            border-radius: var(--radius-card);
            padding: 60px;
            text-align: center;
            box-shadow: var(--shadow-card);
            border: 1px solid rgba(17, 24, 39, .04);
            overflow: hidden;
        }

        .card-inner {
            position: relative;
            z-index: 1;
        }

        .decor-wave {
            position: absolute;
            right: -12%;
            bottom: -16%;
            width: 65%;
            height: 42%;
            background: radial-gradient(ellipse at 70% 70%, var(--soft-lavender) 0%, rgba(237, 233, 254, 0) 70%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
        }

        /* Stepper */
        .stepper {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            margin-bottom: 30px;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            flex: 0 0 auto;
        }

        .step-circle {
            width: 37px;
            height: 37px;
            border-radius: 50%;
            background: var(--primary);
            border: 2px solid var(--primary);
            color: #fff;
            font-size: 14.5px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: none;
        }

        .step-label {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--primary);
            white-space: nowrap;
        }

        .step-connector {
            flex: 1 1 32px;
            min-width: 6px;
            max-width: 44px;
            height: 2px;
            background: var(--primary);
            margin-top: 17px;
        }

        /* Success visual */
        .success-visual {
            position: relative;
            width: 80px;
            height: 80px;
            margin: 4px auto 20px;
        }

        .success-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--primary);
            box-shadow: 0 12px 26px rgba(109, 40, 217, .26);
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .success-circle svg {
                width: 34px;
                height: 34px;
                color: #fff;
            }

        .success-particle {
            position: absolute;
            border-radius: 50%;
            background: var(--light-purple);
            pointer-events: none;
        }

            .success-particle.p1 {
                width: 8px;
                height: 8px;
                top: 4px;
                left: -8px;
            }

            .success-particle.p2 {
                width: 5px;
                height: 5px;
                top: 20px;
                right: -14px;
                background: var(--soft-lavender);
            }

            .success-particle.p3 {
                width: 6px;
                height: 6px;
                bottom: 6px;
                left: -4px;
                background: var(--soft-lavender);
            }

            .success-particle.p4 {
                width: 9px;
                height: 9px;
                bottom: -6px;
                right: 10px;
            }

        h1.page-title {
            color: var(--dark-text);
            margin-bottom: 14px;
            font-size: 36px;
            font-weight: 700;
            letter-spacing: -0.01em;
        }

        p.page-subtitle {
            color: var(--secondary-text);
            line-height: 1.55;
            font-size: 17.5px;
            margin-bottom: 3px;
        }

        .btn-primary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            margin-top: 20px;
            height: 60px;
            background: var(--primary);
            color: #fff;
            border-radius: var(--radius-input);
            text-decoration: none;
            font-weight: 600;
            font-size: 17.5px;
            transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
            box-shadow: 0 10px 22px rgba(109, 40, 217, .20);
        }

            .btn-primary:hover {
                background: var(--primary-hover);
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 12px 26px rgba(109, 40, 217, .26);
            }

        .back-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 14px;
            color: var(--primary);
            text-decoration: none;
            font-size: 15.5px;
            font-weight: 600;
        }

            .back-link:hover {
                color: var(--primary-hover);
            }

            .back-link svg {
                width: 18px;
                height: 18px;
            }

        /* Tablet */
        @@media (max-width: 1023px) {
            .card {
                max-width: 600px;
                padding: 44px;
            }

            h1.page-title {
                font-size: 30px;
            }

            .btn-primary {
                height: 56px;
            }
        }

        /* Mobile */
        @@media (max-width: 767px) {
            .card {
                width: calc(100% - 32px);
                max-width: none;
                padding: 32px;
                border-radius: 20px;
            }

            h1.page-title {
                font-size: 27px;
            }

            p.page-subtitle {
                font-size: 16px;
            }

            .btn-primary {
                height: 54px;
            }

            .success-visual {
                width: 84px;
                height: 84px;
            }

            .success-circle {
                width: 84px;
                height: 84px;
            }

                .success-circle svg {
                    width: 34px;
                    height: 34px;
                }
        }

        /* Very small */
        @@media (max-width: 480px) {
            .card {
                width: calc(100% - 24px);
                padding: 18px;
            }

            .step-connector {
                max-width: 14px;
            }
        }

        @@media (max-width: 360px) {
            .step-label {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
            }
        }
    </style>
</head>

<body>

    <div class="auth-shell">
        <div class="card">
            <div class="decor-wave" aria-hidden="true"></div>

            <div class="card-inner">

                <div class="stepper" aria-hidden="true">
                    <div class="step-item">
                        <div class="step-circle">✓</div>
                        <span class="step-label">Request</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">✓</div>
                        <span class="step-label">Verify</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">✓</div>
                        <span class="step-label">Reset</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">✓</div>
                        <span class="step-label">New Password</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">✓</div>
                        <span class="step-label">Complete</span>
                    </div>
                </div>

                <div class="success-visual" aria-hidden="true">
                    <div class="success-particle p1"></div>
                    <div class="success-particle p2"></div>
                    <div class="success-particle p3"></div>
                    <div class="success-particle p4"></div>
                    <div class="success-circle">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                </div>

                <h1 class="page-title">Password reset successful!</h1>

                <p class="page-subtitle">
                    Your password has been updated successfully.
                </p>

                <p class="page-subtitle">
                    You can now log in with your new password.
                </p>

                <a href="/Identity/Account/Login" class="btn-primary">
                    Go to login
                </a>

                <a href="/Identity/Account/Login" class="back-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5M12 19l-7-7 7-7"></path>
                    </svg>
                    Back to login
                </a>

            </div>
        </div>
    </div>

</body>
</html>
