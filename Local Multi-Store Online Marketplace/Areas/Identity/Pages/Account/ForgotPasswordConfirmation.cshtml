@page
@model ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Check Your Email";
    Layout = null;

    var resetIdentifier = TempData["ResetIdentifier"]?.ToString();
    var demoOtp = TempData["DemoOtp"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Check Your Email</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6D28D9;
            --primary-hover: #5B21B6;
            --light-purple: #8B5CF6;
            --very-light-purple: #F5F3FF;
            --soft-lavender: #EDE9FE;
            --dark-text: #111827;
            --secondary-text: #6B7280;
            --border: #E5E7EB;
            --white: #FFFFFF;
            --success: #22C55E;
            --error: #EF4444;
            --warning: #F59E0B;
            --radius-card: 26px;
            --radius-input: 14px;
            --shadow-card: 0 20px 50px rgba(17, 24, 39, .08), 0 4px 14px rgba(17, 24, 39, .04);
        }

        html, body {
            height: 100%;
        }

        body {
            min-height: 100vh;
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--dark-text);
            background: linear-gradient(180deg, #ffffff 0%, var(--very-light-purple) 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 48px 20px;
        }

        .auth-shell {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .card {
            position: relative;
            width: 100%;
            max-width: 720px;
            background: var(--white);
            border-radius: var(--radius-card);
            padding: 60px;
            box-shadow: var(--shadow-card);
            border: 1px solid rgba(17, 24, 39, .04);
            text-align: center;
            overflow: hidden;
        }

        .card-inner {
            position: relative;
            z-index: 1;
        }

        .decor-dots {
            position: absolute;
            top: 12%;
            right: 10%;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--soft-lavender);
            pointer-events: none;
        }

            .decor-dots.d2 {
                top: 8%;
                right: 22%;
                width: 5px;
                height: 5px;
            }

        /* Stepper */
        .stepper {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            margin-bottom: 30px;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            flex: 0 0 auto;
        }

        .step-circle {
            width: 37px;
            height: 37px;
            border-radius: 50%;
            background: var(--white);
            border: 2px solid var(--border);
            color: var(--secondary-text);
            font-size: 14.5px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: none;
        }

            .step-circle.is-active, .step-circle.is-complete {
                background: var(--primary);
                border-color: var(--primary);
                color: #fff;
            }

        .step-label {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--secondary-text);
            white-space: nowrap;
        }

            .step-label.is-active, .step-label.is-complete {
                color: var(--primary);
            }

        .step-connector {
            flex: 1 1 32px;
            min-width: 6px;
            max-width: 44px;
            height: 2px;
            background: var(--border);
            margin-top: 17px;
        }

            .step-connector.is-complete {
                background: var(--primary);
            }

        /* Header icon */
        .header-icon-wrap {
            position: relative;
            width: 62px;
            height: 62px;
            margin: 0 auto 18px;
        }

        .header-icon {
            width: 62px;
            height: 62px;
            border-radius: 50%;
            background: var(--soft-lavender);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .header-icon svg {
                width: 26px;
                height: 26px;
            }

        .header-icon-badge {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            border: 3px solid #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .header-icon-badge svg {
                width: 11px;
                height: 11px;
            }

        h1.page-title {
            font-size: 36px;
            font-weight: 700;
            color: var(--dark-text);
            margin-bottom: 14px;
            letter-spacing: -0.01em;
        }

        .page-subtitle {
            font-size: 17.5px;
            color: var(--secondary-text);
            line-height: 1.55;
            margin-bottom: 3px;
        }

        .target-value {
            font-size: 14.5px;
            font-weight: 700;
            color: var(--primary);
            word-break: break-word;
            margin-bottom: 16px;
        }

        .info-box {
            display: flex;
            align-items: center;
            gap: 9px;
            justify-content: center;
            background: var(--very-light-purple);
            border: 1px solid var(--soft-lavender);
            border-radius: var(--radius-input);
            padding: 10px 14px;
            font-size: 13px;
            color: var(--dark-text);
            font-weight: 500;
            margin-bottom: 14px;
        }

            .info-box svg {
                width: 16px;
                height: 16px;
                color: var(--primary);
                flex: none;
            }

        .otp-label {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--secondary-text);
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 10px;
        }

        .otp-display-wrap {
            position: relative;
            margin: 0 0 18px;
        }

        .otp-display {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: .35em;
            color: var(--primary);
            background: var(--very-light-purple);
            border: 1px dashed var(--primary);
            border-radius: var(--radius-input);
            padding: 11px 40px 11px 14px;
            text-align: center;
        }

        .copy-btn {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border: none;
            background: transparent;
            color: var(--primary);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

            .copy-btn:hover {
                background: rgba(109, 40, 217, .08);
            }

            .copy-btn svg {
                width: 15px;
                height: 15px;
            }

            .copy-btn .copied-text {
                position: absolute;
                bottom: -20px;
                right: 0;
                font-size: 10.5px;
                font-weight: 600;
                color: var(--success);
                white-space: nowrap;
                opacity: 0;
                transition: opacity .15s ease;
            }

            .copy-btn.is-copied .copied-text {
                opacity: 1;
            }

        .demo-note {
            font-size: 11.5px;
            color: #9CA3AF;
            line-height: 1.55;
            margin-bottom: 18px;
        }

        .actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn-primary {
            width: 100%;
            height: 60px;
            border: none;
            border-radius: var(--radius-input);
            background: var(--primary);
            color: #fff;
            font-weight: 600;
            font-size: 17.5px;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
            box-shadow: 0 10px 22px rgba(109, 40, 217, .20);
        }

            .btn-primary:hover {
                background: var(--primary-hover);
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 12px 26px rgba(109, 40, 217, .26);
            }

        .back-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: var(--primary);
            text-decoration: none;
            font-size: 15.5px;
            font-weight: 600;
        }

            .back-link:hover {
                color: var(--primary-hover);
            }

            .back-link svg {
                width: 18px;
                height: 18px;
            }

        /* Tablet */
        @@media (max-width: 1023px) {
            .card {
                max-width: 600px;
                padding: 44px;
            }

            h1.page-title {
                font-size: 30px;
            }

            .btn-primary {
                height: 56px;
            }
        }

        /* Mobile */
        @@media (max-width: 767px) {
            .card {
                width: calc(100% - 32px);
                max-width: none;
                padding: 32px;
                border-radius: 20px;
            }

            h1.page-title {
                font-size: 27px;
            }

            .page-subtitle, .target-value {
                font-size: 16px;
            }

            .btn-primary {
                height: 54px;
            }

            .header-icon-wrap {
                width: 68px;
                height: 68px;
            }

            .header-icon {
                width: 68px;
                height: 68px;
            }

                .header-icon svg {
                    width: 30px;
                    height: 30px;
                }

            .otp-display {
                letter-spacing: .25em;
                font-size: 23px;
            }
        }

        /* Very small */
        @@media (max-width: 480px) {
            .card {
                width: calc(100% - 24px);
                padding: 18px;
            }

            .step-connector {
                max-width: 14px;
            }
        }

        @@media (max-width: 360px) {
            .step-label {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
            }
        }
    </style>
</head>

<body>

    <div class="auth-shell">
        <div class="card">
            <div class="decor-dots" aria-hidden="true"></div>
            <div class="decor-dots d2" aria-hidden="true"></div>

            <div class="card-inner">

                <div class="stepper" aria-hidden="true">
                    <div class="step-item">
                        <div class="step-circle is-complete">✓</div>
                        <span class="step-label is-complete">Request</span>
                    </div>
                    <div class="step-connector is-complete"></div>
                    <div class="step-item">
                        <div class="step-circle is-active">2</div>
                        <span class="step-label is-active">Verify</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">3</div>
                        <span class="step-label">Reset</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">4</div>
                        <span class="step-label">New Password</span>
                    </div>
                    <div class="step-connector"></div>
                    <div class="step-item">
                        <div class="step-circle">5</div>
                        <span class="step-label">Complete</span>
                    </div>
                </div>

                <div class="header-icon-wrap">
                    <div class="header-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                            <path d="M3 7l9 6 9-6"></path>
                        </svg>
                    </div>
                    <div class="header-icon-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                </div>

                <h1 class="page-title">Check your email</h1>

                <p class="page-subtitle">
                    @(TempData["ResetMessage"] ?? "We've sent a verification code to")
                </p>

                @if (TempData["ResetTarget"] != null)
                {
                    <p class="target-value">@TempData["ResetTarget"]</p>
                }

                <div class="info-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7v5l3 3"></path>
                    </svg>
                    The code will expire in 10 minutes.
                </div>

                @if (!string.IsNullOrWhiteSpace(demoOtp))
                {
                    <p class="otp-label">Demo OTP</p>

                    <div class="otp-display-wrap">
                        <div class="otp-display" id="demoOtpValue">@demoOtp</div>
                        <button type="button" class="copy-btn" id="copyOtpBtn" aria-label="Copy demo OTP">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                            </svg>
                            <span class="copied-text">Copied</span>
                        </button>
                    </div>

                    <p class="demo-note">
                        Email/SMS sender is not configured, so the OTP is shown here for local demo only.
                    </p>
                }

                <div class="actions">
                    <a asp-page="./VerifyResetOtp"
                       asp-route-identifier="@resetIdentifier"
                       class="btn-primary">
                        Continue
                    </a>

                    <a href="/Identity/Account/Login" class="back-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 12H5M12 19l-7-7 7-7"></path>
                        </svg>
                        Back to login
                    </a>
                </div>

            </div>
        </div>
    </div>

    <script>
        (function () {
            var btn = document.getElementById('copyOtpBtn');
            var val = document.getElementById('demoOtpValue');
            if (!btn || !val) { return; }

            btn.addEventListener('click', function () {
                var text = val.textContent.trim();

                function markCopied() {
                    btn.classList.add('is-copied');
                    setTimeout(function () { btn.classList.remove('is-copied'); }, 1500);
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(markCopied).catch(function () { });
                } else {
                    var temp = document.createElement('textarea');
                    temp.value = text;
                    document.body.appendChild(temp);
                    temp.select();
                    try { document.execCommand('copy'); markCopied(); } catch (e) { }
                    document.body.removeChild(temp);
                }
            });
        })();
    </script>

</body>
</html>
