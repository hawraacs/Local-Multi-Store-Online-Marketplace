@page
@model ChangePasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Change Password | realnest</title>

    <!-- Same fonts / icons as the rest of the customer app (Wishlist / Profile) -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-color: #faf9fc;
                --card-bg: #ffffff;
                --border-color: #ece8f6;
                --text-primary: #1e1b2e;
                --text-secondary: #6b6478;
                --accent-color: #6d28d9;
                --accent-hover: #5b21b6;
                --accent-light: #f3effe;
                --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #4f46e5 100%);
                --success-color: #10b981;
                --error-color: #dc2626;
                --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                --shadow-sm: 0 4px 12px rgba(109, 40, 217, 0.04);
                --shadow-md: 0 10px 30px rgba(109, 40, 217, 0.08);
                --shadow-lg: 0 20px 40px rgba(109, 40, 217, 0.12);
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-family);
                background-color: var(--bg-color);
                color: var(--text-primary);
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                min-height: 100vh;
                padding-bottom: 60px;
            }

            /* ============================================================
                       PAGE HEADER — mirrors the Wishlist page header, plus a
                       back arrow that returns the customer to their profile.
                       ============================================================ */
            .password-page {
                padding: 24px 16px 20px;
                min-height: 100vh;
            }

            .page-topbar {
                max-width: 560px;
                margin: 0 auto 8px;
                display: flex;
                align-items: center;
            }

            .back-arrow {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                color: var(--text-secondary);
                text-decoration: none;
                font-size: 15px;
                box-shadow: var(--shadow-sm);
                transition: all 0.2s ease;
                flex-shrink: 0;
            }

                .back-arrow:hover {
                    background: var(--accent-color);
                    border-color: var(--accent-color);
                    color: #ffffff;
                    transform: translateX(-2px);
                }

            .password-header {
                text-align: center;
                margin: 12px auto 28px;
                max-width: 560px;
            }

                .password-header h2 {
                    font-family: 'Playfair Display', Georgia, serif;
                    font-size: 30px;
                    font-weight: 800;
                    margin: 0 0 8px;
                    color: var(--text-primary);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                }

                    .password-header h2 i {
                        color: var(--text-primary);
                    }

                .password-header p {
                    margin: 0;
                    color: var(--text-secondary);
                    font-size: 15px;
                    font-weight: 500;
                }

            /* ============================================================
                       STATUS MESSAGE — restyles the default _StatusMessage partial
                       (Bootstrap .alert markup) to match the app's toast palette.
                       ============================================================ */
            .password-container {
                max-width: 560px;
                margin: auto;
            }

                .password-container .alert {
                    border: none;
                    border-left: 5px solid var(--border-color);
                    border-radius: 14px;
                    padding: 16px 20px;
                    margin-bottom: 20px;
                    font-weight: 600;
                    font-size: 13.5px;
                    background: var(--card-bg);
                    box-shadow: var(--shadow-sm);
                    color: var(--text-secondary);
                }

                .password-container .alert-success {
                    border-left-color: var(--success-color);
                    color: #0d7a5f;
                }

                .password-container .alert-danger {
                    border-left-color: var(--error-color);
                    color: var(--error-color);
                }

            .password-card {
                background: var(--card-bg);
                border-radius: 20px;
                padding: 28px 24px 26px;
                box-shadow: var(--shadow-md);
                border: 1px solid var(--border-color);
            }

            .text-danger {
                color: var(--error-color) !important;
                font-size: 12.5px;
                font-weight: 600;
                display: block;
                margin-top: 4px;
            }

            .validation-summary-valid {
                display: none;
            }

            /* ============================================================
                       FORM FIELDS — same look & feel as the settings-card form
                       groups used on the Profile page.
                       ============================================================ */
            .form-group {
                display: flex;
                flex-direction: column;
                gap: 6px;
                margin-bottom: 18px;
            }

                .form-group label {
                    font-size: 12.5px;
                    font-weight: 700;
                    color: var(--text-secondary);
                    text-transform: uppercase;
                    letter-spacing: 0.3px;
                }

                .form-group input {
                    padding: 12px 14px;
                    border: 1px solid var(--border-color);
                    border-radius: 10px;
                    outline: none;
                    font-size: 14.5px;
                    color: var(--text-primary);
                    width: 100%;
                    background: var(--bg-color);
                    font-family: var(--font-family);
                    transition: border-color 0.15s ease, background-color 0.15s ease;
                }

                    .form-group input:focus {
                        border-color: var(--accent-color);
                        background: var(--card-bg);
                    }

            .password-submit-btn {
                width: 100%;
                border: none;
                background: var(--accent-gradient);
                color: #ffffff;
                padding: 14px;
                border-radius: 50px;
                font-family: var(--font-family);
                font-weight: 800;
                font-size: 14.5px;
                cursor: pointer;
                box-shadow: 0 8px 18px rgba(109, 40, 217, 0.25);
                transition: all 0.2s ease;
                margin-top: 6px;
            }

                .password-submit-btn:hover {
                    opacity: 0.95;
                    transform: translateY(-1px);
                    box-shadow: 0 10px 22px rgba(109, 40, 217, 0.32);
                }

            .password-hint {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                background: var(--accent-light);
                border-radius: 12px;
                padding: 12px 14px;
                margin-bottom: 22px;
                font-size: 12.5px;
                color: var(--accent-color);
                font-weight: 600;
                line-height: 1.5;
            }

                .password-hint i {
                    margin-top: 2px;
                    flex-shrink: 0;
                }

            @@media (max-width: 550px) {
                .password-page {
                    padding: 20px 12px 16px;
                }

                .password-card {
                    padding: 22px 18px 20px;
                }
            }
    </style>
</head>

<body>

    <div class="password-page">

        <div class="page-topbar">
            <a href="/CustomerProfile" class="back-arrow" title="Back to profile" aria-label="Back to profile">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
        </div>

        <div class="password-header">
            <h2><i class="fa-solid fa-lock"></i> Change Password</h2>
            <p>Keep your account secure with a strong password.</p>
        </div>

        <div class="password-container">

            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="password-card">

                <div class="password-hint">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Use at least 8 characters, mixing letters, numbers, and symbols for a stronger password.</span>
                </div>

                <form id="change-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-group">
                        <label asp-for="Input.OldPassword">Current Password</label>
                        <input asp-for="Input.OldPassword" autocomplete="current-password" aria-required="true" placeholder="Enter your current password" />
                        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.NewPassword">New Password</label>
                        <input asp-for="Input.NewPassword" autocomplete="new-password" aria-required="true" placeholder="Enter your new password" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword">Confirm New Password</label>
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Re-enter your new password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="password-submit-btn">
                        <i class="fa-solid fa-check"></i> Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>

</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
