@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset Password</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6D28D9;
            --primary-hover: #5B21B6;
            --light-purple: #8B5CF6;
            --very-light-purple: #F5F3FF;
            --soft-lavender: #EDE9FE;
            --dark-text: #111827;
            --secondary-text: #6B7280;
            --border: #E5E7EB;
            --white: #FFFFFF;
            --success: #22C55E;
            --error: #EF4444;
            --warning: #F59E0B;
            --radius-card: 26px;
            --radius-input: 14px;
            --shadow-card: 0 20px 50px rgba(17, 24, 39, .08), 0 4px 14px rgba(17, 24, 39, .04);
        }

        html, body {
            height: 100%;
        }

        body {
            min-height: 100vh;
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--dark-text);
            background: linear-gradient(180deg, #ffffff 0%, var(--very-light-purple) 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 48px 20px;
        }

        .auth-shell {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .card {
            width: 100%;
            max-width: 720px;
            background: var(--white);
            border-radius: var(--radius-card);
            padding: 60px;
            box-shadow: var(--shadow-card);
            border: 1px solid rgba(17, 24, 39, .04);
        }

        /* Stepper */
        .stepper {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            margin-bottom: 30px;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            flex: 0 0 auto;
        }

        .step-circle {
            width: 37px;
            height: 37px;
            border-radius: 50%;
            background: var(--white);
            border: 2px solid var(--border);
            color: var(--secondary-text);
            font-size: 14.5px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: none;
        }

            .step-circle.is-active, .step-circle.is-complete {
                background: var(--primary);
                border-color: var(--primary);
                color: #fff;
            }

        .step-label {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--secondary-text);
            white-space: nowrap;
        }

            .step-label.is-active, .step-label.is-complete {
                color: var(--primary);
            }

        .step-connector {
            flex: 1 1 32px;
            min-width: 6px;
            max-width: 44px;
            height: 2px;
            background: var(--border);
            margin-top: 17px;
        }

            .step-connector.is-complete {
                background: var(--primary);
            }

        h1.page-title {
            font-size: 36px;
            font-weight: 700;
            color: var(--dark-text);
            text-align: center;
            margin-bottom: 14px;
            letter-spacing: -0.01em;
        }

        .page-subtitle {
            font-size: 17.5px;
            color: var(--secondary-text);
            text-align: center;
            line-height: 1.55;
            margin-bottom: 30px;
        }

        /* Validation summary (original class name "validation-box" preserved) */
        div.validation-box {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: #FEF2F2;
            border: 1px solid #FECACA;
            color: var(--error);
            border-radius: var(--radius-input);
            padding: 10px 13px;
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 16px;
        }

            div.validation-box::before {
                content: "!";
                flex: 0 0 auto;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: var(--error);
                color: #fff;
                font-size: 12px;
                font-weight: 800;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-top: 1px;
            }

            div.validation-box.validation-summary-valid {
                display: none;
                padding: 0;
                margin: 0;
                border: none;
                background: none;
            }

                div.validation-box.validation-summary-valid::before {
                    content: none;
                }

            div.validation-box ul {
                list-style: none;
                margin: 0;
                padding: 0;
            }

        /* Fields */
        .field {
            margin-bottom: 22px;
        }

            .field label {
                display: block;
                margin-bottom: 8px;
                font-size: 15px;
                font-weight: 600;
                color: var(--dark-text);
            }

        .input-wrap {
            position: relative;
        }

        .form-control {
            width: 100%;
            height: 60px;
            padding: 0 18px;
            border-radius: var(--radius-input);
            border: 1px solid var(--border);
            font: inherit;
            font-size: 17px;
            color: var(--dark-text);
            background: var(--white);
            transition: border-color .15s ease, box-shadow .15s ease;
        }

            .form-control.has-toggle {
                padding-right: 42px;
            }

            .form-control::placeholder {
                color: #9CA3AF;
            }

            .form-control:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.10);
            }

            .form-control.input-validation-error {
                border-color: var(--error);
            }

        .toggle-visibility {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            border: none;
            background: transparent;
            color: var(--secondary-text);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border-radius: 8px;
        }

            .toggle-visibility:hover {
                background: var(--very-light-purple);
                color: var(--primary);
            }

            .toggle-visibility svg {
                width: 17px;
                height: 17px;
            }

            .toggle-visibility .icon-off {
                display: none;
            }

            .toggle-visibility.is-visible .icon-on {
                display: none;
            }

            .toggle-visibility.is-visible .icon-off {
                display: block;
            }

        span.text-danger {
            display: block;
            font-size: 14.5px;
            margin-top: 6px;
            font-weight: 500;
            color: var(--error);
        }

            span.text-danger:empty {
                display: none;
            }

        .strength-meter {
            display: flex;
            gap: 4px;
            margin-top: 8px;
        }

        .strength-bar {
            flex: 1;
            height: 4px;
            border-radius: 4px;
            background: var(--border);
            transition: background .15s ease;
        }

        .strength-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 5px;
        }

        .strength-text {
            font-size: 11.5px;
            color: var(--secondary-text);
        }

        /* Buttons */
        .btn-primary {
            width: 100%;
            height: 60px;
            margin-top: 4px;
            border: none;
            border-radius: var(--radius-input);
            background: var(--primary);
            color: #fff;
            font-weight: 600;
            font-size: 17.5px;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
            box-shadow: 0 10px 22px rgba(109, 40, 217, .20);
        }

            .btn-primary:hover {
                background: var(--primary-hover);
                transform: translateY(-1px);
                box-shadow: 0 12px 26px rgba(109, 40, 217, .26);
            }

            .btn-primary:active {
                transform: translateY(0);
            }

            .btn-primary:disabled {
                opacity: .65;
                cursor: not-allowed;
                transform: none;
            }

            .btn-primary .spinner {
                width: 16px;
                height: 16px;
                border-radius: 50%;
                border: 2px solid rgba(255, 255, 255, .4);
                border-top-color: #fff;
                display: none;
            }

            .btn-primary.is-loading .spinner {
                display: inline-block;
                animation: spin .7s linear infinite;
            }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .back-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 22px;
            color: var(--primary);
            text-decoration: none;
            font-size: 15.5px;
            font-weight: 600;
        }

            .back-link:hover {
                color: var(--primary-hover);
            }

            .back-link svg {
                width: 18px;
                height: 18px;
            }

        /* Tablet */
        @@media (max-width: 1023px) {
            .card {
                max-width: 600px;
                padding: 44px;
            }

            h1.page-title {
                font-size: 30px;
            }

            .form-control, .btn-primary {
                height: 56px;
            }
        }

        /* Mobile */
        @@media (max-width: 767px) {
            .card {
                width: calc(100% - 32px);
                max-width: none;
                padding: 32px;
                border-radius: 20px;
            }

            h1.page-title {
                font-size: 27px;
            }

            .page-subtitle {
                font-size: 16px;
            }

            .form-control, .btn-primary {
                height: 54px;
            }
        }

        /* Very small */
        @@media (max-width: 480px) {
            .card {
                width: calc(100% - 24px);
                padding: 18px;
            }

            .step-connector {
                max-width: 14px;
            }
        }

        @@media (max-width: 360px) {
            .step-label {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
            }
        }
    </style>
</head>

<body>

    <div class="auth-shell">
        <div class="card">

            <div class="stepper" aria-hidden="true">
                <div class="step-item">
                    <div class="step-circle is-complete">✓</div>
                    <span class="step-label is-complete">Request</span>
                </div>
                <div class="step-connector is-complete"></div>
                <div class="step-item">
                    <div class="step-circle is-complete">✓</div>
                    <span class="step-label is-complete">Verify</span>
                </div>
                <div class="step-connector is-complete"></div>
                <div class="step-item">
                    <div class="step-circle is-complete">✓</div>
                    <span class="step-label is-complete">Reset</span>
                </div>
                <div class="step-connector is-complete"></div>
                <div class="step-item">
                    <div class="step-circle is-active">4</div>
                    <span class="step-label is-active">New Password</span>
                </div>
                <div class="step-connector"></div>
                <div class="step-item">
                    <div class="step-circle">5</div>
                    <span class="step-label">Complete</span>
                </div>
            </div>

            <h1 class="page-title">Create new password</h1>

            <p class="page-subtitle">
                Choose a strong password that you haven't used before.
            </p>

            <form method="post">

                <div asp-validation-summary="All" class="validation-box" aria-live="polite"></div>

                <input asp-for="Input.Code" type="hidden" />
                <input asp-for="Input.Email" type="hidden" />

                <div class="field">
                    <label asp-for="Input.Password">New Password</label>

                    <div class="input-wrap">
                        <input asp-for="Input.Password"
                               id="Input_Password"
                               class="form-control has-toggle"
                               type="password"
                               placeholder="Enter new password"
                               autocomplete="new-password" />

                        <button type="button" class="toggle-visibility" data-target="Input_Password" aria-label="Show password">
                            <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.94 10.94 0 0112 19c-7 0-11-7-11-7a21.86 21.86 0 015.06-6.06M9.9 4.24A10.94 10.94 0 0112 4c7 0 11 7 11 7a21.86 21.86 0 01-3.22 4.44M14.12 14.12a3 3 0 11-4.24-4.24"></path>
                                <path d="M1 1l22 22"></path>
                            </svg>
                        </button>
                    </div>

                    <div class="strength-row">
                        <div class="strength-meter" id="strengthMeter" aria-hidden="true">
                            <div class="strength-bar"></div>
                            <div class="strength-bar"></div>
                            <div class="strength-bar"></div>
                        </div>
                        <span class="strength-text" id="strengthText"></span>
                    </div>

                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>

                    <div class="input-wrap">
                        <input asp-for="Input.ConfirmPassword"
                               id="Input_ConfirmPassword"
                               class="form-control has-toggle"
                               type="password"
                               placeholder="Confirm new password"
                               autocomplete="new-password" />

                        <button type="button" class="toggle-visibility" data-target="Input_ConfirmPassword" aria-label="Show password">
                            <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.94 10.94 0 0112 19c-7 0-11-7-11-7a21.86 21.86 0 015.06-6.06M9.9 4.24A10.94 10.94 0 0112 4c7 0 11 7 11 7a21.86 21.86 0 01-3.22 4.44M14.12 14.12a3 3 0 11-4.24-4.24"></path>
                                <path d="M1 1l22 22"></path>
                            </svg>
                        </button>
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn-primary">
                    <span class="spinner"></span>
                    <span class="btn-label">Reset Password</span>
                </button>

            </form>

            <a asp-page="./Login" class="back-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5M12 19l-7-7 7-7"></path>
                </svg>
                Back to login
            </a>

        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            // Show / hide password toggles
            document.querySelectorAll('.toggle-visibility').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetId = btn.getAttribute('data-target');
                    var input = document.getElementById(targetId);
                    if (!input) { return; }

                    var isVisible = input.type === 'text';
                    input.type = isVisible ? 'password' : 'text';
                    btn.classList.toggle('is-visible', !isVisible);
                    btn.setAttribute('aria-label', isVisible ? 'Show password' : 'Hide password');
                });
            });

            // Lightweight client-side strength meter (visual guidance only;
            // actual password rules are enforced server-side and are unchanged)
            var pwd = document.getElementById('Input_Password');
            var bars = document.querySelectorAll('#strengthMeter .strength-bar');
            var text = document.getElementById('strengthText');
            var colors = ['#EF4444', '#F59E0B', '#22C55E'];
            var labels = ['Weak', 'Medium', 'Strong'];

            if (pwd && bars.length) {
                pwd.addEventListener('input', function () {
                    var val = pwd.value;

                    if (!val) {
                        bars.forEach(function (b) { b.style.background = ''; });
                        text.textContent = '';
                        return;
                    }

                    var score = 0;
                    if (val.length >= 6) score++;
                    if (val.length >= 10 && /[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
                    if (val.length >= 10 && /[^A-Za-z0-9]/.test(val) && /[A-Z]/.test(val) && /[0-9]/.test(val)) score = 3;
                    if (score > 3) score = 3;
                    if (score < 1) score = 1;

                    bars.forEach(function (b, i) {
                        b.style.background = i < score ? colors[score - 1] : '';
                    });

                    text.textContent = labels[score - 1];
                    text.style.color = colors[score - 1];
                });
            }

            // Loading state on submit
            var form = document.querySelector('form[method="post"]');
            if (!form) { return; }

            form.addEventListener('submit', function () {
                if (window.jQuery && typeof jQuery(form).valid === 'function' && !jQuery(form).valid()) {
                    return;
                }
                var btn = form.querySelector('button[type="submit"]');
                if (btn && !btn.classList.contains('is-loading')) {
                    btn.classList.add('is-loading');
                    btn.querySelector('.btn-label').textContent = 'Processing...';
                    btn.disabled = true;
                }
            });
        })();
    </script>

</body>

</html>
